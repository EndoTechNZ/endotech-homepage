---
import '../styles/tailwind.css';
import logoDefault from '../assets/endotech-nz-logo-2026.jpg';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.defaultDescription,
  image,
  noindex = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();
const defaultImage = Astro.site ? new URL(logoDefault.src, Astro.site).toString() : undefined;
const socialImage = image ? new URL(image, Astro.site ?? Astro.url).toString() : defaultImage;
const googleSiteVerification =
  import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '66rRw6fVQeHsCNpjSjIFm6tde0bpo4CXXigS2n2Vklg';
const googleAnalyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
const clarityProjectId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
const organizationSchema = Astro.site
  ? {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: siteConfig.name,
      url: Astro.site.toString(),
      email: `mailto:${siteConfig.email}`,
    }
  : null;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <link rel="icon" type="image/jpeg" href={`${import.meta.env.BASE_URL}brand/endotech-nz-logo-2026.jpg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}brand/endotech-nz-logo-2026.jpg`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Nunito+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    {googleAnalyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
        <script is:inline define:vars={{ googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', googleAnalyticsId);
        </script>
      </>
    )}

    {clarityProjectId && (
      <script is:inline define:vars={{ clarityProjectId }}>
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", clarityProjectId);
      </script>
    )}

    <title>{title}</title>
    {organizationSchema && <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}
    <slot name="head" />
  </head>
  <body class="landing-page bg-white font-sans text-slate-900 antialiased transition-colors dark:bg-slate-900 dark:text-slate-100">
    <slot />

    <script is:inline define:vars={{ logoDefaultSrc: logoDefault.src }}>
      window.logoDarkSrc = logoDefaultSrc;
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: 'Nunito Sans', system-ui, sans-serif;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: 'Sora', system-ui, sans-serif;
  }
</style>
