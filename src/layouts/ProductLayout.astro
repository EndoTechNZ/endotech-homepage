---
import Layout from './Layout.astro';
import logoIcon from '../assets/endotech-logo-2.png';
import { siteConfig } from '../config/site';
import { getFooterSections, getFooterUtilityLinks, getOrderMenu, getPrimaryNavItems, getProductMenu, getProductMobileNavItems, getTechnologyMenu } from '../data/navigation';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: Record<string, unknown>;
  accent?: 'teal' | 'violet' | 'slate';
}

const { title, description, image, schema, accent = 'teal' } = Astro.props;
const base = import.meta.env.BASE_URL;
const navItems = getPrimaryNavItems(base);
const productMenu = getProductMenu(base);
const technologyMenu = getTechnologyMenu(base);
const orderMenu = getOrderMenu(base);
const mobileNavItems = getProductMobileNavItems(base);
const footerSections = getFooterSections(base);
const footerUtilityLinks = getFooterUtilityLinks(base);
---

<Layout title={title} description={description} image={image}>
  {schema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <header class="product-site-header">
    <div class="product-site-header-inner">
      <a href={base} class="product-site-brand" aria-label={`${siteConfig.name} home`}>
        <img src={logoIcon.src} alt="" />
        <span>
          <strong>{siteConfig.name}</strong>
          <small>Engineered endodontics</small>
        </span>
      </a>

      <nav aria-label="Primary navigation">
        <a href={navItems[0].href}>{navItems[0].label}</a>
        <div class="products-menu">
          <button id="products-menu-button" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="products-menu-panel">
            Products
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>
          <div class="products-menu-bridge"></div>
          <div id="products-menu-panel" class="products-menu-panel">
            <div class="products-menu-shell">
              <span>Product lineup</span>
              {productMenu.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </div>
          </div>
        </div>
        <a href={navItems[2].href}>{navItems[2].label}</a>
        <div class="products-menu technology-menu">
          <button id="technology-menu-button" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="technology-menu-panel">
            Technology
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>
          <div class="products-menu-bridge"></div>
          <div id="technology-menu-panel" class="products-menu-panel">
            <div class="products-menu-shell">
              <span>Technology Platform</span>
              {technologyMenu.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </div>
          </div>
        </div>
        {navItems.slice(5).filter((item) => item.label !== 'Order').map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <div class="product-header-actions">
        <div class="products-menu order-menu">
          <button id="order-menu-button" class="product-header-action" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="order-menu-panel">
            Order
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>
          <div class="products-menu-bridge"></div>
          <div id="order-menu-panel" class="products-menu-panel order-menu-panel">
            <div class="products-menu-shell">
              <span>Order options</span>
              {orderMenu.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </div>
          </div>
        </div>
        <a class="product-header-action" href={`${base}about/contact/`}>Contact</a>
        <button class="product-menu-toggle" id="product-mobile-menu-button" type="button" aria-expanded="false" aria-controls="product-mobile-menu">
          Menu
        </button>
      </div>
    </div>

    <div id="product-mobile-menu" class="product-mobile-menu">
      <div class="product-mobile-menu-shell">
        {mobileNavItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
    </div>
  </header>

  <main class="product-site-main" data-accent={accent}>
    <slot />
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const productsMenu = document.querySelector('.products-menu');
      const productsMenuButton = document.getElementById('products-menu-button');
      const technologyMenu = document.querySelector('.technology-menu');
      const technologyMenuButton = document.getElementById('technology-menu-button');
      const orderMenu = document.querySelector('.order-menu');
      const orderMenuButton = document.getElementById('order-menu-button');
      const mobileMenu = document.getElementById('product-mobile-menu');
      const mobileMenuButton = document.getElementById('product-mobile-menu-button');
      const siteHeader = document.querySelector('.product-site-header');

      function syncMobileMenuBounds() {
        if (!mobileMenu || !siteHeader) return;
        const headerBottom = Math.max(0, Math.ceil(siteHeader.getBoundingClientRect().bottom));
        const viewportHeight = Math.floor(window.visualViewport?.height || window.innerHeight);
        const openMenuRect = mobileMenu.classList.contains('is-open') ? mobileMenu.getBoundingClientRect() : null;
        const panelTop = Math.max(0, Math.ceil(openMenuRect?.top || headerBottom));
        const panelHeight = Math.max(160, viewportHeight - panelTop - 1);
        document.documentElement.style.setProperty('--product-mobile-menu-top', `${headerBottom}px`);
        document.documentElement.style.setProperty('--product-mobile-viewport-height', `${viewportHeight}px`);
        document.documentElement.style.setProperty('--product-mobile-menu-height', `${panelHeight}px`);
      }

      function syncOpenMobileMenuBounds() {
        if (mobileMenuButton?.getAttribute('aria-expanded') === 'true') {
          syncMobileMenuBounds();
        }
      }

      function setProductsMenu(open) {
        if (!productsMenu || !productsMenuButton) return;
        productsMenu.classList.toggle('is-open', open);
        productsMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      function setTechnologyMenu(open) {
        if (!technologyMenu || !technologyMenuButton) return;
        technologyMenu.classList.toggle('is-open', open);
        technologyMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      function setOrderMenu(open) {
        if (!orderMenu || !orderMenuButton) return;
        orderMenu.classList.toggle('is-open', open);
        orderMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      function setMobileMenu(open) {
        if (!mobileMenu || !mobileMenuButton) return;
        if (open) {
          syncMobileMenuBounds();
          mobileMenu.scrollTop = 0;
        }
        mobileMenu.classList.toggle('is-open', open);
        mobileMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.documentElement.classList.toggle('product-mobile-menu-open', open);
        document.body.classList.toggle('product-mobile-menu-open', open);
        if (open) {
          window.requestAnimationFrame(syncMobileMenuBounds);
        }
      }

      productsMenuButton?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const isOpen = productsMenuButton.getAttribute('aria-expanded') === 'true';
        setProductsMenu(!isOpen);
        setTechnologyMenu(false);
        setOrderMenu(false);
      });

      technologyMenuButton?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const isOpen = technologyMenuButton.getAttribute('aria-expanded') === 'true';
        setTechnologyMenu(!isOpen);
        setProductsMenu(false);
        setOrderMenu(false);
      });

      orderMenuButton?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const isOpen = orderMenuButton.getAttribute('aria-expanded') === 'true';
        setOrderMenu(!isOpen);
        setProductsMenu(false);
        setTechnologyMenu(false);
      });

      mobileMenuButton?.addEventListener('click', () => {
        const isOpen = mobileMenuButton.getAttribute('aria-expanded') === 'true';
        setMobileMenu(!isOpen);
      });

      productsMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setProductsMenu(false));
      });

      technologyMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setTechnologyMenu(false));
      });

      orderMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setOrderMenu(false));
      });

      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMobileMenu(false));
      });

      document.addEventListener('click', (event) => {
        if (!productsMenu) return;
        if (!productsMenu.contains(event.target)) {
          setProductsMenu(false);
        }
        if (technologyMenu && !technologyMenu.contains(event.target)) {
          setTechnologyMenu(false);
        }
        if (orderMenu && !orderMenu.contains(event.target)) {
          setOrderMenu(false);
        }
        if (mobileMenu && mobileMenuButton && !mobileMenu.contains(event.target) && !mobileMenuButton.contains(event.target)) {
          setMobileMenu(false);
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setProductsMenu(false);
          setTechnologyMenu(false);
          setOrderMenu(false);
          setMobileMenu(false);
        }
      });

      window.addEventListener('resize', () => {
        syncOpenMobileMenuBounds();
        if (window.innerWidth > 1120) {
          setMobileMenu(false);
        }
      });
      window.visualViewport?.addEventListener('resize', syncOpenMobileMenuBounds);
      window.visualViewport?.addEventListener('scroll', syncOpenMobileMenuBounds);
    });
  </script>

  <footer class="product-site-footer">
    <div class="product-site-footer-shell">
      <div class="product-site-footer-brand">
        <span class="product-site-footer-kicker">EndoTech NZ</span>
        <strong>{siteConfig.name}</strong>
        <p>Clinical endodontic systems for New Zealand dentists.</p>
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      </div>

      <div class="product-site-footer-links">
        {footerSections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            <nav aria-label={`${section.title} footer navigation`}>
              {section.links.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </nav>
          </section>
        ))}
      </div>
    </div>

    <div class="product-site-footer-bottom">
      <p>
        Review technique guidance, product files, and supporting evidence before ordering.
      </p>
      <nav aria-label="Footer utility navigation">
        {footerUtilityLinks.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </div>
  </footer>
</Layout>

<style is:global>
  html.product-mobile-menu-open,
  body.product-mobile-menu-open {
    overscroll-behavior: contain;
  }

  .product-site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    border-bottom: 1px solid #e3e8ee;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
  }

  .product-site-header-inner {
    display: grid;
    grid-template-columns: minmax(210px, auto) 1fr auto;
    gap: 28px;
    align-items: center;
    min-height: 72px;
    padding: 0 56px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .product-site-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .product-site-brand img {
    width: 34px;
  }

  .product-site-brand span {
    display: grid;
    gap: 2px;
    line-height: 1;
    min-width: 0;
  }

  .product-site-brand strong,
  .product-site-footer strong {
    color: #0b1424;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .product-site-brand small {
    color: #707881;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .product-site-header nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    color: #404750;
    font-size: 0.82rem;
    font-weight: 500;
  }

  .product-site-header nav a,
  .products-menu button,
  .product-header-action,
  .product-menu-toggle {
    color: inherit;
    text-decoration: none;
  }

  .products-menu {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .products-menu button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 0;
    padding: 0;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .products-menu svg {
    width: 14px;
    height: 14px;
    transition: transform 180ms ease;
  }

  .products-menu path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .products-menu-bridge {
    position: absolute;
    top: 100%;
    left: 50%;
    width: 280px;
    height: 22px;
    transform: translateX(-50%);
  }

  .products-menu-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 90;
    width: 300px;
    padding-top: 10px;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 4px);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .products-menu-shell {
    display: grid;
    gap: 2px;
    border: 1px solid #e3e8ee;
    border-radius: 12px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 8px 24px rgba(0, 55, 112, 0.08);
    backdrop-filter: blur(16px);
  }

  .products-menu-shell span {
    padding: 6px 8px 8px;
    color: #707881;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .products-menu-shell a {
    display: flex;
    min-height: 44px;
    align-items: center;
    border-radius: 8px;
    padding: 10px 8px;
    color: #344357;
    font-size: 0.84rem;
    font-weight: 500;
    transition:
      background 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .products-menu-shell a:hover,
  .products-menu-shell a:focus-visible {
    background: #f3f7fa;
    color: #0b1424;
    transform: translateX(2px);
  }

  .products-menu:hover .products-menu-panel,
  .products-menu:focus-within .products-menu-panel,
  .products-menu.is-open .products-menu-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .products-menu:hover svg,
  .products-menu:focus-within svg,
  .products-menu.is-open svg {
    transform: translateY(1px);
  }

  .product-header-actions {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .product-header-action,
  .product-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    border: 1px solid #c0c7d2;
    border-radius: 8px;
    padding: 0 16px;
    color: #102033;
    font-size: 0.82rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .order-menu button.product-header-action {
    gap: 6px;
    border: 1px solid #c0c7d2;
    padding: 0 14px 0 16px;
    background: rgba(255, 255, 255, 0.92);
  }

  .order-menu .products-menu-bridge {
    width: 230px;
  }

  .order-menu-panel {
    width: 230px;
  }

  .product-header-action:hover,
  .product-header-action:focus-visible,
  .product-menu-toggle:hover,
  .product-menu-toggle:focus-visible {
    background: #f8fbfd;
    border-color: #aeb8c5;
    box-shadow:
      0 10px 24px rgba(15, 23, 42, 0.08),
      0 2px 6px rgba(15, 23, 42, 0.05);
    transform: translateY(-1px);
  }

  .product-menu-toggle {
    display: none;
    background: #ffffff;
    cursor: pointer;
  }

  .product-mobile-menu {
    display: none;
    position: fixed;
    top: var(--product-mobile-menu-top, 72px);
    left: 0;
    right: 0;
    z-index: 80;
    border-top: 1px solid #e3e8ee;
    background: rgba(255, 255, 255, 0.98);
    height: calc(100svh - 72px);
    height: calc(var(--product-mobile-viewport-height, 100svh) - var(--product-mobile-menu-top, 72px));
    height: var(--product-mobile-menu-height, calc(var(--product-mobile-viewport-height, 100svh) - var(--product-mobile-menu-top, 72px)));
    max-height: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y;
    -webkit-overflow-scrolling: touch;
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
  }

  .product-mobile-menu-shell {
    display: grid;
    gap: 8px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 14px 18px calc(18px + env(safe-area-inset-bottom, 0px));
  }

  .product-mobile-menu-shell a {
    display: flex;
    min-height: 44px;
    align-items: center;
    border: 1px solid #e3e8ee;
    border-radius: 10px;
    padding: 12px 14px;
    color: #0b1424;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    background: rgba(248, 250, 252, 0.92);
  }

  .product-site-main {
    background: #f7f9fb;
  }

  .product-site-footer {
    border-top: 1px solid #e3e8ee;
    background: #fbfcfe;
    padding: 0 56px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .product-site-footer-shell {
    display: grid;
    grid-template-columns: minmax(280px, 0.95fr) minmax(0, 2.05fr);
    gap: 44px;
    padding: 48px 0 28px;
  }

  .product-site-footer-brand {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .product-site-footer-kicker {
    color: #7b8794;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .product-site-footer-brand p,
  .product-site-footer-bottom p {
    color: #5f6b78;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .product-site-footer-brand p {
    max-width: 34ch;
    margin: 0;
  }

  .product-site-footer-brand a,
  .product-site-footer-bottom a {
    color: #25364a;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.83rem;
    font-weight: 500;
    text-decoration: none;
  }

  .product-site-footer-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .product-site-footer-links section {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .product-site-footer-links h2 {
    margin: 0;
    color: #7b8794;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .product-site-footer-links nav {
    display: grid;
    gap: 8px;
  }

  .product-site-footer-links nav a {
    color: #25364a;
    font-size: 0.84rem;
    font-weight: 450;
    line-height: 1.5;
  }

  .product-site-footer-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    padding: 18px 0 28px;
    border-top: 1px solid #e3e8ee;
  }

  .product-site-footer-bottom p {
    margin: 0;
    max-width: 78ch;
    font-size: 0.79rem;
  }

  .product-site-footer-bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    row-gap: 10px;
  }

  @media (max-width: 1120px) {
    .product-site-header-inner,
    .product-site-footer {
      padding-left: 30px;
      padding-right: 30px;
    }

    .product-site-header-inner {
      grid-template-columns: auto auto;
    }

    .product-site-header nav {
      display: none;
    }

    .product-menu-toggle {
      display: inline-flex;
    }

    .product-mobile-menu.is-open {
      display: block;
    }

    .product-site-footer-shell,
    .product-site-footer-links,
    .product-site-footer-bottom {
      grid-template-columns: 1fr;
    }

    .product-site-footer-shell {
      gap: 32px;
    }

    .product-site-footer-bottom nav {
      justify-content: flex-start;
    }
  }

  @media (max-width: 720px) {
    .product-site-header-inner,
    .product-site-footer {
      padding-left: 18px;
      padding-right: 18px;
    }

    .product-site-header-inner {
      min-height: 70px;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px;
    }

    .product-mobile-menu {
      top: var(--product-mobile-menu-top, 70px);
      height: calc(100svh - 70px);
      height: calc(var(--product-mobile-viewport-height, 100svh) - var(--product-mobile-menu-top, 70px));
      height: var(--product-mobile-menu-height, calc(var(--product-mobile-viewport-height, 100svh) - var(--product-mobile-menu-top, 70px)));
    }

    .order-menu .products-menu-bridge {
      right: 0;
      left: auto;
      transform: none;
    }

    .order-menu-panel {
      right: 0;
      left: auto;
      transform: translate(0, 4px);
    }

    .order-menu:hover .order-menu-panel,
    .order-menu:focus-within .order-menu-panel,
    .order-menu.is-open .order-menu-panel {
      transform: translate(0, 0);
    }

    .product-site-brand small {
      display: none;
    }

    .product-header-action,
    .product-menu-toggle {
      min-height: 44px;
      padding: 0 12px;
      font-size: 0.8rem;
    }

    .product-header-action.account-header-action {
      display: none;
    }

    .product-site-footer-links nav a,
    .product-site-footer-bottom nav a,
    .product-site-footer-brand a {
      display: flex;
      min-height: 32px;
      align-items: center;
    }
  }

  @media (max-width: 480px) {
    .product-site-brand {
      gap: 10px;
    }

    .product-site-brand img {
      width: 32px;
    }

    .product-site-brand strong {
      font-size: 0.9rem;
    }

    .product-header-actions {
      gap: 8px;
    }

