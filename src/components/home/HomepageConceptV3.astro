---
import logoIcon from '../../assets/endotech-logo-2.png';
import homepageSplash from '../../assets/homepage-transformx-clinical-splash.png';
import transformxSystem from '../../assets/transformx-rotary-file-system.png';
import etProduct from '../../assets/et-transformx.png';
import ptProduct from '../../assets/pt-transformx.png';
import acrobatProduct from '../../assets/acrobat-glide-path-files.png';
import bcsSealer from '../../assets/bcs-sealer.png';
import vortiflowFlow from '../../assets/vortiflow/vortiflow-fluid-dynamics-clean.png';
import ClinicalWorkflowWheel from './ClinicalWorkflowWheel.astro';
import { siteConfig } from '../../config/site';
import { getFooterSections, getFooterUtilityLinks, getHomepageMobileNavItems, getPrimaryNavItems, getProductMenu } from '../../data/navigation';

const base = import.meta.env.BASE_URL;

const navItems = getPrimaryNavItems(base);
const productMenu = getProductMenu(base);
const mobileNavItems = getHomepageMobileNavItems(base);
const footerSections = getFooterSections(base);
const footerUtilityLinks = getFooterUtilityLinks(base);

const systems = [
  {
    title: 'TransformX ET',
    label: 'Rotary shaping',
    description: 'ET-style shaping with a familiar .04/.06 sequence path.',
    href: `${base}products/et-transformx/`,
    image: etProduct.src,
    alt: 'ET TransformX rotary files',
  },
  {
    title: 'TransformX PT',
    label: 'Rotary shaping',
    description: 'PT-style shaping with a clearer coronal-to-apical progression.',
    href: `${base}products/pt-transformx/`,
    image: ptProduct.src,
    alt: 'PT TransformX rotary file system',
  },
  {
    title: 'Acrobat',
    label: 'Glide path',
    description: 'A rotary glide path before shaping becomes more demanding.',
    href: `${base}products/acrobat-glide-path/`,
    image: acrobatProduct.src,
    alt: 'Acrobat glide path files',
  },
  {
    title: 'VortiFlow',
    label: 'Irrigation',
    description: 'Fluid delivery after shaping and before the final seal.',
    href: `${base}products/vortiflow-irrigation-needle/`,
    image: vortiflowFlow.src,
    alt: 'VortiFlow irrigation support image',
  },
];

const evidenceLinks = [
  {
    label: 'Workflow documents',
    title: 'Clinical workflow and technique files',
    href: `${base}resources/downloads/`,
  },
  {
    label: 'Technology',
    title: 'Transform Technology and Avatar Tip',
    href: `${base}technology/transform-technology/`,
  },
  {
    label: 'Education',
    title: 'Clinical tips and product learning',
    href: `${base}resources/clinical-tips/`,
  },
];

const workflowSteps = [
  {
    number: '01',
    title: 'Glide',
    description: 'Establish and maintain a consistent glide path.',
    path: 'M19 3c-2.7 0-4.3 2.2-5 4.2C13.3 5.2 11.7 3 9 3 5.8 3 4 5.5 4 8.7c0 3.1 2 5.1 3 8.6.6 2.2 1.2 3.7 2.4 3.7 1.5 0 1.1-5.2 4.6-5.2s3.1 5.2 4.6 5.2c1.2 0 1.8-1.5 2.4-3.7 1-3.5 3-5.5 3-8.6C24 5.5 22.2 3 19 3Z M14 7.2c-.4 2.5-.4 5.5 0 9.2 M10.5 7.8c.7 1.6 1 3.2.8 4.9 M17.5 7.8c-.7 1.6-1 3.2-.8 4.9',
  },
  {
    number: '02',
    title: 'Shape',
    description: 'Adaptive shaping for efficient dentin removal and anatomy conformance.',
    path: 'M19 3c-2.7 0-4.3 2.2-5 4.2C13.3 5.2 11.7 3 9 3 5.8 3 4 5.5 4 8.7c0 3.1 2 5.1 3 8.6.6 2.2 1.2 3.7 2.4 3.7 1.5 0 1.1-5.2 4.6-5.2s3.1 5.2 4.6 5.2c1.2 0 1.8-1.5 2.4-3.7 1-3.5 3-5.5 3-8.6C24 5.5 22.2 3 19 3Z M14 6.5v9.8 M10.8 9.4h6.4 M11.8 12.2h4.4',
  },
  {
    number: '03',
    title: 'Finish',
    description: 'Refine the canal to final taper for optimal cleaning and disinfection.',
    path: 'M19 3c-2.7 0-4.3 2.2-5 4.2C13.3 5.2 11.7 3 9 3 5.8 3 4 5.5 4 8.7c0 3.1 2 5.1 3 8.6.6 2.2 1.2 3.7 2.4 3.7 1.5 0 1.1-5.2 4.6-5.2s3.1 5.2 4.6 5.2c1.2 0 1.8-1.5 2.4-3.7 1-3.5 3-5.5 3-8.6C24 5.5 22.2 3 19 3Z M14 7.2c.8 2.7.8 5.9 0 9.6 M11.2 8.8c1.9 1.7 3.8 1.7 5.6 0',
  },
];
---

<header class="homepage-shell-header">
  <div class="homepage-shell-header-inner">
    <a class="homepage-brand" href={base} aria-label={`${siteConfig.name} home`}>
      <img src={logoIcon.src} alt="" />
      <span>
        <strong>{siteConfig.name}</strong>
        <small>Engineered endodontics</small>
      </span>
    </a>

    <nav aria-label="Primary navigation">
      {navItems.filter((item) => item.label !== 'Order').map((item) => (
        item.label === 'Products' ? (
          <div class="products-menu">
            <button
              id="homepage-products-menu-button"
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="homepage-products-menu-panel"
            >
              Products
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </button>
            <div class="products-menu-bridge"></div>
            <div id="homepage-products-menu-panel" class="products-menu-panel">
              <div class="products-menu-shell">
                <span>Product lineup</span>
                {productMenu.map((product) => (
                  <a href={product.href}>{product.label}</a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href}>{item.label}</a>
        )
      ))}
    </nav>

    <div class="homepage-header-actions">
      <a class="homepage-header-action" href={`${base}order/`}>Order</a>
      <a class="homepage-header-action" href={`${base}about/contact/`}>Contact</a>
      <button class="homepage-menu-toggle" id="homepage-mobile-menu-button" type="button" aria-expanded="false" aria-controls="homepage-mobile-menu">
        Menu
      </button>
    </div>
  </div>

  <div id="homepage-mobile-menu" class="homepage-mobile-menu">
    <div class="homepage-mobile-menu-shell">
      {mobileNavItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </div>
  </div>
</header>

<main class="homepage-stitch-page">
  <section class="homepage-hero" aria-labelledby="homepage-hero-title">
    <figure class="homepage-hero-product-bg" aria-hidden="true">
      <img src={homepageSplash.src} alt="" />
    </figure>
    <div class="homepage-hero-panel">
      <div class="homepage-hero-copy">
        <div class="clinical-workflow-reveal-mask">
          <p class="clinical-workflow-reveal-text js-clinical-workflow-reveal">
            EndoTech NZ Clinical Workflow
          </p>
        </div>
        <h1 id="homepage-hero-title" class="homepage-hero-title homepage-hero-title--pre-reveal" data-homepage-hero-title>
          <span class="homepage-hero-line" style="--hero-line-delay: 0ms;">
            <span class="homepage-hero-dark">Shape</span>
            <span class="homepage-hero-light">with confidence.</span>
          </span>
          <span class="homepage-hero-line" style="--hero-line-delay: 70ms;">
            <span class="homepage-hero-dark">Clean</span>
            <span class="homepage-hero-light">with purpose.</span>
          </span>
          <span class="homepage-hero-line" style="--hero-line-delay: 140ms;">
            <span class="homepage-hero-dark">Seal</span>
            <span class="homepage-hero-light">with control.</span>
          </span>
        </h1>
        <p class="homepage-hero-lede">
          EndoTech brings together glide path, shaping, irrigation and obturation into one practical clinical workflow for New Zealand endodontics.
        </p>
      </div>

      <div class="homepage-hero-actions">
        <a class="homepage-button primary" href={`${base}products/overview/`}>Product Systems</a>
        <a class="homepage-button secondary" href={`${base}technique/workflow/`}>Clinical Workflow</a>
      </div>
    </div>
  </section>

  <section class="homepage-workflow-strip" aria-label="Clinical workflow stages">
    <div class="homepage-workflow-strip-shell">
      {workflowSteps.map((step, index) => (
        <>
          <article class="homepage-workflow-step">
            <div class="homepage-workflow-icon" aria-hidden="true">
              <svg viewBox="0 0 28 28">
                <path d={step.path}></path>
              </svg>
            </div>
            <div class="homepage-workflow-copy">
              <span>{step.number}</span>
              <h2>{step.title}</h2>
              <p>{step.description}</p>
            </div>
          </article>
          {index < workflowSteps.length - 1 && (
            <div class="homepage-workflow-divider" aria-hidden="true">
              <span>
                <svg viewBox="0 0 16 16">
                  <path d="M6.5 4.5 10 8l-3.5 3.5"></path>
                </svg>
              </span>
            </div>
          )}
        </>
      ))}
    </div>
  </section>

  <div class="homepage-core-separator" aria-hidden="true"></div>

  <section class="homepage-systems-section" aria-labelledby="homepage-systems-title">
    <div class="homepage-section-heading">
      <p class="homepage-eyebrow">Core systems</p>
      <h2 id="homepage-systems-title">Choose the product path that fits the case.</h2>
    </div>

    <div class="homepage-systems-grid" role="list">
      {systems.map((system) => (
        <a class="homepage-system-card" href={system.href} role="listitem">
          <figure>
            <img src={system.image} alt={system.alt} />
          </figure>
          <div>
            <span>{system.label}</span>
            <h3>{system.title}</h3>
            <p>{system.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <ClinicalWorkflowWheel base={base} />

  <section class="homepage-bcs-section" aria-labelledby="homepage-bcs-title">
    <div class="homepage-bcs-copy">
      <p class="homepage-eyebrow">Chemical engineering</p>
      <h2 id="homepage-bcs-title">BCS BioCeramic Sealer</h2>
      <p class="homepage-bcs-lede">
        EndoTech NZ extends beyond shaping. The system moves from preparation into irrigation and then into a matched bioceramic sealing pathway.
      </p>
      <div class="homepage-bcs-metrics">
        <div>
          <strong>Glide to seal</strong>
          <span>matched workflow path</span>
        </div>
        <div>
          <strong>NZ support</strong>
          <span>local ordering and enquiry</span>
        </div>
      </div>
      <div class="homepage-bcs-actions">
        <a class="homepage-button dark" href={`${base}products/bcs/`}>Explore BCS Family</a>
        <a class="homepage-inline-link" href={`${base}resources/downloads/`}>Open clinical files</a>
      </div>
    </div>

    <figure class="homepage-bcs-visual">
      <img src={bcsSealer.src} alt="BCS BioCeramic sealer packaging" />
    </figure>
  </section>

  <section class="homepage-evidence-section" aria-labelledby="homepage-evidence-title">
    <div class="homepage-evidence-heading">
      <h2 id="homepage-evidence-title">Evidence and downloads</h2>
      <p>Technical files, workflow documents, and product learning for evaluation before ordering.</p>
    </div>

    <div class="homepage-evidence-list">
      {evidenceLinks.map((item) => (
        <a href={item.href}>
          <span>{item.label}</span>
          <strong>{item.title}</strong>
        </a>
      ))}
    </div>
  </section>

  <section class="homepage-cta-section" aria-labelledby="homepage-cta-title">
    <div class="homepage-cta-copy">
      <h2 id="homepage-cta-title">Review the EndoTech product system.</h2>
      <p>
        Review the product system, then move into the shaping path, downloads, or ordering page that fits the case and clinic workflow.
      </p>
    </div>
    <div class="homepage-cta-actions">
      <a class="homepage-button primary" href={`${base}order/`}>Order Products</a>
      <a class="homepage-button secondary on-dark" href={`${base}about/contact/`}>Contact EndoTech NZ</a>
    </div>
  </section>
</main>

<footer class="homepage-shell-footer">
  <div class="homepage-shell-footer-shell">
    <div class="homepage-shell-footer-brand">
      <span class="homepage-shell-footer-kicker">EndoTech NZ</span>
      <strong>{siteConfig.name}</strong>
      <p>Clinical endodontic systems for New Zealand dentists.</p>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </div>

    <div class="homepage-shell-footer-links">
      {footerSections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <nav aria-label={`${section.title} footer navigation`}>
            {section.links.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>
        </section>
      ))}
    </div>
  </div>

  <div class="homepage-shell-footer-bottom">
    <p>
      Review workflow documents, product files, and local support pathways before ordering.
    </p>
    <nav aria-label="Footer utility navigation">
      {footerUtilityLinks.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</footer>

<script>
  const productsMenu = document.querySelector('.homepage-shell-header .products-menu');
  const productsMenuButton = document.getElementById('homepage-products-menu-button');
  const mobileMenu = document.getElementById('homepage-mobile-menu');
  const mobileMenuButton = document.getElementById('homepage-mobile-menu-button');

  const setProductsMenu = (open) => {
    if (!productsMenu || !productsMenuButton) return;
    productsMenu.classList.toggle('is-open', open);
    productsMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
  };

  const setMobileMenu = (open) => {
    if (!mobileMenu || !mobileMenuButton) return;
    mobileMenu.classList.toggle('is-open', open);
    mobileMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
  };

  productsMenuButton?.addEventListener('click', (event) => {
    event.preventDefault();
    const isOpen = productsMenuButton.getAttribute('aria-expanded') === 'true';
    setProductsMenu(!isOpen);
  });

  productsMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setProductsMenu(false));
  });

  mobileMenuButton?.addEventListener('click', (event) => {
    event.preventDefault();
    event.stopPropagation();
    const isOpen = mobileMenuButton.getAttribute('aria-expanded') === 'true';
    setMobileMenu(!isOpen);
  });

  mobileMenu?.addEventListener('click', (event) => {
    event.stopPropagation();
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMobileMenu(false));
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node) || !productsMenu) return;
    if (!productsMenu.contains(event.target)) setProductsMenu(false);
    if (mobileMenu && mobileMenuButton && !mobileMenu.contains(event.target) && !mobileMenuButton.contains(event.target)) {
      setMobileMenu(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setProductsMenu(false);
      setMobileMenu(false);
    }
  });

  const homepageHeroTitle = document.querySelector('[data-homepage-hero-title]');

  if (homepageHeroTitle) {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        setTimeout(() => {
          homepageHeroTitle.classList.remove('homepage-hero-title--pre-reveal');
        }, 70);
      });
    });
  }

  const clinicalWorkflowMask = document.querySelector('.clinical-workflow-reveal-mask');
  const clinicalWorkflowText = document.querySelector('.js-clinical-workflow-reveal');

  if (clinicalWorkflowMask && clinicalWorkflowText) {
    const originalText = 'EndoTech NZ Clinical Workflow';

    clinicalWorkflowText.setAttribute('aria-label', originalText);
    clinicalWorkflowText.innerHTML = Array.from(originalText)
      .map((char, index) => {
        const safeChar = char === ' ' ? '&nbsp;' : char;
        return `<span class="clinical-workflow-reveal-char" aria-hidden="true" style="--char-index:${index}">${safeChar}</span>`;
      })
      .join('');

    const clinicalWorkflowObserver = new IntersectionObserver(
      (entries, observerInstance) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            window.setTimeout(() => {
              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  clinicalWorkflowMask.classList.add('is-visible');
                });
              });
            }, 180);

            observerInstance.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        threshold: 0.2,
      }
    );

    clinicalWorkflowObserver.observe(clinicalWorkflowMask);
  }

</script>

<style>
  :global(body.landing-page) {
    background: #ffffff;
    color: #181c20;
  }

  .homepage-shell-header {
    position: sticky;
    top: 0;
    z-index: 70;
    border-bottom: 1px solid #e3e8ee;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
  }

  .homepage-shell-header-inner {
    display: grid;
    grid-template-columns: minmax(210px, auto) 1fr auto;
    gap: 28px;
    align-items: center;
    min-height: 72px;
    padding: 0 56px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .homepage-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }

  .homepage-brand img {
    width: 34px;
  }

  .homepage-brand span {
    display: grid;
    gap: 2px;
    line-height: 1;
  }

  .homepage-brand strong,
  .homepage-shell-footer strong {
    color: #0b1424;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .homepage-brand small {
    color: #707881;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .homepage-shell-header nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    color: #404750;
    font-size: 0.82rem;
    font-weight: 500;
  }

  .homepage-shell-header nav a,
  .products-menu button,
  .homepage-header-action,
  .homepage-menu-toggle {
    color: inherit;
    text-decoration: none;
  }

  .products-menu {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .products-menu button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 0;
    padding: 0;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .products-menu svg {
    width: 14px;
    height: 14px;
    transition: transform 180ms ease;
  }

  .products-menu path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .products-menu-bridge {
    position: absolute;
    top: 100%;
    left: 50%;
    width: 280px;
    height: 16px;
    transform: translateX(-50%);
  }

  .products-menu-panel {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    z-index: 80;
    width: 300px;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 8px);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .products-menu-shell {
    display: grid;
    gap: 2px;
    border: 1px solid #e3e8ee;
    border-radius: 12px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 8px 24px rgba(0, 55, 112, 0.08);
    backdrop-filter: blur(16px);
  }

  .products-menu-shell span {
    padding: 6px 8px 8px;
    color: #707881;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .products-menu-shell a {
    border-radius: 8px;
    padding: 10px 8px;
    color: #344357;
    font-size: 0.84rem;
    font-weight: 500;
    transition:
      background 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .products-menu-shell a:hover,
  .products-menu-shell a:focus-visible {
    background: #f3f7fa;
    color: #0b1424;
    transform: translateX(2px);
  }

  .products-menu:hover .products-menu-panel,
  .products-menu:focus-within .products-menu-panel,
  .products-menu.is-open .products-menu-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .products-menu:hover svg,
  .products-menu:focus-within svg,
  .products-menu.is-open svg {
    transform: translateY(1px);
  }

  .homepage-header-actions {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .homepage-header-action,
  .homepage-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    border: 1px solid #c0c7d2;
    border-radius: 8px;
    padding: 0 16px;
    color: #102033;
    font-size: 0.82rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .homepage-header-action:hover,
  .homepage-header-action:focus-visible,
  .homepage-menu-toggle:hover,
  .homepage-menu-toggle:focus-visible {
    background: #f8fbfd;
    border-color: #aeb8c5;
    box-shadow:
      0 10px 24px rgba(15, 23, 42, 0.08),
      0 2px 6px rgba(15, 23, 42, 0.05);
    transform: translateY(-1px);
  }

  .homepage-menu-toggle {
    display: none;
    background: #ffffff;
    cursor: pointer;
  }

  .homepage-mobile-menu {
    display: none;
    border-top: 1px solid #e3e8ee;
    background: rgba(255, 255, 255, 0.98);
  }

  .homepage-mobile-menu-shell {
    display: grid;
    gap: 8px;
    padding: 14px 18px 18px;
  }

  .homepage-mobile-menu-shell a {
    border: 1px solid #e3e8ee;
    border-radius: 10px;
    padding: 12px 14px;
    color: #0b1424;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    background: rgba(248, 250, 252, 0.92);
  }

  .homepage-stitch-page {
    background: #ffffff;
    color: #181c20;
  }

  .homepage-hero,
  .homepage-workflow-strip,
  .homepage-systems-section,
  .homepage-bcs-section,
  .homepage-evidence-section,
  .homepage-cta-section,
  .homepage-shell-footer {
    padding-left: 56px;
    padding-right: 56px;
  }

  .homepage-eyebrow {
    margin: 0 0 14px;
