---
import logoIcon from '../../assets/endotech-logo-2.png';
import WorkflowStrip from '../navigation/WorkflowStrip.astro';
import transformxSystem from '../../assets/transformx-rotary-file-system.png';
import etProduct from '../../assets/et-transformx.png';
import ptProduct from '../../assets/pt-transformx.png';
import acrobatProduct from '../../assets/acrobat-glide-path-files.png';
import vortiflowFlow from '../../assets/vortiflow/vortiflow-fluid-dynamics-clean.png';
import { siteConfig } from '../../config/site';
import { getHomepageMobileNavItems, getPrimaryNavItems, getProductMenu } from '../../data/navigation';
import { getWorkflowStripItems } from '../../data/workflowStrip';

const base = import.meta.env.BASE_URL;
const avatarTipVideo = `${base}videos/avatar-tip/avatar-tip-rounded.mp4`;

const navItems = getPrimaryNavItems(base);
const productMenu = getProductMenu(base);
const mobileNavItems = getHomepageMobileNavItems(base);
const workflow = getWorkflowStripItems(base);

const heroHighlights = [
  'Engineered endodontic systems for New Zealand clinicians.',
  'Designed around control, safety, and adaptable shaping behaviour.',
  'Supported by evidence, downloads, and direct local enquiry pathways.',
];

const systemOverview = [
  {
    label: 'TransformX ET',
    role: 'Shape',
    summary: 'ET-style shaping for clinicians preserving .04/.06 sequence logic with better apical guidance.',
    href: `${base}products/et-transformx/`,
  },
  {
    label: 'TransformX PT',
    role: 'Shape',
    summary: 'PT-style progression for practices wanting familiar crown-down rhythm with greater control.',
    href: `${base}products/pt-transformx/`,
  },
  {
    label: 'Acrobat',
    role: 'Glide',
    summary: 'Rotary glide path files that establish a reproducible route before shaping becomes demanding.',
    href: `${base}products/acrobat-glide-path/`,
  },
  {
    label: 'BCS / iRoot',
    role: 'Seal',
    summary: 'Premixed bioceramic materials for final sealing and repair across a matched obturation pathway.',
    href: `${base}products/bcs/`,
  },
  {
    label: 'VortiFlow',
    role: 'Clean 3D',
    summary: 'Irrigation support engineered around controlled fluid behaviour after preparation is complete.',
    href: `${base}products/vortiflow-irrigation-needle/`,
  },
];

const featuredProducts = [
  {
    eyebrow: 'Shaping System',
    title: 'ET TransformX Files',
    description:
      'For clinicians already shaping with ET, EdgeX7, or other .04/.06-style systems who want safer progression toward working length.',
    bullets: ['Avatar Tip guidance', 'Transform Technology metallurgy', 'Familiar ET-style sequence logic'],
    image: etProduct.src,
    href: `${base}products/et-transformx/`,
    cta: 'Review ET TransformX',
  },
  {
    eyebrow: 'Shaping System',
    title: 'PT TransformX Files',
    description:
      'For ProTaper-style workflows that need a more controlled shaping response without abandoning familiar progression.',
    bullets: ['Progressive PT-style rhythm', 'Apical adaptability', 'Lower switching curve for existing users'],
    image: ptProduct.src,
    href: `${base}products/pt-transformx/`,
    cta: 'Review PT TransformX',
  },
  {
    eyebrow: 'Glide Path',
    title: 'Acrobat Glide Path Files',
    description:
      'Rotary glide path files positioned before shaping to create a controlled, reproducible path through demanding anatomy.',
    bullets: ['Transform Metal Technology', 'Working-length progression', 'Useful before full shaping sequence'],
    image: acrobatProduct.src,
    href: `${base}products/acrobat-glide-path/`,
    cta: 'Review Acrobat',
  },
  {
    eyebrow: 'Irrigation & Seal',
    title: 'VortiFlow and BCS BioCeramics',
    description:
      'A clean-to-seal pairing that connects irrigant exchange and premixed bioceramic sealing to the final restorative endpoint.',
    bullets: ['3D irrigation support', 'Premixed sealer workflow', 'Matched system thinking after shaping'],
    image: vortiflowFlow.src,
    href: `${base}products/bcs/evidence/`,
    cta: 'Review evidence and downloads',
  },
];

const evidenceLinks = [
  {
    label: 'Downloads',
    detail: 'Technique sheets, workflow PDFs, and technical support files for evaluation and ordering.',
    href: `${base}resources/downloads/`,
  },
  {
    label: 'Clinical workflow',
    detail: 'Assess to restore, structured as a practical sequence rather than isolated product claims.',
    href: `${base}technique/workflow/`,
  },
  {
    label: 'Clinical education',
    detail: 'Education material that links anatomy, shaping behaviour, irrigation, and final sealing decisions.',
    href: `${base}resources/clinical-tips/`,
  },
  {
    label: 'Technology rationale',
    detail: 'Transform Technology and Avatar Tip are framed by what they help clinicians control clinically.',
    href: `${base}technology/transform-technology/`,
  },
];

const supportPanels = [
  {
    title: 'NZ availability',
    text: 'Request current New Zealand availability, pack configuration, and product guidance directly from EndoTech NZ.',
  },
  {
    title: 'Clinical support',
    text: 'Use the workflow, technology, and education pages to review how each product fits the treatment sequence.',
  },
  {
    title: 'Clinic purchasing',
    text: 'The site is structured to support both product evaluation and practical next-step ordering conversations.',
  },
];
---

<header class="v3-header">
  <a class="brand" href={base} aria-label={`${siteConfig.name} home`}>
    <img src={logoIcon.src} alt="" />
    <span>
      <strong>{siteConfig.name}</strong>
      <small>Engineered endodontics</small>
    </span>
  </a>

  <nav aria-label="Primary navigation">
    {navItems.map((item) => (
      item.label === 'Products' ? (
        <div class="products-menu">
          <button
            id="homepage-products-menu-button"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="homepage-products-menu-panel"
          >
            Products
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>
          <div class="products-menu-bridge"></div>
          <div id="homepage-products-menu-panel" class="products-menu-panel">
            <div class="products-menu-shell">
              <span>Product lineup</span>
              {productMenu.map((product) => (
                <a href={product.href}>{product.label}</a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a href={item.href}>{item.label}</a>
      )
    ))}
  </nav>

  <div class="header-actions">
    <a class="header-action" href={`${base}about/contact/`}>Contact</a>
    <button class="header-menu-toggle" id="homepage-mobile-menu-button" type="button" aria-expanded="false" aria-controls="homepage-mobile-menu">
      Menu
    </button>
  </div>

  <div id="homepage-mobile-menu" class="homepage-mobile-menu">
    <div class="homepage-mobile-menu-shell">
      {mobileNavItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </div>
  </div>
</header>

<main class="homepage-v3">
  <section class="hero" aria-labelledby="hero-title">
    <div class="section-shell">
      <div class="hero-copy">
        <p class="eyebrow">EndoTech NZ</p>
        <h1 id="hero-title">Engineered endodontics for New Zealand clinicians.</h1>
        <p class="hero-lead">
          Evidence-led shaping, irrigation, and sealing systems presented as one clinical pathway for safer preparation, cleaner canals, and more predictable obturation.
        </p>

        <ul class="hero-highlights" aria-label="Homepage highlights">
          {heroHighlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <div class="hero-actions">
          <a class="button primary" href={`${base}products/overview/`}>View product overview</a>
          <a class="button secondary" href="#workflow">Review workflow</a>
          <a class="button secondary" href={`${base}about/contact/`}>Contact EndoTech NZ</a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-device">
          <div class="hero-device-header">
            <span>Clinical system overview</span>
            <small>Assess to restore</small>
          </div>
          <figure class="hero-system-figure">
            <img src={transformxSystem.src} alt="TransformX rotary file system" />
            <figcaption>
              <strong>TransformX system</strong>
              <span>Shaping technology positioned inside a complete endodontic workflow.</span>
            </figcaption>
          </figure>
        </div>

        <div class="hero-sidecards" aria-hidden="true">
          <article>
            <span>Clinical focus</span>
            <strong>Control near working length</strong>
            <p>Avatar Tip and Transform Technology support canal-centred progression where tolerance for error is lowest.</p>
          </article>
          <article>
            <span>Commercial focus</span>
            <strong>NZ-ready product pathway</strong>
            <p>Product pages, downloads, and enquiry routes are structured for clinics evaluating supply and fit.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="system-overview" aria-labelledby="system-overview-title">
    <div class="section-shell">
      <div class="section-heading compact">
        <p class="eyebrow">Product System Overview</p>
        <h2 id="system-overview-title">A coordinated system from glide path to final seal.</h2>
        <p>
          EndoTech NZ is presented as a workflow architecture first. Each product family is positioned by the clinical problem it helps control, not as a disconnected catalogue item.
        </p>
      </div>

      <div class="system-grid" role="list">
        {systemOverview.map((item) => (
          <a class="system-card" href={item.href} role="listitem">
            <div class="system-card-top">
              <span>{item.role}</span>
              <strong>{item.label}</strong>
            </div>
            <p>{item.summary}</p>
            <em>Open page</em>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="workflow" class="workflow-section" aria-labelledby="workflow-title">
    <div class="section-shell">
      <div class="section-heading">
        <p class="eyebrow">Clinical Workflow</p>
        <h2 id="workflow-title">Assess to restore, structured as one clinical pathway.</h2>
        <p>
          The sequence is designed to help clinicians review instrumentation, irrigation, and sealing decisions in order. The homepage introduces the logic first, then points into detailed product, evidence, and education pages.
        </p>
      </div>

      <WorkflowStrip />

      <ol class="workflow-rail" aria-label="Clinical workflow summary">
        {workflow.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{item.step}</strong>
            <p>{item.note}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="featured-products" id="products" aria-labelledby="featured-products-title">
    <div class="section-shell">
      <div class="section-heading">
        <p class="eyebrow">Featured Product Cards</p>
        <h2 id="featured-products-title">Featured systems for shaping, irrigation, and sealing.</h2>
        <p>
          Each card connects product features back to the clinical problem being solved: path creation, canal-centred shaping, disciplined irrigant exchange, and consistent final sealing.
        </p>
      </div>

      <div class="featured-grid">
        {featuredProducts.map((product) => (
          <article class="featured-card">
            <figure>
              <img src={product.image} alt="" />
            </figure>
            <div class="featured-card-copy">
              <p class="card-eyebrow">{product.eyebrow}</p>
              <h3>{product.title}</h3>
              <p>{product.description}</p>
              <ul>
                {product.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
              <a href={product.href}>{product.cta}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="evidence-section" aria-labelledby="evidence-title">
    <div class="section-shell evidence-shell">
      <div class="evidence-copy">
        <p class="eyebrow">Evidence & Downloads</p>
        <h2 id="evidence-title">Evidence-led pages support product evaluation before ordering.</h2>
        <p>
          Downloads, workflow sheets, and technology pages are available for practices that want to review rationale, technique, and support documents before selecting a system.
        </p>

        <div class="evidence-panel">
          <video
            data-avatar-tip-video
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            aria-label="Avatar Tip rounded leading geometry video"
          >
            <source src={avatarTipVideo} type="video/mp4" />
            Your browser does not support the video tag.
          </video>
          <div>
            <strong>Technology shown through clinical relevance</strong>
            <p>Transform Technology and Avatar Tip are positioned by their effect on shaping behaviour, not by generic feature claims.</p>
          </div>
        </div>
      </div>

      <div class="evidence-links" role="list">
        {evidenceLinks.map((item) => (
          <a href={item.href} role="listitem">
            <strong>{item.label}</strong>
            <p>{item.detail}</p>
            <span>Open</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="support-section" aria-labelledby="support-title">
    <div class="section-shell support-shell">
      <div class="section-heading compact">
        <p class="eyebrow">NZ Availability & Local Support</p>
        <h2 id="support-title">Clear pathways for New Zealand dentists, clinics, and distributors.</h2>
        <p>
          EndoTech NZ should feel both clinical and commercially ready: a site that supports product review, technical questions, and practical next-step enquiries without friction.
        </p>
      </div>

      <div class="support-grid">
        {supportPanels.map((panel) => (
          <article>
            <h3>{panel.title}</h3>
            <p>{panel.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section" aria-labelledby="cta-title">
    <div class="section-shell cta-shell">
      <div>
        <p class="eyebrow">Next Step</p>
        <h2 id="cta-title">Review the workflow, compare the systems, then request the right next step for your practice.</h2>
        <p>
          Start with the product overview, move into the workflow and downloads, or contact EndoTech NZ directly for pricing, availability, and clinical questions.
        </p>
      </div>

      <div class="cta-actions">
        <a class="button primary" href={`${base}products/overview/`}>View product system</a>
        <a class="button secondary" href={`${base}order/`}>Review order options</a>
        <a class="button tertiary" href={`${base}about/contact/`}>Contact EndoTech NZ</a>
      </div>
    </div>
  </section>
</main>

<footer class="v3-footer">
  <div>
    <strong>{siteConfig.name}</strong>
    <span>{siteConfig.organizationDescription}</span>
  </div>
  <nav aria-label="Homepage footer links">
    <a href={`${base}products/overview/`}>Products</a>
    <a href={`${base}technique/workflow/`}>Clinical Workflow</a>
    <a href={`${base}resources/downloads/`}>Downloads</a>
    <a href={`${base}about/contact/`}>Contact</a>
  </nav>
  <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
</footer>

<script>
  const productsMenu = document.querySelector('.v3-header .products-menu');
  const productsMenuButton = document.getElementById('homepage-products-menu-button');
  const mobileMenu = document.getElementById('homepage-mobile-menu');
  const mobileMenuButton = document.getElementById('homepage-mobile-menu-button');

  const setProductsMenu = (open) => {
    if (!productsMenu || !productsMenuButton) return;
    productsMenu.classList.toggle('is-open', open);
    productsMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
  };

  const setMobileMenu = (open) => {
    if (!mobileMenu || !mobileMenuButton) return;
    mobileMenu.classList.toggle('is-open', open);
    mobileMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
  };

  productsMenuButton?.addEventListener('click', (event) => {
    event.preventDefault();
    const isOpen = productsMenuButton.getAttribute('aria-expanded') === 'true';
    setProductsMenu(!isOpen);
  });

  productsMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setProductsMenu(false));
  });

  mobileMenuButton?.addEventListener('click', (event) => {
    event.preventDefault();
    event.stopPropagation();
    const isOpen = mobileMenuButton.getAttribute('aria-expanded') === 'true';
    setMobileMenu(!isOpen);
  });

  mobileMenu?.addEventListener('click', (event) => {
    event.stopPropagation();
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMobileMenu(false));
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node) || !productsMenu) return;
    if (!productsMenu.contains(event.target)) setProductsMenu(false);
    if (mobileMenu && mobileMenuButton && !mobileMenu.contains(event.target) && !mobileMenuButton.contains(event.target)) {
      setMobileMenu(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setProductsMenu(false);
      setMobileMenu(false);
    }
  });

  document.querySelectorAll('[data-avatar-tip-video]').forEach((element) => {
    if (!(element instanceof HTMLVideoElement)) return;

    const setSlowLoop = () => {
      element.defaultPlaybackRate = 0.5;
      element.playbackRate = 0.5;
    };

    setSlowLoop();
    element.addEventListener('loadedmetadata', setSlowLoop);
    element.addEventListener(
      'canplay',
      () => {
        element.play().catch(() => {});
      },
      { once: true }
    );
  });
</script>

<style>
  :global(html) {
    scroll-padding-top: 96px;
  }

  :global(body.landing-page) {
    background: #ffffff;
    color: #102033;
  }

  .homepage-v3 {
    --canvas: #ffffff;
    --canvas-soft: #f6f9fc;
    --canvas-clinical: #f3f6f8;
    --surface: #ffffff;
    --surface-soft: #f8fafc;
    --surface-blue: #eef6fb;
    --surface-steel: #e8edf2;
    --ink: #102033;
    --ink-secondary: #273951;
    --ink-muted: #64748d;
    --ink-subtle: #8a94a3;
    --primary: #0b75b7;
    --primary-hover: #09639b;
    --primary-deep: #064b78;
    --primary-soft: #dceff8;
    --accent-green: #4bae73;
    --hairline: #e3e8ee;
    --hairline-strong: #cad5e0;
    --gradient-clinical-hero: linear-gradient(135deg, #ffffff 0%, #f6f9fc 45%, #eef6fb 100%);
    --gradient-technical-blue: radial-gradient(circle at 30% 20%, rgba(11, 117, 183, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f3f7fb 100%);
    font-family: Inter, 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    background: var(--canvas);
    color: var(--ink);
  }

  .v3-header,
  .v3-footer {
    padding-left: 56px;
    padding-right: 56px;
  }

  .section-shell {
    max-width: 1240px;
    margin: 0 auto;
    padding-left: 56px;
    padding-right: 56px;
  }

  .v3-header {
    position: sticky;
    top: 0;
    z-index: 60;
    display: grid;
    grid-template-columns: minmax(210px, auto) 1fr auto;
    gap: 28px;
    align-items: center;
    min-height: 82px;
    border-bottom: 1px solid var(--hairline);
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }

  .brand img {
    width: 42px;
  }

  .brand span {
    display: grid;
    gap: 3px;
    line-height: 1;
  }

  .brand strong,
  .v3-footer strong {
    color: var(--ink);
    font-family: Inter, 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand small {
    color: var(--ink-muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .v3-header nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 1.8vw, 1.75rem);
    color: var(--ink-secondary);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .v3-header nav a,
  .products-menu button,
  .v3-footer a {
    color: inherit;
    text-decoration: none;
  }

  .v3-header nav a,
  .products-menu button {
    position: relative;
  }

  .v3-header nav a::after,
  .products-menu button::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.45rem;
    height: 1px;
    background: var(--hairline-strong);
    opacity: 0;
    transform: scaleX(0.6);
    transition: opacity 180ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .v3-header nav a:hover::after,
  .v3-header nav a:focus-visible::after,
  .products-menu button:hover::after,
  .products-menu button:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .products-menu {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .products-menu button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .products-menu svg {
    width: 14px;
    height: 14px;
    transition: transform 180ms ease;
  }

  .products-menu path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .products-menu-bridge {
    position: absolute;
    top: 100%;
    left: 50%;
    width: 280px;
    height: 16px;
    transform: translateX(-50%);
  }

  .products-menu-panel {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    z-index: 80;
    width: 300px;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 8px);
    transition: opacity 180ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .products-menu-shell {
    display: grid;
    gap: 2px;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 24px 55px -34px rgba(15, 23, 42, 0.22);
    backdrop-filter: blur(16px);
  }

  .products-menu-shell span {
    padding: 6px 8px 8px;
    color: #876a2b;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .products-menu-shell a {
    border-radius: 6px;
    padding: 10px 8px;
    color: var(--ink-secondary);
    font-size: 0.86rem;
    font-weight: 600;
    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .products-menu-shell a:hover,
  .products-menu-shell a:focus-visible {
    background: var(--surface-soft);
    color: var(--ink);
    transform: translateX(2px);
  }

  .products-menu:hover .products-menu-panel,
  .products-menu:focus-within .products-menu-panel,
  .products-menu.is-open .products-menu-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .products-menu:hover svg,
  .products-menu:focus-within svg,
  .products-menu.is-open svg {
    transform: translateY(1px) rotate(180deg);
  }

  .header-actions {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .header-action,
  .header-menu-toggle,
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .header-action {
