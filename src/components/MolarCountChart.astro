---
interface Props { titleId: string; }
const { titleId } = Astro.props;
const rows = [
  { label: 'First', sample: 823, three: '79.9', four: '15.4' },
  { label: 'Second', sample: 925, three: '72.8', four: '2.3' },
];
---

<section class="molar-count-chart" data-count-chart data-active-count="all" aria-labelledby={titleId}>
  <header>
    <p class="chart-kicker">Canals seen on CBCT</p>
    <h4 id={titleId}>First and second molars</h4>
  </header>
  <table>
    <caption class="visually-hidden">Frequency of three and four canals in the study sample</caption>
    <thead><tr><th scope="col">Lower molar</th><th scope="col" data-count="3"><i aria-hidden="true"></i>3 canals</th><th scope="col" data-count="4"><i aria-hidden="true"></i>4 canals</th></tr></thead>
    <tbody>{rows.map(row => <tr>
      <th scope="row">{row.label}<small>{row.sample} molars</small></th>
      {[['3', row.three], ['4', row.four]].map(([count, value]) => <td data-count={count}>
        <span class="chart-value">{value}<span>%</span></span>
        <span class="chart-track" aria-hidden="true"><span style={`width:${value}%`}></span></span>
      </td>)}
    </tr>)}</tbody>
  </table>
  <p class="chart-summary">In this sample, four canals were more frequent in first molars.</p>
  <footer><p>Turkish sample. Other counts occurred.</p><a href="#ref-demirbuga">Demirbuga et al., 2013 <span>[12]</span></a></footer>
</section>

<style>
  .molar-count-chart{--three:#257f83;--four:#304b67;box-sizing:border-box;padding:24px;border:1px solid #d9e7e7;border-radius:18px;background:#fff;color:#153845;font-family:'Nunito Sans',Arial,sans-serif;text-align:left}
  .molar-count-chart header{padding-right:18px;margin-bottom:18px}
  .molar-count-chart .chart-kicker{margin:0 0 6px;font-size:10px;line-height:1.4;letter-spacing:.14em;font-weight:800;text-transform:uppercase;color:#458186}
  .molar-count-chart h4{margin:0;font-family:Sora,Arial,sans-serif;font-size:20px;font-weight:600;line-height:1.3;letter-spacing:-.035em;color:#153845}
  .molar-count-chart table{width:100%;table-layout:fixed;border-collapse:collapse;line-height:1.4;text-align:left}
  .molar-count-chart thead th{padding:0 12px 12px;border-bottom:1px solid #cfdddd;font-size:11px;font-weight:800;color:#526a73}
  .molar-count-chart thead th:first-child{width:28%;padding-left:0}
  .molar-count-chart thead i{display:inline-block;width:6px;height:6px;margin:0 5px 1px 0;border-radius:50%;background:var(--column-color);vertical-align:middle}
  .molar-count-chart [data-count="3"]{--column-color:var(--three)}.molar-count-chart [data-count="4"]{--column-color:var(--four)}
  .molar-count-chart tbody th{padding:18px 10px 18px 0;border-bottom:1px solid #e4eded;font-size:15px;font-weight:800;vertical-align:middle}
  .molar-count-chart tbody th small{display:block;margin-top:4px;color:#7a8e94;font-size:10px;font-weight:500;white-space:nowrap}
  .molar-count-chart td{padding:16px 12px;border-bottom:1px solid #e4eded;vertical-align:middle}
  .chart-value{display:block;color:var(--column-color);font-family:Sora,Arial,sans-serif;font-size:28px;line-height:1.25;letter-spacing:-.045em;font-weight:500;font-variant-numeric:tabular-nums;white-space:nowrap}
  .chart-value>span{margin-left:2px;font-size:13px;letter-spacing:0}
  .chart-track{display:block;height:4px;width:100%;margin-top:9px;border-radius:4px;background:#eaf0f1;overflow:hidden}
  .chart-track>span{display:block;height:100%;min-width:1px;border-radius:4px;background:var(--column-color)}
  .molar-count-chart[data-active-count="3"] [data-count="3"],.molar-count-chart[data-active-count="4"] [data-count="4"]{background:#eef7f5}
  .molar-count-chart[data-active-count="3"] thead [data-count="3"],.molar-count-chart[data-active-count="4"] thead [data-count="4"]{color:#153845;box-shadow:inset 0 -2px var(--column-color)}
  .molar-count-chart .chart-summary{margin:16px 0 0;color:#47626c;font-size:12px;line-height:1.55}
  .molar-count-chart footer{display:flex;justify-content:space-between;align-items:flex-start;gap:8px 18px;flex-wrap:wrap;margin-top:15px}
  .molar-count-chart footer p,.molar-count-chart footer a{margin:0;color:#71868e;font-size:10px;line-height:1.5}
  .molar-count-chart footer a{color:#36747e;text-decoration:underline;text-underline-offset:3px}
  .molar-count-chart footer a:focus-visible{outline:3px solid #0b75b7;outline-offset:4px}
  .visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
  @media(max-width:400px){.molar-count-chart{padding:20px 16px}.molar-count-chart h4{font-size:18px}.molar-count-chart td{padding-inline:8px}.molar-count-chart thead th{padding-inline:8px;font-size:10px}.chart-value{font-size:24px}.chart-value>span{font-size:11px}.molar-count-chart tbody th{font-size:14px}.molar-count-chart footer{gap:6px}}
</style>
