---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import logoIcon from '../../assets/endotech-logo-2.png';
import { getOrderMenu, getPrimaryNavItems, getProductMenu, getProductMobileNavItems, getTechnologyMenu } from '../../data/navigation';

const base = import.meta.env.BASE_URL;
const navItems = getPrimaryNavItems(base);
const productMenu = getProductMenu(base);
const technologyMenu = getTechnologyMenu(base);
const orderMenu = getOrderMenu(base);
const mobileNavItems = getProductMobileNavItems(base);

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="endotech-docs-header">
  <div class="header">
    <div class="docs-product-header-inner">
      <a href={base} class="docs-brand" aria-label="EndoTechNZ home">
        <img src={logoIcon.src} alt="EndoTechNZ" class="docs-brand-icon" />
        <span class="docs-brand-copy">
          <span class="docs-brand-name">EndoTech NZ</span>
          <span class="docs-brand-region">Engineered Endodontics</span>
        </span>
      </a>

      <nav class="docs-product-nav" aria-label="Primary navigation">
        <a href={navItems[0].href}>{navItems[0].label}</a>
        <div class="products-menu">
          <button id="docs-products-menu-button" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="docs-products-menu-panel">
            Products
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>
          <div class="products-menu-bridge"></div>
          <div id="docs-products-menu-panel" class="products-menu-panel">
            <div class="products-menu-shell">
              <span>Product lineup</span>
              {productMenu.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </div>
          </div>
        </div>
        <a href={navItems[2].href}>{navItems[2].label}</a>
        <div class="products-menu technology-menu">
          <button id="docs-technology-menu-button" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="docs-technology-menu-panel">
            Technology
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>
          <div class="products-menu-bridge"></div>
          <div id="docs-technology-menu-panel" class="products-menu-panel">
            <div class="products-menu-shell">
              <span>Technology Platform</span>
              {technologyMenu.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </div>
          </div>
        </div>
        {navItems.slice(5).filter((item) => item.label !== 'Order').map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <div class="docs-header-actions">
        <div class="products-menu docs-order-menu">
          <button id="docs-order-menu-button" class="docs-header-action" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="docs-order-menu-panel">
            Order
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>
          <div class="products-menu-bridge"></div>
          <div id="docs-order-menu-panel" class="products-menu-panel docs-order-menu-panel">
            <div class="products-menu-shell">
              <span>Order options</span>
              {orderMenu.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </div>
          </div>
        </div>
        <a class="docs-header-action" href={`${base}about/contact/`}>Contact</a>
        <button class="docs-menu-toggle" id="docs-mobile-menu-button" type="button" aria-expanded="false" aria-controls="docs-mobile-menu">
          Menu
        </button>
        <div class="docs-utility-tools print:hidden" aria-hidden="true">
          {shouldRenderSearch && <Search />}
          <div class="sl-hidden md:sl-flex social-icons">
            <SocialIcons />
          </div>
          <div class="sl-hidden md:sl-flex">
            <ThemeSelect />
            <LanguageSelect />
          </div>
        </div>
      </div>
    </div>

    <div id="docs-mobile-menu" class="docs-mobile-menu">
      <div class="docs-mobile-menu-shell">
        {mobileNavItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const productsMenu = document.querySelector('.endotech-docs-header .products-menu');
    const productsMenuButton = document.getElementById('docs-products-menu-button');
    const technologyMenu = document.querySelector('.endotech-docs-header .technology-menu');
    const technologyMenuButton = document.getElementById('docs-technology-menu-button');
    const orderMenu = document.querySelector('.endotech-docs-header .docs-order-menu');
    const orderMenuButton = document.getElementById('docs-order-menu-button');
    const mobileMenu = document.getElementById('docs-mobile-menu');
    const mobileMenuButton = document.getElementById('docs-mobile-menu-button');
    const docsHeader = document.querySelector('.endotech-docs-header');

    function syncMobileMenuBounds() {
      if (!mobileMenu || !docsHeader) return;
      const headerBottom = Math.max(0, Math.ceil(docsHeader.getBoundingClientRect().bottom));
      const viewportHeight = Math.floor(window.visualViewport?.height || window.innerHeight);
      const openMenuRect = mobileMenu.classList.contains('is-open') ? mobileMenu.getBoundingClientRect() : null;
      const panelTop = Math.max(0, Math.ceil(openMenuRect?.top || headerBottom));
      const panelHeight = Math.max(160, viewportHeight - panelTop - 1);
      document.documentElement.style.setProperty('--docs-mobile-menu-top', `${headerBottom}px`);
      document.documentElement.style.setProperty('--docs-mobile-viewport-height', `${viewportHeight}px`);
      document.documentElement.style.setProperty('--docs-mobile-menu-height', `${panelHeight}px`);
    }

    function syncOpenMobileMenuBounds() {
      if (mobileMenuButton?.getAttribute('aria-expanded') === 'true') {
        syncMobileMenuBounds();
      }
    }

    function setProductsMenu(open) {
      if (!productsMenu || !productsMenuButton) return;
      productsMenu.classList.toggle('is-open', open);
      productsMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function setTechnologyMenu(open) {
      if (!technologyMenu || !technologyMenuButton) return;
      technologyMenu.classList.toggle('is-open', open);
      technologyMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function setOrderMenu(open) {
      if (!orderMenu || !orderMenuButton) return;
      orderMenu.classList.toggle('is-open', open);
      orderMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function setMobileMenu(open) {
      if (!mobileMenu || !mobileMenuButton) return;
      if (open) {
        syncMobileMenuBounds();
        mobileMenu.scrollTop = 0;
      }
      mobileMenu.classList.toggle('is-open', open);
      mobileMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.documentElement.classList.toggle('docs-mobile-menu-open', open);
      document.body.classList.toggle('docs-mobile-menu-open', open);
      if (open) {
        window.requestAnimationFrame(syncMobileMenuBounds);
      }
    }

    productsMenuButton?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      const isOpen = productsMenuButton.getAttribute('aria-expanded') === 'true';
      setProductsMenu(!isOpen);
      setTechnologyMenu(false);
      setOrderMenu(false);
    });

    technologyMenuButton?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      const isOpen = technologyMenuButton.getAttribute('aria-expanded') === 'true';
      setTechnologyMenu(!isOpen);
      setProductsMenu(false);
      setOrderMenu(false);
    });

    orderMenuButton?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      const isOpen = orderMenuButton.getAttribute('aria-expanded') === 'true';
      setOrderMenu(!isOpen);
      setProductsMenu(false);
      setTechnologyMenu(false);
    });

    mobileMenuButton?.addEventListener('click', () => {
      const isOpen = mobileMenuButton.getAttribute('aria-expanded') === 'true';
      setMobileMenu(!isOpen);
    });

    productsMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setProductsMenu(false));
    });

    technologyMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setTechnologyMenu(false));
    });

    orderMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOrderMenu(false));
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMobileMenu(false));
    });

    document.addEventListener('click', (event) => {
      if (!productsMenu) return;
      if (!productsMenu.contains(event.target)) {
        setProductsMenu(false);
      }
      if (technologyMenu && !technologyMenu.contains(event.target)) {
        setTechnologyMenu(false);
      }
      if (orderMenu && !orderMenu.contains(event.target)) {
        setOrderMenu(false);
      }
      if (mobileMenu && mobileMenuButton && !mobileMenu.contains(event.target) && !mobileMenuButton.contains(event.target)) {
        setMobileMenu(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setProductsMenu(false);
        setTechnologyMenu(false);
        setOrderMenu(false);
        setMobileMenu(false);
      }
    });

    window.addEventListener('resize', () => {
      syncOpenMobileMenuBounds();
      if (window.innerWidth > 1120) {
        setMobileMenu(false);
      }
    });
    window.visualViewport?.addEventListener('resize', syncOpenMobileMenuBounds);
    window.visualViewport?.addEventListener('scroll', syncOpenMobileMenuBounds);
  });
</script>

<style>
  :global(html.docs-mobile-menu-open),
  :global(body.docs-mobile-menu-open) {
    overscroll-behavior: contain;
  }

  @layer starlight.core {
    .endotech-docs-header {
      position: relative;
      width: 100%;
    }

    .docs-brand {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: inherit;
      min-width: 0;
      max-width: 100%;
    }

    .docs-brand-icon {
      width: 2.125rem;
      height: auto;
      flex: 0 0 auto;
    }

    .docs-brand-copy {
      display: flex;
      flex-direction: column;
      line-height: 1;
      min-width: 0;
      flex: 1 1 auto;
    }

    .docs-brand-name {
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: #0b1424;
      white-space: nowrap;
    }

    .docs-brand-region {
      margin-top: 0.2rem;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #707881;
      white-space: nowrap;
    }

    .docs-product-header-inner {
      display: grid;
      grid-template-columns: minmax(210px, auto) 1fr auto;
      gap: 28px;
      align-items: center;
      min-height: 72px;
      padding: 0 56px;
      max-width: 1280px;
      margin: 0 auto;
    }

    .docs-product-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 24px;
      color: #404750;
      font-size: 0.82rem;
      font-weight: 500;
    }

    .docs-product-nav a,
    .products-menu button,
    .docs-header-action,
    .docs-menu-toggle {
      color: inherit;
      text-decoration: none;
    }

    .products-menu {
      position: relative;
      display: inline-flex;
      align-items: center;
    }

    .products-menu button {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 0;
      padding: 0;
      background: transparent;
      font: inherit;
      cursor: pointer;
    }

    .products-menu svg {
      width: 14px;
      height: 14px;
      transition: transform 180ms ease;
    }

    .products-menu path {
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.8;
    }

    .products-menu-bridge {
      position: absolute;
      top: 100%;
      left: 50%;
      width: 280px;
      height: 22px;
      transform: translateX(-50%);
    }

    .products-menu-panel {
      position: absolute;
      top: 100%;
      left: 50%;
      z-index: 90;
      width: 300px;
      padding-top: 10px;
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, 4px);
      transition:
        opacity 180ms ease,
        transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .products-menu-shell {
      display: grid;
      gap: 2px;
      border: 1px solid #e3e8ee;
      border-radius: 12px;
      padding: 12px;
      background: rgba(255, 255, 255, 0.98);
      box-shadow: 0 8px 24px rgba(0, 55, 112, 0.08);
      backdrop-filter: blur(16px);
    }

    .products-menu-shell span {
      padding: 6px 8px 8px;
      color: #707881;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .products-menu-shell a {
      border-radius: 8px;
      padding: 10px 8px;
      font-size: 0.85rem;
      font-weight: 500;
      color: #344357;
      text-decoration: none;
      transition:
        background 160ms ease,
        color 160ms ease,
        transform 160ms ease;
    }

    .products-menu-shell a:hover,
    .products-menu-shell a:focus-visible {
      background: #f3f7fa;
      color: #0b1424;
      transform: translateX(2px);
    }

    .products-menu:hover .products-menu-panel,
    .products-menu:focus-within .products-menu-panel,
    .products-menu.is-open .products-menu-panel {
      opacity: 1;
      pointer-events: auto;
      transform: translate(-50%, 0);
    }

    .products-menu:hover svg,
    .products-menu:focus-within svg,
    .products-menu.is-open svg {
      transform: translateY(1px);
    }

    .docs-header-actions {
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .docs-header-action,
    .docs-menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 38px;
      border: 1px solid #c0c7d2;
      border-radius: 8px;
      padding: 0 16px;
      color: #102033;
      font-size: 0.82rem;
      font-weight: 600;
      background: rgba(255, 255, 255, 0.92);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      transition:
        background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
        border-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .docs-order-menu button.docs-header-action {
      gap: 6px;
      border: 1px solid #c0c7d2;
      padding: 0 14px 0 16px;
      background: rgba(255, 255, 255, 0.92);
    }

    .docs-order-menu-panel {
      width: 230px;
    }

    .docs-header-action:hover,
    .docs-header-action:focus-visible,
    .docs-menu-toggle:hover,
    .docs-menu-toggle:focus-visible {
      background: #f8fbfd;
      border-color: #aeb8c5;
      box-shadow:
        0 10px 24px rgba(15, 23, 42, 0.08),
        0 2px 6px rgba(15, 23, 42, 0.05);
      transform: translateY(-1px);
    }

    .docs-menu-toggle {
      display: none;
      background: #ffffff;
      cursor: pointer;
    }

    .docs-utility-tools {
      display: none;
    }

    .docs-mobile-menu {
      display: none;
      position: fixed;
      top: var(--docs-mobile-menu-top, 72px);
      left: 0;
      right: 0;
      z-index: 80;
      border-top: 1px solid #e3e8ee;
      background: rgba(255, 255, 255, 0.98);
      height: calc(100svh - 72px);
      height: calc(var(--docs-mobile-viewport-height, 100svh) - var(--docs-mobile-menu-top, 72px));
      height: var(--docs-mobile-menu-height, calc(var(--docs-mobile-viewport-height, 100svh) - var(--docs-mobile-menu-top, 72px)));
      max-height: none;
      overflow-y: auto;
      overscroll-behavior: contain;
      touch-action: pan-y;
      -webkit-overflow-scrolling: touch;
      box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
    }

    .docs-mobile-menu-shell {
      display: grid;
      gap: 8px;
      max-width: 1280px;
      margin: 0 auto;
      padding: 14px 18px calc(18px + env(safe-area-inset-bottom, 0px));
    }

    .docs-mobile-menu-shell a {
      border: 1px solid #e3e8ee;
      border-radius: 10px;
      padding: 12px 14px;
      color: #0b1424;
      font-size: 0.88rem;
      font-weight: 600;
      text-decoration: none;
      background: rgba(248, 250, 252, 0.92);
    }

    .header {
      display: block;
      height: auto;
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }

    .social-icons::after {
      content: '';
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }

    @media (max-width: 1120px) {
      .docs-product-header-inner {
        grid-template-columns: auto auto;
        padding-left: 30px;
        padding-right: 30px;
      }

      .docs-product-nav {
        display: none;
      }

      .docs-menu-toggle {
        display: inline-flex;
      }

      .docs-mobile-menu.is-open {
        display: block;
      }
    }

    @media (max-width: 720px) {
      .docs-product-header-inner {
        min-height: 70px;
        padding-left: 18px;
        padding-right: 18px;
      }

      .docs-mobile-menu {
        top: var(--docs-mobile-menu-top, 70px);
        height: calc(100svh - 70px);
        height: calc(var(--docs-mobile-viewport-height, 100svh) - var(--docs-mobile-menu-top, 70px));
        height: var(--docs-mobile-menu-height, calc(var(--docs-mobile-viewport-height, 100svh) - var(--docs-mobile-menu-top, 70px)));
      }

      .docs-brand-region,
      .docs-header-action {
        display: none;
      }

      .docs-menu-toggle {
        padding: 0 12px;
        font-size: 0.8rem;
      }
    }
  }
</style>
