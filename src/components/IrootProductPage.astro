---
import ProductLayout from '../layouts/ProductLayout.astro';
const base = import.meta.env.BASE_URL;
const asset = (name: string) => `${base}products/iroot-sp/${name}`;
const doc = (name: string) => `${base}downloads/iroot-sp/${name}`;
const order = `${base}quote-request/?promo=iRoot#iroot-offer`;
const ingredients = ['Zirconium oxide', 'Calcium silicates', 'Calcium hydroxide', 'Calcium phosphate monobasic', 'Filler agents'];
const facts = [['Delivery', 'Premixed, injectable paste'], ['Working time', 'Over 30 min at room temperature'], ['Setting time', '4 h; over 10 h in very dry canals'], ['Techniques', 'Single cone and lateral condensation']];
const features = [
  ['Ready from the syringe', 'A premixed paste removes the chairside mixing step before sealer placement.'],
  ['Sets with dentinal moisture', 'The hydraulic calcium silicate cement uses moisture from the dentin. The IFU says additional canal moisture is unnecessary.'],
  ['Radiopaque. No setting shrinkage.', 'The IFU describes a radiopaque, aluminium-free material that does not shrink as it sets.'],
];
const schema = {'@context':'https://schema.org','@type':'Product',name:'iRoot SP Bioceramic Sealer',description:'Premixed calcium silicate root canal sealer. 2 g syringe with 15 disposable tips.',brand:{'@type':'Brand',name:'iRoot'},manufacturer:{'@type':'Organization',name:'Innovative BioCeramix Inc.'}};
---
<ProductLayout title="iRoot Bioceramic Sealer | NZ$240 | EndoTech NZ" description="iRoot SP bioceramic sealer, NZ$240 including GST per 2 g syringe. Compare the listed constituents, manufacturer and price with EndoSequence BC Sealer. Read both IFUs." image={asset('iroot-sp-studio-rebuilt.webp')} schema={schema}>
  <div class="iroot">
    <section class="hero" aria-labelledby="iroot-title"><div class="wrap">
      <div class="breadcrumb"><a href={`${base}products/overview/`}>Systems</a><span>/</span><span>Obturation</span></div>
      <div class="hero-grid">
        <div class="hero-copy"><p class="eyebrow"><i aria-hidden="true"></i> iRoot SP · Canadian manufacturer</p><h1 id="iroot-title">iRoot<span>Bioceramic Sealer.</span></h1><p class="intro">Premixed calcium silicate chemistry.<br />Manufactured by Innovative BioCeramix Inc.</p>
          <div class="hero-price"><span>NZ$</span><strong>240</strong><div>per 2 g syringe · incl. GST<small>Includes 15 disposable tips</small></div></div>
          <p class="gift"><strong>Free Micro-Path six-pack</strong>15/.03 · 25 mm · with promo code <a href={order}>iRoot</a></p><div class="actions"><a class="button primary" href={order}>Claim the iRoot offer ↗</a><a class="button secondary" href="#comparison">Compare with BC Sealer ↓</a></div><p class="price-note">NZ$100 below the NZ$340 BC Sealer reference RRP.<a href="#price-basis" aria-label="Price comparison basis">*</a></p>
        </div>
        <figure class="stage"><span class="stage-label">iRoot SP / Injectable root canal sealer</span><img src={asset('iroot-sp-studio-rebuilt.webp')} alt="Reconstructed studio image of the iRoot SP bioceramic sealer box and preloaded syringe" width="1774" height="887" fetchpriority="high" /><figcaption><span>1 × 2 g syringe + 15 tips</span><span>Innovative BioCeramix, Canada</span></figcaption></figure>
      </div>
      <div class="proof-strip"><a href="#manufacturer"><strong>One manufacturer</strong><span>Innovative BioCeramix Inc., Canada ↘</span></a><a href="#composition"><strong>Five listed constituents</strong><span>Matching ingredient lists in both IFUs ↘</span></a><a href="#price"><strong>NZ$100 difference</strong><span>iRoot SP NZ$240 · BC Sealer RRP NZ$340 ↘</span></a></div>
    </div></section>
    <nav class="local-nav" aria-label="iRoot page sections"><div class="wrap"><a href="#comparison">Compare the products</a><a href="#price">Compare the prices</a><a href="#clinical">Clinical use</a><a href="#documents">IFUs & sources</a></div></nav>
    <section id="comparison" class="pale section" aria-labelledby="comparison-title"><div class="wrap">
      <div class="heading"><div><p class="eyebrow">iRoot SP & EndoSequence® BC Sealer™</p><h2 id="comparison-title">Manufacturer.<br />Constituents. Price.</h2></div><p>Compare the standard sealers using their product documents. Both revision 11 IFUs are dated 15 May 2023.</p></div>
      <div class="table-frame"><table><caption class="sr-only">Comparison of iRoot SP and standard EndoSequence BC Sealer using the listed product documents.</caption><colgroup><col class="label-col" /><col class="iroot-col" /><col /></colgroup>
        <thead><tr><td><span class="overline">Product comparison</span></td><th scope="col"><span class="tag">EndoTech NZ</span><strong>iRoot SP</strong><span>Bioceramic Sealer</span></th><th scope="col"><span class="tag neutral">Brasseler USA</span><strong>BC Sealer</strong><span>EndoSequence®</span></th></tr></thead>
        <tbody><tr id="manufacturer" class="manufacturer"><th scope="row">Manufacturer<a href="#source-3" aria-label="Manufacturer source">3</a></th><td><strong>Innovative<br />BioCeramix Inc.</strong><span>Burnaby, British Columbia, Canada</span></td><td><strong>Innovative<br />BioCeramix Inc.</strong><span>Burnaby, British Columbia, Canada</span></td></tr>
          <tr id="composition" class="divider"><th colspan="3" scope="colgroup">Constituents listed in the IFUs <a href="#source-1" aria-label="iRoot IFU source">1</a><a href="#source-2" aria-label="BC Sealer IFU source">2</a></th></tr>
          {ingredients.map((name, i) => <tr class="ingredient"><th scope="row"><span class="index">{String(i+1).padStart(2,'0')}</span></th><td><span class="check" aria-hidden="true">✓</span>{name}</td><td><span class="check neutral" aria-hidden="true">✓</span>{name}</td></tr>)}
          <tr class="divider"><th colspan="3" scope="colgroup">Handling & setting · IFU revision 11</th></tr>
          {facts.map(([label, value]) => <tr><th scope="row">{label}</th><td>{value}</td><td>{value}</td></tr>)}
          <tr class="table-price"><th scope="row">Price per 2 g syringe<a href="#price-basis" aria-label="Price basis">*</a></th><td><strong>NZ$240</strong><span>EndoTech NZ price</span></td><td><strong>NZ$340</strong><span>Reference recommended retail price</span></td></tr>
        </tbody>
      </table></div>
      <div class="notes"><p>The BC Sealer IFU identifies Brasseler U.S.A. Dental, LLC as the company the product is manufactured for. The manufacturer comparison is supported by the scientific overview, page 1.<a href="#source-3" aria-label="Scientific overview source">3</a></p><p>The IFUs list constituent groups, without exact proportions. This comparison covers standard BC Sealer; HiFlow and Ion+ are separate products.</p></div>
    </div></section>
    <section id="price" class="price-section section" aria-labelledby="price-title"><div class="wrap price-grid">
      <div><p class="eyebrow">The price difference</p><h2 id="price-title">Save NZ$100<br />on each syringe.</h2><p>iRoot SP is NZ$240 per 2 g syringe.<br />The BC Sealer reference RRP is NZ$340.</p><p class="percent">29.4% less<small>than the reference RRP</small></p><a class="button light" href={order}>Order iRoot SP ↗</a></div>
      <div class="calculator" data-iroot-calculator><div class="quantity-row"><label for="iroot-quantity">Number of 2 g syringes</label><div class="quantity-control"><button type="button" data-change="-1" aria-label="One fewer syringe">−</button><input id="iroot-quantity" type="number" min="1" max="100" value="1" inputmode="numeric" /><button type="button" data-change="1" aria-label="One more syringe">+</button></div></div>
        <div class="bar-row"><div><span>BC Sealer reference RRP</span><strong data-bc-total>NZ$340</strong></div><div class="bar bc" aria-hidden="true"></div></div><div class="bar-row"><div><span>iRoot SP · EndoTech NZ</span><strong data-iroot-total>NZ$240</strong></div><div class="bar ir" aria-hidden="true"></div></div>
        <div class="saving" aria-live="polite" aria-atomic="true"><span>Your price difference</span><output data-saving-total for="iroot-quantity">NZ$100</output></div><p id="price-basis" class="price-basis">NZD per standard 2 g syringe. BC Sealer RRP supplied by EndoTech NZ on 27 October 2026; actual selling prices may vary. Both prices include GST.</p>
      </div>
    </div></section>
    <section id="clinical" class="section" aria-labelledby="clinical-title"><div class="wrap">
      <div class="heading"><div><p class="eyebrow">Clinical use</p><h2 id="clinical-title">Ready for obturation.</h2></div><p>The final seal follows canal preparation and irrigation. iRoot SP supplies the sealer as a ready-to-use paste for permanent obturation with gutta-percha.</p></div>
      <div class="features">{features.map(([title,text],i) => <article><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
      <div class="workflow"><div><p class="eyebrow">Placement overview</p><h3>Small amount.<br />Slow cone placement.</h3><a class="text-link" href={doc('iRoot-SP-IFU-4608-rev11.pdf')} target="_blank" rel="noopener">Read the full iRoot IFU ↗</a></div><ol><li><strong>Prepare, irrigate and dry.</strong><p>Prepare and irrigate using standard endodontic techniques. Dry with paper points as directed in the IFU.</p></li><li><strong>Apply a small amount of sealer.</strong><p>Coat the cone or a small hand file extra-orally. For tip delivery, keep the tip within the coronal third and dispense gently.</p></li><li><strong>Insert the master cone slowly.</strong><p>Use a thin sealer coating. Avoid excessive force and overfilling; follow the complete IFU for condensation and finishing.</p></li></ol></div><p class="clinical-note">For professional dental use. Check for ingredient allergies. Use a new disposable tip for each application and follow the IFU supplied with your product.</p>
    </div></section>
    <section id="documents" class="documents section" aria-labelledby="documents-title"><div class="wrap">
      <div class="heading"><div><p class="eyebrow">Product documents & research</p><h2 id="documents-title">Read the source material.</h2></div><p>Open either IFU to compare the composition, indications and handling instructions. The manufacturer’s document portal carries subsequent updates.</p></div>
      <div class="doc-grid">
        <a id="source-1" class="doc-card" href={doc('iRoot-SP-IFU-4608-rev11.pdf')} target="_blank" rel="noopener"><div class="doc-preview"><img src={asset('iroot-ifu.webp')} alt="iRoot SP revision 11 instructions for use" width="429" height="555" loading="lazy" /></div><div class="doc-caption"><span>01 / Instructions for use</span><h3>iRoot SP ↗</h3><p>IFU 4608 · Rev 11 · 15 May 2023<br />Composition & manufacturer · 1 page</p></div></a>
        <a id="source-2" class="doc-card" href={doc('EndoSequence-BC-Sealer-IFU-4608-rev11.pdf')} target="_blank" rel="noopener"><div class="doc-preview"><img src={asset('bc-ifu.webp')} alt="EndoSequence BC Sealer revision 11 instructions for use" width="429" height="555" loading="lazy" /></div><div class="doc-caption"><span>02 / Instructions for use</span><h3>EndoSequence BC Sealer ↗</h3><p>IFU 4608 · Rev 11 · 15 May 2023<br />Standard BC Sealer & HiFlow · 2 pages</p></div></a>
        <a id="source-3" class="doc-card" href={doc('bioceramic-scientific-overview.pdf')} target="_blank" rel="noopener"><div class="overview-preview"><span>Scientific<br />Overview</span><hr /><p>Manufacturer statement<br />& research bibliography</p><span class="page-number">19 <small>pages</small></span></div><div class="doc-caption"><span>03 / Manufacturer source</span><h3>Scientific overview ↗</h3><p>EdgeEndo technical bibliography<br />Manufacturer statement · page 1</p></div></a>
      </div>
      <div class="sds-links"><strong>Safety data sheets</strong><a href={doc('iRoot-SP-SDS-4608-rev9.pdf')} target="_blank" rel="noopener">iRoot SP · SDS rev 9 ↗</a><a href={doc('EndoSequence-BC-Sealer-SDS-4608-rev9.pdf')} target="_blank" rel="noopener">BC Sealer · SDS rev 9 ↗</a><a href="https://www.ibioceramix.com/eifu.html" target="_blank" rel="noopener">Manufacturer IFU & SDS portal ↗</a></div>
      <div class="research"><div><p class="eyebrow">Clinical literature</p><h3>BC Sealer in clinical research.</h3></div><div><p>Chybowski et al. reported outcomes for 307 teeth treated with EndoSequence BC Sealer and a single-cone technique. This was a retrospective study of BC Sealer, rather than a head-to-head clinical comparison with iRoot SP.</p><a class="text-link" href="https://pubmed.ncbi.nlm.nih.gov/29606401/" target="_blank" rel="noopener">Journal of Endodontics, 2018 · Read the study ↗</a></div></div>
      <p class="document-note">The documents above are identified by revision and date. Consult the current IFU supplied with the product before clinical use. EndoSequence and BC Sealer are trademarks of their respective owners.</p>
    </div></section>
    <section class="closing"><div class="wrap closing-grid"><div><p class="eyebrow">iRoot SP · EndoTech NZ</p><h2>iRoot SP for NZ$240.</h2><p>Includes GST. Use code iRoot to add a free six-pack of Micro-Path 15/.03, 25 mm files.</p></div><div><a class="button primary" href={order}>Order iRoot SP ↗</a><a class="text-link" href={`${base}products/iroot-sp-disposable-tips/`}>Explore the disposable tip organiser →</a></div></div></section>
  </div>
</ProductLayout>
<script>
  const calculator = document.querySelector('[data-iroot-calculator]');
  const quantity = calculator?.querySelector<HTMLInputElement>('#iroot-quantity');
  const format = (n: number) => `NZ$${n.toLocaleString('en-NZ')}`;
  const update = () => {
    if (!quantity || !calculator) return;
    const n = Math.max(1, Math.min(100, Math.round(Number(quantity.value)||1)));
    quantity.value = String(n);
    calculator.querySelector('[data-bc-total]')!.textContent = format(n*340);
    calculator.querySelector('[data-iroot-total]')!.textContent = format(n*240);
    calculator.querySelector('[data-saving-total]')!.textContent = format(n*100);
    calculator.querySelectorAll<HTMLButtonElement>('[data-change]').forEach(b => b.disabled = b.dataset.change === '-1' ? n===1 : n===100);
  };
  quantity?.addEventListener('change', update);
  calculator?.querySelectorAll<HTMLButtonElement>('[data-change]').forEach(b => b.addEventListener('click', () => {if(quantity) quantity.value=String((Number(quantity.value)||1)+Number(b.dataset.change));update();}));
  update();
</script>
<style>
