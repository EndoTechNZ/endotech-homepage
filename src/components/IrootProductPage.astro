ht:1.85;max-width:45ch;padding-bottom:3px}
  .table-frame{border:1px solid var(--line);border-radius:10px;overflow:hidden;background:white}.iroot table{border-collapse:collapse;width:100%;table-layout:fixed;text-align:left;font-size:14px;line-height:1.6}.label-col{width:25%}.iroot-col{background:#edf5f0}.iroot table :is(th,td){padding:17px 26px;border-bottom:1px solid #dfe7e4;vertical-align:middle;font-weight:400}.iroot thead :is(th,td){padding-block:28px}.iroot thead strong{display:block;font-size:30px;letter-spacing:-.045em;font-weight:550;line-height:1.3;margin-top:11px}.iroot thead th>span:last-child{font-size:13px;color:var(--muted)}.overline{font-size:11px;color:var(--muted)}.tag{display:inline-block;font-size:10px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:#2d6a54}.neutral{color:#7c8c86!important}.manufacturer td{padding-block:24px!important}.manufacturer td strong{display:block;font-size:23px;font-weight:550;line-height:1.3;letter-spacing:-.025em}.manufacturer td>span{display:block;font-size:11px;color:var(--muted);margin-top:10px}.iroot th[scope=row]{font-size:12px;color:#546b73;font-weight:500}.iroot table a,.notes a{font-size:10px;vertical-align:super;color:#0b75b7;padding:4px}.iroot .divider th{padding:13px 26px;font-size:11px;letter-spacing:.04em;background:#e3ede8;color:#3d5e52;font-weight:600}.index{font-size:11px;color:#788a86}.check{display:inline-block;color:#2c7a5b;margin-right:12px}.ingredient td{font-weight:500!important}.table-price td{padding-block:25px!important}.table-price strong{display:block;font-size:32px;font-weight:500;letter-spacing:-.045em}.table-price td:first-of-type strong{color:#276c51}.table-price td>span{font-size:11px;color:var(--muted)}.iroot tr:last-child :is(th,td){border-bottom:0}.notes{display:grid;grid-template-columns:1fr 1fr;gap:36px;padding-top:22px}.notes p{font-size:12px;line-height:1.8}
