---
interface Props { initiallyHidden?: boolean; inOrder?: boolean; }
const {initiallyHidden = false, inOrder = false} = Astro.props;
const base = import.meta.env.BASE_URL;
const Heading = inOrder ? 'h1' : 'h2';
---
<section id="iroot-offer" class="iroot-offer" data-iroot-offer hidden={initiallyHidden} aria-labelledby="iroot-offer-title">
  <div class="offer-top"><p>EndoTech NZ offer</p><span>Promo code <strong>iRoot</strong></span></div>
  <div class="offer-grid">
    <div class="offer-image"><img src={`${base}products/iroot-sp/iroot-sp-studio-rebuilt.webp`} alt="Reconstructed iRoot SP sealer box and syringe" width="1774" height="887" /><span>Per box: 1 × 2 g syringe + 15 disposable tips</span></div>
    <div class="offer-copy"><Heading id="iroot-offer-title" tabindex="-1">iRoot SP +<br />Micro-Path.</Heading><p class="offer-description">Your iRoot sealer, with a free pack of glide-path files.</p>
      <div class="offer-bonus"><span class="offer-six">6<small>files</small></span><div><span class="free-label">One free six-pack per box</span><h3>Micro-Path 15/.03</h3><p>25 mm · glide-path files</p></div><strong class="free-price">FREE</strong></div>
      <div class="offer-total"><strong>NZ$240</strong><span>+ GST per box<br /><small>NZ$276 including GST · postage separate</small></span></div>
      <p class="offer-limit">Limited to two iRoot boxes per clinic.</p>
      {inOrder && <div class="offer-quantity"><label for="iroot-offer-boxes">iRoot boxes</label><select id="iroot-offer-boxes" data-iroot-boxes><option value="1">1 box</option><option value="2">2 boxes</option></select><p data-iroot-selected-total aria-live="polite">1 box + 1 free six-pack · NZ$276 including GST</p></div>}
      {inOrder ? <button type="button" class="offer-action" data-iroot-continue>Continue with this offer <span aria-hidden="true">→</span></button> : <a class="offer-action" href={`${base}quote-request/?promo=iRoot#iroot-offer`}>Claim the iRoot offer <span aria-hidden="true">→</span></a>}
      <p class="offer-help">{inOrder ? 'The syringe and free six-pack are in your request. Add your practice details, then review.' : 'Enter iRoot in the order’s Promo code box and press Enter, or claim the offer above.'}</p>
    </div>
  </div>
</section>
<style>
  .offer-limit{font-size:12px;font-weight:600;line-height:1.6;margin:0 0 18px;color:#376b60}.offer-quantity{display:flex;align-items:center;flex-wrap:wrap;gap:8px 14px;margin:18px 0}.offer-quantity label{font-size:13px;font-weight:600}.offer-quantity select{min-height:44px;padding:8px 30px 8px 12px;border:1px solid #c6dacf;border-radius:5px;background:#fff;color:#173342;font:inherit}.offer-quantity p{flex-basis:100%;font-size:12px;line-height:1.7;margin:0;color:#536975}
  .iroot-offer[hidden]{display:none!important}.iroot-offer{max-width:1180px;margin:32px auto 48px;padding:30px 38px 38px;border:1px solid #dce7e2;border-radius:12px;background:white;color:#173342;font-family:Inter,'Segoe UI',sans-serif;scroll-margin-top:140px}.offer-top{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-bottom:24px;border-bottom:1px solid #e1eae5}.offer-top p{margin:0;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#527469}.offer-top>span{font-size:12px;color:#536975}.offer-top strong{display:inline-block;margin-left:8px;border:1px solid #c6dacf;border-radius:5px;padding:4px 12px;font:600 15px/1.4 ui-monospace,monospace;color:#286e68}.offer-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:50px;align-items:center;padding-top:32px}.offer-image{background:#f0f5f2;border-radius:8px;padding:42px 15px 24px}.offer-image img{display:block;width:100%;height:auto}.offer-image>span{display:block;text-align:center;font-size:11px;color:#60786d;margin-top:30px}.offer-copy :is(h1,h2){font-size:clamp(34px,4vw,46px);font-weight:500;line-height:1.1;letter-spacing:-.045em;margin:0}.offer-copy :is(h1,h2):focus{outline:none}.offer-description{font-size:14px;line-height:1.7;color:#536975;margin:17px 0 24px}.offer-bonus{display:flex;align-items:center;gap:18px;border-block:1px solid #dde8e1;padding:20px 0}.offer-six{display:flex;flex-direction:column;justify-content:center;align-items:center;min-width:48px;height:58px;background:#e9f3ed;border-radius:5px;font-size:27px;line-height:1;color:#2d6d51}.offer-six small{font-size:10px;margin-top:4px}.free-label{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#2b7756;font-weight:600}.offer-bonus h3{font-size:17px;font-weight:600;line-height:1.35;margin:5px 0}.offer-bonus p{font-size:12px;margin:0;color:#536975}.free-price{margin-left:auto;font-size:12px;letter-spacing:.05em;color:#2b7756}.offer-total{display:flex;align-items:center;gap:20px;margin:25px 0}.offer-total>strong{font-size:44px;font-weight:500;line-height:1;letter-spacing:-.05em}.offer-total>span{font-size:12px;color:#536975;line-height:1.7}.offer-total small{font-size:10px}.offer-action{display:flex;justify-content:space-between;align-items:center;gap:26px;width:100%;min-height:48px;padding:13px 18px;border:0;border-radius:6px;background:#0b75b7;color:white;text-decoration:none;font:600 13px/1.5 Inter,'Segoe UI',sans-serif;cursor:pointer}.offer-action:hover{background:#095b8d}.offer-action:focus-visible{outline:3px solid #173342;outline-offset:4px}.offer-help{font-size:11px;color:#667d72;line-height:1.75;margin:13px 0 0}@media(max-width:720px){.iroot-offer{margin:24px 18px 36px;padding:22px}.offer-top{gap:12px;padding-bottom:18px}.offer-top p{font-size:9px}.offer-top>span{font-size:10px}.offer-top strong{font-size:13px;padding:3px 9px;margin-left:5px}.offer-grid{grid-template-columns:1fr;gap:27px;padding-top:22px}.offer-copy{order:0}.offer-image{order:1}.offer-image{padding:25px 12px 15px}.offer-image>span{font-size:10px;margin-top:18px}.offer-copy :is(h1,h2){font-size:38px}.offer-total>strong{font-size:40px}.offer-total{gap:16px}.offer-bonus{gap:12px}.offer-bonus h3{font-size:16px}.free-label{font-size:9px}}
</style>
