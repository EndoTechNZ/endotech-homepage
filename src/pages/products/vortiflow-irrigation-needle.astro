---
import { existsSync } from 'node:fs';
import path from 'node:path';
import ProductLayout from '../../layouts/ProductLayout.astro';
import vortiflowTechnicalRender from '../../assets/vortiflow/vortiflow-technical-cad-render.png';
import vortiflowComparisonChart from '../../assets/vortiflow/vortiflow-irrigation-modality-comparison.png';
import vortiflowVortexFlow from '../../assets/vortiflow/vortiflow-fluid-dynamics-clean.png';
import vortiflowWaterFlowMarketingImage from '../../assets/vortiflow/vortiflow-water-flow-marketing-image.png';
import vortiflowHelicalFigure from '../../assets/vortiflow/vortiflow-helical-channel-figure.png';
import vortiflowVortexFigure from '../../assets/vortiflow/vortiflow-vortex-concept-figure.png';
import vortiflowCadTip1 from '../../assets/vortiflow/vortiflow-cad-tip-render-1.jpg';
import vortiflowCadTip2 from '../../assets/vortiflow/vortiflow-cad-tip-render-2.jpg';
import { siteConfig } from '../../config/site';
import { withBasePath } from '../../utils/paths';

const siteUrl = Astro.site?.toString() ?? 'https://EndoTechSG.github.io';
const evidencePdfHref = '/downloads/VortiFlow-Evidence-Overview.pdf';
const hasEvidencePdf = existsSync(path.join(process.cwd(), 'public', 'downloads', 'VortiFlow-Evidence-Overview.pdf'));
const evidenceOverviewHref = hasEvidencePdf ? withBasePath(evidencePdfHref) : '#flow-evidence';
const vortiflowVideoSrc = withBasePath('/videos/vortiflow-clean-hero.mp4');
const workflowHref = withBasePath('/technique/workflow/');
const contactHref = withBasePath('/about/contact/');
const bcsHref = withBasePath('/products/bcs/');

const pageTitle = `VortiFlow Irrigation Needle for Controlled Endodontic Irrigation | ${siteConfig.name}`;
const pageDescription =
  'VortiFlow is an irrigation needle concept designed for controlled lateral irrigant flow, fluid exchange, and debris transport after canal shaping.';

const vortiflowSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'VortiFlow Irrigation Needle',
  description: pageDescription,
  brand: {
    '@type': 'Brand',
    name: siteConfig.name,
  },
  category: 'Endodontic irrigation needle',
  image: [new URL(vortiflowVortexFlow.src, siteUrl).toString()],
  url: new URL('/products/vortiflow-irrigation-needle/', siteUrl).toString(),
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Flow concept', value: 'Helical channel lateral flow' },
    { '@type': 'PropertyValue', name: 'Tip concept', value: 'Closed-end style lateral outlet' },
    { '@type': 'PropertyValue', name: 'Workflow position', value: 'After shaping and before obturation' },
  ],
};

const technicalCards = [
  {
    title: 'Helical channel geometry',
    body:
      'VortiFlow is presented as a lateral-flow concept built around channel geometry, outlet placement, and shaped-canal fluid behaviour.',
    tone: 'light',
  },
  {
    title: 'Cleaning after shaping',
    body:
      'The system story is deliberate: shape first, then clean with controlled delivery before sealing with a matched bioceramic pathway.',
    tone: 'dark',
    metric: 'Shape → Clean 3D → Seal',
  },
];

const workflowSteps = [
  {
    number: '1',
    title: 'Shape the canal',
    description:
      'Preparation geometry determines how irrigant can move, exchange, and reach the canal walls during the cleaning phase.',
  },
  {
    number: '2',
    title: 'Deliver controlled irrigation',
    description:
      'VortiFlow positions lateral outlet design and helical channel flow as part of the cleaning step rather than a generic accessory choice.',
  },
  {
    number: '3',
    title: 'Move into final sealing',
    description:
      'After cleaning, the workflow transitions into bioceramic sealing so the preparation, irrigation, and final material choice stay connected.',
  },
];

const evidenceRows = [
  {
    feature: 'Outlet geometry',
    vortiflow: 'Lateral-flow concept',
    standard: 'Often treated as a commodity feature',
  },
  {
    feature: 'Workflow position',
    vortiflow: 'Integrated after shaping',
    standard: 'Often described in isolation',
  },
  {
    feature: 'Engineering story',
    vortiflow: 'Fluid exchange and debris transport',
    standard: 'Less system-led explanation',
  },
  {
    feature: 'Final step connection',
    vortiflow: 'Leads into sealing',
    standard: 'Usually separated from material choice',
  },
];

const downloads = hasEvidencePdf
  ? [
      {
        label: 'Evidence overview',
        title: 'VortiFlow PDF',
        href: withBasePath(evidencePdfHref),
      },
      {
        label: 'Clinical workflow',
        title: 'EndoTech treatment sequence',
        href: workflowHref,
      },
    ]
  : [
      {
        label: 'Clinical workflow',
        title: 'EndoTech treatment sequence',
        href: workflowHref,
      },
    ];
---

<ProductLayout
  title={pageTitle}
  description={pageDescription}
  image={vortiflowVortexFlow.src}
  schema={vortiflowSchema}
  accent="teal"
>
  <main class="vorti-stitch-page">
    <section class="vorti-hero" aria-labelledby="vorti-hero-title">
      <div class="vorti-hero-copy">
        <div class="vorti-irrigation-delivery-reveal-mask">
          <p class="vorti-irrigation-delivery-reveal-text js-vorti-irrigation-delivery-reveal">Irrigation delivery system</p>
        </div>
        <h1 id="vorti-hero-title">
          <span class="vorti-hero-title-main">VortiFlow</span>
          <span class="vorti-hero-title-sub">Irrigation Needle</span>
        </h1>
        <p class="vorti-hero-lede">
          Controlled lateral irrigant delivery positioned as the cleaning bridge between shaping and final bioceramic sealing.
        </p>
      </div>

      <figure
        data-vortiflow-hero-visual
        class="vorti-hero-visual vorti-hero-visual--pre-reveal"
        style="transform: translateZ(0) scale(0.9);"
      >
        <img
          class="vorti-hero-image"
          src={vortiflowTechnicalRender.src}
          alt="Technical CAD render of the VortiFlow irrigation needle concept"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      </figure>

      <div class="vorti-hero-actions">
        <a class="vorti-button primary" href={evidenceOverviewHref}>Evidence Overview</a>
        <a class="vorti-button secondary" href={contactHref}>Contact EndoTech</a>
      </div>

      <div class="vorti-hero-meta" aria-label="VortiFlow key concepts">
        <span>Lateral flow</span>
        <span>Clean 3D</span>
        <span>Seal</span>
      </div>
    </section>

    <section class="vorti-technical-band" aria-labelledby="vorti-technical-title">
      <h2 class="sr-only" id="vorti-technical-title">Technical overview</h2>
      <div class="vorti-technical-grid">
        {technicalCards.map((card) => (
          <article class:list={['vorti-technical-card', card.tone === 'dark' && 'is-dark']}>
            <div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </div>
            {card.metric ? (
              <div class="vorti-technical-meta">
                <span>{card.metric}</span>
              </div>
            ) : (
              <img src={vortiflowVortexFlow.src} alt="Fluid dynamics visual for the VortiFlow irrigation concept" />
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="vorti-video-section" aria-labelledby="vorti-video-title">
      <div class="vorti-video-layout">
        <div class="vorti-video-copy">
          <p class="vorti-eyebrow">Clinical video</p>
          <h2 id="vorti-video-title">VortiFlow in motion.</h2>
          <p>
            The video sits here as a focused clinical visual, not as a generic media insert. Use it alongside the
            engineering figures and evidence overview to review the cleaning concept in context.
          </p>

          <div class="vorti-video-points">
            <article>
              <strong>Lateral delivery</strong>
              <span>Review how the concept is positioned within the cleaning phase after shaping.</span>
            </article>
            <article>
              <strong>Canal context</strong>
              <span>Keep the motion study close to the surrounding engineering and workflow explanation.</span>
            </article>
            <article>
              <strong>Evidence path</strong>
              <span>Move from the video into the evidence overview or the wider workflow sequence when needed.</span>
            </article>
          </div>

          <a class="vorti-inline-link" href={evidenceOverviewHref}>Open evidence overview</a>
        </div>

        <div class="vorti-video-frame">
          <div class="vorti-video-stage">
            <video controls muted playsinline preload="metadata" class="vorti-video-player">
              <source src={vortiflowVideoSrc} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
          <p class="vorti-video-note">Short clinical animation showing the VortiFlow irrigation concept.</p>
        </div>
      </div>
    </section>

    <section class="vorti-journey-section" aria-labelledby="vorti-journey-title">
      <div class="vorti-journey-media">
        <img src={vortiflowWaterFlowMarketingImage.src} alt="VortiFlow concept image showing fluid delivery in the canal" />
      </div>

      <div class="vorti-journey-copy">
        <p class="vorti-eyebrow">The clinical journey</p>
        <h2 id="vorti-journey-title">Cleaning should follow the preparation geometry you just created.</h2>
        <div class="vorti-journey-steps">
          {workflowSteps.map((step) => (
            <article>
              <span>{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="vorti-engineering-section" aria-labelledby="vorti-engineering-title">
      <div class="vorti-section-heading">
        <p class="vorti-eyebrow">Engineering detail</p>
        <h2 id="vorti-engineering-title">Helical channels, lateral outlets, and fluid movement within the shaped canal.</h2>
      </div>

      <div class="vorti-visual-grid">
        <article>
          <img src={vortiflowComparisonChart.src} alt="Comparison chart showing different irrigation needle delivery concepts" />
          <h3>Delivery comparison</h3>
          <p>Used to explain why outlet style and needle geometry influence the way irrigant behaves inside the preparation.</p>
        </article>
        <article>
          <img src={vortiflowHelicalFigure.src} alt="Diagram showing the helical channel geometry in the VortiFlow concept" />
          <h3>Helical channel figure</h3>
          <p>Shows the directional-flow concept that underpins the VortiFlow cleaning story.</p>
        </article>
        <article>
          <div class="vorti-cad-pair">
            <img src={vortiflowCadTip1.src} alt="CAD rendering of one VortiFlow tip concept" />
            <img src={vortiflowCadTip2.src} alt="CAD rendering of the VortiFlow lateral outlet tip concept" />
          </div>
          <h3>Tip geometry</h3>
          <p>Supports the message that distal form, outlet placement, and controlled delivery all work together.</p>
        </article>
      </div>
    </section>

    <section class="vorti-bcs-section" aria-labelledby="vorti-bcs-title">
      <div class="vorti-bcs-copy">
        <p class="vorti-eyebrow">Seal the workflow</p>
        <h2 id="vorti-bcs-title">BCS BioCeramic Sealer</h2>
        <p class="vorti-bcs-lede">
          VortiFlow is positioned inside the wider EndoTech sequence: shape the canal, clean with controlled irrigation, then move into a matched sealing pathway.
        </p>

        <div class="vorti-bcs-metrics">
          <div>
            <strong>Clean 3D</strong>
            <span>irrigation phase logic</span>
          </div>
          <div>
            <strong>Seal</strong>
            <span>bioceramic completion</span>
          </div>
        </div>

        <div class="vorti-bcs-actions">
          <a class="vorti-button dark" href={bcsHref}>View BCS family</a>
          <a class="vorti-inline-link" href={workflowHref}>Review clinical workflow</a>
        </div>
      </div>

      <figure class="vorti-bcs-visual">
        <img src={vortiflowVortexFigure.src} alt="Engineering illustration representing the VortiFlow flow pathway before sealing" />
      </figure>
    </section>

    <section id="flow-evidence" class="vorti-comparison-section" aria-labelledby="vorti-comparison-title">
      <div class="vorti-comparison-heading">
        <h2 id="vorti-comparison-title">Evidence and rationale</h2>
        <p>Transparent context for clinicians evaluating why delivery design matters in the cleaning phase.</p>
      </div>

      <div class="vorti-table-shell">
        <table class="vorti-comparison-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>VortiFlow</th>
              <th>Typical Alternative</th>
            </tr>
          </thead>
          <tbody>
            {evidenceRows.map((row) => (
              <tr>
                <th>{row.feature}</th>
                <td>{row.vortiflow}</td>
                <td>{row.standard}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="vorti-downloads-section" aria-labelledby="vorti-downloads-title">
      <div class="vorti-downloads-heading">
        <p class="vorti-eyebrow">Downloads</p>
        <h2 id="vorti-downloads-title">Evidence files and system references.</h2>
      </div>

      <div class="vorti-download-list">
        {downloads.map((download) => (
          <a href={download.href}>
            <span>{download.label}</span>
            <strong>{download.title}</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="vorti-cta-section" aria-labelledby="vorti-cta-title">
      <div class="vorti-cta-copy">
        <h2 id="vorti-cta-title">Connect shaping, cleaning, and sealing more clearly.</h2>
        <p>
          Review the VortiFlow concept, then contact EndoTech Singapore if you want to discuss how the irrigation step fits within the wider TransformX workflow.
        </p>
      </div>
      <div class="vorti-cta-actions">
        <a class="vorti-button primary" href={contactHref}>Request Clinical Support</a>
        {hasEvidencePdf ? (
          <a class="vorti-button secondary on-dark" href={withBasePath(evidencePdfHref)}>Open evidence PDF</a>
        ) : (
          <a class="vorti-button secondary on-dark" href={workflowHref}>Open workflow</a>
        )}
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const visual = document.querySelector('[data-vortiflow-hero-visual]');
      if (!(visual instanceof HTMLElement)) return;

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          setTimeout(() => {
            visual.style.transform = '';
            visual.classList.remove('vorti-hero-visual--pre-reveal');
          }, 70);
        });
      });
    })();
  </script>

  <script is:inline>
    (() => {
      const mask = document.querySelector('.vorti-irrigation-delivery-reveal-mask');
      const text = document.querySelector('.js-vorti-irrigation-delivery-reveal');
      if (!(mask instanceof HTMLElement) || !(text instanceof HTMLElement)) return;

      const originalText = 'Irrigation delivery system';
      text.setAttribute('aria-label', originalText);
      text.innerHTML = Array.from(originalText)
        .map((char, index) => {
          const safeChar = char === ' ' ? '&nbsp;' : char;
          return `<span class="vorti-irrigation-delivery-reveal-char" aria-hidden="true" style="--char-index:${index}">${safeChar}</span>`;
        })
        .join('');

      const observer = new IntersectionObserver(
        (entries, observerInstance) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            window.setTimeout(() => {
              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  mask.classList.add('is-visible');
                });
              });
            }, 180);

            observerInstance.unobserve(entry.target);
          });
        },
        {
          root: null,
          threshold: 0.2,
        }
      );

      observer.observe(mask);
    })();
  </script>
</ProductLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .vorti-stitch-page {
    background: #ffffff;
    color: #181c20;
  }

  .vorti-hero,
  .vorti-technical-band,
  .vorti-journey-section,
  .vorti-engineering-section,
  .vorti-bcs-section,
  .vorti-comparison-section,
  .vorti-video-section,
  .vorti-downloads-section,
  .vorti-cta-section {
    padding-left: 56px;
    padding-right: 56px;
  }

  .vorti-eyebrow {
    margin: 0 0 14px;
    color: #00639c;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .vorti-hero h1,
  .vorti-technical-card h3,
  .vorti-journey-copy h2,
  .vorti-journey-copy h3,
  .vorti-section-heading h2,
  .vorti-bcs-copy h2,
  .vorti-visual-grid h3,
  .vorti-comparison-heading h2,
  .vorti-downloads-heading h2,
  .vorti-cta-copy h2 {
    margin: 0;
    color: #181c20;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .vorti-hero {
    display: grid;
    justify-items: center;
    padding-top: 104px;
    padding-bottom: 88px;
    text-align: center;
    background: #ffffff;
  }

  .vorti-hero-copy {
    max-width: 740px;
  }

  .vorti-irrigation-delivery-reveal-mask {
    display: block;
    overflow: hidden;
    text-align: center;
    padding: 0 0 14px;
    min-height: 24px;
  }

  .vorti-irrigation-delivery-reveal-text {
    margin: 0;
    color: #00639c;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
  }

  :global(.vorti-irrigation-delivery-reveal-char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(5px);
    filter: blur(1.5px);
    transition:
      opacity 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--char-index) * 12ms);
    will-change: opacity, transform, filter;
  }

  :global(.vorti-irrigation-delivery-reveal-mask.is-visible .vorti-irrigation-delivery-reveal-char) {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .vorti-hero h1 {
    font-size: clamp(3.8rem, 7vw, 5.8rem);
    line-height: 0.94;
  }

  .vorti-hero-title-main,
  .vorti-hero-title-sub {
    display: block;
  }

  .vorti-hero-title-sub {
    margin-top: 10px;
    color: #7a8190;
    font-size: clamp(1rem, 1.4vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.15;
  }

  .vorti-hero-lede,
  .vorti-technical-card p,
  .vorti-journey-copy p,
  .vorti-section-heading p,
  .vorti-visual-grid p,
  .vorti-bcs-copy p,
  .vorti-comparison-heading p,
  .vorti-video-copy p,
  .vorti-download-list span,
  .vorti-cta-copy p {
    color: #404750;
    font-family: Inter, 'Segoe UI', sans-serif;
    line-height: 1.65;
  }

  .vorti-hero-lede {
    max-width: 580px;
    margin: 18px auto 0;
    font-size: 1rem;
  }

  .vorti-hero-visual {
    width: 100%;
    max-width: 1040px;
    margin: 52px 0 0;
    padding: 28px;
    border: 1px solid #e3e8ee;
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(248, 251, 254, 0.96), rgba(241, 246, 251, 0.96));
    box-shadow: 0 10px 28px rgba(0, 55, 112, 0.06);
    transform-origin: center center;
    transform: translateZ(0) scale(1);
    transition: transform 1320ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .vorti-hero-visual--pre-reveal {
    transform: translateZ(0) scale(0.9);
  }

  .vorti-hero-visual img {
    display: block;
    width: 100%;
    max-height: 700px;
    object-fit: contain;
    backface-visibility: hidden;
  }

  .vorti-hero-actions,
  .vorti-cta-actions,
  .vorti-bcs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .vorti-hero-actions {
    justify-content: center;
    margin-top: 30px;
  }

  .vorti-hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
  }

  .vorti-hero-meta span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    border: 1px solid #d7e0e8;
    border-radius: 999px;
    padding: 0 14px;
    color: #4e5a68;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #fbfdff;
  }

  .vorti-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border-radius: 6px;
    padding: 0 18px;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      color 180ms ease,
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .vorti-button:hover,
  .vorti-button:focus-visible {
    transform: translateY(-1px);
    box-shadow:
      0 12px 24px rgba(15, 23, 42, 0.08),
      0 2px 6px rgba(15, 23, 42, 0.05);
  }

  .vorti-button.primary {
    background: #005c92;
    border: 1px solid #005c92;
    color: #ffffff;
  }

  .vorti-button.primary:hover,
  .vorti-button.primary:focus-visible {
    background: #0a6ca8;
    border-color: #0a6ca8;
  }

  .vorti-button.secondary {
    background: #ffffff;
    border: 1px solid #c0c7d2;
    color: #404750;
  }

  .vorti-button.secondary:hover,
  .vorti-button.secondary:focus-visible {
    background: #f8fbfd;
    border-color: #aeb8c5;
    color: #1f2937;
  }

  .vorti-button.dark {
    background: #181c20;
    border: 1px solid #181c20;
    color: #ffffff;
  }

  .vorti-button.dark:hover,
  .vorti-button.dark:focus-visible {
    background: #111827;
    border-color: #111827;
  }

  .vorti-button.on-dark,
