---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import { laschalCatalogItems } from '../../../data/laschal';
import {
  laschalAssets,
  laschalBestSellerCampaigns,
  laschalCataloguePdfHref,
  laschalCategoryOrder,
  laschalClinicalTasks,
  laschalFeaturedInstruments,
} from '../../../data/laschalCatalogue';
import { withBasePath } from '../../../utils/paths';

const contactHref = withBasePath('/about/contact/');
const cataloguePdfHref = withBasePath(laschalCataloguePdfHref);
const images = Object.fromEntries(
  Object.entries(laschalAssets).map(([key, value]) => [key, withBasePath(value)]),
) as Record<keyof typeof laschalAssets, string>;
const featuredInstruments = laschalFeaturedInstruments.map((instrument) => ({
  ...instrument,
  image: withBasePath(instrument.image),
}));
const bestSellerCampaigns = laschalBestSellerCampaigns.map((campaign) => ({
  ...campaign,
  image: withBasePath(campaign.image),
}));
const clinicalTasks = laschalClinicalTasks;

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const categoryOrder = laschalCategoryOrder;

const categoryCounts = categoryOrder
  .map((label) => ({
    label,
    count: laschalCatalogItems.filter((item) => item.category === label).length,
  }))
  .filter((category) => category.count > 0);

const catalogGroups = categoryOrder
  .map((label) => ({
    label,
    items: laschalCatalogItems.filter((item) => item.category === label),
  }))
  .filter((group) => group.items.length > 0);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Laschal Endodontic Instruments',
  description:
    'EndoTech NZ range page for Laschal endodontic instruments, including tactile file control, file retrieval, gutta percha removal, and microsurgical support.',
  mainEntity: {
    '@type': 'ItemList',
      itemListElement: laschalCatalogItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      sku: item.sku,
    })),
  },
};
---

<ProductLayout
  title="Laschal Endodontic Instruments | EndoTech NZ"
  description="Laschal endodontic instruments available through EndoTech NZ, including file control, separated instrument retrieval, gutta percha removal, and microsurgical access."
  image={images.hero}
  schema={schema}
  accent="slate"
>
  <main class="laschal-page">
    <section class="laschal-hero" aria-labelledby="laschal-hero-title">
      <div class="laschal-hero-copy">
        <img class="laschal-brand-mark" src={images.logo} alt="Laschal Surgical" />
        <p class="laschal-eyebrow">Endodontic instrument range</p>
        <h1 id="laschal-hero-title">Laschal endodontic instruments for control, access, and retrieval.</h1>
        <p class="laschal-hero-lede">
          Precision instruments for tactile file control, separated instrument retrieval, gutta percha removal, and microsurgical endodontic support.
        </p>
        <div class="laschal-actions">
          <a class="laschal-button primary" href="#laschal-best-sellers">View best sellers</a>
          <a class="laschal-button secondary" href="#laschal-catalog">Browse full range</a>
          <a class="laschal-button secondary" href={cataloguePdfHref} download="EndoTech-NZ-Laschal-Endodontic-Instruments-Catalogue.pdf">Download catalogue</a>
        </div>
      </div>

      <figure class="laschal-hero-visual">
        <img src={images.hero} alt="Laschal endodontic instrumentation set" />
      </figure>

      <nav class="laschal-proof-strip" aria-label="Laschal range roles">
        <a href="#laschal-feature-file-control" data-laschal-task-link>File control</a>
        <a href="#laschal-feature-fxp-retrieval" data-laschal-task-link>Retrieval</a>
        <a href="#laschal-feature-gutta-percha" data-laschal-task-link>Retreatment</a>
        <a href="#laschal-catalog-needle-holders" data-laschal-task-link>Microsurgery</a>
      </nav>
    </section>

    <section class="laschal-best-section" id="laschal-best-sellers" aria-labelledby="laschal-best-title">
      <div class="laschal-section-heading centered">
        <img class="laschal-section-mark" src={images.logo} alt="Laschal Surgical" loading="lazy" decoding="async" />
        <p class="laschal-eyebrow">Best-selling Endo range</p>
        <h2 id="laschal-best-title">Instruments clinicians love.</h2>
        <p>
          These SKUs form the first campaign set for EndoTech NZ: retrieval, file control, retreatment support, and microsurgical closure, with public video material used where it genuinely supports the clinical story.
        </p>
      </div>

      <div class="laschal-best-grid">
        {bestSellerCampaigns.map((campaign) => (
          <article class="laschal-best-card" id={campaign.anchorId}>
            <figure>
              <img src={campaign.image} alt={campaign.title} loading="eager" decoding="async" />
            </figure>
            <div class="laschal-best-copy">
              <p class="laschal-card-kicker">Hero campaign</p>
              <h3>{campaign.title}</h3>
              <div class="laschal-sku-row" aria-label={`${campaign.title} SKUs`}>
                {campaign.skus.map((sku) => (
                  <span>{sku}</span>
                ))}
              </div>
              <p>{campaign.clinicalUse}</p>
              <ul>
                {campaign.clinicalBenefits.map((benefit) => (
                  <li>{benefit}</li>
                ))}
              </ul>
              <div class="laschal-best-note">
                <strong>Promotion angle</strong>
                <p>{campaign.promoAngle}</p>
              </div>
              <div class="laschal-best-signal">
                <strong>Online signal</strong>
                <span>{campaign.onlineSignal}</span>
              </div>
              <div class="laschal-card-actions">
                <a href={contactHref}>Discuss availability</a>
                {campaign.videos.map((video) => (
                  <a class="video" href={video.href} target="_blank" rel="noreferrer">{video.label}</a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="laschal-task-section" aria-labelledby="laschal-task-title">
      <div class="laschal-section-heading centered">
        <img class="laschal-section-mark" src={images.logo} alt="Laschal Surgical" loading="lazy" decoding="async" />
        <p class="laschal-eyebrow">Clinical workflow fit</p>
        <h2 id="laschal-task-title">Precision instruments for demanding endodontic access.</h2>
        <p>
          Use Laschal instruments where direct finger access, visibility, or force control limits the procedure. The range supports fine file handling, conservative retrieval, retreatment, and microsurgical closure.
        </p>
      </div>

      <div class="laschal-task-grid">
        {clinicalTasks.map((task, index) => (
          <a class="laschal-task-card" href={task.href} aria-label={task.ariaLabel} data-laschal-task-link>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{task.title}</h3>
            <p>{task.body}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="laschal-featured-section" id="laschal-featured" aria-labelledby="laschal-featured-title">
      <div class="laschal-section-heading centered">
        <img class="laschal-section-mark" src={images.logo} alt="Laschal Surgical" loading="lazy" decoding="async" />
        <p class="laschal-eyebrow">Featured instruments</p>
        <h2 id="laschal-featured-title">Choose by the clinical problem in front of you.</h2>
        <p>
          Start with file control, separated instrument retrieval, retreatment removal, or narrow surgical access.
        </p>
      </div>

      <div class="laschal-featured-grid">
        {featuredInstruments.map((instrument) => (
          <article class="laschal-feature-card" id={instrument.anchorId}>
            <figure>
              <img src={instrument.image} alt={instrument.title} loading="lazy" decoding="async" />
            </figure>
            <div class="laschal-feature-copy">
              <p class="laschal-card-kicker">Part number: {instrument.model}</p>
              <h3>{instrument.title}</h3>
              <dl>
                <div>
                  <dt>Clinical Problem</dt>
                  <dd>{instrument.clinicalProblem}</dd>
                </div>
                <div>
                  <dt>Laschal Solution</dt>
                  <dd>{instrument.solution}</dd>
                </div>
              </dl>
              <div class="laschal-feature-lists">
                <div>
                  <h4>Key Features</h4>
                  <ul>
                    {instrument.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4>Clinical Benefits</h4>
                  <ul>
                    {instrument.benefits.map((benefit) => (
                      <li>{benefit}</li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="laschal-card-actions">
                <a href={contactHref}>Enquire through EndoTech NZ</a>
                {instrument.videos.map((video) => (
                  <a class="video" href={video.href} target="_blank" rel="noreferrer">{video.label}</a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="laschal-focus-section" aria-labelledby="laschal-focus-title">
      <div class="laschal-focus-media">
        <img src={images.group} alt="Laschal Sonic Steel instrument group" loading="lazy" decoding="async" />
      </div>
      <div class="laschal-focus-copy">
        <img class="laschal-section-mark" src={images.logo} alt="Laschal Surgical" loading="lazy" decoding="async" />
        <p class="laschal-eyebrow">Clinical selection</p>
        <h2 id="laschal-focus-title">Select the instrument family around the procedure you are managing.</h2>
        <div class="laschal-focus-steps">
          <article>
            <span>1</span>
            <div>
              <h3>Control files in tight access.</h3>
              <p>File benders and tactile file forceps support controlled placement when microscope angle, posterior access, or finger crowding reduces direct handling.</p>
            </div>
          </article>
          <article>
            <span>2</span>
            <div>
              <h3>Retrieve separated instruments conservatively.</h3>
              <p>FXP probes and Steiglitz forceps support a staged trough-and-retrieve sequence with angled access and controlled grip.</p>
            </div>
          </article>
          <article>
            <span>3</span>
            <div>
              <h3>Extend the set for retreatment and microsurgery.</h3>
              <p>Gutta percha instruments, Raptor forceps, needle holders, micro scissors, and tissue forceps support the wider endodontic surgical workflow.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="laschal-catalog-section" id="laschal-catalog" aria-labelledby="laschal-catalog-title">
      <div class="laschal-catalog-heading">
        <div>
          <img class="laschal-section-mark" src={images.logo} alt="Laschal Surgical" loading="lazy" decoding="async" />
          <p class="laschal-eyebrow">Full endodontic range</p>
          <h2 id="laschal-catalog-title">Laschal endodontic instruments available through EndoTech NZ.</h2>
          <p>
            Browse by clinical category, then contact EndoTech NZ for suitability, availability, and ordering.
          </p>
        </div>
      </div>

      <div class="laschal-filter-bar" aria-label="Filter Laschal products by category">
        <button class="is-active" type="button" data-category-filter="all" aria-pressed="true">
          All <span>{laschalCatalogItems.length}</span>
        </button>
        {categoryCounts.map((category) => (
          <button type="button" data-category-filter={category.label} aria-pressed="false">
            {category.label} <span>{category.count}</span>
          </button>
        ))}
      </div>

      <div class="laschal-page-groups">
        {catalogGroups.map((group) => (
          <section class="laschal-page-group" id={`laschal-catalog-${slugify(group.label)}`} data-category-group>
            <div class="laschal-page-group-heading">
              <h3>{group.label}</h3>
              <span>{group.items.length} products</span>
            </div>
            <div class="laschal-catalog-grid">
              {group.items.map((item) => (
                <article
                  class="laschal-product-card"
                  data-category-card
                  data-category={item.category}
                >
                  <figure>
                    <img src={withBasePath(item.image)} alt={item.title} loading="lazy" decoding="async" />
                  </figure>
                  <div>
                    <p class="laschal-card-kicker">{item.category}</p>
                    <h4>{item.title}</h4>
                    <p class="laschal-product-sku">SKU: {item.sku}</p>
                    <span>Enquire through EndoTech NZ</span>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="laschal-cta-section" aria-labelledby="laschal-cta-title">
      <div class="laschal-cta-copy">
        <img class="laschal-section-mark on-dark" src={images.logo} alt="Laschal Surgical" loading="lazy" decoding="async" />
        <h2 id="laschal-cta-title">Talk to EndoTech NZ about Laschal instruments.</h2>
        <p>
          Tell us the procedure you are preparing for and the access challenge you want to solve. We can help identify suitable Laschal instruments and confirm availability.
        </p>
      </div>
      <div class="laschal-actions">
        <a class="laschal-button primary" href={contactHref}>Contact EndoTech NZ</a>
        <a class="laschal-button secondary on-dark" href={cataloguePdfHref} download="EndoTech-NZ-Laschal-Endodontic-Instruments-Catalogue.pdf">Download catalogue</a>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const filterButtons = Array.from(document.querySelectorAll('[data-category-filter]'));
      const cards = Array.from(document.querySelectorAll('[data-category-card]'));
      const groups = Array.from(document.querySelectorAll('[data-category-group]'));

      function applyFilter(category) {
        cards.forEach((card) => {
          const matches = category === 'all' || card.getAttribute('data-category') === category;
          card.toggleAttribute('hidden', !matches);
        });

        groups.forEach((group) => {
          const visibleCards = group.querySelectorAll('[data-category-card]:not([hidden])');
          group.toggleAttribute('hidden', visibleCards.length === 0);
        });

        filterButtons.forEach((button) => {
          const active = button.getAttribute('data-category-filter') === category;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
      }

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          applyFilter(button.getAttribute('data-category-filter') || 'all');
        });
      });

      document.querySelectorAll('[data-laschal-task-link]').forEach((link) => {
        link.addEventListener('click', (event) => {
          const href = link.getAttribute('href');
          if (!href || !href.startsWith('#')) return;

          const target = document.querySelector(href);
          if (!target) return;

          event.preventDefault();
          applyFilter('all');

          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          target.scrollIntoView({
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
            block: 'start',
          });
          history.pushState(null, '', href);
        });
      });
    })();
  </script>
</ProductLayout>

<style>
  .laschal-page {
    background: #ffffff;
    color: #111827;
  }

  .laschal-hero,
  .laschal-best-section,
  .laschal-task-section,
  .laschal-featured-section,
  .laschal-focus-section,
  .laschal-catalog-section,
  .laschal-cta-section {
    padding-left: 56px;
    padding-right: 56px;
  }

  .laschal-eyebrow,
  .laschal-card-kicker {
    margin: 0;
    color: #0b75b7;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .laschal-hero h1,
  .laschal-section-heading h2,
  .laschal-task-card h3,
  .laschal-feature-card h3,
  .laschal-feature-card h4,
  .laschal-focus-copy h2,
  .laschal-focus-copy h3,
  .laschal-catalog-heading h2,
  .laschal-page-group-heading h3,
  .laschal-product-card h4,
  .laschal-cta-copy h2 {
    margin: 0;
    color: #111827;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-weight: 600;
    letter-spacing: 0;
  }

  .laschal-hero {
    display: grid;
    justify-items: center;
    padding-top: 96px;
    padding-bottom: 84px;
    text-align: center;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(247, 249, 252, 0.88) 100%),
      #ffffff;
  }

  .laschal-hero-copy {
    display: grid;
    justify-items: center;
    max-width: 820px;
  }

  .laschal-brand-mark {
    width: min(240px, 58vw);
    max-height: 58px;
    object-fit: contain;
    margin-bottom: 18px;
  }

  .laschal-section-mark {
    display: block;
    width: min(148px, 42vw);
    height: auto;
    margin: 0 0 18px;
    border: 1px solid rgba(227, 232, 238, 0.9);
    border-radius: 8px;
    padding: 8px 10px;
    background: #ffffff;
    box-shadow: 0 10px 24px rgba(0, 55, 112, 0.06);
  }

  .laschal-section-heading.centered .laschal-section-mark,
  .laschal-cta-copy .laschal-section-mark {
    margin-left: auto;
    margin-right: auto;
  }

  .laschal-section-mark.on-dark {
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.16);
  }

  .laschal-hero h1 {
    max-width: 12.8ch;
    margin-top: 16px;
    font-size: clamp(3.1rem, 6.6vw, 5.5rem);
    line-height: 0.98;
    text-wrap: balance;
  }

  .laschal-hero-lede,
  .laschal-section-heading p,
  .laschal-task-card p,
  .laschal-feature-card dd,
  .laschal-feature-card li,
  .laschal-focus-copy p,
  .laschal-catalog-heading p,
  .laschal-product-card span,
  .laschal-cta-copy p {
    color: #404750;
    font-family: Inter, 'Segoe UI', sans-serif;
    line-height: 1.65;
  }

  .laschal-hero-lede {
    max-width: 62ch;
    margin: 20px auto 0;
    font-size: 1.02rem;
  }

  .laschal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
  }

  .laschal-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border-radius: 999px;
    padding: 0 20px;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .laschal-button:hover,
  .laschal-button:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
  }

  .laschal-button.primary {
    border: 1px solid #0b75b7;
    background: #0b75b7;
    color: #ffffff;
  }

  .laschal-button.secondary {
    border: 1px solid #b8d8ea;
    background: #ffffff;
    color: #064b78;
  }

  .laschal-button.on-dark {
    border-color: rgba(255, 255, 255, 0.34);
    background: transparent;
    color: #ffffff;
  }

  .laschal-hero-visual {
    width: min(100%, 980px);
    margin: 48px 0 0;
    padding: 26px;
    border: 1px solid #e3e8ee;
    border-radius: 16px;
    background: linear-gradient(180deg, #ffffff 0%, #f7f9fc 100%);
    box-shadow: 0 18px 44px rgba(16, 32, 51, 0.08);
  }

  .laschal-hero-visual img {
    width: 100%;
    max-height: 430px;
    object-fit: contain;
  }

  .laschal-proof-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: min(100%, 920px);
    margin-top: 28px;
    border: 1px solid #e3e8ee;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    overflow: hidden;
  }

  .laschal-proof-strip a {
    display: grid;
    place-items: center;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 42px;
    padding: 0 12px;
    color: #24364a;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.78rem;
    font-weight: 650;
    text-decoration: none;
    border-right: 1px solid #e3e8ee;
    background: #ffffff;
    transition:
      color 180ms ease,
      background-color 220ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 240ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .laschal-proof-strip a::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 18% 20%, rgba(0, 119, 200, 0.14), rgba(0, 119, 200, 0) 32%),
      radial-gradient(circle at 82% 18%, rgba(0, 156, 220, 0.1), rgba(0, 156, 220, 0) 34%),
      linear-gradient(115deg, #ffffff 0%, #f6fbff 30%, #eaf5ff 48%, #ffffff 68%, #f4f9ff 100%);
    background-size:
      180% 180%,
      180% 180%,
      340% 340%;
    background-position:
      0% 45%,
      100% 50%,
      0% 50%;
    opacity: 0;
    animation: laschal-soft-gradient-drift 16s ease-in-out infinite;
    transition: opacity 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .laschal-proof-strip a:last-child {
    border-right: 0;
  }

  .laschal-proof-strip a:hover,
  .laschal-proof-strip a:focus-visible {
    color: #0b4f7a;
    box-shadow:
      inset 0 0 0 1px rgba(22, 71, 217, 0.08),
      0 8px 18px rgba(0, 99, 156, 0.08);
    outline: none;
    transform: translateY(-1px);
  }

  .laschal-proof-strip a:hover::before,
  .laschal-proof-strip a:focus-visible::before {
    opacity: 0.92;
  }

  .laschal-proof-strip a:focus-visible {
    box-shadow:
      inset 0 0 0 1px rgba(22, 71, 217, 0.22),
      0 0 0 3px rgba(22, 71, 217, 0.12),
      0 8px 18px rgba(0, 99, 156, 0.08);
  }

  .laschal-proof-strip a:active {
    transform: translateY(1px) scale(0.997);
    box-shadow:
      inset 0 0 0 1px rgba(22, 71, 217, 0.1),
      0 4px 10px rgba(0, 99, 156, 0.08);
  }

  .laschal-task-section,
  .laschal-featured-section,
  .laschal-focus-section,
  .laschal-catalog-section {
    border-top: 1px solid #e3e8ee;
    padding-top: 82px;
    padding-bottom: 82px;
  }

  .laschal-section-heading {
    max-width: 780px;
    margin: 0 0 38px;
  }

  .laschal-section-heading.centered {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .laschal-section-heading h2,
  .laschal-focus-copy h2,
  .laschal-catalog-heading h2,
  .laschal-cta-copy h2 {
    font-size: clamp(2.05rem, 4.4vw, 3.35rem);
    line-height: 1.05;
  }

  .laschal-section-heading h2 {
    margin-top: 14px;
  }

  .laschal-section-heading p,
  .laschal-catalog-heading p {
    margin: 16px 0 0;
    font-size: 0.98rem;
  }

  .laschal-task-grid,
  .laschal-featured-grid,
  .laschal-focus-section,
  .laschal-catalog-section {
    max-width: 1280px;
    margin: 0 auto;
