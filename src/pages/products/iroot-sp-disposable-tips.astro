---
import ProductLayout from '../../layouts/ProductLayout.astro';
import '../../styles/iroot-tips.css';
const productName = 'iRoot SP Disposable Tips';
---

<ProductLayout title={`${productName} · Coming soon | EndoTech NZ`} image="/images/iroot-sp-tip-engineering-30g-4pct.png" description="Coming soon to EndoTech NZ. Explore the irrigation needle, pack and case in interactive 3D.">
  <article class="vf-preview">
  <section class="vf-intro vf-shell" aria-labelledby="product-title">
    <a class="vf-back" href="/products/overview/">Systems <span aria-hidden="true">/</span> Irrigation</a>
    <div class="vf-title-row">
      <div>
        <span class="vf-soon"><span aria-hidden="true"></span>Coming soon</span>
        <h1 id="product-title">iRoot SP<span>Disposable Tips</span></h1>
      </div>
      <p class="vf-intro-copy">A closer look at the pack, case and needle tip.<br />Drag the models to explore them in 3D.</p>
    </div>
  </section>

  <section class="vf-models vf-shell" aria-label="Interactive 3D product views">
    <article class="vf-model-card vf-kit-card">
      <div class="vf-card-top"><h2>Pack &amp; case</h2><span class="vf-3d-label">Interactive 3D</span></div>
      <iframe src="/models/iroot-sp-disposable-tips/preview/?view=3" title="Interactive 3D pack and clear case" class="vf-viewer" loading="eager"></iframe>
      <div class="vf-card-bottom"><span>Rotate the case or open a tray.</span><a href="/models/iroot-sp-disposable-tips/preview/?view=3" target="_blank" rel="noopener" aria-label="Open the pack and case 3D view in a new tab">Larger view <span aria-hidden="true">↗</span></a></div>
    </article>
    <article class="vf-model-card vf-tip-card">
      <div class="vf-card-top"><h2>Needle &amp; tip</h2><span class="vf-3d-label">Interactive 3D</span></div>
      <iframe src="/models/iroot-sp-disposable-tips/preview/?view=5" title="Interactive 3D irrigation needle and tip" class="vf-viewer" loading="eager"></iframe>
      <div class="vf-card-bottom"><span>Turn the needle. Inspect the outlets.</span><a href="/models/iroot-sp-disposable-tips/preview/?view=5" target="_blank" rel="noopener" aria-label="Open the needle and tip 3D view in a new tab">Larger view <span aria-hidden="true">↗</span></a></div>
    </article>
  </section>

  <section class="vf-details vf-shell" aria-labelledby="details-title">
    <div class="vf-section-heading"><div><p class="vf-eyebrow">A closer look</p><h2 id="details-title">Needle design</h2></div><p>The engineering image and tip views.</p></div>
    <figure class="vf-engineering"><img src="/images/iroot-sp-tip-engineering-30g-4pct.png" width="1678" height="937" alt="iRoot SP Disposable Tips engineering illustration labelled Tip: 30 Gauge and Taper: 4%" loading="lazy" /></figure>
    <section class="vf-tip-scroll" aria-labelledby="tip-closeup-title" data-tip-scroll>
      <div class="vf-tip-details vf-tip-details--3d" data-tip-card>
        <div class="vf-tip-copy">
          <p class="vf-eyebrow">Tip geometry</p>
          <h3 id="tip-closeup-title">The needle tip,<br /> in 3D.</h3>
          <p data-tip-instructions>Hover to turn the tip. Scroll past for a full 360° view.</p>
          <div class="vf-tip-specs"><span>30 gauge</span><span>4% taper</span></div>
        </div>
        <div class="vf-tip-closeup" data-tip-closeup>
          <img class="vf-tip-fallback" src="/images/vortiflow-cad-tip-render-1.jpg" width="600" height="600" alt="Black CAD close-up of the rounded needle tip and lateral outlet" />
          <span class="vf-tip-loading" role="status">Loading 3D tip…</span>
          <div class="vf-tip-caption"><span data-tip-caption>Hover or scroll to rotate</span><span aria-hidden="true">360°</span></div>
          <div class="vf-tip-progress" aria-hidden="true"><span data-tip-progress></span></div>
        </div>
      </div>
    </section>
  </section>

  <section class="vf-contact vf-shell" aria-label="Coming soon enquiries">
    <div><span class="vf-soon"><span aria-hidden="true"></span>Coming soon</span><h2>Irrigation needles for EndoTech NZ.</h2></div>
    <a class="vf-contact-link" href="/about/contact/">Enquire about availability <span aria-hidden="true">↗</span></a>
  </section>
  </article>
</ProductLayout>

<script>
  import '../../scripts/iroot-tip-closeup.js';
</script>
