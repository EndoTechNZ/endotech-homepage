---
import ProductLayout from '../../layouts/ProductLayout.astro';
import { withBasePath } from '../../utils/paths';

const assets = withBasePath('/models/iroot-sp-disposable-tips/');
const viewer = `${assets}viewer/`;
const contact = withBasePath('/about/contact/');
const title = 'iRoot SP Disposable Tips | Interactive Product Model | EndoTech NZ';
const description = 'Explore the iRoot SP Disposable Tips organizer in 3D. Rotate the transparent case, inspect a single tip and view all five layers of 20 tips.';
---

<ProductLayout title={title} description={description} image={`${assets}photos/standing.webp`} accent="teal">
  <article class="tips-page">
    <section class="tips-hero" aria-labelledby="tips-title">
      <p class="tips-eyebrow">iRoot SP · Disposable delivery tips</p>
      <h1 id="tips-title">iRoot SP<br /><span>Disposable Tips.</span></h1>
      <p class="tips-intro">A closer look at every layer.</p>
      <p class="tips-lede">Explore the clear organizer from every angle. Look through the case, open a circular tray, or inspect an individual tip.</p>
      <div class="tips-actions">
        <a class="tips-button tips-primary" href="#interactive-model">Explore in 3D <span aria-hidden="true">↗</span></a>
        <a class="tips-button" href={contact}>Enquire about this product</a>
      </div>
    </section>

    <section id="interactive-model" class="tips-model-section" aria-labelledby="model-title">
      <div class="tips-model-heading">
        <div><p class="tips-eyebrow">Interactive product model</p><h2 id="model-title">Turn it. Open it. See inside.</h2></div>
        <a href={viewer} target="_blank" rel="noopener">Open full viewer <span aria-hidden="true">↗</span></a>
      </div>
      <div class="tips-model" data-tip-viewer data-src={viewer}>
        <div class="tips-poster" data-viewer-poster>
          <img src={`${assets}photos/standing.webp`} alt="Transparent circular iRoot SP Disposable Tips organizer with five stacked trays and its original top label" width="1440" height="810" fetchpriority="high" />
          <button class="tips-launch" type="button" data-load-viewer><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 8.4 12.2M12 3l-3 3m3-3 3 3M8 12l4-2 4 2v4l-4 2-4-2z" /></svg>Explore the 3D model</button>
        </div>
        <p class="tips-viewer-status" data-viewer-status role="status" hidden></p>
      </div>
      <p class="tips-caption">Drag to rotate · Scroll or pinch to zoom · Choose a tray or the single-tip view. Static product views are also available below.</p>
      <dl class="tips-specs">
        <div><dt>100</dt><dd>individual tips</dd></div>
        <div><dt>5 × 20</dt><dd>circular arrangement</dd></div>
        <div><dt>150 × 75 <span>mm</span></dt><dd>diameter × height</dd></div>
      </dl>
    </section>

    <section class="tips-detail" aria-labelledby="detail-title">
      <figure><img src={`${assets}photos/single-tip.webp`} alt="Close view of a translucent disposable tip with a winged connector, short elbow and long tapered nozzle" width="1500" height="850" loading="lazy" /><figcaption>Individual tip · enlarged view</figcaption></figure>
      <div class="tips-detail-copy"><p class="tips-eyebrow">The details, in view</p><h2 id="detail-title">One tip.<br /> Every detail.</h2><p>A flared connector, two grip wings, a short elbow and a straight tapered nozzle. The translucent material lets you inspect the shape from all sides.</p>
        <ul><li>Rotate freely through 360°</li><li>Isolate any of the five circular layers</li><li>Adjust case and tip visibility</li><li>Inspect the top and underside labels</li></ul>
      </div>
    </section>

    <section class="tips-gallery" aria-labelledby="gallery-title">
      <div class="tips-section-heading"><p class="tips-eyebrow">Product views</p><h2 id="gallery-title">The complete picture.</h2></div>
      <div class="tips-gallery-grid">
        <figure><a href={`${assets}photos/overhead.webp`} target="_blank" rel="noopener"><img src={`${assets}photos/overhead.webp`} alt="Near overhead view of the complete organizer with the top label and a clear border around it" width="810" height="1440" loading="lazy" /></a><figcaption>Top label & clear border</figcaption></figure>
        <figure><a href={`${assets}photos/side.webp`} target="_blank" rel="noopener"><img src={`${assets}photos/side.webp`} alt="Organizer resting on its side, revealing five separate layers of tips" width="810" height="1440" loading="lazy" /></a><figcaption>Five stacked layers</figcaption></figure>
        <figure><a href={`${assets}photos/open-tray.webp`} target="_blank" rel="noopener"><img src={`${assets}photos/open-tray.webp`} alt="Open circular tray with all twenty disposable tips in place" width="1200" height="1200" loading="lazy" /></a><figcaption>20 tips in each tray</figcaption></figure>
      </div>
    </section>

    <section class="tips-context" aria-labelledby="context-title">
      <div data-clinical-problem><p class="tips-eyebrow">Clinical context</p><h2 id="context-title">From preparation to sealing.</h2><p>Tip selection is part of the final sealing setup. Refer to the product instructions for intended use and compatibility.</p></div>
      <div data-transformx-solution><h3>The EndoTech workflow</h3><p>Explore the <a href={withBasePath('/products/overview/')}><span class="tips-nowrap">Transform S™</span> preparation systems</a> and the <a href={withBasePath('/products/bcs/')}>bioceramic sealing range</a> for the preceding and final treatment stages.</p><p class="tips-model-note">This photographic reconstruction shows the pack layout and tip form. Fine dimensions are estimated from the supplied references.</p></div>
    </section>
    <section class="tips-cta"><div><p class="tips-eyebrow">iRoot SP Disposable Tips</p><h2>Let’s talk about your setup.</h2></div><a class="tips-button" href={contact}>Contact EndoTech NZ <span aria-hidden="true">↗</span></a></section>
  </article>
  <script>
    const host = document.querySelector<HTMLElement>('[data-tip-viewer]');
    const launch = host?.querySelector<HTMLButtonElement>('[data-load-viewer]');
    const status = host?.querySelector<HTMLElement>('[data-viewer-status]');
    let frame: HTMLIFrameElement | null = null;
    launch?.addEventListener('click', () => {
      if (!host || frame) return;
      frame = document.createElement('iframe');
      frame.title = 'Interactive iRoot SP Disposable Tips product model';
      frame.src = host.dataset.src || '';
      frame.allow = 'fullscreen';
      frame.setAttribute('allowfullscreen', '');
      frame.style.height = '850px';
      frame.addEventListener('load', () => {
        host.querySelector('[data-viewer-poster]')?.setAttribute('hidden', '');
        if (status) status.hidden = true;
        frame?.focus({ preventScroll: true });
      });
      if (status) { status.hidden = false; status.textContent = 'Opening the interactive model…'; }
      host.append(frame);
    });
    window.addEventListener('message', event => {
      if (event.origin !== location.origin || event.source !== frame?.contentWindow || event.data?.type !== 'iroot-viewer-size') return;
      const height = Number(event.data.height);
      if (Number.isFinite(height) && frame) frame.style.height = `${Math.max(600, Math.min(2400, Math.ceil(height)))}px`;
    });
  </script>
</ProductLayout>

<style>
  .tips-page{--tips-ink:#183344;--tips-muted:#617482;--tips-line:#dce5e9;color:var(--tips-ink);font-family:Inter,"Segoe UI",sans-serif;background:#fff}.tips-page *{box-sizing:border-box}.tips-page h1,.tips-page h2,.tips-page h3,.tips-page p,.tips-page figure{margin:0}.tips-eyebrow{font-size:11px!important;line-height:1.5!important;font-weight:650;letter-spacing:.15em;text-transform:uppercase;color:#4d7d7e}.tips-hero{text-align:center;padding:72px 24px 56px;max-width:900px;margin:auto}.tips-hero h1{font-size:clamp(42px,5.1vw,72px);line-height:1.04;font-weight:550;letter-spacing:-.055em;margin:20px 0}.tips-hero h1 span{color:#7a999a}.tips-intro{font-size:23px;font-weight:450;letter-spacing:-.02em}.tips-lede{max-width:560px;margin:14px auto 0!important;font-size:16px;line-height:1.7;color:var(--tips-muted)}.tips-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin-top:28px}.tips-button{display:inline-flex;align-items:center;justify-content:center;gap:20px;min-height:48px;padding:12px 22px;border:1px solid var(--tips-line);border-radius:30px;text-decoration:none;font-size:14px;font-weight:600;color:var(--tips-ink);background:#fff}.tips-primary{background:#0b75b7;color:#fff;border-color:#0b75b7}.tips-button:hover{border-color:#0b75b7;box-shadow:0 2px 8px #1733440b}.tips-page :focus-visible{outline:3px solid #0b75b7;outline-offset:5px}.tips-model-section{max-width:1280px;padding:0 32px;margin:auto;scroll-margin-top:140px}.tips-model-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}.tips-model-heading h2{font-size:26px;font-weight:550;letter-spacing:-.035em;margin-top:7px}.tips-model-heading>a{font-size:13px;color:#335e72;text-decoration:none;white-space:nowrap}.tips-model{border:1px solid #d4dfe4;border-radius:16px;overflow:hidden;background:#172c36;position:relative}.tips-poster{position:relative}.tips-poster img{width:100%;height:auto;max-height:650px;object-fit:contain;display:block;background:#172c36}.tips-launch{position:absolute;left:50%;bottom:30px;transform:translateX(-50%);display:flex;align-items:center;justify-content:center;gap:12px;min-height:50px;white-space:nowrap;padding:13px 24px;border:1px solid #b4ced1;border-radius:30px;background:#fffffff0;color:#173344;box-shadow:0 8px 32px #0c273433;font:600 14px Inter,"Segoe UI",sans-serif;cursor:pointer}.tips-launch svg{width:23px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.tips-model :global(iframe){width:100%;border:0;display:block;background:#111f28}.tips-viewer-status{padding:18px;text-align:center;color:#fff;font-size:14px}.tips-caption{margin:14px 0 0!important;color:var(--tips-muted);font-size:12px;line-height:1.65}.tips-specs{display:grid;grid-template-columns:repeat(3,1fr);margin:32px 0 0;border-block:1px solid var(--tips-line);padding:28px 0}.tips-specs>div{text-align:center;border-left:1px solid var(--tips-line)}.tips-specs>div:first-child{border:0}.tips-specs dt{font-size:32px;letter-spacing:-.045em;font-weight:500;line-height:1.3}.tips-specs dt span{font-size:18px}.tips-specs dd{margin:5px 0 0;color:var(--tips-muted);font-size:12px}.tips-detail{max-width:1280px;margin:88px auto;display:grid;grid-template-columns:1.15fr 1fr;gap:64px;padding:0 32px;align-items:center}.tips-detail figure{background:#1c303b;border-radius:16px;overflow:hidden}.tips-detail figure img{width:100%;display:block;aspect-ratio:1.3;object-fit:contain}.tips-detail figcaption{font-size:12px;color:#c2d4dc;padding:0 24px 22px}.tips-detail-copy h2{font-size:clamp(34px,3.6vw,48px);font-weight:500;line-height:1.08;letter-spacing:-.045em;margin:16px 0 22px}.tips-detail-copy>p:not(.tips-eyebrow){color:var(--tips-muted);font-size:15px;line-height:1.75;max-width:430px}.tips-detail ul{padding:0;margin:24px 0 0;list-style:none;max-width:430px}.tips-detail li{border-top:1px solid var(--tips-line);padding:12px 0;font-size:14px}.tips-detail li:before{content:'+';color:#5c8f90;margin-right:16px}.tips-gallery{background:#f5f8f9;padding:64px 32px}.tips-section-heading{max-width:1216px;margin:auto}.tips-section-heading h2{font-size:36px;letter-spacing:-.04em;font-weight:500;margin-top:12px}.tips-gallery-grid{max-width:1216px;margin:28px auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.tips-gallery figure{border:1px solid #dce5e9;border-radius:12px;overflow:hidden;background:#fff}.tips-gallery img{display:block;width:100%;height:300px;object-fit:contain;background:#1d303b}.tips-gallery figcaption{font-size:13px;padding:18px 20px}.tips-context{max-width:1280px;padding:72px 32px;display:grid;grid-template-columns:1fr 1fr;gap:72px;margin:auto}.tips-context h2{font-size:30px;font-weight:500;letter-spacing:-.03em;margin:12px 0 18px}.tips-context h3{font-size:18px;font-weight:600;margin-bottom:14px}.tips-context p:not(.tips-eyebrow){font-size:14px;line-height:1.8;color:var(--tips-muted)}.tips-context a{color:#0b75b7}.tips-model-note{margin-top:16px!important;font-size:12px!important}.tips-nowrap{white-space:nowrap}.tips-cta{display:flex;align-items:center;justify-content:space-between;gap:24px;background:#eff5f5;border-block:1px solid #dce5e9;padding:48px max(32px,calc((100vw - 1216px)/2));}.tips-cta h2{font-size:30px;font-weight:500;letter-spacing:-.03em;margin-top:10px}.tips-page [hidden]{display:none!important}
  @media(max-width:800px){.tips-hero{padding:48px 24px}.tips-detail{gap:32px;margin:64px auto}.tips-detail-copy h2{font-size:36px}.tips-gallery img{height:230px}.tips-context{gap:32px}.tips-cta h2{font-size:26px}}
  @media(max-width:540px){.tips-hero{padding:40px 20px}.tips-hero h1{font-size:44px}.tips-intro{font-size:21px}.tips-lede{font-size:14px}.tips-actions{gap:10px}.tips-button{font-size:13px;padding:12px 20px}.tips-model-section{padding:0 16px}.tips-model-heading{align-items:start;flex-direction:column;gap:12px}.tips-model-heading h2{font-size:24px}.tips-poster img{aspect-ratio:1.05;object-fit:contain}.tips-launch{bottom:18px;font-size:13px;padding:12px 18px;gap:8px}.tips-caption{font-size:11px}.tips-specs{padding:22px 0;margin-top:24px;gap:5px}.tips-specs dt{font-size:23px}.tips-specs dt span{font-size:13px}.tips-specs dd{font-size:10px;line-height:1.5}.tips-detail{grid-template-columns:1fr;gap:28px;margin:48px auto;padding:0 16px}.tips-detail figure img{aspect-ratio:1.65}.tips-detail-copy{padding:0 8px}.tips-detail-copy h2 br{display:none}.tips-gallery{padding:40px 16px}.tips-section-heading h2{font-size:30px}.tips-gallery-grid{grid-template-columns:1fr;gap:16px}.tips-gallery img{height:300px}.tips-context{grid-template-columns:1fr;padding:48px 24px;gap:28px}.tips-cta{align-items:start;flex-direction:column;padding:36px 24px}.tips-cta h2{font-size:26px}}
</style>
