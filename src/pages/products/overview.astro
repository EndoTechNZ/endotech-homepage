---
import ProductLayout from '../../layouts/ProductLayout.astro';
import etProduct from '../../assets/et-transformx.png';
import ptProduct from '../../assets/pt-transformx.png';
import acrobatProduct from '../../assets/acrobat-glide-path-files.png';
import bcsSealer from '../../assets/bcs-sealer.png';
import vortiflowFlow from '../../assets/vortiflow/vortiflow-fluid-dynamics-clean.png';

const base = import.meta.env.BASE_URL;

const systems = [
  {
    eyebrow: 'Rotary shaping system',
    title: 'TransformX™ ET',
    description:
      'ET-style shaping for clinicians who want familiar .04/.06 sequence logic and a clear apical sequence, positioned as a replacement for EdgeFile X7, HyFlex CM, FKG RACE EVO / RaCe, MicroMega, Komet FQ, and HERO systems.',
    href: `${base}products/et-transformx/`,
    image: etProduct.src,
    alt: 'TransformX™ ET rotary files',
  },
  {
    eyebrow: 'Rotary shaping system',
    title: 'TransformX™ PT',
    description:
      'PT-style shaping for clinicians preserving progressive crown-down sequence logic through more demanding anatomy, positioned as a replacement for ProTaper, ProTaper Gold, and ProTaper Next.',
    href: `${base}products/pt-transformx/`,
    image: ptProduct.src,
    alt: 'TransformX™ PT rotary file system',
  },
  {
    eyebrow: 'Glide path',
    title: 'Acrobat',
    description:
      'Rotary glide path files positioned before shaping to establish a clearer route through curved or demanding canals.',
    href: `${base}products/acrobat-glide-path/`,
    image: acrobatProduct.src,
    alt: 'Acrobat glide path files',
  },
  {
    eyebrow: 'Irrigation',
    title: 'VortiFlow',
    description:
      'Irrigation support engineered around controlled fluid behaviour after shaping and before final sealing.',
    href: `${base}products/vortiflow-irrigation-needle/`,
    image: vortiflowFlow.src,
    alt: 'VortiFlow irrigation support image',
  },
];

const workflowSteps = [
  {
    title: 'Glide',
    description: 'Create a path that respects anatomy before the shaping system carries more load.',
  },
  {
    title: 'Shape',
    description: 'Use ET or PT sequence logic according to the preparation style you already trust.',
  },
  {
    title: 'Clean 3D',
    description: 'Support irrigant exchange once preparation geometry is established.',
  },
  {
    title: 'Seal',
    description: 'Move directly into the BCS / iRoot bioceramic pathway for final sealing.',
  },
];

const compareRows = [
  {
    feature: 'Primary shaping path',
    et: 'ET-style .04 / .06 sequence logic',
    pt: 'PT-style progressive shaping logic',
    support: 'BCS family completes the sealing stage',
  },
  {
    feature: 'Best fit',
    et: 'Clinicians preserving ET-style habits',
    pt: 'Clinicians preserving ProTaper-style habits',
    support: 'Practices building a matched shaping-to-sealing system',
  },
  {
    feature: 'Workflow role',
    et: 'Shape',
    pt: 'Shape',
    support: 'Seal',
  },
  {
    feature: 'Open next',
    et: 'TransformX™ ET page',
    pt: 'TransformX™ PT page',
    support: 'BCS family page',
  },
];
---

<ProductLayout
  title="Product Systems | EndoTech NZ"
  description="Review the EndoTech NZ product system from glide path to shaping, irrigation, and bioceramic sealing."
  image={etProduct.src}
  accent="teal"
>
  <main class="overview-stitch-page">
    <section class="overview-hero" aria-labelledby="overview-hero-title">
      <div class="overview-hero-copy">
        <div class="overview-product-systems-reveal-mask">
          <p class="overview-product-systems-reveal-text js-overview-product-systems-reveal">
            Product Systems
          </p>
        </div>
        <h1 id="overview-hero-title">A clinical system from glide path to final seal.</h1>
        <p class="overview-hero-lede">
          Review the EndoTech NZ product architecture first, then move into the shaping system, glide path, irrigation, or bioceramic pathway that fits the case.
        </p>
      </div>

      <figure class="overview-hero-visual">
        <img src={etProduct.src} alt="TransformX™ ET and PT product imagery presented as the core shaping system" />
      </figure>

      <div class="overview-hero-actions">
        <a class="overview-button primary" href={`${base}products/et-transformx/`}>View TransformX™ ET</a>
        <a class="overview-button secondary" href={`${base}products/pt-transformx/`}>View TransformX™ PT</a>
      </div>
    </section>

    <section class="overview-systems-section" aria-labelledby="overview-systems-title">
      <div class="overview-section-heading">
        <p class="overview-eyebrow">Rotary shaping systems</p>
        <h2 id="overview-systems-title">TransformX™ ET and PT form the core shaping pathways.</h2>
      </div>

      <div class="overview-systems-grid">
        {systems.slice(0, 2).map((system) => (
          <article class="overview-system-card">
            <figure>
              <img src={system.image} alt={system.alt} />
            </figure>
            <div>
              <span>{system.eyebrow}</span>
              <h3>{system.title}</h3>
              <p>{system.description}</p>
              <a href={system.href}>View product page</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="overview-supporting-systems" aria-labelledby="overview-supporting-title">
      <div class="overview-section-heading">
        <p class="overview-eyebrow">Supporting systems</p>
        <h2 id="overview-supporting-title">Glide path, irrigation, and bioceramics complete the workflow.</h2>
      </div>

      <div class="overview-support-grid">
        <article class="overview-support-card">
          <figure>
            <img src={acrobatProduct.src} alt="Acrobat glide path files" />
          </figure>
          <div>
            <span>Glide path</span>
            <h3>Acrobat</h3>
            <p>
              Establish a reproducible route before shaping becomes more demanding.
            </p>
            <a href={`${base}products/acrobat-glide-path/`}>View Acrobat</a>
          </div>
        </article>

        <article class="overview-support-card">
          <figure>
            <img src={vortiflowFlow.src} alt="VortiFlow fluid dynamics image" />
          </figure>
          <div>
            <span>Irrigation</span>
            <h3>VortiFlow</h3>
            <p>
              Support cleaner irrigant exchange once preparation geometry is established.
            </p>
            <a href={`${base}products/vortiflow-irrigation-needle/`}>View VortiFlow</a>
          </div>
        </article>

        <article class="overview-support-card overview-support-card-wide">
          <div class="overview-support-copy">
            <p class="overview-eyebrow">Bioceramics</p>
            <h3>BCS / iRoot</h3>
            <p>
              Complete the pathway with a premixed bioceramic family designed for final sealing and repair after shaping and irrigation decisions are made.
            </p>
            <a class="overview-button dark" href={`${base}products/bcs/`}>View BCS Family</a>
          </div>
          <figure>
            <img src={bcsSealer.src} alt="BCS BioCeramic sealer packaging" />
          </figure>
        </article>
      </div>
    </section>

    <section class="overview-workflow-section" aria-labelledby="overview-workflow-title">
      <div class="overview-workflow-media">
        <img src={vortiflowFlow.src} alt="Workflow support visual linking shaping, cleaning, and sealing" />
      </div>

      <div class="overview-workflow-copy">
        <p class="overview-eyebrow">Workflow connection</p>
        <h2 id="overview-workflow-title">Glide to shape, clean 3D, then seal.</h2>
        <div class="overview-workflow-steps">
          {workflowSteps.map((step, index) => (
            <article>
              <span>{String(index + 1)}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="overview-comparison-section" aria-labelledby="overview-comparison-title">
      <div class="overview-comparison-heading">
        <h2 id="overview-comparison-title">System comparison</h2>
        <p>Use the overview page to decide which product path to open next.</p>
      </div>

      <div class="overview-table-shell">
        <table class="overview-comparison-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>TransformX™ ET</th>
              <th>TransformX™ PT</th>
              <th>BCS / iRoot</th>
            </tr>
          </thead>
          <tbody>
            {compareRows.map((row) => (
              <tr>
                <th>{row.feature}</th>
                <td>{row.et}</td>
                <td>{row.pt}</td>
                <td>{row.support}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="overview-cta-section" aria-labelledby="overview-cta-title">
      <div class="overview-cta-copy">
        <h2 id="overview-cta-title">Move from system review into product detail.</h2>
        <p>
          Start with the shaping path that matches your workflow, then move into Acrobat, VortiFlow, or the BCS family as the case demands.
        </p>
      </div>
      <div class="overview-cta-actions">
        <a class="overview-button primary" href={`${base}order/`}>Order Products</a>
        <a class="overview-button secondary on-dark" href={`${base}about/contact/`}>Contact EndoTech NZ</a>
      </div>
    </section>
  </main>
</ProductLayout>

<script>
  const overviewProductSystemsMask = document.querySelector('.overview-product-systems-reveal-mask');
  const overviewProductSystemsText = document.querySelector('.js-overview-product-systems-reveal');

  if (overviewProductSystemsMask && overviewProductSystemsText) {
    const originalText = 'Product Systems';

    overviewProductSystemsText.setAttribute('aria-label', originalText);
    overviewProductSystemsText.innerHTML = Array.from(originalText)
      .map((char, index) => {
        const safeChar = char === ' ' ? '&nbsp;' : char;
        return `<span class="overview-product-systems-reveal-char" aria-hidden="true" style="--char-index:${index}">${safeChar}</span>`;
      })
      .join('');

    const overviewProductSystemsObserver = new IntersectionObserver(
      (entries, observerInstance) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            window.setTimeout(() => {
              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  overviewProductSystemsMask.classList.add('is-visible');
                });
              });
            }, 180);

            observerInstance.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        threshold: 0.2,
      }
    );

    overviewProductSystemsObserver.observe(overviewProductSystemsMask);
  }
</script>

<style>
  .overview-stitch-page {
    background: #ffffff;
    color: #181c20;
  }

  .overview-hero,
  .overview-systems-section,
  .overview-supporting-systems,
  .overview-workflow-section,
  .overview-comparison-section,
  .overview-cta-section {
    padding-left: 56px;
    padding-right: 56px;
  }

  .overview-eyebrow {
    margin: 0 0 14px;
    color: #00639c;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .overview-hero h1,
  .overview-section-heading h2,
  .overview-system-card h3,
  .overview-support-card h3,
  .overview-workflow-copy h2,
  .overview-workflow-copy h3,
  .overview-comparison-heading h2,
  .overview-cta-copy h2 {
    margin: 0;
    color: #181c20;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .overview-hero {
    display: grid;
    justify-items: center;
    padding-top: 96px;
    padding-bottom: 80px;
    text-align: center;
    background: #ffffff;
  }

  .overview-hero-copy {
    max-width: 720px;
  }

  .overview-product-systems-reveal-mask {
    display: block;
    overflow: hidden;
    text-align: center;
    padding: 0 0 14px;
    min-height: 24px;
  }

  .overview-product-systems-reveal-text {
    margin: 0;
    color: #00639c;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
  }

  :global(.overview-product-systems-reveal-char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(5px);
    filter: blur(1.5px);
    transition:
      opacity 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--char-index) * 12ms);
    will-change: opacity, transform, filter;
  }

  :global(.overview-product-systems-reveal-mask.is-visible .overview-product-systems-reveal-char) {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .overview-hero h1 {
    max-width: 12ch;
    font-size: clamp(3rem, 5.4vw, 4.7rem);
    line-height: 0.96;
    text-wrap: balance;
  }

  .overview-hero-lede,
  .overview-section-heading p,
  .overview-system-card p,
  .overview-support-card p,
  .overview-workflow-copy p,
  .overview-comparison-heading p,
  .overview-cta-copy p {
    color: #404750;
    font-family: Inter, 'Segoe UI', sans-serif;
    line-height: 1.65;
  }

  .overview-hero-lede {
    max-width: 54ch;
    margin: 18px auto 0;
    font-size: 1rem;
  }

  .overview-hero-visual {
    width: 100%;
    max-width: 860px;
    margin: 36px 0 0;
  }

  .overview-hero-visual img {
    width: 100%;
    max-height: 500px;
    object-fit: contain;
  }

  .overview-hero-actions,
  .overview-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-top: 28px;
  }

  .overview-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border-radius: 6px;
    padding: 0 18px;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      color 180ms ease,
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .overview-button:hover,
  .overview-button:focus-visible {
    transform: translateY(-1px);
    box-shadow:
      0 12px 24px rgba(15, 23, 42, 0.08),
      0 2px 6px rgba(15, 23, 42, 0.05);
  }

  .overview-button.primary {
    background: #005c92;
    border: 1px solid #005c92;
    color: #ffffff;
  }

  .overview-button.primary:hover,
  .overview-button.primary:focus-visible {
    background: #0a6ca8;
    border-color: #0a6ca8;
    color: #ffffff;
  }

  .overview-button.secondary {
    background: #ffffff;
    border: 1px solid #c0c7d2;
    color: #404750;
  }

  .overview-button.secondary:hover,
  .overview-button.secondary:focus-visible {
    background: #f8fbfd;
    border-color: #aeb8c5;
    color: #1f2937;
  }

  .overview-button.dark {
    background: #181c20;
    border: 1px solid #181c20;
    color: #ffffff;
  }

  .overview-button.dark:hover,
  .overview-button.dark:focus-visible {
    background: #111827;
    border-color: #111827;
    color: #ffffff;
  }

  .overview-button.on-dark,
  .overview-button.secondary.on-dark {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }

  .overview-button.on-dark:hover,
  .overview-button.on-dark:focus-visible,
  .overview-button.secondary.on-dark:hover,
  .overview-button.secondary.on-dark:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.42);
    color: #ffffff;
  }

  .overview-systems-section,
  .overview-supporting-systems,
  .overview-workflow-section,
  .overview-comparison-section {
    padding-top: 80px;
    padding-bottom: 80px;
    border-top: 1px solid #e3e8ee;
  }

  .overview-comparison-section {
    padding-top: 84px;
    padding-bottom: 84px;
    background: #f7f9ff;
  }

  .overview-section-heading {
    max-width: 860px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .overview-section-heading h2,
  .overview-workflow-copy h2,
  .overview-comparison-heading h2,
  .overview-cta-copy h2 {
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1.05;
  }

  .overview-systems-grid,
  .overview-support-grid,
  .overview-workflow-section {
    max-width: 1280px;
    margin: 0 auto;
  }

  .overview-systems-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .overview-system-card,
  .overview-support-card {
    display: grid;
    gap: 22px;
    align-content: start;
    min-height: 100%;
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    padding: 24px;
    background: #ffffff;
    box-shadow: 0 1px 3px rgba(0, 55, 112, 0.06);
  }

  .overview-system-card figure,
  .overview-support-card figure {
    display: grid;
    place-items: center;
    min-height: 220px;
    margin: 0;
    padding: 22px;
    border-radius: 8px;
    background: #f4f6fb;
  }

  .overview-system-card img,
  .overview-support-card img {
    width: 100%;
    max-height: 182px;
    object-fit: contain;
  }

  .overview-system-card span,
  .overview-support-card span {
    display: block;
    margin-bottom: 12px;
    color: #707881;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .overview-system-card h3,
  .overview-support-card h3 {
    font-size: 1.28rem;
    line-height: 1.16;
  }

  .overview-system-card p,
  .overview-support-card p {
    margin: 14px 0 0;
    font-size: 0.94rem;
  }

  .overview-system-card a,
  .overview-support-card a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    margin-top: 18px;
    border: 1px solid #bfd3e0;
    border-radius: 999px;
    padding: 0 16px;
    background: linear-gradient(180deg, #ffffff 0%, #f3f8fc 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 1px 2px rgba(15, 23, 42, 0.04);
    color: #005c92;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      color 180ms ease,
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .overview-system-card a:hover,
  .overview-system-card a:focus-visible,
  .overview-support-card a:hover,
  .overview-support-card a:focus-visible {
    transform: translateY(-1px);
    border-color: #a9c2d3;
    background: linear-gradient(180deg, #ffffff 0%, #eef6fb 100%);
    color: #064b78;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 12px 24px rgba(15, 23, 42, 0.08),
      0 2px 6px rgba(15, 23, 42, 0.05);
  }

  .overview-support-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .overview-support-card-wide {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
    align-items: center;
  }

  .overview-support-copy p:not(.overview-eyebrow) {
    margin: 16px 0 0;
  }

  .overview-workflow-section {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: 48px;
    align-items: center;
  }

  .overview-workflow-media {
    display: grid;
    place-items: center;
    min-height: 320px;
    padding: 30px;
    border-radius: 8px;
    background: #f4f6fb;
  }

  .overview-workflow-media img {
    width: 100%;
    max-height: 340px;
    object-fit: contain;
  }

  .overview-workflow-steps {
    display: grid;
    gap: 22px;
    margin-top: 24px;
  }

  .overview-workflow-steps article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: start;
  }

  .overview-workflow-steps span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: #eef8fc;
    color: #005c92;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .overview-workflow-steps h3 {
    font-size: 1rem;
    line-height: 1.2;
  }

  .overview-workflow-steps p {
    margin: 6px 0 0;
    font-size: 0.92rem;
  }

  .overview-comparison-heading {
    max-width: 760px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .overview-comparison-heading p {
    margin: 14px 0 0;
  }

  .overview-table-shell {
    max-width: 1040px;
    margin: 0 auto;
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    overflow: hidden;
    background: #ffffff;
  }

  .overview-comparison-table {
    width: 100%;
    border-collapse: collapse;
  }

  .overview-comparison-table th,
  .overview-comparison-table td {
    padding: 18px 20px;
    border-bottom: 1px solid #e3e8ee;
    text-align: left;
    vertical-align: top;
  }

  .overview-comparison-table thead th {
    background: #e8edf2;
    color: #404750;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .overview-comparison-table tbody th {
    width: 22%;
    color: #181c20;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .overview-comparison-table tbody td {
    color: #404750;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .overview-comparison-table tbody tr:last-child th,
  .overview-comparison-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .overview-cta-section {
    padding-top: 92px;
