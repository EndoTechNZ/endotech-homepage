---
import ProductLayout from '../../layouts/ProductLayout.astro';

const base = import.meta.env.BASE_URL;
const range = [
  { size: '20', colour: 'Yellow', swatch: '#f4d23b', image: `${base}products/gutta-percha/iso-20.png`, taper03: 'TSGP-2003-60PK', taper05: 'TSGP-2005-60PK' },
  { size: '25', colour: 'Red', swatch: '#df4851', image: `${base}products/gutta-percha/iso-25.png`, taper03: 'TSGP-2503-60PK', taper05: 'TSGP-2505-60PK' },
  { size: '30', colour: 'Blue', swatch: '#347fbd', image: `${base}products/gutta-percha/iso-30.png`, taper03: 'TSGP-3003-60PK', taper05: 'TSGP-3005-60PK' },
  { size: '35', colour: 'Green', swatch: '#48a56a', image: `${base}products/gutta-percha/iso-35.png`, taper03: 'TSGP-3503-60PK', taper05: 'TSGP-3505-60PK' },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'EndoTech Gutta Percha Points',
  description: 'Matched-taper gutta percha points in sizes 20, 25, 30 and 35 with .03 and .05 tapers.',
  image: `https://endotechnz.com/products/gutta-percha/gutta-percha-points.png`,
  brand: { '@type': 'Brand', name: 'EndoTech NZ' },
};
---

<ProductLayout
  title="Gutta Percha Points | EndoTech NZ"
  description="Shop the stocked EndoTech NZ Gutta Percha Point range: sizes 20, 25, 30 and 35 in .03 and .05 taper, supplied in boxes of 60."
  image={`${base}products/gutta-percha/gutta-percha-points.png`}
  schema={productSchema}
  accent="teal"
>
  <article class="gp-page">
    <section class="gp-hero" aria-labelledby="gp-title">
      <div class="gp-hero-copy">
        <p class="gp-kicker">Obturation · stocked in New Zealand</p>
        <h1 id="gp-title">Gutta Percha<br />Points</h1>
        <p class="gp-lede">A focused matched-taper range for predictable selection after shaping: four ISO tip sizes, two tapers, 60 points per box.</p>
        <div class="gp-actions">
          <a class="gp-button gp-button-primary" href={`${base}quote-request/?family=gutta-percha`}>Order / request pro forma</a>
          <a class="gp-text-link" href="#stocked-range">View stocked sizes <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <figure class="gp-hero-visual">
        <img src={`${base}products/gutta-percha/gutta-percha-points.png`} width="680" height="580" alt="Gutta percha points with ISO colour-coded ends" />
      </figure>
      <dl class="gp-hero-facts" aria-label="Range summary">
        <div><dt>Tip sizes</dt><dd>20–35</dd></div>
        <div><dt>Tapers</dt><dd>.03 / .05</dd></div>
        <div><dt>Box</dt><dd>60 points</dd></div>
      </dl>
    </section>

    <section class="gp-intro" aria-labelledby="gp-intro-title">
      <div>
        <p class="gp-kicker">Consistent selection</p>
        <h2 id="gp-intro-title">The size and taper you need, without the catalogue noise.</h2>
      </div>
      <p>The EndoTech NZ range is deliberately limited to the eight lines currently stocked: ISO 20, 25, 30 and 35 in .03 and .05 taper. Colour-coded ends make chairside identification immediate.</p>
    </section>

    <section id="stocked-range" class="gp-range" aria-labelledby="gp-range-title">
      <div class="gp-range-heading">
        <div>
          <p class="gp-kicker">New Zealand stocked range</p>
          <h2 id="gp-range-title">Sizes, tapers and article numbers.</h2>
        </div>
        <p>Every line below contains 60 points. Only these stocked variants are available in the order builder.</p>
      </div>

      <div class="gp-table-shell">
        <table>
          <thead>
            <tr><th>ISO size</th><th>Identification</th><th>.03 taper</th><th>.05 taper</th><th>Pack</th></tr>
          </thead>
          <tbody>
            {range.map((item) => (
              <tr>
                <th scope="row"><strong>{item.size}</strong></th>
                <td><span class="gp-colour" style={`--iso-colour:${item.swatch}`}><img src={item.image} width="40" height="20" alt="" />{item.colour}</span></td>
                <td><code>{item.taper03}</code></td>
                <td><code>{item.taper05}</code></td>
                <td>60</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <a class="gp-button gp-button-primary" href={`${base}quote-request/?family=gutta-percha`}>Add Gutta Percha Points to a request</a>
    </section>

    <section class="gp-detail" aria-labelledby="gp-detail-title">
      <figure>
        <img src={`${base}products/gutta-percha/gutta-percha-packaging.jpg`} width="680" height="580" alt="Colour-coded gutta percha points grouped by ISO size" />
      </figure>
      <div class="gp-detail-copy">
        <p class="gp-kicker">Material and handling</p>
        <h2 id="gp-detail-title">Made for a clean, readable workflow.</h2>
        <div class="gp-feature-list">
          <article><span>01</span><div><h3>Machine manufactured</h3><p>Automated production supports consistent point dimensions and a clean finish.</p></div></article>
          <article><span>02</span><div><h3>Radiopaque formulation</h3><p>Gutta percha, zinc oxide, barium sulfate and colour pigment form the point composition.</p></div></article>
          <article><span>03</span><div><h3>Stable during handling</h3><p>The points are non-conductive and thermally stable for routine obturation workflows.</p></div></article>
        </div>
      </div>
    </section>

    <section class="gp-final" aria-labelledby="gp-final-title">
      <div>
        <p class="gp-kicker">Ready to order</p>
        <h2 id="gp-final-title">Choose the matched size and taper.</h2>
      </div>
      <a class="gp-button gp-button-light" href={`${base}quote-request/?family=gutta-percha`}>Open the order builder</a>
    </section>
  </article>
</ProductLayout>

<style>
  .gp-page{--gp-ink:#102844;--gp-blue:#0b5678;--gp-aqua:#dff2ef;--gp-coral:#ee806d;color:var(--gp-ink);background:#fff}.gp-page *{box-sizing:border-box}.gp-hero{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.88fr);gap:clamp(2rem,6vw,6rem);align-items:center;min-height:710px;padding:clamp(4rem,9vw,8rem) max(5vw,calc((100vw - 1180px)/2));overflow:hidden;background:linear-gradient(100deg,#fff 0 58%,#edf7f5 58% 100%)}.gp-hero::after{content:"";position:absolute;right:-10vw;bottom:-28vw;width:48vw;height:48vw;border:1px solid rgba(11,86,120,.12);border-radius:50%;pointer-events:none}.gp-kicker{margin:0 0 1rem;color:#427086;font-size:.76rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.gp-hero h1{margin:0;font-size:clamp(3.8rem,7vw,7.4rem);font-weight:420;line-height:.88;letter-spacing:0}.gp-lede{max-width:620px;margin:2rem 0 0;color:#536b7d;font-size:clamp(1.05rem,1.45vw,1.3rem);line-height:1.65}.gp-actions{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;margin-top:2.2rem}.gp-button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;padding:.8rem 1.35rem;border:1px solid transparent;border-radius:4px;font-weight:750;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease,background .2s ease}.gp-button:hover{transform:translateY(-2px)}.gp-button-primary{color:#fff;background:var(--gp-blue);box-shadow:0 8px 18px rgba(11,86,120,.16)}.gp-button-primary:hover{background:#073f5a}.gp-text-link{color:var(--gp-ink);font-weight:700;text-underline-offset:5px}.gp-text-link:hover{text-decoration-thickness:2px}.gp-hero-visual{position:relative;z-index:1;margin:0}.gp-hero-visual img{display:block;width:100%;height:auto;mix-blend-mode:multiply}.gp-hero-facts{position:absolute;left:max(5vw,calc((100vw - 1180px)/2));bottom:2.8rem;display:flex;gap:0;margin:0}.gp-hero-facts div{min-width:120px;padding:.8rem 1.25rem;border-left:1px solid #c9dadd}.gp-hero-facts dt{color:#738797;font-size:.68rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.gp-hero-facts dd{margin:.25rem 0 0;font-size:1.05rem;font-weight:800}.gp-intro,.gp-range,.gp-detail,.gp-final{padding:clamp(4.5rem,8vw,8rem) max(5vw,calc((100vw - 1180px)/2))}.gp-intro{display:grid;grid-template-columns:1fr .72fr;gap:clamp(2rem,8vw,8rem);align-items:end;border-bottom:1px solid #dae5e8}.gp-intro h2,.gp-range h2,.gp-detail h2,.gp-final h2{margin:0;font-size:clamp(2.1rem,4vw,4rem);font-weight:430;line-height:1.04;letter-spacing:0}.gp-intro>p,.gp-range-heading>p{margin:0;color:#566d7e;font-size:1.08rem;line-height:1.75}.gp-range{background:#f4f7f9}.gp-range-heading{display:grid;grid-template-columns:1fr .62fr;gap:3rem;align-items:end;margin-bottom:2.4rem}.gp-table-shell{overflow-x:auto;margin-bottom:2rem;border:1px solid #cddde2;background:#fff}.gp-table-shell table{width:100%;min-width:760px;border-collapse:collapse}.gp-table-shell th,.gp-table-shell td{padding:1rem 1.2rem;text-align:left;border-bottom:1px solid #dce6e9}.gp-table-shell thead{color:#fff;background:var(--gp-blue)}.gp-table-shell thead th{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase}.gp-table-shell tbody tr:nth-child(even){background:#edf4f6}.gp-table-shell tbody tr:last-child>*{border-bottom:0}.gp-table-shell code{color:#23465e;font-size:.82rem}.gp-colour{display:inline-flex;align-items:center;gap:.65rem;font-weight:700}.gp-colour::before{content:"";width:11px;height:11px;border-radius:50%;background:var(--iso-colour);box-shadow:0 0 0 2px #fff,0 0 0 3px #cad6da}.gp-colour img{width:40px;height:20px;object-fit:contain}.gp-detail{display:grid;grid-template-columns:.85fr 1fr;gap:clamp(3rem,8vw,8rem);align-items:center}.gp-detail figure{margin:0;background:#edf4f3}.gp-detail figure img{display:block;width:100%;height:auto;mix-blend-mode:multiply}.gp-feature-list{margin-top:2.5rem;border-top:1px solid #cadadd}.gp-feature-list article{display:grid;grid-template-columns:46px 1fr;gap:1rem;padding:1.3rem 0;border-bottom:1px solid #cadadd}.gp-feature-list span{display:grid;width:30px;height:30px;place-items:center;border:1px solid #9dc4c7;border-radius:50%;color:#33737c;font-size:.72rem;font-weight:800}.gp-feature-list h3{margin:0 0 .35rem;font-size:1.05rem}.gp-feature-list p{margin:0;color:#607486;line-height:1.6}.gp-final{display:flex;align-items:center;justify-content:space-between;gap:3rem;color:#fff;background:var(--gp-ink)}.gp-final .gp-kicker{color:#8dc9c6}.gp-button-light{color:var(--gp-ink);background:#fff}.gp-button-light:hover{background:var(--gp-aqua)}
  @media(max-width:760px){.gp-hero{grid-template-columns:1fr;min-height:auto;padding-top:4rem;padding-bottom:8rem;background:linear-gradient(180deg,#fff 0 52%,#edf7f5 52% 100%)}.gp-hero h1{font-size:clamp(3.3rem,18vw,5.5rem)}.gp-hero-visual{grid-row:2}.gp-hero-facts{right:5vw;bottom:2rem;justify-content:center}.gp-hero-facts div{min-width:0;padding:.6rem .8rem}.gp-intro,.gp-range-heading,.gp-detail{grid-template-columns:1fr}.gp-intro{align-items:start}.gp-range-heading{gap:1.2rem}.gp-detail figure{order:2}.gp-final{align-items:flex-start;flex-direction:column}.gp-button{width:100%}.gp-actions{align-items:stretch;flex-direction:column}.gp-text-link{text-align:center}.gp-colour img{display:none}}
  @media(prefers-reduced-motion:reduce){.gp-button{transition:none}}
</style>
