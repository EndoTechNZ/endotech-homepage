---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import DistributorCTA from '../../../components/product/DistributorCTA.astro';
import { evidenceCards, getProductDownloads, literatureReferences } from '../../../data/bcs';
import { getBcsDownloads } from '../../../utils/downloads';
import { withBasePath } from '../../../utils/paths';

const downloads = getProductDownloads(getBcsDownloads());
const leadDownload = downloads[0];
const supportingDownloads = downloads.slice(1);
const competitorSeparationVideoSrc = withBasePath('/videos/bcs/competitor-sealer-separation.mp4');
const materialConsistencyVideoSrc = withBasePath('/videos/bcs/material-consistency-fundamental.mp4');
const sealerPackshotSrc = withBasePath('/downloads/metallic-packshots/BCS-Sealer-metallic-silver.png');
const puttyPackshotSrc = withBasePath('/downloads/metallic-packshots/BCS-Putty-metallic-gold.png');

function getDownloadMeta(fileName: string) {
  const extension = fileName.split('.').pop()?.toLowerCase() ?? '';

  if (extension === 'pdf') {
    return {
      typeLabel: 'PDF document',
      ctaLabel: 'Open PDF',
    };
  }

  if (extension === 'ppt' || extension === 'pptx') {
    return {
      typeLabel: 'PowerPoint file',
      ctaLabel: 'Download PowerPoint',
    };
  }

  if (extension === 'png' || extension === 'jpg' || extension === 'jpeg' || extension === 'webp') {
    return {
      typeLabel: 'Image asset',
      ctaLabel: 'Open image',
    };
  }

  return {
    typeLabel: 'Technical file',
    ctaLabel: 'Download file',
  };
}
---

<ProductLayout
  title="BCS Evidence & Downloads | Bioceramic Sealer and Putty Downloads"
  description="Access BCS bioceramic sealer and putty downloads, clinical references, IFUs, SDS files, and technical documents in one place."
  accent="slate"
>
  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-4xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Clinical Evidence & Downloads</p>
        <h1 class="mt-5 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          BCS BioCeramic evidence built as a clean reference page
        </h1>
        <p class="mt-5 text-lg leading-8 text-slate-600 sm:text-xl">
          Technical files, material-review videos, and supporting literature presented with the same sharp, restrained rhythm used across the Stitch-inspired redesign.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={withBasePath('/products/bcs/')}
            class="inline-flex min-w-[15rem] items-center justify-center rounded-full bg-slate-900 px-6 py-3.5 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.16),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
          >
            Open BCS family
          </a>
          <a
            href={withBasePath('/products/bcs/clinical-applications/')}
            class="inline-flex min-w-[15rem] items-center justify-center rounded-full border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.82),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color,color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
          >
            Review applications
          </a>
        </div>
      </div>

      <div class="mx-auto mt-12 max-w-5xl rounded-[2rem] border border-slate-200 bg-[linear-gradient(180deg,#ffffff,#f5f8fb)] p-6 shadow-[0_28px_80px_-48px_rgba(15,23,42,0.16)] sm:p-8">
        <div class="grid gap-5 lg:grid-cols-[minmax(0,0.92fr)_minmax(280px,0.7fr)] lg:items-center">
          <div class="rounded-[1.75rem] border border-slate-200 bg-white p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.26em] text-slate-500">Reference structure</p>
                <h2 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
              A cleaner evidence desk for the BCS material family
                </h2>
                <p class="mt-4 text-base leading-8 text-slate-600">
              Move cleanly between documents, material review, and literature without losing the premium clinical rhythm established on the product pages.
                </p>
            <div class="mt-6 grid gap-3 sm:grid-cols-3">
              <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Files</p>
                <p class="mt-2 text-sm leading-6 text-slate-700">Technical assets presented as primary references.</p>
              </div>
              <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Review</p>
                <p class="mt-2 text-sm leading-6 text-slate-700">Competitor and consistency videos framed clinically.</p>
              </div>
              <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Evidence</p>
                <p class="mt-2 text-sm leading-6 text-slate-700">Published themes and literature kept easy to scan.</p>
              </div>
            </div>
          </div>

          <div class="rounded-[1.75rem] border border-slate-200 bg-[#123d78] p-6 text-white shadow-[0_24px_60px_-42px_rgba(15,23,42,0.42)]">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cyan-100/90">BCS system</p>
            <h3 class="mt-4 text-2xl font-bold tracking-tight">Evidence-led presentation</h3>
            <p class="mt-4 text-sm leading-7 text-slate-200">
              BCS Sealer and Putty are shown here as a coordinated material family, with downloads and evidence arranged like a premium clinical catalogue.
            </p>
            <div class="mt-6 flex items-end justify-center gap-3">
              <div class="w-[44%] rounded-[1.15rem] border border-white/10 bg-white/96 p-2 shadow-[0_18px_30px_-24px_rgba(2,6,23,0.55)]">
                <img src={sealerPackshotSrc} alt="BCS BioCeramic Sealer packshot" class="w-full object-contain" />
              </div>
              <div class="w-[44%] rounded-[1.15rem] border border-white/10 bg-white/96 p-2 shadow-[0_18px_30px_-24px_rgba(2,6,23,0.55)]">
                <img src={puttyPackshotSrc} alt="BCS BioCeramic Putty packshot" class="w-full object-contain" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-slate-50/70">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-20 lg:py-24">
      <div class="grid gap-5 lg:grid-cols-[minmax(0,0.98fr)_minmax(320px,0.72fr)]">
        <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_24px_60px_-42px_rgba(15,23,42,0.12)] sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Document library</p>
          <h2 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            Featured technical file
          </h2>
          {leadDownload && (
            <>
              <p class="mt-4 text-base leading-8 text-slate-600">
                Keep the lead file prominent and direct. The page should foreground the main BCS reference instead of hiding it inside a long list.
              </p>
              <div class="mt-6 rounded-[1.5rem] border border-slate-200 bg-slate-50/80 p-5 sm:p-6">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">
                  {getDownloadMeta(leadDownload.fileName).typeLabel}
                </p>
                <h3 class="mt-3 text-2xl font-bold tracking-tight text-slate-900">
                  {leadDownload.label}
                </h3>
                <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
                  <a
                    href={withBasePath(leadDownload.href)}
                    class="inline-flex items-center justify-center rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.16),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
                  >
                    {getDownloadMeta(leadDownload.fileName).ctaLabel}
                  </a>
                  <span class="text-sm leading-7 text-slate-500">
                    If the preview browser does not download it, the direct file link still works in a standard browser.
                  </span>
                </div>
              </div>
            </>
          )}
        </article>

        <article class="rounded-[1.75rem] border border-slate-200 bg-[#0f2850] p-6 text-white shadow-[0_24px_60px_-42px_rgba(15,23,42,0.45)]">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cyan-100/90">Included here</p>
          <h3 class="mt-4 text-2xl font-bold tracking-tight">Sharper file presentation</h3>
          <p class="mt-4 text-sm leading-7 text-slate-200">
            Brochures, presentation files, technical references, and evidence-linked materials should all feel part of the same controlled system.
          </p>
          <div class="mt-6 space-y-3 rounded-[1.5rem] border border-white/12 bg-white/6 p-5">
            <p class="text-sm leading-7 text-slate-200">Brochures and presentation files</p>
            <p class="text-sm leading-7 text-slate-200">Supporting technical documents</p>
            <p class="text-sm leading-7 text-slate-200">Evidence-linked review materials</p>
          </div>
        </article>
      </div>

      {supportingDownloads.length > 0 && (
        <div class="mt-5 grid gap-4">
          {supportingDownloads.map((item) => (
            <article class="flex flex-col gap-4 rounded-[1.5rem] border border-slate-200 bg-white p-5 md:flex-row md:items-center md:justify-between">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">
                  {getDownloadMeta(item.fileName).typeLabel}
                </p>
                <h3 class="mt-2 text-lg font-bold text-slate-900">{item.label}</h3>
              </div>
              <a
                href={withBasePath(item.href)}
                class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.82),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color,color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
              >
                {getDownloadMeta(item.fileName).ctaLabel}
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-20 lg:py-24">
      <div class="grid gap-5 lg:grid-cols-[minmax(0,0.95fr)_minmax(320px,0.62fr)] lg:items-stretch">
        <article class="rounded-[1.75rem] border border-slate-200 bg-slate-50/70 p-6 shadow-[0_20px_48px_-40px_rgba(15,23,42,0.14)]">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Evidence logic</p>
          <h2 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            What the evidence page should help a clinician review
          </h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            <div class="rounded-[1.2rem] border border-slate-200 bg-white p-4">
              <p class="text-sm font-semibold text-slate-900">Material condition</p>
              <p class="mt-2 text-sm leading-7 text-slate-600">How the sealer presents before entering the canal.</p>
            </div>
            <div class="rounded-[1.2rem] border border-slate-200 bg-white p-4">
              <p class="text-sm font-semibold text-slate-900">Handling consistency</p>
              <p class="mt-2 text-sm leading-7 text-slate-600">Whether the premixed workflow remains stable and readable.</p>
            </div>
            <div class="rounded-[1.2rem] border border-slate-200 bg-white p-4">
              <p class="text-sm font-semibold text-slate-900">Published support</p>
              <p class="mt-2 text-sm leading-7 text-slate-600">How the material story connects back to literature.</p>
            </div>
          </div>
        </article>

        <article class="rounded-[1.75rem] border border-slate-200 bg-[#123d78] p-6 text-white shadow-[0_24px_60px_-42px_rgba(15,23,42,0.42)]">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cyan-100/90">Material review</p>
          <h3 class="mt-4 text-2xl font-bold tracking-tight">Competitor observations should feel structured, not sensational</h3>
          <p class="mt-4 text-sm leading-7 text-slate-200">
            These sections need the same clinical discipline as the rest of the redesign: calm language, clear framing, and evidence modules that look intentional.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-slate-50/70">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-18 lg:py-20">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Competitor Sealer Issues</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Video review presented as a sharper evidence module
        </h2>
        <p class="mt-4 text-base leading-8 text-slate-600 sm:text-lg">
          These examples are included for professional review of visible separation, handling variation, and delivery readiness before use.
        </p>
      </div>

      <div class="mt-10 grid gap-8">
        <section id="competitor-video-example" class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-[0_24px_60px_-42px_rgba(15,23,42,0.14)] sm:p-8">
          <div class="grid gap-8 lg:grid-cols-[minmax(320px,1fr)_minmax(280px,320px)] lg:items-center">
            <div class="space-y-5">
              <div class="max-w-xl">
                <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Video 1</p>
                <h3 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Visible separation example</h3>
                <p class="mt-4 text-base leading-8 text-slate-600">
                  A competitor-sample example presented for professional review of visible phase separation before use. It sits here as material context, not as a broad comparative claim.
                </p>
              </div>

              <div class="grid gap-4 sm:grid-cols-3">
                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 p-4">
                  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Observe</p>
                  <p class="mt-2 text-sm leading-7 text-slate-700">Visible separation before delivery.</p>
                </div>
                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 p-4">
                  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Consider</p>
                  <p class="mt-2 text-sm leading-7 text-slate-700">Possible implications for placement control.</p>
                </div>
                <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 p-4">
                  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Context</p>
                  <p class="mt-2 text-sm leading-7 text-slate-700">Why condition review matters before obturation.</p>
                </div>
              </div>
            </div>

            <div class="justify-self-center lg:justify-self-end">
              <div class="w-[min(100%,320px)] overflow-hidden rounded-[1.75rem] border border-slate-200 bg-[linear-gradient(180deg,#f8fafc,#edf3f8)] shadow-[0_24px_60px_-42px_rgba(15,23,42,0.2)]">
                <div class="aspect-[9/16] w-full">
                  <video
                    class="h-full w-full object-cover object-center bg-transparent"
                    controls
                    preload="metadata"
                    playsinline
                  >
                    <source src={competitorSeparationVideoSrc} type="video/mp4" />
                    Your browser does not support the video tag.
                  </video>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="competitor-video-context" class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-[0_24px_60px_-42px_rgba(15,23,42,0.14)] sm:p-8">
          <div class="grid gap-8 lg:grid-cols-[minmax(280px,0.72fr)_minmax(0,1.18fr)] lg:items-center">
            <div class="space-y-5">
              <div class="max-w-xl">
                <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Video 2</p>
                <h3 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Why consistency matters before use</h3>
                <p class="mt-4 text-base leading-8 text-slate-600">
                  A supporting video used to frame why clinicians may want to evaluate syringe behaviour, material uniformity, and delivery readiness before the sealer enters the canal.
                </p>
              </div>

              <div class="rounded-[1.5rem] border border-slate-200 bg-slate-50/80 p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Key review points</p>
                <ul class="mt-4 space-y-3 text-sm leading-7 text-slate-600">
                  <li>Uniformity before delivery</li>
                  <li>Handling consistency at the point of use</li>
                  <li>Clinical relevance of material-condition review</li>
                </ul>
              </div>
            </div>

            <div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-[linear-gradient(180deg,#f8fafc,#edf3f8)] shadow-[0_24px_60px_-42px_rgba(15,23,42,0.2)]">
              <div class="aspect-video w-full">
                <video
                  class="h-full w-full object-contain bg-transparent"
                  controls
                  preload="metadata"
                  playsinline
                >
                  <source src={materialConsistencyVideoSrc} type="video/mp4" />
                  Your browser does not support the video tag.
                </video>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-20 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Evidence Areas</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Key material evidence
        </h2>
        <p class="mt-4 text-base leading-8 text-slate-600 sm:text-lg">
          Review the main material areas relevant to bioceramic sealer and repair workflows.
        </p>
      </div>

      <div class="mt-10 rounded-[2rem] border border-slate-200 bg-[linear-gradient(180deg,#f8fafc,#eef4f8)] p-6 shadow-[0_28px_80px_-50px_rgba(15,23,42,0.14)] sm:p-8">
        <div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
          {evidenceCards.map((item) => (
            <article class="rounded-[1.35rem] border border-slate-200 bg-white p-5 shadow-[0_20px_48px_-42px_rgba(15,23,42,0.12)]">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Evidence area</p>
              <h3 class="mt-3 text-lg font-bold tracking-tight text-slate-900">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-slate-50/70">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-18 lg:py-20">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Selected References</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Literature held back as a clean appendix
        </h2>
        <p class="mt-4 text-base leading-8 text-slate-600 sm:text-lg">
          The references remain visible, but they sit as a final technical layer instead of competing with the main evidence modules.
        </p>
      </div>

      <div class="mt-10 grid gap-4">
        {literatureReferences.map((reference) => (
          <article class="rounded-[1.5rem] border border-slate-200 bg-white p-6">
            <p class="text-base leading-8 text-slate-900">{reference.citation}</p>
            <p class="mt-3 text-sm leading-7 text-slate-600">{reference.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <DistributorCTA
    title="Review the evidence alongside the product information"
    body="Use this page to access technical files, supporting literature, and material-review videos relevant to the BCS bioceramic family."
    secondaryLabel="View BCS BioCeramic Sealer"
    secondaryHref="/products/bcs-bioceramic-sealer/"
  />
</ProductLayout>
