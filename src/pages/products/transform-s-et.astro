---
import ProductLayout from '../../layouts/ProductLayout.astro';
import etProduct from '../../assets/transform-s-et.png';
import transformSWordmark from '../../assets/transform-s-wordmark.png';
import avatarTipComparison from '../../assets/avatar-tip-comparison.png';
import etFirewireMachine from '../../assets/et-firewire-machine.png';
import { siteConfig } from '../../config/site';
import { nzLaunchCatalog } from '../../data/nzLaunchCatalog';

const siteUrl = Astro.site?.toString() ?? 'https://endotechnz.github.io';
const base = import.meta.env.BASE_URL;
const etOrderHref = `${base}order/#et-order`;
const workflowHref = `${base}technique/workflow/`;
const downloadsHref = `${base}resources/downloads/`;
const etPartNumbersHref = `${base}downloads/EndoTech-NZ-Transform-S-ET-Part-Numbers.pdf`;
const etProducts = nzLaunchCatalog.filter((item) => item.family === 'et');

const etSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Transform S™ ET Files',
  description:
    'Rotary shaping files for clinicians who want to preserve established .04/.06-style sequence logic while using Avatar Tip and Transform Technology.',
  brand: {
    '@type': 'Brand',
    name: siteConfig.name,
  },
  category: 'Endodontic rotary files',
  image: [new URL(etProduct.src, siteUrl).toString()],
  url: new URL('/products/transform-s-et/', siteUrl).toString(),
};

const technicalCards = [
  {
    title: 'Transform Technology',
    body:
      'Transform Technology is positioned to support flexibility through curvature while preserving the shaping response clinicians expect from ET-style sequence logic.',
    tone: 'light',
    image: etFirewireMachine,
    imageAlt: 'Transform Technology machine render.',
  },
  {
    title: 'Geometry matters',
    body:
      'As the canal narrows, curves, or becomes less forgiving, tip design becomes critical. Avatar Tip is designed to guide the file along the prepared path, helping reduce aggressive apical engagement while supporting controlled progression through complex anatomy.',
    tone: 'dark',
    metric: 'ET-style .04 / .06',
  },
];

const workflowSteps = [
  {
    number: '1',
    title: 'Assess and open',
    description:
      'Preserve conservative access objectives while creating a pathway that still respects the natural canal form.',
  },
  {
    number: '2',
    title: 'Shape and clean',
    description:
      'Use ET-style sequence logic, then move into irrigation with a preparation geometry suited to the next clinical step.',
  },
  {
    number: '3',
    title: 'Obturate',
    description:
      'Finish the case with a matched bioceramic sealing pathway so shaping and obturation work as one system.',
  },
];

const comparisonRows = [
  {
    feature: 'Technique transition',
    et: 'Familiar ET-style sequence logic',
    standard: 'Often requires more adaptation',
  },
  {
    feature: 'Apical control',
    et: 'Guided apical progression',
    standard: 'Varies widely by file design',
  },
  {
    feature: 'Workflow fit',
    et: 'Glide, shape, clean, then seal',
    standard: 'Often evaluated as a file-only choice',
  },
  {
    feature: 'Next step',
    et: 'Complete part-number list',
    standard: 'Compare to your current protocol',
  },
];

---

<ProductLayout
  title="Transform S™ ET Files | Rotary Endodontic Files for ET-Style Technique"
  description="Transform S™ ET rotary endodontic files preserve established .04/.06-style shaping technique while using Avatar Tip and Transform Technology."
  image={etProduct.src}
  schema={etSchema}
  accent="teal"
>
  <main class="et-stitch-page">
    <section class="et-hero" aria-labelledby="et-hero-title">
      <div class="et-hero-copy">
        <img class="et-series-mark" src={transformSWordmark.src} width="742" height="116" alt="Transform S™ root canal shaping system" />
        <div class="et-next-generation-reveal-mask">
          <p class="et-next-generation-reveal-text js-et-next-generation-reveal">Next generation endodontics</p>
        </div>
        <h1 id="et-hero-title">Transform S™ ET</h1>
        <p class="et-hero-lede">
          ET-style shaping for clinicians already using .04 / .06 constant-taper workflows such as EdgeFile X7, HyFlex CM, RaCe, and similar rotary systems.
        </p>
      </div>

      <figure data-et-hero-visual class="et-hero-visual et-hero-visual--pre-reveal" style="transform: translateZ(0) scale(0.9);">
        <img
          class="et-hero-image"
          src={etProduct.src}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          alt="Transform S™ ET rotary files displayed as a shaping system"
        />
      </figure>

      <div class="et-hero-actions">
        <a class="et-button primary" href="#technical-specifications">Technical Specifications</a>
        <a class="et-button secondary" href={downloadsHref}>Evidence &amp; Downloads</a>
      </div>
    </section>

    <section id="technical-specifications" class="et-technical-band" aria-labelledby="et-technical-title">
      <h2 class="sr-only" id="et-technical-title">Technical overview</h2>
      <div class="et-technical-grid">
        {technicalCards.map((card) => (
          <article class:list={['et-technical-card', card.tone === 'dark' && 'is-dark']}>
            <div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </div>
            {card.metric && (
              <div class="et-technical-meta">
                <span>{card.metric}</span>
              </div>
            )}
            {card.tone === 'light' && (
              <img src={(card.image ?? avatarTipComparison).src} alt={card.imageAlt ?? 'Avatar Tip geometry comparison'} />
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="et-journey-section" aria-labelledby="et-journey-title">
      <div class="et-journey-media">
        <img src={avatarTipComparison.src} alt="Clinical illustration supporting anatomical shaping control" />
      </div>

      <div class="et-journey-copy">
        <p class="et-eyebrow">The clinical journey</p>
        <h2 id="et-journey-title">Anatomical respect by design.</h2>
        <div class="et-journey-steps">
          {workflowSteps.map((step) => (
            <article>
              <span>{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="et-comparison-section" aria-labelledby="et-comparison-title">
      <div class="et-comparison-heading">
        <h2 id="et-comparison-title">Product Comparison</h2>
        <p>Transparent information for clinicians evaluating sequence fit and workflow role.</p>
      </div>

      <div class="et-table-shell">
        <table class="et-comparison-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Transform S™ ET</th>
              <th>Typical Alternative</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <th>{row.feature}</th>
                <td>{row.et}</td>
                <td>{row.standard}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="et-comparison-section" aria-labelledby="et-catalogue-title">
      <div class="et-comparison-heading">
        <img class="et-catalogue-wordmark" src={transformSWordmark.src} width="742" height="116" alt="Transform S™" />
        <h2 id="et-catalogue-title">ET — Complete Part Number List</h2>
      </div>
      <div class="et-table-shell">
        <table class="et-comparison-table">
          <thead><tr><th>Size</th><th>Length</th><th>Pack</th><th>Part number</th></tr></thead>
          <tbody>
            {etProducts.map((product) => (
              <tr><td>{product.size}</td><td>{product.lengthMm === null ? '—' : `${product.lengthMm} mm`}</td><td>{product.packQty}</td><td><code>{product.sku}</code></td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <a class="et-button dark" href={etPartNumbersHref}>Download ET part-number guide</a>
    </section>

    <section class="et-downloads-section" aria-labelledby="et-downloads-title">
      <div class="et-downloads-heading">
        <p class="et-eyebrow">Downloads</p>
        <h2 id="et-downloads-title">Confirmed ET part-number guide.</h2>
        <p>The customer-selectable article numbers are available as a clean PDF. Technique and IFU documents remain pending approval.</p>
      </div>
      <a class="et-button dark" href={etPartNumbersHref}>Download ET guide</a>
    </section>

    <section class="et-cta-section" aria-labelledby="et-cta-title">
      <div class="et-cta-copy">
        <h2 id="et-cta-title">Review Transform S™ ET in the wider workflow.</h2>
        <p>
          Review Transform S™ ET, then move into the ordering section or supporting product files when you are ready to evaluate the system in practice.
        </p>
      </div>
      <div class="et-cta-actions">
        <a class="et-button primary" href={etOrderHref}>Order Transform S™ ET</a>
        <a class="et-button secondary on-dark" href={downloadsHref}>Evidence &amp; Downloads</a>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const visual = document.querySelector('[data-et-hero-visual]');
      if (!(visual instanceof HTMLElement)) return;

      const playReveal = () => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
          setTimeout(() => {
            visual.style.transform = '';
            visual.classList.remove('et-hero-visual--pre-reveal');
          }, 70);
          });
        });
      };

      playReveal();
    })();
  </script>

  <script is:inline>
    (() => {
      const mask = document.querySelector('.et-next-generation-reveal-mask');
      const text = document.querySelector('.js-et-next-generation-reveal');
      if (!(mask instanceof HTMLElement) || !(text instanceof HTMLElement)) return;

      const originalText = 'Next generation endodontics';
      text.setAttribute('aria-label', originalText);
      text.innerHTML = Array.from(originalText)
        .map((char, index) => {
          const safeChar = char === ' ' ? '&nbsp;' : char;
          return `<span class="et-next-generation-reveal-char" aria-hidden="true" style="--char-index:${index}">${safeChar}</span>`;
        })
        .join('');

      const observer = new IntersectionObserver(
        (entries, observerInstance) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              window.setTimeout(() => {
                requestAnimationFrame(() => {
                  requestAnimationFrame(() => {
                    mask.classList.add('is-visible');
                  });
                });
              }, 180);

              observerInstance.unobserve(entry.target);
            }
          });
        },
        {
          root: null,
          threshold: 0.2,
        }
      );

      observer.observe(mask);
    })();
  </script>
</ProductLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .et-stitch-page {
    background: #ffffff;
    color: #181c20;
  }

  .et-hero,
  .et-technical-band,
  .et-journey-section,
  .et-bcs-section,
  .et-comparison-section,
  .et-video-section,
  .et-downloads-section,
  .et-cta-section {
    padding-left: 56px;
    padding-right: 56px;
  }

  .et-eyebrow {
    margin: 0 0 14px;
    color: #00639c;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .et-hero h1,
  .et-technical-card h3,
  .et-journey-copy h2,
  .et-journey-copy h3,
  .et-bcs-copy h2,
  .et-comparison-heading h2,
  .et-video-heading h2,
  .et-downloads-heading h2,
  .et-cta-copy h2 {
    margin: 0;
    color: #181c20;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .et-hero {
    display: grid;
    justify-items: center;
    padding-top: 96px;
    padding-bottom: 80px;
    text-align: center;
    background: #ffffff;
  }

  .et-hero-copy {
    width: 100%;
    max-width: 760px;
  }

  .et-series-mark {
    display: block;
    width: min(100%, 360px);
    height: auto;
    margin: 0 0 24px;
  }

  .et-next-generation-reveal-mask {
    display: block;
    overflow: hidden;
    text-align: center;
    padding: 0 0 14px;
    min-height: 24px;
  }

  .et-next-generation-reveal-text {
    margin: 0;
    color: #00639c;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
  }

  :global(.et-next-generation-reveal-char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(5px);
    filter: blur(1.5px);
    transition:
      opacity 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--char-index) * 12ms);
    will-change: opacity, transform, filter;
  }

  :global(.et-next-generation-reveal-mask.is-visible .et-next-generation-reveal-char) {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .et-hero h1 {
    width: max-content;
    max-width: 100%;
    margin-right: auto;
    margin-left: auto;
    font-size: clamp(2.15rem, 7vw, 5.8rem);
    line-height: 0.94;
    white-space: nowrap;
    text-wrap: nowrap;
  }

  .et-hero-lede,
  .et-technical-card p,
  .et-journey-copy p,
  .et-bcs-copy p,
  .et-comparison-heading p,
  .et-download-list span,
  .et-cta-copy p {
    color: #404750;
    font-family: Inter, 'Segoe UI', sans-serif;
    line-height: 1.65;
  }

  .et-hero-lede {
    max-width: 48ch;
    margin: 18px auto 0;
    font-size: 1rem;
  }

  .et-hero-visual {
    width: 100%;
    max-width: 920px;
    margin: 36px 0 0;
    transform-origin: center center;
    transform: translateZ(0) scale(1);
    transition: transform 1320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .et-hero-visual--pre-reveal {
    transform: translateZ(0) scale(0.9);
  }

  .et-hero-visual img,
  .et-hero-image {
    display: block;
    width: 100%;
    max-height: 660px;
    object-fit: contain;
    backface-visibility: hidden;
  }

  .et-hero-actions,
  .et-cta-actions,
  .et-bcs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .et-hero-actions {
    justify-content: center;
    margin-top: 30px;
  }

  .et-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border-radius: 6px;
    padding: 0 18px;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      color 180ms ease,
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .et-button:hover,
  .et-button:focus-visible {
    transform: translateY(-1px);
    box-shadow:
      0 12px 24px rgba(15, 23, 42, 0.08),
      0 2px 6px rgba(15, 23, 42, 0.05);
  }

  .et-button.primary {
    background: #005c92;
    border: 1px solid #005c92;
    color: #ffffff;
  }

  .et-button.primary:hover,
  .et-button.primary:focus-visible {
    background: #0a6ca8;
    border-color: #0a6ca8;
    color: #ffffff;
  }

  .et-button.secondary {
    background: #ffffff;
    border: 1px solid #c0c7d2;
    color: #404750;
  }

  .et-button.secondary:hover,
  .et-button.secondary:focus-visible {
    background: #f8fbfd;
    border-color: #aeb8c5;
    color: #1f2937;
  }

  .et-button.dark {
    background: #181c20;
    border: 1px solid #181c20;
    color: #ffffff;
  }

  .et-button.dark:hover,
  .et-button.dark:focus-visible {
    background: #111827;
    border-color: #111827;
    color: #ffffff;
  }

  .et-button.on-dark,
  .et-button.secondary.on-dark {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }

  .et-button.on-dark:hover,
  .et-button.on-dark:focus-visible,
  .et-button.secondary.on-dark:hover,
  .et-button.secondary.on-dark:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.42);
    color: #ffffff;
  }

  .et-technical-band,
  .et-journey-section,
  .et-bcs-section,
  .et-comparison-section,
  .et-video-section,
  .et-downloads-section {
    border-top: 1px solid #e3e8ee;
  }

  .et-technical-band,
  .et-journey-section,
  .et-bcs-section,
  .et-video-section,
  .et-downloads-section {
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .et-comparison-section {
    padding-top: 84px;
    padding-bottom: 84px;
    background: #f7f9ff;
  }

  .et-technical-grid,
  .et-journey-section,
  .et-bcs-section,
  .et-download-list {
    max-width: 1280px;
    margin: 0 auto;
  }

  .et-technical-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.74fr);
    gap: 20px;
  }

  .et-technical-card {
    display: grid;
    gap: 28px;
    align-content: space-between;
    min-height: 300px;
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    padding: 28px;
    background: #ffffff;
    box-shadow: 0 1px 3px rgba(0, 55, 112, 0.06);
  }

  .et-technical-card h3 {
    font-size: 1.28rem;
    line-height: 1.16;
  }

  .et-technical-card p {
    max-width: 34ch;
    margin: 12px 0 0;
    font-size: 0.94rem;
  }

  .et-technical-card img {
    width: 100%;
    max-width: 260px;
    max-height: 162px;
    justify-self: end;
    object-fit: contain;
    opacity: 0.42;
  }

  .et-technical-card.is-dark {
    background: #005c92;
    border-color: #005c92;
  }

  .et-technical-card.is-dark h3,
  .et-technical-card.is-dark p,
  .et-technical-card.is-dark span {
    color: #ffffff;
  }

  .et-technical-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 18px;
  }

  .et-technical-meta span {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .et-journey-section,
  .et-bcs-section {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: 48px;
    align-items: center;
  }

  .et-journey-media,
  .et-bcs-visual {
    display: grid;
    place-items: center;
    min-height: 320px;
    padding: 30px;
    border-radius: 8px;
    background: #f4f6fb;
  }

  .et-journey-media img,
  .et-bcs-visual img {
    width: 100%;
    max-height: 340px;
    object-fit: contain;
  }

  .et-journey-copy h2,
  .et-bcs-copy h2,
  .et-comparison-heading h2,
  .et-video-heading h2,
  .et-downloads-heading h2,
  .et-cta-copy h2 {
    font-size: clamp(2.1rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .et-journey-steps {
    display: grid;
    gap: 22px;
    margin-top: 24px;
  }

  .et-journey-steps article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: start;
  }

  .et-journey-steps span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: #eef8fc;
    color: #005c92;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .et-journey-steps h3 {
    font-size: 1rem;
    line-height: 1.2;
  }

  .et-journey-steps p {
    margin: 6px 0 0;
    font-size: 0.92rem;
  }

  .et-bcs-lede {
    max-width: 44ch;
    margin: 16px 0 0;
    font-size: 1rem;
  }

  .et-bcs-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    max-width: 460px;
    margin: 28px 0 24px;
  }

  .et-bcs-metrics div {
    border-left: 3px solid #006a6a;
    padding-left: 14px;
  }

  .et-bcs-metrics strong {
    display: block;
    color: #006a6a;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .et-bcs-metrics span {
    display: block;
    margin-top: 6px;
    color: #707881;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .et-inline-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border: 1px solid #bfd3e0;
    border-radius: 999px;
    padding: 0 18px;
    background: linear-gradient(180deg, #ffffff 0%, #f3f8fc 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.92),
      0 1px 2px rgba(15, 23, 42, 0.04);
    color: #005c92;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      color 180ms ease,
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

