---
import ProductLayout from '../../layouts/ProductLayout.astro';
import { bcsPutty } from '../../data/bcs';
import { withBasePath } from '../../utils/paths';
import { siteConfig } from '../../config/site';

const siteUrl = Astro.site?.toString() ?? 'https://endotechnz.github.io';
const puttyImage = withBasePath('/downloads/metallic-packshots/BCS-Putty-metallic-gold.png');
const evidenceHref = withBasePath('/products/bcs/evidence/');
const applicationsHref = withBasePath('/products/bcs/clinical-applications/');
const familyHref = withBasePath('/products/bcs/');
const contactHref = withBasePath('/about/contact/');

const puttySchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'BCS BioCeramic Putty',
  description: bcsPutty.shortDescription,
  brand: {
    '@type': 'Brand',
    name: siteConfig.name,
  },
  category: 'Bioceramic root repair material',
  image: [new URL(puttyImage, siteUrl).toString()],
  url: new URL('/products/bcs-bioceramic-putty/', siteUrl).toString(),
  additionalProperty: bcsPutty.featureBullets.map((feature) => ({
    '@type': 'PropertyValue',
    name: feature.title,
    value: feature.description,
  })),
};

const technicalCards = [
  {
    title: 'Premixed repair material',
    body:
      'BCS BioCeramic Putty removes hand mixing from repair procedures and supports a consistent placement step where consistency matters.',
    tone: 'light',
  },
  {
    title: 'Placement-oriented handling',
    body:
      'The material story is built around controlled handling, washout resistance, and repair-focused workflow clarity rather than broad promotional claims.',
    tone: 'dark',
    metric: 'Repair-focused bioceramic',
  },
];

const workflowSteps = [
  {
    number: '1',
    title: 'Prepare the site',
    description:
      'Repair procedures still depend on access, visibility, and local field control before material placement begins.',
  },
  {
    number: '2',
    title: 'Place the putty',
    description:
      'A premixed format supports controlled delivery where the material needs to be positioned deliberately and consistently.',
  },
  {
    number: '3',
    title: 'Restore with a clear material step',
    description:
      'The repair material step remains connected to the wider treatment plan and final restorative goal.',
  },
];
---

<ProductLayout
  title="BCS BioCeramic Putty | Bioceramic Root Repair Material"
  description={bcsPutty.shortDescription}
  image={puttyImage}
  schema={puttySchema}
  accent="slate"
>
  <main class="bcs-putty-page">
    <section class="bcs-putty-hero" aria-labelledby="bcs-putty-hero-title">
      <div class="bcs-putty-hero-copy">
        <p class="bcs-putty-eyebrow">Bioceramic root repair material</p>
        <h1 id="bcs-putty-hero-title">BCS BioCeramic Putty</h1>
        <p class="bcs-putty-hero-lede">
          Premixed repair material designed for deliberate placement in procedures where handling consistency and biologically aligned repair matter.
        </p>
      </div>

      <figure class="bcs-putty-hero-visual">
        <img src={puttyImage} alt="BCS BioCeramic Putty product packaging" />
      </figure>

      <div class="bcs-putty-hero-actions">
        <a class="bcs-putty-button primary" href={applicationsHref}>View applications</a>
        <a class="bcs-putty-button secondary" href={evidenceHref}>Open evidence</a>
      </div>
    </section>

    <section class="bcs-putty-technical-band" aria-labelledby="bcs-putty-technical-title">
      <h2 class="sr-only" id="bcs-putty-technical-title">Technical overview</h2>
      <div class="bcs-putty-technical-grid">
        {technicalCards.map((card) => (
          <article class:list={['bcs-putty-technical-card', card.tone === 'dark' && 'is-dark']}>
            <div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </div>
            {card.metric ? (
              <div class="bcs-putty-technical-meta">
                <span>{card.metric}</span>
              </div>
            ) : (
              <img src={puttyImage} alt="BCS BioCeramic Putty premixed repair material packaging" />
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="bcs-putty-journey-section" aria-labelledby="bcs-putty-journey-title">
      <div class="bcs-putty-journey-media">
        <img src={puttyImage} alt="BCS BioCeramic Putty shown as a repair-stage material" />
      </div>

      <div class="bcs-putty-journey-copy">
        <p class="bcs-putty-eyebrow">The clinical journey</p>
        <h2 id="bcs-putty-journey-title">Handling is part of the clinical value.</h2>
        <div class="bcs-putty-journey-steps">
          {workflowSteps.map((step) => (
            <article>
              <span>{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bcs-putty-story-section" aria-labelledby="bcs-putty-story-title">
      <div class="bcs-putty-story-copy">
        <p class="bcs-putty-eyebrow">Clinical problem and solution</p>
        <h2 id="bcs-putty-story-title">Controlled repair without the variability of mixed materials.</h2>
      </div>

      <div class="bcs-putty-story-grid">
        <article class="is-light">
          <h3>Clinical problem</h3>
          <p>{bcsPutty.clinicalProblem}</p>
        </article>
        <article class="is-dark">
          <h3>TransformX solution</h3>
          <p>{bcsPutty.transformxSolution}</p>
        </article>
      </div>
    </section>

    <section class="bcs-putty-applications-section" aria-labelledby="bcs-putty-applications-title">
      <div class="bcs-putty-section-heading">
        <p class="bcs-putty-eyebrow">Applications</p>
        <h2 id="bcs-putty-applications-title">Designed for repair and vital pulp procedures.</h2>
      </div>

      <div class="bcs-putty-application-grid">
        {bcsPutty.applications.map((application, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{application}</h3>
          </article>
        ))}
      </div>
    </section>

    <section class="bcs-putty-rationale-section" aria-labelledby="bcs-putty-rationale-title">
      <div class="bcs-putty-section-heading">
        <p class="bcs-putty-eyebrow">Why clinicians choose it</p>
        <h2 id="bcs-putty-rationale-title">Repair workflow consistency, expressed in practical terms.</h2>
      </div>

      <div class="bcs-putty-rationale-grid">
        <div class="bcs-putty-reason-list">
          {bcsPutty.clinicianReasons.map((reason) => (
            <p>{reason}</p>
          ))}
        </div>
        <article class="bcs-putty-story-card">
          <span>Product story</span>
          <p>{bcsPutty.story}</p>
        </article>
      </div>
    </section>

    <section class="bcs-putty-comparison-section" aria-labelledby="bcs-putty-comparison-title">
      <div class="bcs-putty-comparison-heading">
        <h2 id="bcs-putty-comparison-title">Material comparison</h2>
        <p>Comparison focused on handling logic, chairside consistency, and repair workflow control rather than broad superiority claims.</p>
      </div>

      <div class="bcs-putty-table-shell">
        <table class="bcs-putty-comparison-table">
          <thead>
            <tr>
              <th>Clinical factor</th>
              <th>BCS BioCeramic Putty</th>
              <th>Conventional mixed repair material</th>
            </tr>
          </thead>
          <tbody>
            {bcsPutty.comparisonRows.map((row) => (
              <tr>
                <th>{row.label}</th>
                <td>{row.product}</td>
                <td>{row.conventional}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="bcs-putty-support-section" aria-labelledby="bcs-putty-support-title">
      <div class="bcs-putty-section-heading">
        <p class="bcs-putty-eyebrow">Packaging and questions</p>
        <h2 id="bcs-putty-support-title">Technical details kept close to the clinical story.</h2>
      </div>

      <div class="bcs-putty-support-grid">
        <article class="bcs-putty-packaging">
          <span>Packaging</span>
          {bcsPutty.packaging.map((item) => (
            <p>{item}</p>
          ))}
        </article>

        <div class="bcs-putty-faq-list">
          {bcsPutty.faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bcs-putty-cta-section" aria-labelledby="bcs-putty-cta-title">
      <div class="bcs-putty-cta-copy">
        <h2 id="bcs-putty-cta-title">Use BCS BioCeramic Putty where repair procedures need controlled handling.</h2>
        <p>{bcsPutty.regulatoryNote}</p>
      </div>
      <div class="bcs-putty-cta-actions">
        <a class="bcs-putty-button primary" href={familyHref}>Open BCS family</a>
        <a class="bcs-putty-button secondary on-dark" href={contactHref}>Contact EndoTech</a>
      </div>
    </section>
  </main>
</ProductLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .bcs-putty-page {
    background: #ffffff;
    color: #181c20;
  }

  .bcs-putty-hero,
  .bcs-putty-technical-band,
  .bcs-putty-journey-section,
  .bcs-putty-story-section,
  .bcs-putty-applications-section,
  .bcs-putty-rationale-section,
  .bcs-putty-comparison-section,
  .bcs-putty-support-section,
  .bcs-putty-cta-section {
    padding-left: 56px;
    padding-right: 56px;
  }

  .bcs-putty-eyebrow,
  .bcs-putty-story-card span,
  .bcs-putty-packaging span {
    margin: 0 0 14px;
    color: #00639c;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .bcs-putty-hero h1,
  .bcs-putty-technical-card h3,
  .bcs-putty-journey-copy h2,
  .bcs-putty-journey-copy h3,
  .bcs-putty-story-copy h2,
  .bcs-putty-story-grid h3,
  .bcs-putty-section-heading h2,
  .bcs-putty-application-grid h3,
  .bcs-putty-comparison-heading h2,
  .bcs-putty-support-section h2,
  .bcs-putty-cta-copy h2 {
    margin: 0;
    color: #181c20;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .bcs-putty-hero {
    display: grid;
    justify-items: center;
    padding-top: 104px;
    padding-bottom: 88px;
    text-align: center;
    background: #ffffff;
  }

  .bcs-putty-hero-copy {
    max-width: 760px;
  }

  .bcs-putty-hero h1 {
    font-size: clamp(3.4rem, 6.8vw, 5.4rem);
    line-height: 0.98;
  }

  .bcs-putty-hero-lede,
  .bcs-putty-technical-card p,
  .bcs-putty-journey-copy p,
  .bcs-putty-story-grid p,
  .bcs-putty-section-heading p,
  .bcs-putty-application-grid span,
  .bcs-putty-rationale-grid p,
  .bcs-putty-comparison-heading p,
  .bcs-putty-packaging p,
  .bcs-putty-faq-list p,
  .bcs-putty-cta-copy p {
    color: #404750;
    font-family: Inter, 'Segoe UI', sans-serif;
    line-height: 1.65;
  }

  .bcs-putty-hero-lede {
    max-width: 620px;
    margin: 18px auto 0;
    font-size: 1rem;
  }

  .bcs-putty-hero-visual {
    width: 100%;
    max-width: 640px;
    margin: 44px 0 0;
  }

  .bcs-putty-hero-visual img {
    width: 100%;
    max-height: 520px;
    object-fit: contain;
  }

  .bcs-putty-hero-actions,
  .bcs-putty-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .bcs-putty-hero-actions {
    justify-content: center;
    margin-top: 30px;
  }

  .bcs-putty-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border-radius: 6px;
    padding: 0 18px;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      color 180ms ease,
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bcs-putty-button:hover,
  .bcs-putty-button:focus-visible {
    transform: translateY(-1px);
    box-shadow:
      0 12px 24px rgba(15, 23, 42, 0.08),
      0 2px 6px rgba(15, 23, 42, 0.05);
  }

  .bcs-putty-button.primary {
    background: #005c92;
    border: 1px solid #005c92;
    color: #ffffff;
  }

  .bcs-putty-button.primary:hover,
  .bcs-putty-button.primary:focus-visible {
    background: #0a6ca8;
    border-color: #0a6ca8;
  }

  .bcs-putty-button.secondary {
    background: #ffffff;
    border: 1px solid #c0c7d2;
    color: #404750;
  }

  .bcs-putty-button.secondary:hover,
  .bcs-putty-button.secondary:focus-visible {
    background: #f8fbfd;
    border-color: #aeb8c5;
    color: #1f2937;
  }

  .bcs-putty-button.on-dark,
  .bcs-putty-button.secondary.on-dark {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }

  .bcs-putty-button.on-dark:hover,
  .bcs-putty-button.on-dark:focus-visible,
  .bcs-putty-button.secondary.on-dark:hover,
  .bcs-putty-button.secondary.on-dark:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.42);
    color: #ffffff;
  }

  .bcs-putty-technical-band,
  .bcs-putty-journey-section,
  .bcs-putty-story-section,
  .bcs-putty-applications-section,
  .bcs-putty-rationale-section,
  .bcs-putty-comparison-section,
  .bcs-putty-support-section {
    border-top: 1px solid #e3e8ee;
  }

  .bcs-putty-technical-band,
  .bcs-putty-journey-section,
  .bcs-putty-story-section,
  .bcs-putty-applications-section,
  .bcs-putty-rationale-section,
  .bcs-putty-support-section {
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .bcs-putty-comparison-section {
    padding-top: 88px;
    padding-bottom: 88px;
    background: #f7f9ff;
  }

  .bcs-putty-technical-grid,
  .bcs-putty-journey-section,
  .bcs-putty-story-section,
  .bcs-putty-applications-section,
  .bcs-putty-rationale-section,
  .bcs-putty-support-section {
    max-width: 1280px;
    margin: 0 auto;
  }

  .bcs-putty-technical-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.74fr);
    gap: 18px;
  }

  .bcs-putty-technical-card {
    display: grid;
    gap: 28px;
    align-content: space-between;
    min-height: 280px;
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    padding: 28px;
    background: #ffffff;
    box-shadow: 0 1px 3px rgba(0, 55, 112, 0.06);
  }

  .bcs-putty-technical-card h3 {
    font-size: 1.28rem;
    line-height: 1.16;
  }

  .bcs-putty-technical-card p {
    max-width: 35ch;
    margin: 12px 0 0;
    font-size: 0.94rem;
  }

  .bcs-putty-technical-card img {
    width: 100%;
    max-width: 260px;
    max-height: 180px;
    justify-self: end;
    object-fit: contain;
  }

  .bcs-putty-technical-card.is-dark {
    background: #005c92;
    border-color: #005c92;
  }

  .bcs-putty-technical-card.is-dark h3,
  .bcs-putty-technical-card.is-dark p,
  .bcs-putty-technical-card.is-dark span {
    color: #ffffff;
  }

  .bcs-putty-technical-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 18px;
  }

  .bcs-putty-technical-meta span {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .bcs-putty-journey-section {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: 40px;
    align-items: center;
  }

  .bcs-putty-journey-media {
    display: grid;
    place-items: center;
    min-height: 280px;
    padding: 26px;
    border-radius: 8px;
    background: #f4f6fb;
  }

  .bcs-putty-journey-media img {
    width: 100%;
    max-height: 320px;
    object-fit: contain;
  }

  .bcs-putty-journey-copy h2,
  .bcs-putty-story-copy h2,
  .bcs-putty-section-heading h2,
  .bcs-putty-comparison-heading h2,
  .bcs-putty-support-section h2,
  .bcs-putty-cta-copy h2 {
    font-size: clamp(2.1rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .bcs-putty-journey-steps {
    display: grid;
    gap: 22px;
    margin-top: 24px;
  }

  .bcs-putty-journey-steps article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: start;
  }

  .bcs-putty-journey-steps span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: #eef8fc;
    color: #005c92;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .bcs-putty-journey-steps h3 {
    font-size: 1rem;
    line-height: 1.2;
  }

  .bcs-putty-journey-steps p {
    margin: 6px 0 0;
    font-size: 0.92rem;
  }

  .bcs-putty-story-copy,
  .bcs-putty-section-heading {
    max-width: 760px;
    margin: 0 auto 36px;
  }

  .bcs-putty-story-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .bcs-putty-story-grid article {
    min-height: 240px;
    border-radius: 8px;
    padding: 28px;
  }

  .bcs-putty-story-grid article.is-light {
    border: 1px solid #e3e8ee;
    background: #f7f9ff;
  }

  .bcs-putty-story-grid article.is-dark {
    background: #181c20;
  }

  .bcs-putty-story-grid article.is-dark h3,
  .bcs-putty-story-grid article.is-dark p {
    color: #ffffff;
  }

  .bcs-putty-story-grid p {
    margin: 14px 0 0;
    font-size: 0.96rem;
  }

  .bcs-putty-application-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
  }

  .bcs-putty-application-grid article {
    min-height: 190px;
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    background: #ffffff;
    padding: 24px;
  }

  .bcs-putty-application-grid span {
    display: block;
    color: #00639c;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bcs-putty-application-grid h3 {
    margin-top: 42px;
    font-size: 1.08rem;
    line-height: 1.28;
  }

  .bcs-putty-rationale-grid,
  .bcs-putty-support-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(380px, 0.82fr);
    gap: 36px;
    align-items: start;
  }

  .bcs-putty-reason-list,
  .bcs-putty-story-card,
  .bcs-putty-packaging,
  .bcs-putty-faq-list {
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    background: #ffffff;
    padding: 24px;
  }

  .bcs-putty-reason-list p,
  .bcs-putty-story-card p,
  .bcs-putty-packaging p,
  .bcs-putty-faq-list p {
    margin: 0;
    font-size: 0.94rem;
  }

  .bcs-putty-reason-list p + p,
  .bcs-putty-packaging p + p {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid #e3e8ee;
  }

  .bcs-putty-story-card p {
    margin-top: 10px;
  }

  .bcs-putty-comparison-heading {
    max-width: 760px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .bcs-putty-comparison-heading p {
    margin: 14px 0 0;
  }

  .bcs-putty-table-shell {
    max-width: 980px;
    margin: 0 auto;
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    overflow: hidden;
    background: #ffffff;
  }

  .bcs-putty-comparison-table {
    width: 100%;
    border-collapse: collapse;
  }

  .bcs-putty-comparison-table th,
  .bcs-putty-comparison-table td {
    padding: 18px 20px;
    border-bottom: 1px solid #e3e8ee;
    text-align: left;
  }

  .bcs-putty-comparison-table thead th {
    background: #e8edf2;
    color: #404750;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
