---
import ProductLayout from '../../layouts/ProductLayout.astro';
import acrobatFiles from '../../assets/acrobat-glide-path-files.png';
import bcsSealer from '../../assets/bcs-sealer.png';
import { withBasePath } from '../../utils/paths';
import { siteConfig } from '../../config/site';

const siteUrl = Astro.site?.toString() ?? 'https://EndoTechSG.github.io';
const base = import.meta.env.BASE_URL;
const acrobatClinicalBlueprintSrc = withBasePath('/downloads/Acrobat_Clinical_Blueprint.pdf');
const acrobatIfuPdfSrc = withBasePath('/downloads/ETNZ-IFU-ACROBAT-001-Acrobat-Glide-Path.pdf');
const acrobatOrderHref = `${base}order/#acrobat-order`;
const workflowHref = `${base}technique/workflow/`;
const motorSettingsHref = `${base}technique/motor-settings/`;
const bcsHref = `${base}products/bcs/`;

const standardRange = [
  {
    size: '13/.03',
    items: [
      { length: '21 mm', sku: 'ACGP-130321RF' },
      { length: '25 mm', sku: 'ACGP-130325RF' },
      { length: '29 mm', sku: 'ACGP-130329RF' },
    ],
  },
  {
    size: '15/.03',
    items: [
      { length: '21 mm', sku: 'ACGP-150321RF' },
      { length: '25 mm', sku: 'ACGP-150325RF' },
      { length: '29 mm', sku: 'ACGP-150329RF' },
    ],
  },
  {
    size: '17/.03',
    items: [
      { length: '21 mm', sku: 'ACGP-170321RF' },
      { length: '25 mm', sku: 'ACGP-170325RF' },
      { length: '29 mm', sku: 'ACGP-170329RF' },
    ],
  },
];

const technicalCards = [
  {
    title: 'Rotary glide path progression',
    body:
      'Acrobat separates the glide stage from shaping so clinicians can create a reproducible rotary path before larger shaping files enter the canal.',
    tone: 'light',
  },
  {
    title: 'Transform Metal Technology',
    body:
      'Flexibility is positioned around the clinical problem it helps address: narrow, curved, and less forgiving anatomy during glide path development.',
    tone: 'dark',
    metric: '13/.03 to 17/.03',
  },
];

const workflowSteps = [
  {
    number: '1',
    title: 'Negotiate and confirm access',
    description:
      'Establish coronal access and a readable path before the glide sequence begins so the shaping stage is not forced too early.',
  },
  {
    number: '2',
    title: 'Create the rotary glide path',
    description:
      'Progress from 13/.03 through 17/.03 to create a more controlled route to working length in routine and curved anatomy.',
  },
  {
    number: '3',
    title: 'Move into shaping with intent',
    description:
      'Once the path is established, the clinician can transition into TransformX shaping with a cleaner, more reproducible handoff.',
  },
];

const comparisonRows = [
  {
    feature: 'Workflow role',
    acrobat: 'Dedicated rotary glide stage',
    standard: 'Often improvised before shaping',
  },
  {
    feature: 'Progression logic',
    acrobat: '13/.03, 15/.03, 17/.03 sequence',
    standard: 'Varies across systems',
  },
  {
    feature: 'Length options',
    acrobat: '21 mm, 25 mm, 29 mm',
    standard: 'May be more limited',
  },
  {
    feature: 'Restricted access option',
    acrobat: '15/.05 MB2 in 17 mm',
    standard: 'Not always available',
  },
];

const acrobatSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Acrobat Glide Path Files',
  description:
    'Rotary glide path files using Transform Metal Technology to create a controlled path to working length before shaping, with 13/.03, 15/.03, and 17/.03 sizes plus an MB2 option.',
  brand: {
    '@type': 'Brand',
    name: siteConfig.name,
  },
  category: 'Endodontic glide path files',
  image: [new URL(acrobatFiles.src, siteUrl).toString()],
  url: new URL('/products/acrobat-glide-path/', siteUrl).toString(),
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'System type', value: 'Rotary glide path files' },
    { '@type': 'PropertyValue', name: 'Technology', value: 'Transform Metal Technology' },
    { '@type': 'PropertyValue', name: 'Standard sizes', value: '13/.03, 15/.03, 17/.03' },
    { '@type': 'PropertyValue', name: 'Lengths', value: '21 mm, 25 mm, 29 mm' },
    { '@type': 'PropertyValue', name: 'MB2 option', value: '15/.05 17 mm' },
  ],
};

const downloads = [
  {
    label: 'Clinical blueprint',
    title: 'Acrobat Glide Path PDF',
    href: acrobatClinicalBlueprintSrc,
  },
  {
    label: 'Technique workflow',
    title: 'Clinical workflow overview',
    href: workflowHref,
  },
  {
    label: 'Instructions for use',
    title: 'Acrobat Glide Path IFU PDF',
    href: acrobatIfuPdfSrc,
  },
];
---

<ProductLayout
  title="Acrobat Glide Path Files | Rotary Glide Path Files for Endodontics"
  description="Acrobat Glide Path Files are rotary glide path files for endodontics, using Transform Metal Technology to support controlled progression to working length before shaping."
  image={acrobatFiles.src}
  schema={acrobatSchema}
  accent="teal"
>
  <main class="acrobat-stitch-page">
    <section class="acrobat-hero" aria-labelledby="acrobat-hero-title">
      <div class="acrobat-hero-copy">
        <div class="acrobat-rotary-glide-reveal-mask">
          <p class="acrobat-rotary-glide-reveal-text js-acrobat-rotary-glide-reveal">Rotary glide path system</p>
        </div>
        <h1 id="acrobat-hero-title">Acrobat</h1>
        <p class="acrobat-hero-lede">
          Controlled rotary glide path preparation before shaping begins, with a simple sequence designed to lead cleanly into TransformX.
        </p>
      </div>

      <figure
        data-acrobat-hero-visual
        class="acrobat-hero-visual acrobat-hero-visual--pre-reveal"
        style="transform: translateZ(0) scale(0.9);"
      >
        <img
          class="acrobat-hero-image"
          src={acrobatFiles.src}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          alt="Acrobat glide path files displayed as a rotary glide path system"
        />
      </figure>

      <div class="acrobat-hero-actions">
        <a class="acrobat-button primary" href="#product-range">Technical Specifications</a>
        <a class="acrobat-button secondary" href={motorSettingsHref}>Motor Settings</a>
      </div>

      <div class="acrobat-hero-meta" aria-label="Acrobat key range">
        <span>13/.03</span>
        <span>15/.03</span>
        <span>17/.03</span>
        <span>MB2 15/.05</span>
      </div>
    </section>

    <section class="acrobat-technical-band" aria-labelledby="acrobat-technical-title">
      <h2 class="sr-only" id="acrobat-technical-title">Technical overview</h2>
      <div class="acrobat-technical-grid">
        {technicalCards.map((card) => (
          <article class:list={['acrobat-technical-card', card.tone === 'dark' && 'is-dark']}>
            <div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </div>
            {card.metric ? (
              <div class="acrobat-technical-meta">
                <span>{card.metric}</span>
              </div>
            ) : (
              <img src={acrobatFiles.src} alt="Acrobat glide path files showing staged size progression" />
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="acrobat-journey-section" aria-labelledby="acrobat-journey-title">
      <div class="acrobat-journey-media">
        <img src={acrobatFiles.src} alt="Acrobat glide path files shown as the access-to-shaping bridge" />
      </div>

      <div class="acrobat-journey-copy">
        <p class="acrobat-eyebrow">The clinical journey</p>
        <h2 id="acrobat-journey-title">Create the path before shaping asks more of the canal.</h2>
        <div class="acrobat-journey-steps">
          {workflowSteps.map((step) => (
            <article>
              <span>{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="product-range" class="acrobat-range-section" aria-labelledby="acrobat-range-title">
      <div class="acrobat-range-heading">
        <p class="acrobat-eyebrow">Product range</p>
        <h2 id="acrobat-range-title">Sizes, lengths, and part numbers.</h2>
        <p>
          The core Acrobat range stays deliberately simple: 13/.03, 15/.03, and 17/.03 in 21 mm, 25 mm, and 29 mm lengths, plus a dedicated MB2 option.
        </p>
      </div>

      <div class="acrobat-table-shell">
        <table class="acrobat-range-table">
          <thead>
            <tr>
              <th>File</th>
              <th>21 mm</th>
              <th>25 mm</th>
              <th>29 mm</th>
            </tr>
          </thead>
          <tbody>
            {standardRange.map((row) => (
              <tr>
                <th>{row.size}</th>
                <td>{row.items[0].sku}</td>
                <td>{row.items[1].sku}</td>
                <td>{row.items[2].sku}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <article class="acrobat-mb2-card">
        <div>
          <p class="acrobat-eyebrow">MB2 option</p>
          <h3>15/.05 in 17 mm</h3>
        </div>
        <p>
          SKU `ACGP-150517RF` extends the glide path system into restricted-access cases where a shorter file format and more deliberate coronal headroom can matter.
        </p>
      </article>
    </section>

    <section class="acrobat-bcs-section" aria-labelledby="acrobat-bcs-title">
      <div class="acrobat-bcs-copy">
        <p class="acrobat-eyebrow">Seal the workflow</p>
        <h2 id="acrobat-bcs-title">BCS BioCeramic Sealer</h2>
        <p class="acrobat-bcs-lede">
          Acrobat is designed to hand off into shaping, cleaning, and final sealing as one connected clinical sequence rather than an isolated glide step.
        </p>

        <div class="acrobat-bcs-metrics">
          <div>
            <strong>Glide to shape</strong>
            <span>clear system handoff</span>
          </div>
          <div>
            <strong>Shape to seal</strong>
            <span>matched workflow logic</span>
          </div>
        </div>

        <div class="acrobat-bcs-actions">
          <a class="acrobat-button dark" href={bcsHref}>View BCS family</a>
          <a class="acrobat-inline-link" href={workflowHref}>Review clinical workflow</a>
        </div>
      </div>

      <figure class="acrobat-bcs-visual">
        <img src={bcsSealer.src} alt="BCS BioCeramic sealer as the final sealing step after glide path and shaping" />
      </figure>
    </section>

    <section class="acrobat-comparison-section" aria-labelledby="acrobat-comparison-title">
      <div class="acrobat-comparison-heading">
        <h2 id="acrobat-comparison-title">Product comparison</h2>
        <p>Transparent information for clinicians evaluating how the glide stage fits into the broader endodontic workflow.</p>
      </div>

      <div class="acrobat-table-shell">
        <table class="acrobat-comparison-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Acrobat</th>
              <th>Typical Alternative</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <th>{row.feature}</th>
                <td>{row.acrobat}</td>
                <td>{row.standard}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="acrobat-downloads-section" aria-labelledby="acrobat-downloads-title">
      <div class="acrobat-downloads-heading">
        <p class="acrobat-eyebrow">Downloads</p>
        <h2 id="acrobat-downloads-title">Files for technique review and product selection.</h2>
      </div>

      <div class="acrobat-download-list">
        {downloads.map((download) => (
          <a href={download.href}>
            <span>{download.label}</span>
            <strong>{download.title}</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="acrobat-cta-section" aria-labelledby="acrobat-cta-title">
      <div class="acrobat-cta-copy">
        <h2 id="acrobat-cta-title">Bring more control to the glide stage.</h2>
        <p>
          Review the Acrobat range, then move into the central ordering section when you are ready to combine glide path and shaping files in one order.
        </p>
      </div>
      <div class="acrobat-cta-actions">
        <a class="acrobat-button primary" href={acrobatOrderHref}>Order Acrobat Glide Path</a>
        <a class="acrobat-button secondary on-dark" href={acrobatIfuPdfSrc}>Download IFU</a>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const visual = document.querySelector('[data-acrobat-hero-visual]');
      if (!(visual instanceof HTMLElement)) return;

      const playReveal = () => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            setTimeout(() => {
              visual.style.transform = '';
              visual.classList.remove('acrobat-hero-visual--pre-reveal');
            }, 70);
          });
        });
      };

      playReveal();
    })();
  </script>

  <script is:inline>
    (() => {
      const mask = document.querySelector('.acrobat-rotary-glide-reveal-mask');
      const text = document.querySelector('.js-acrobat-rotary-glide-reveal');
      if (!(mask instanceof HTMLElement) || !(text instanceof HTMLElement)) return;

      const originalText = 'Rotary glide path system';
      text.setAttribute('aria-label', originalText);
      text.innerHTML = Array.from(originalText)
        .map((char, index) => {
          const safeChar = char === ' ' ? '&nbsp;' : char;
          return `<span class="acrobat-rotary-glide-reveal-char" aria-hidden="true" style="--char-index:${index}">${safeChar}</span>`;
        })
        .join('');

      const observer = new IntersectionObserver(
        (entries, observerInstance) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              window.setTimeout(() => {
                requestAnimationFrame(() => {
                  requestAnimationFrame(() => {
                    mask.classList.add('is-visible');
                  });
                });
              }, 180);

              observerInstance.unobserve(entry.target);
            }
          });
        },
        {
          root: null,
          threshold: 0.2,
        }
      );

      observer.observe(mask);
    })();
  </script>
</ProductLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .acrobat-stitch-page {
    background: #ffffff;
    color: #181c20;
  }

  .acrobat-hero,
  .acrobat-technical-band,
  .acrobat-journey-section,
  .acrobat-range-section,
  .acrobat-bcs-section,
  .acrobat-comparison-section,
  .acrobat-downloads-section,
  .acrobat-cta-section {
    padding-left: 56px;
    padding-right: 56px;
  }

  .acrobat-eyebrow {
    margin: 0 0 14px;
    color: #00639c;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .acrobat-hero h1,
  .acrobat-technical-card h3,
  .acrobat-journey-copy h2,
  .acrobat-journey-copy h3,
  .acrobat-range-heading h2,
  .acrobat-bcs-copy h2,
  .acrobat-mb2-card h3,
  .acrobat-comparison-heading h2,
  .acrobat-downloads-heading h2,
  .acrobat-cta-copy h2 {
    margin: 0;
    color: #181c20;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .acrobat-hero {
    display: grid;
    justify-items: center;
    padding-top: 104px;
    padding-bottom: 88px;
    text-align: center;
    background: #ffffff;
  }

  .acrobat-hero-copy {
    max-width: 740px;
  }

  .acrobat-rotary-glide-reveal-mask {
    display: block;
    overflow: hidden;
    text-align: center;
    padding: 0 0 14px;
    min-height: 24px;
  }

  .acrobat-rotary-glide-reveal-text {
    margin: 0;
    color: #00639c;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
  }

  :global(.acrobat-rotary-glide-reveal-char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(5px);
    filter: blur(1.5px);
    transition:
      opacity 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--char-index) * 12ms);
    will-change: opacity, transform, filter;
  }

  :global(.acrobat-rotary-glide-reveal-mask.is-visible .acrobat-rotary-glide-reveal-char) {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .acrobat-hero h1 {
    font-size: clamp(3.8rem, 7vw, 5.8rem);
    line-height: 0.94;
  }

  .acrobat-hero-lede,
  .acrobat-technical-card p,
  .acrobat-journey-copy p,
  .acrobat-range-heading p,
  .acrobat-mb2-card p,
  .acrobat-bcs-copy p,
  .acrobat-comparison-heading p,
  .acrobat-download-list span,
  .acrobat-cta-copy p {
    color: #404750;
    font-family: Inter, 'Segoe UI', sans-serif;
    line-height: 1.65;
  }

  .acrobat-hero-lede {
    max-width: 560px;
    margin: 18px auto 0;
    font-size: 1rem;
  }

  .acrobat-hero-visual {
    width: 100%;
    max-width: 1080px;
    margin: 52px 0 0;
    transform-origin: center center;
    transform: translateZ(0) scale(1);
    transition: transform 1320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .acrobat-hero-visual--pre-reveal {
    transform: translateZ(0) scale(0.9);
  }

  .acrobat-hero-visual img,
  .acrobat-hero-image {
    display: block;
    width: 100%;
    max-height: 780px;
    object-fit: contain;
    backface-visibility: hidden;
  }

  .acrobat-hero-actions,
  .acrobat-cta-actions,
  .acrobat-bcs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .acrobat-hero-actions {
    justify-content: center;
    margin-top: 30px;
  }

  .acrobat-hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
  }

  .acrobat-hero-meta span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    border: 1px solid #d7e0e8;
    border-radius: 999px;
    padding: 0 14px;
    color: #4e5a68;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #fbfdff;
  }

  .acrobat-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border-radius: 6px;
    padding: 0 18px;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      color 180ms ease,
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .acrobat-button:hover,
  .acrobat-button:focus-visible {
    transform: translateY(-1px);
    box-shadow:
      0 12px 24px rgba(15, 23, 42, 0.08),
      0 2px 6px rgba(15, 23, 42, 0.05);
  }

  .acrobat-button.primary {
    background: #005c92;
    border: 1px solid #005c92;
    color: #ffffff;
  }

  .acrobat-button.primary:hover,
  .acrobat-button.primary:focus-visible {
    background: #0a6ca8;
    border-color: #0a6ca8;
  }

  .acrobat-button.secondary {
    background: #ffffff;
    border: 1px solid #c0c7d2;
    color: #404750;
  }

  .acrobat-button.secondary:hover,
  .acrobat-button.secondary:focus-visible {
    background: #f8fbfd;
    border-color: #aeb8c5;
    color: #1f2937;
  }

  .acrobat-button.dark {
    background: #181c20;
    border: 1px solid #181c20;
    color: #ffffff;
  }

  .acrobat-button.dark:hover,
  .acrobat-button.dark:focus-visible {
    background: #111827;
    border-color: #111827;
  }

  .acrobat-button.on-dark,
  .acrobat-button.secondary.on-dark {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }

  .acrobat-button.on-dark:hover,
  .acrobat-button.on-dark:focus-visible,
  .acrobat-button.secondary.on-dark:hover,
  .acrobat-button.secondary.on-dark:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.42);
    color: #ffffff;
  }

  .acrobat-technical-band,
  .acrobat-journey-section,
  .acrobat-range-section,
  .acrobat-bcs-section,
  .acrobat-comparison-section,
  .acrobat-downloads-section {
    border-top: 1px solid #e3e8ee;
  }

  .acrobat-technical-band,
  .acrobat-journey-section,
  .acrobat-range-section,
  .acrobat-bcs-section,
  .acrobat-downloads-section {
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .acrobat-comparison-section {
    padding-top: 88px;
    padding-bottom: 88px;
    background: #f7f9ff;
  }

  .acrobat-technical-grid,
  .acrobat-journey-section,
  .acrobat-range-section,
  .acrobat-bcs-section,
  .acrobat-download-list {
    max-width: 1280px;
    margin: 0 auto;
  }

  .acrobat-technical-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.74fr);
    gap: 18px;
  }

  .acrobat-technical-card {
    display: grid;
    gap: 28px;
    align-content: space-between;
    min-height: 280px;
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    padding: 28px;
    background: #ffffff;
