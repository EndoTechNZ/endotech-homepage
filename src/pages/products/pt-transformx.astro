---
import ProductLayout from '../../layouts/ProductLayout.astro';
import ptProduct from '../../assets/pt-transformx.png';
import avatarTipComparison from '../../assets/avatar-tip-comparison.png';
import bcsSealer from '../../assets/bcs-sealer.png';
import { withBasePath } from '../../utils/paths';
import { siteConfig } from '../../config/site';

const siteUrl = Astro.site?.toString() ?? 'https://endotechnz.github.io';
const base = import.meta.env.BASE_URL;
const workflowPdfSrc = withBasePath('/downloads/PT-Technique-Work-Flow.pdf');
const partNumbersPdfSrc = withBasePath('/downloads/PT-Part-Numbers.pdf');
const ptOrderHref = `${base}order/#pt-order`;
const workflowHref = `${base}technique/workflow/`;
const downloadsHref = `${base}resources/downloads/`;

const ptSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'PT TransformX Files',
  description:
    'PT TransformX rotary shaping files for clinicians using a ProTaper-style workflow, combining progressive sequence logic with Avatar Tip and Transform Technology.',
  brand: {
    '@type': 'Brand',
    name: siteConfig.name,
  },
  category: 'Endodontic rotary files',
  image: [new URL(ptProduct.src, siteUrl).toString()],
  url: new URL('/products/pt-transformx/', siteUrl).toString(),
};

const technicalCards = [
  {
    title: 'Progressive PT sequence',
    body:
      'PT TransformX is positioned for clinicians who want coronal-to-apical sequence familiarity through more demanding anatomy.',
    tone: 'light',
  },
  {
    title: 'Geometry matters',
    body:
      'As the canal narrows, curves, or becomes less forgiving, tip design becomes critical. Avatar Tip is designed to guide the file along the prepared path, helping reduce aggressive apical engagement while supporting controlled progression through complex anatomy.',
    tone: 'dark',
    metric: 'SX / S1 / S2 / F1-F5',
  },
];

const workflowSteps = [
  {
    number: '1',
    title: 'Coronal access',
    description:
      'Begin with a familiar PT-style coronal strategy that reduces restrictive forces before deeper shaping begins.',
  },
  {
    number: '2',
    title: 'Shape and clean',
    description:
      'Carry progressive shaping toward working length with a sequence that still feels readable from SX through the shaping files.',
  },
  {
    number: '3',
    title: 'Finish and obturate',
    description:
      'Match the final preparation to apical anatomy, then move directly into a bioceramic sealing pathway.',
  },
];

const comparisonRows = [
  {
    feature: 'Technique transition',
    pt: 'Familiar PT-style progression',
    standard: 'Often requires more adaptation',
  },
  {
    feature: 'Sequence clarity',
    pt: 'Readable coronal-to-apical logic',
    standard: 'Varies widely by file family',
  },
  {
    feature: 'Workflow fit',
    pt: 'Access, shape, clean, then seal',
    standard: 'Often evaluated as a file-only choice',
  },
  {
    feature: 'Next step',
    pt: 'PT technique workflow PDF',
    standard: 'Compare to your current protocol',
  },
];

const downloads = [
  {
    label: 'Technical specifications',
    title: 'PT Technique Workflow PDF',
    href: workflowPdfSrc,
  },
  {
    label: 'Product file',
    title: 'PT Part Numbers PDF',
    href: partNumbersPdfSrc,
  },
];
---

<ProductLayout
  title="PT TransformX Files | Rotary Endodontic Files for ProTaper-Style Workflows"
  description="PT TransformX rotary shaping files preserve a familiar ProTaper-style sequence while using Avatar Tip and Transform Technology."
  image={ptProduct.src}
  schema={ptSchema}
  accent="teal"
>
  <main class="pt-stitch-page">
    <section class="pt-hero" aria-labelledby="pt-hero-title">
      <div class="pt-hero-copy">
        <div class="pt-next-generation-reveal-mask">
          <p class="pt-next-generation-reveal-text js-pt-next-generation-reveal">Next generation endodontics</p>
        </div>
        <h1 id="pt-hero-title">TransformX PT</h1>
        <p class="pt-hero-lede">
          PT-style shaping for clinicians already using ProTaper Gold-style sequence logic and a progressive coronal-to-apical workflow.
        </p>
      </div>

      <figure data-pt-hero-visual class="pt-hero-visual pt-hero-visual--pre-reveal" style="transform: translateZ(0) scale(0.9);">
        <img
          class="pt-hero-image"
          src={ptProduct.src}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          alt="PT TransformX rotary files displayed as a shaping system"
        />
      </figure>

      <div class="pt-hero-actions">
        <a class="pt-button primary" href="#technical-specifications">Technical Specifications</a>
        <a class="pt-button secondary" href="#downloads">Technical Files</a>
      </div>
    </section>

    <section id="technical-specifications" class="pt-technical-band" aria-labelledby="pt-technical-title">
      <h2 class="sr-only" id="pt-technical-title">Technical overview</h2>
      <div class="pt-technical-grid">
        {technicalCards.map((card) => (
          <article class:list={['pt-technical-card', card.tone === 'dark' && 'is-dark']}>
            <div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </div>
            {card.metric && (
              <div class="pt-technical-meta">
                <span>{card.metric}</span>
              </div>
            )}
            {card.tone === 'light' && (
              <img src={avatarTipComparison.src} alt="Avatar Tip geometry comparison" />
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="pt-journey-section" aria-labelledby="pt-journey-title">
      <div class="pt-journey-media">
        <img src={avatarTipComparison.src} alt="Clinical illustration supporting controlled progressive shaping" />
      </div>

      <div class="pt-journey-copy">
        <p class="pt-eyebrow">The clinical journey</p>
        <h2 id="pt-journey-title">Progressive shaping by design.</h2>
        <div class="pt-journey-steps">
          {workflowSteps.map((step) => (
            <article>
              <span>{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pt-bcs-section" aria-labelledby="pt-bcs-title">
      <div class="pt-bcs-copy">
        <p class="pt-eyebrow">Chemical engineering</p>
        <h2 id="pt-bcs-title">BCS BioCeramic Sealer</h2>
        <p class="pt-bcs-lede">
          PT TransformX sits within a matched clinical system. Preserve familiar shaping logic, then move into a sealing pathway aligned with the final restorative objective.
        </p>

        <div class="pt-bcs-metrics">
          <div>
            <strong>SX to F5</strong>
            <span>familiar PT logic</span>
          </div>
          <div>
            <strong>Shape to seal</strong>
            <span>matched workflow path</span>
          </div>
        </div>

        <div class="pt-bcs-actions">
          <a class="pt-button dark" href={downloadsHref}>Evidence &amp; Downloads</a>
          <a class="pt-inline-link" href={workflowHref}>Review clinical workflow</a>
        </div>
      </div>

      <figure class="pt-bcs-visual">
        <img src={bcsSealer.src} alt="BCS BioCeramic sealer packaging as the matched sealing stage after PT shaping" />
      </figure>
    </section>

    <section class="pt-comparison-section" aria-labelledby="pt-comparison-title">
      <div class="pt-comparison-heading">
        <h2 id="pt-comparison-title">Product Comparison</h2>
        <p>Transparent information for clinicians evaluating sequence fit and workflow role.</p>
      </div>

      <div class="pt-table-shell">
        <table class="pt-comparison-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>TransformX PT</th>
              <th>Typical Alternative</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <th>{row.feature}</th>
                <td>{row.pt}</td>
                <td>{row.standard}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="pt-downloads-section" aria-labelledby="pt-downloads-title">
      <div class="pt-downloads-heading">
        <p class="pt-eyebrow">Downloads</p>
        <h2 id="pt-downloads-title">Technical files for ordering and product evaluation.</h2>
      </div>

      <div class="pt-download-list">
        {downloads.map((download) => (
          <a href={download.href}>
            <span>{download.label}</span>
            <strong>{download.title}</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="pt-cta-section" aria-labelledby="pt-cta-title">
      <div class="pt-cta-copy">
        <h2 id="pt-cta-title">Review PT TransformX in the wider workflow.</h2>
        <p>
          Review PT TransformX, then move into the ordering section or supporting product files when you are ready to evaluate the system in practice.
        </p>
      </div>
      <div class="pt-cta-actions">
        <a class="pt-button primary" href={ptOrderHref}>Order PT TransformX</a>
        <a class="pt-button secondary on-dark" href={downloadsHref}>Open Downloads</a>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const visual = document.querySelector('[data-pt-hero-visual]');
      if (!(visual instanceof HTMLElement)) return;

      const playReveal = () => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
          setTimeout(() => {
            visual.style.transform = '';
            visual.classList.remove('pt-hero-visual--pre-reveal');
          }, 70);
          });
        });
      };

      playReveal();
    })();
  </script>

  <script is:inline>
    (() => {
      const mask = document.querySelector('.pt-next-generation-reveal-mask');
      const text = document.querySelector('.js-pt-next-generation-reveal');
      if (!(mask instanceof HTMLElement) || !(text instanceof HTMLElement)) return;

      const originalText = 'Next generation endodontics';
      text.setAttribute('aria-label', originalText);
      text.innerHTML = Array.from(originalText)
        .map((char, index) => {
          const safeChar = char === ' ' ? '&nbsp;' : char;
          return `<span class="pt-next-generation-reveal-char" aria-hidden="true" style="--char-index:${index}">${safeChar}</span>`;
        })
        .join('');

      const observer = new IntersectionObserver(
        (entries, observerInstance) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              window.setTimeout(() => {
                requestAnimationFrame(() => {
                  requestAnimationFrame(() => {
                    mask.classList.add('is-visible');
                  });
                });
              }, 180);

              observerInstance.unobserve(entry.target);
            }
          });
        },
        {
          root: null,
          threshold: 0.2,
        }
      );

      observer.observe(mask);
    })();
  </script>
</ProductLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .pt-stitch-page {
    background: #ffffff;
    color: #181c20;
  }

  .pt-hero,
  .pt-technical-band,
  .pt-journey-section,
  .pt-bcs-section,
  .pt-comparison-section,
  .pt-downloads-section,
  .pt-cta-section {
    padding-left: 56px;
    padding-right: 56px;
  }

  .pt-eyebrow {
    margin: 0 0 14px;
    color: #00639c;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pt-hero h1,
  .pt-technical-card h3,
  .pt-journey-copy h2,
  .pt-journey-copy h3,
  .pt-bcs-copy h2,
  .pt-comparison-heading h2,
  .pt-downloads-heading h2,
  .pt-cta-copy h2 {
    margin: 0;
    color: #181c20;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .pt-hero {
    display: grid;
    justify-items: center;
    padding-top: 104px;
    padding-bottom: 88px;
    text-align: center;
    background: #ffffff;
  }

  .pt-hero-copy {
    max-width: 740px;
  }

  .pt-next-generation-reveal-mask {
    display: block;
    overflow: hidden;
    text-align: center;
    padding: 0 0 14px;
    min-height: 24px;
  }

  .pt-next-generation-reveal-text {
    margin: 0;
    color: #00639c;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
  }

  :global(.pt-next-generation-reveal-char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(5px);
    filter: blur(1.5px);
    transition:
      opacity 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--char-index) * 12ms);
    will-change: opacity, transform, filter;
  }

  :global(.pt-next-generation-reveal-mask.is-visible .pt-next-generation-reveal-char) {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .pt-hero h1 {
    font-size: clamp(3.8rem, 7vw, 5.8rem);
    line-height: 0.94;
  }

  .pt-hero-lede,
  .pt-technical-card p,
  .pt-journey-copy p,
  .pt-bcs-copy p,
  .pt-comparison-heading p,
  .pt-download-list span,
  .pt-cta-copy p {
    color: #404750;
    font-family: Inter, 'Segoe UI', sans-serif;
    line-height: 1.65;
  }

  .pt-hero-lede {
    max-width: 560px;
    margin: 18px auto 0;
    font-size: 1rem;
  }

  .pt-hero-visual {
    width: 100%;
    max-width: 980px;
    margin: 44px 0 0;
    transform-origin: center center;
    transform: translateZ(0) scale(1);
    transition: transform 1320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pt-hero-visual--pre-reveal {
    transform: translateZ(0) scale(0.9);
  }

  .pt-hero-visual img,
  .pt-hero-image {
    display: block;
    width: 100%;
    max-height: 720px;
    object-fit: contain;
    backface-visibility: hidden;
  }

  .pt-hero-actions,
  .pt-cta-actions,
  .pt-bcs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .pt-hero-actions {
    justify-content: center;
    margin-top: 30px;
  }

  .pt-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border-radius: 6px;
    padding: 0 18px;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      background-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
      color 180ms ease,
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pt-button:hover,
  .pt-button:focus-visible {
    transform: translateY(-1px);
    box-shadow:
      0 12px 24px rgba(15, 23, 42, 0.08),
      0 2px 6px rgba(15, 23, 42, 0.05);
  }

  .pt-button.primary {
    background: #005c92;
    border: 1px solid #005c92;
    color: #ffffff;
  }

  .pt-button.primary:hover,
  .pt-button.primary:focus-visible {
    background: #0a6ca8;
    border-color: #0a6ca8;
  }

  .pt-button.secondary {
    background: #ffffff;
    border: 1px solid #c0c7d2;
    color: #404750;
  }

  .pt-button.secondary:hover,
  .pt-button.secondary:focus-visible {
    background: #f8fbfd;
    border-color: #aeb8c5;
    color: #1f2937;
  }

  .pt-button.dark {
    background: #181c20;
    border: 1px solid #181c20;
    color: #ffffff;
  }

  .pt-button.dark:hover,
  .pt-button.dark:focus-visible {
    background: #111827;
    border-color: #111827;
  }

  .pt-button.on-dark,
  .pt-button.secondary.on-dark {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }

  .pt-button.on-dark:hover,
  .pt-button.on-dark:focus-visible,
  .pt-button.secondary.on-dark:hover,
  .pt-button.secondary.on-dark:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.42);
    color: #ffffff;
  }

  .pt-technical-band,
  .pt-journey-section,
  .pt-bcs-section,
  .pt-comparison-section,
  .pt-downloads-section {
    border-top: 1px solid #e3e8ee;
  }

  .pt-technical-band,
  .pt-journey-section,
  .pt-bcs-section,
  .pt-downloads-section {
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .pt-comparison-section {
    padding-top: 88px;
    padding-bottom: 88px;
    background: #f7f9ff;
  }

  .pt-technical-grid,
  .pt-journey-section,
  .pt-bcs-section,
  .pt-download-list {
    max-width: 1280px;
    margin: 0 auto;
  }

  .pt-technical-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.74fr);
    gap: 18px;
  }

  .pt-technical-card {
    display: grid;
    gap: 28px;
    align-content: space-between;
    min-height: 280px;
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    padding: 28px;
    background: #ffffff;
    box-shadow: 0 1px 3px rgba(0, 55, 112, 0.06);
  }

  .pt-technical-card h3 {
    font-size: 1.28rem;
    line-height: 1.16;
  }

  .pt-technical-card p {
    max-width: 34ch;
    margin: 12px 0 0;
    font-size: 0.94rem;
  }

  .pt-technical-card img {
    width: 100%;
    max-width: 260px;
    max-height: 150px;
    justify-self: end;
    object-fit: contain;
    opacity: 0.42;
  }

  .pt-technical-card.is-dark {
    background: #005c92;
    border-color: #005c92;
  }

  .pt-technical-card.is-dark h3,
  .pt-technical-card.is-dark p,
  .pt-technical-card.is-dark span {
    color: #ffffff;
  }

  .pt-technical-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 18px;
  }

  .pt-technical-meta span {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pt-journey-section,
  .pt-bcs-section {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: 40px;
    align-items: center;
  }

  .pt-journey-media,
  .pt-bcs-visual {
    display: grid;
    place-items: center;
    min-height: 280px;
    padding: 26px;
    border-radius: 8px;
    background: #f4f6fb;
  }

  .pt-journey-media img,
  .pt-bcs-visual img {
    width: 100%;
    max-height: 320px;
    object-fit: contain;
  }

  .pt-journey-copy h2,
  .pt-bcs-copy h2,
  .pt-comparison-heading h2,
  .pt-downloads-heading h2,
  .pt-cta-copy h2 {
    font-size: clamp(2.1rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .pt-journey-steps {
    display: grid;
    gap: 22px;
    margin-top: 24px;
  }

  .pt-journey-steps article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: start;
  }

  .pt-journey-steps span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: #eef8fc;
    color: #005c92;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .pt-journey-steps h3 {
    font-size: 1rem;
    line-height: 1.2;
  }

  .pt-journey-steps p {
    margin: 6px 0 0;
    font-size: 0.92rem;
  }

  .pt-bcs-lede {
    max-width: 44ch;
    margin: 16px 0 0;
    font-size: 1rem;
  }

  .pt-bcs-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    max-width: 460px;
    margin: 28px 0 24px;
  }

  .pt-bcs-metrics div {
    border-left: 3px solid #006a6a;
    padding-left: 14px;
  }

  .pt-bcs-metrics strong {
    display: block;
    color: #006a6a;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .pt-bcs-metrics span {
    display: block;
    margin-top: 6px;
    color: #707881;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pt-inline-link {
    color: #005c92;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .pt-comparison-heading,
  .pt-downloads-heading {
    max-width: 760px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .pt-comparison-heading p,
  .pt-downloads-heading p {
    margin: 14px 0 0;
  }

  .pt-table-shell {
    max-width: 900px;
    margin: 0 auto;
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    overflow: hidden;
    background: #ffffff;
  }

  .pt-comparison-table {
    width: 100%;
    border-collapse: collapse;
  }

  .pt-comparison-table th,
  .pt-comparison-table td {
    padding: 18px 20px;
    border-bottom: 1px solid #e3e8ee;
    text-align: left;
  }

  .pt-comparison-table thead th {
    background: #e8edf2;
    color: #404750;
    font-family: Inter, 'Segoe UI', sans-serif;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pt-comparison-table tbody th {
    width: 26%;
    color: #181c20;
    font-family: Inter, 'Segoe UI', sans-serif;
