---
import ProductLayout from '../layouts/ProductLayout.astro';
import endotechLogo from '../assets/endotech-logo-2.png';
import transformLogo from '../assets/transform-s-wordmark.png';
import { nzCustomerSelectableCatalog, type NzLaunchFamily } from '../data/nzLaunchCatalog';
import { quoteFamilyLabels } from '../lib/quoteRequest';
import { siteConfig } from '../config/site';

const familyOrder: NzLaunchFamily[] = ['et', 'pt', 'micro-path', 'c-plus', 'k-files'];
const familyMeta: Record<NzLaunchFamily, { eyebrow: string; description: string }> = {
  et: {
    eyebrow: 'Rotary shaping',
    description: 'Constant-taper shaping files in the complete New Zealand ET range.',
  },
  pt: {
    eyebrow: 'Progressive taper',
    description: 'Progressive-taper shaping and finishing files for the initial New Zealand launch.',
  },
  'micro-path': {
    eyebrow: 'Glide path',
    description: 'Micro-Path standard, MB2 and extended glide-path packs.',
  },
  'c-plus': {
    eyebrow: 'Calcified canals',
    description: 'Ultra-stiff C+ hand files across the listed sizes and lengths.',
  },
  'k-files': {
    eyebrow: 'Hand files',
    description: 'Confirmed stainless-steel K-File individual and assorted packs.',
  },
};

const groupedCatalog = Object.fromEntries(
  familyOrder.map((family) => [
    family,
    nzCustomerSelectableCatalog
      .filter((item) => item.family === family)
      .sort((a, b) =>
        a.size.localeCompare(b.size, 'en-NZ', { numeric: true }) ||
        (a.lengthMm ?? 0) - (b.lengthMm ?? 0) ||
        a.sku.localeCompare(b.sku),
      ),
  ]),
) as Record<NzLaunchFamily, typeof nzCustomerSelectableCatalog>;

const encodedCatalog = encodeURIComponent(JSON.stringify(nzCustomerSelectableCatalog));
const submissionEndpoint = import.meta.env.PUBLIC_QUOTE_REQUEST_ENDPOINT || '';
const submissionEnabled = import.meta.env.PUBLIC_QUOTE_REQUEST_SUBMISSION_ENABLED === 'true';
const contactEmail = siteConfig.email.toLowerCase();
---

<ProductLayout
  title="Request a Pro Forma Invoice | EndoTech NZ"
  description="Prepare an unpriced EndoTech NZ pro forma invoice request using the complete listed Transform S, Micro-Path, C+ and K-File product range."
  image={transformLogo.src}
  accent="slate"
>
  <div
    class="quote-builder-page"
    data-quote-builder
    data-catalog={encodedCatalog}
    data-transform-logo={transformLogo.src}
    data-endotech-logo={endotechLogo.src}
    data-contact-email={contactEmail}
    data-submission-endpoint={submissionEndpoint}
    data-submission-enabled={String(submissionEnabled)}
  >
    <section class="quote-hero" aria-labelledby="quote-builder-title">
      <div class="quote-hero-copy">
        <p class="quote-eyebrow">Account pro forma request</p>
        <h1 id="quote-builder-title">Request a pro forma invoice from EndoTech NZ.</h1>
        <p class="quote-hero-lede">
          Select New Zealand products and quantities, add the practice details, then send the PDF request directly to EndoTech NZ. We will prepare the priced pro forma invoice in our invoicing system.
        </p>
        <div class="quote-hero-actions">
          <a href="#select-products">Start selecting products</a>
          <a href="#review-request">Review the request</a>
        </div>
      </div>
      <div class="quote-hero-brand" aria-label="Transform S root canal shaping system">
        <img src={transformLogo.src} width="742" height="116" alt="Transform S root canal shaping system" />
        <p>Five launch families · {nzCustomerSelectableCatalog.length} listed SKUs · no prices shown</p>
      </div>
    </section>

    <section class="quote-review-build" aria-label="How pro forma requests work">
      <strong>No online checkout</strong>
      <p>
        This page records no payment and shows no prices. It creates an unpriced pro forma invoice request that the customer can email to
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
      </p>
    </section>

    <ol class="quote-steps" aria-label="Pro forma invoice request steps">
      <li><span>1</span><strong>Select products</strong><small>Complete NZ launch list</small></li>
      <li><span>2</span><strong>Add practice details</strong><small>Nothing personal is stored</small></li>
      <li><span>3</span><strong>Review and send</strong><small>PDF, SKU list or prepared email</small></li>
    </ol>

    <section id="select-products" class="quote-section" aria-labelledby="select-products-title">
      <div class="quote-section-heading">
        <div>
          <p class="quote-eyebrow">Step 1</p>
          <h2 id="select-products-title">Select New Zealand products</h2>
          <p>Quantities are packs. Product selections are saved on this device; customer and practice details are not.</p>
        </div>
        <label class="quote-search">
          <span>Search this family</span>
          <input type="search" data-product-search placeholder="Search size, length or SKU" autocomplete="off" />
        </label>
      </div>

      <div class="quote-family-tabs" role="tablist" aria-label="Product family">
        {familyOrder.map((family, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`quote-family-${family}`}
            tabindex={index === 0 ? 0 : -1}
            class:list={{ 'is-active': index === 0 }}
            data-family-tab={family}
          >
            <span class="quote-product-label">{quoteFamilyLabels[family]}</span>
            <small>{groupedCatalog[family].length} SKUs</small>
          </button>
        ))}
      </div>

      <div class="quote-selector-layout">
        <div class="quote-family-panels">
          {familyOrder.map((family, index) => (
            <section
              id={`quote-family-${family}`}
              class="quote-family-panel"
              role="tabpanel"
              aria-label={quoteFamilyLabels[family]}
              data-family-panel={family}
              hidden={index !== 0}
            >
              <header>
                <div>
                  <p>{familyMeta[family].eyebrow}</p>
                  <h3 class="quote-product-label">{quoteFamilyLabels[family]}</h3>
                </div>
                <span>{familyMeta[family].description}</span>
              </header>
              <div class="quote-catalog-scroll">
                <table class="quote-catalog-table">
                  <thead>
                    <tr>
                      <th>Product</th>
                      <th>Size</th>
                      <th>Length</th>
                      <th>Pack</th>
                      <th>SKU</th>
                      <th>Qty</th>
                    </tr>
                  </thead>
                  <tbody>
                    {groupedCatalog[family].map((item) => (
                      <tr
                        data-catalog-row
                        data-search={`${item.system} ${item.publicMeaning} ${item.fileType} ${item.size} ${item.lengthMm ?? ''} ${item.sku}`.toLowerCase()}
                      >
                        <td>
                          <strong class="quote-product-label">{quoteFamilyLabels[item.family]}</strong>
                          <span>{item.fileType}</span>
                        </td>
                        <td data-label="Size">{item.size}</td>
                        <td data-label="Length">{item.lengthMm ? `${item.lengthMm} mm` : '—'}</td>
                        <td data-label="Pack">{item.packQty}</td>
                        <td data-label="SKU"><code>{item.sku}</code></td>
                        <td data-label="Qty">
                          <input
                            type="number"
                            min="0"
                            max="999"
                            step="1"
                            inputmode="numeric"
                            placeholder="0"
                            data-quote-quantity
                            data-sku={item.sku}
                            aria-label={`Quantity for ${quoteFamilyLabels[item.family]} ${item.size} ${item.lengthMm ? `${item.lengthMm} millimetres` : ''}, SKU ${item.sku}`}
                          />
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="quote-no-results" data-no-results hidden>No products in this family match that search.</p>
            </section>
          ))}
        </div>

        <aside class="quote-selection-card" aria-labelledby="selected-products-title">
          <div class="quote-selection-card-heading">
            <div>
              <p class="quote-eyebrow">Live request</p>
              <h3 id="selected-products-title">Selected products</h3>
            </div>
            <button type="button" data-clear-selections>Clear</button>
          </div>
          <div class="quote-selection-empty" data-selection-empty>
            Enter a pack quantity beside any listed product to add it here.
          </div>
          <div class="quote-selection-summary" data-selection-summary hidden></div>
          <footer>
            <strong data-selection-total>0 lines · 0 packs</strong>
            <a href="#practice-details">Continue to practice details</a>
          </footer>
        </aside>
      </div>
    </section>

    <section id="practice-details" class="quote-section quote-details-section" aria-labelledby="practice-details-title">
      <div class="quote-section-heading">
        <div>
          <p class="quote-eyebrow">Step 2</p>
          <h2 id="practice-details-title">Add the practice and delivery details</h2>
          <p>These details are used only to build this request. They are not saved in the browser.</p>
        </div>
        <div class="quote-privacy-note">
          <strong>Privacy</strong>
          <span>Do not include patient names, NHI numbers, images or other patient-identifiable clinical information.</span>
        </div>
      </div>

      <form class="quote-customer-form" data-customer-form novalidate>
        <div class="quote-form-grid">
          <label>
            <span>Contact name <b aria-hidden="true">*</b></span>
            <input name="fullName" type="text" autocomplete="name" maxlength="100" required />
          </label>
          <label>
            <span>Practice or account name <b aria-hidden="true">*</b></span>
            <input name="practice" type="text" autocomplete="organization" maxlength="140" required />
          </label>
          <label>
            <span>Email <b aria-hidden="true">*</b></span>
            <input name="email" type="email" autocomplete="email" maxlength="200" required />
          </label>
          <label>
            <span>Phone <b aria-hidden="true">*</b></span>
            <input name="phone" type="tel" autocomplete="tel" maxlength="50" required />
          </label>
          <label>
            <span>EndoTech NZ account number</span>
            <input name="accountNumber" type="text" maxlength="80" placeholder="If known" />
          </label>
          <label>
            <span>Purchase-order reference</span>
            <input name="purchaseOrderReference" type="text" maxlength="100" placeholder="Optional" />
          </label>
          <label class="quote-form-wide">
            <span>Delivery address <b aria-hidden="true">*</b></span>
            <textarea name="deliveryAddress" rows="4" autocomplete="shipping street-address" maxlength="500" required></textarea>
          </label>
          <label class="quote-form-wide">
            <span>Notes</span>
            <textarea name="notes" rows="4" maxlength="1500" placeholder="Availability questions or commercial notes only — no patient information"></textarea>
          </label>
          <label class="quote-honeypot" aria-hidden="true" tabindex="-1">
            <span>Website</span>
            <input name="website" type="text" autocomplete="off" tabindex="-1" />
          </label>
        </div>
        <label class="quote-consent">
          <input name="privacyConsent" type="checkbox" required />
          <span>I confirm that this request contains no patient-identifiable information and understand that EndoTech NZ must prepare and issue the priced pro forma invoice.</span>
        </label>
      </form>
    </section>

    <section id="review-request" class="quote-section quote-review-section" aria-labelledby="review-request-title">
      <div class="quote-section-heading">
        <div>
          <p class="quote-eyebrow">Step 3</p>
          <h2 id="review-request-title">Review and send the request</h2>
          <p>The website supplies SKUs and quantities only. EndoTech NZ will add pricing, GST, freight, availability and account terms in the pro forma invoice.</p>
        </div>
        <div class="quote-draft-reference">
          <span>Draft reference</span>
          <strong data-draft-reference>NZQ-DRAFT</strong>
        </div>
      </div>

      <div class="quote-review-grid">
        <div class="quote-review-card">
          <header>
            <div>
              <span>Requested products</span>
              <strong data-review-total>0 lines · 0 packs</strong>
            </div>
          </header>
          <p class="quote-review-empty" data-review-empty>No products have been selected yet.</p>
          <div class="quote-review-table-scroll">
            <table class="quote-review-table">
              <thead><tr><th>SKU</th><th>Qty</th><th>Product</th><th>Size</th><th>Length</th></tr></thead>
              <tbody data-review-lines></tbody>
            </table>
          </div>
        </div>

        <aside class="quote-review-card quote-review-details">
          <header><span>Practice details</span><strong>Live preview</strong></header>
          <dl data-review-details></dl>
        </aside>
      </div>

      <div class="quote-export-card">
        <div>
          <p class="quote-eyebrow">Ready to send</p>
          <h3>Send the PDF request directly to EndoTech NZ.</h3>
          <p id="email-attachment-help">The main button securely emails the generated PDF and customer comments straight to EndoTech NZ. It does not open an email program. Download options remain available as a backup.</p>
          <p><strong>Email recipient:</strong> <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
        </div>
        <div class="quote-export-actions">
          <button type="button" class="quote-primary-action" data-prepare-email aria-describedby="email-attachment-help">Send PDF request directly to EndoTech NZ</button>
          <button type="button" data-download-email-draft aria-describedby="email-attachment-help">Download attached email draft</button>
          <button type="button" class="quote-primary-action" data-download-pdf>Download pro forma request PDF</button>
          <button type="button" data-download-sku-list>Download SKU entry list</button>
          <button type="button" data-copy-sku-list>Copy SKU + quantity</button>
          <button type="button" data-print-request>Print / save as PDF</button>
        </div>
      </div>
      <p class="quote-status" data-quote-status data-tone="neutral" aria-live="polite"></p>
    </section>
  </div>

  <article class="quote-print-sheet" data-quote-print-sheet aria-hidden="true">
    <header class="quote-print-header">
      <img src={transformLogo.src} width="742" height="116" alt="Transform S root canal shaping system" />
      <div><strong>ENDOTECH NZ</strong><span>ENGINEERED ENDODONTICS</span></div>
    </header>
    <div class="quote-print-title">
      <div><p>UNPRICED</p><h1>Pro forma invoice request</h1></div>
      <dl><div><dt>Draft reference</dt><dd data-draft-reference></dd></div><div><dt>Created</dt><dd data-print-created></dd></div></dl>
    </div>
    <p class="quote-print-disclaimer">Customer-prepared request for EndoTech NZ review. This is not the priced pro forma invoice, a tax invoice, a purchase order or a confirmed order.</p>
    <section><h2>Practice details</h2><dl class="quote-print-details" data-print-details></dl></section>
    <section>
      <h2>Requested products</h2>
      <table><thead><tr><th>SKU</th><th>Qty</th><th>Product</th><th>Size</th><th>Length</th></tr></thead><tbody data-print-lines></tbody></table>
    </section>
    <section><h2>Notes</h2><p data-print-notes></p></section>
    <aside><strong>Next step</strong><p>Email this request to {contactEmail}. EndoTech NZ will enter the listed SKUs and quantities into its desktop invoicing app, then issue the priced pro forma invoice.</p></aside>
    <footer>EndoTech NZ · Unpriced pro forma invoice request · No patient-identifiable information</footer>
  </article>
</ProductLayout>

<script src="../scripts/quote-request-builder.ts"></script>

<style>
  :global(html) { scroll-behavior: smooth; }
  .quote-builder-page {
    --quote-navy: #0e243e;
    --quote-teal: #176562;
    --quote-teal-dark: #104d4b;
    --quote-gold: #ac7d29;
    --quote-ink: #26394b;
    --quote-muted: #647587;
    --quote-line: #dce5ea;
    --quote-pale: #f3f7f8;
    background: #fff;
    color: var(--quote-ink);
  }
  .quote-product-label { white-space: nowrap; }
  .quote-eyebrow {
    margin: 0 0 .65rem;
    color: var(--quote-teal);
    font-size: .74rem;
    font-weight: 800;
    letter-spacing: .17em;
    text-transform: uppercase;
  }
  .quote-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(19rem, .8fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding: clamp(4.5rem, 9vw, 8rem) max(1.25rem, calc((100vw - 78rem) / 2));
    background:
      radial-gradient(circle at 86% 18%, rgba(172,125,41,.13), transparent 22rem),
      radial-gradient(circle at 12% 10%, rgba(23,101,98,.12), transparent 30rem),
      linear-gradient(180deg, #f8fafb, #fff);
    border-bottom: 1px solid var(--quote-line);
  }
  .quote-hero h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--quote-navy);
    font-size: clamp(2.7rem, 6vw, 5.7rem);
    line-height: .98;
    letter-spacing: -.055em;
  }
  .quote-hero-lede {
    max-width: 43rem;
    margin: 1.5rem 0 0;
    color: #3a5064;
    font-size: clamp(1.08rem, 2vw, 1.35rem);
    line-height: 1.65;
  }
  .quote-hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 2rem; }
  .quote-hero-actions a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    padding: .7rem 1.15rem;
    border: 1px solid var(--quote-teal);
    border-radius: 999px;
    color: var(--quote-teal-dark);
    font-weight: 800;
    text-decoration: none;
  }
  .quote-hero-actions a:first-child { background: var(--quote-teal); color: #fff; }
  .quote-hero-brand {
    padding: clamp(1.8rem, 4vw, 3rem);
    border: 1px solid rgba(14,36,62,.12);
    border-top: 4px solid var(--quote-teal);
    border-radius: 1rem;
    background: rgba(255,255,255,.9);
    box-shadow: 0 1.5rem 4rem rgba(14,36,62,.09);
  }
  .quote-hero-brand img { display: block; width: 100%; height: auto; }
  .quote-hero-brand p { margin: 1.25rem 0 0; color: var(--quote-muted); font-size: .91rem; line-height: 1.5; }
  .quote-review-build {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    max-width: 78rem;
    margin: 1.5rem auto 0;
    padding: 1rem 1.25rem;
    border: 1px solid #ead8b5;
    border-radius: .75rem;
    background: #fffaf0;
    color: #5b451f;
  }
  .quote-review-build strong { white-space: nowrap; color: #7c591b; }
  .quote-review-build p { margin: 0; line-height: 1.55; }
  .quote-review-build a { color: inherit; font-weight: 800; }
  .quote-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 78rem;
    margin: 1.5rem auto 0;
    padding: 0;
    border: 1px solid var(--quote-line);
    border-radius: .9rem;
    list-style: none;
    overflow: hidden;
  }
  .quote-steps li { display: grid; grid-template-columns: 2.25rem 1fr; gap: .12rem .75rem; padding: 1rem 1.25rem; }
  .quote-steps li + li { border-left: 1px solid var(--quote-line); }
  .quote-steps li > span { grid-row: 1 / 3; display: grid; width: 2.1rem; height: 2.1rem; place-items: center; border-radius: 50%; background: var(--quote-teal); color: #fff; font-weight: 900; }
  .quote-steps strong { color: var(--quote-navy); }
  .quote-steps small { color: var(--quote-muted); }
  .quote-section { max-width: 78rem; margin: 0 auto; padding: clamp(4rem, 8vw, 7rem) 0; }
  .quote-section + .quote-section { border-top: 1px solid var(--quote-line); }
  .quote-section-heading { display: flex; gap: 2rem; justify-content: space-between; align-items: end; margin-bottom: 2rem; }
  .quote-section-heading h2 { margin: 0; color: var(--quote-navy); font-size: clamp(2rem, 4vw, 3.35rem); line-height: 1.08; letter-spacing: -.035em; }
  .quote-section-heading p:not(.quote-eyebrow) { max-width: 48rem; margin: .9rem 0 0; color: var(--quote-muted); line-height: 1.65; }
  .quote-search { width: min(100%, 22rem); }
  .quote-search span, .quote-customer-form label > span { display: block; margin-bottom: .45rem; color: var(--quote-navy); font-size: .82rem; font-weight: 800; }
  .quote-search input, .quote-customer-form input, .quote-customer-form textarea {
    width: 100%;
    border: 1px solid #c8d5dc;
    border-radius: .65rem;
    background: #fff;
    color: var(--quote-navy);
    font: inherit;
  }
  .quote-search input, .quote-customer-form input { min-height: 3rem; padding: .7rem .85rem; }
  .quote-customer-form textarea { padding: .8rem .85rem; resize: vertical; }
  .quote-search input:focus, .quote-customer-form input:focus, .quote-customer-form textarea:focus, .quote-catalog-table input:focus { outline: 3px solid rgba(23,101,98,.18); border-color: var(--quote-teal); }
  .quote-family-tabs { display: flex; gap: .6rem; padding-bottom: .8rem; overflow-x: auto; scrollbar-width: thin; }
  .quote-family-tabs button {
    display: grid;
    gap: .15rem;
    flex: 0 0 auto;
    min-height: 3.75rem;
    padding: .65rem 1rem;
    border: 1px solid var(--quote-line);
    border-radius: .75rem;
    background: #fff;
    color: var(--quote-navy);
    font: inherit;
    font-weight: 800;
    text-align: left;
    cursor: pointer;
  }
  .quote-family-tabs small { color: var(--quote-muted); font-weight: 600; }
  .quote-family-tabs button.is-active { border-color: var(--quote-teal); background: var(--quote-teal); color: #fff; box-shadow: 0 .5rem 1.5rem rgba(23,101,98,.18); }
  .quote-family-tabs button.is-active small { color: rgba(255,255,255,.78); }
  .quote-selector-layout { display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 1.25rem; align-items: start; }
  .quote-selector-layout > *, .quote-review-grid > * { min-width: 0; }
  .quote-family-panels, .quote-family-panel { min-width: 0; max-width: 100%; }
  .quote-family-panel { border: 1px solid var(--quote-line); border-radius: .9rem; background: #fff; overflow: hidden; }
  .quote-family-panel[hidden] { display: none; }
  .quote-family-panel > header { display: flex; gap: 2rem; justify-content: space-between; align-items: end; padding: 1.4rem 1.5rem; border-bottom: 1px solid var(--quote-line); background: var(--quote-pale); }
  .quote-family-panel > header p { margin: 0 0 .3rem; color: var(--quote-teal); font-size: .7rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .quote-family-panel > header h3 { margin: 0; color: var(--quote-navy); font-size: 1.45rem; }
  .quote-family-panel > header > span { max-width: 30rem; color: var(--quote-muted); font-size: .88rem; line-height: 1.45; text-align: right; }
  .quote-catalog-scroll, .quote-review-table-scroll { width: 100%; max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; }
  .quote-catalog-table { width: 100%; min-width: 47rem; border-collapse: collapse; }
  .quote-catalog-table th { padding: .65rem .75rem; background: var(--quote-navy); color: #fff; font-size: .68rem; letter-spacing: .08em; text-align: left; text-transform: uppercase; }
  .quote-catalog-table td { padding: .72rem .75rem; border-bottom: 1px solid #e8eef1; color: var(--quote-ink); font-size: .86rem; vertical-align: middle; }
  .quote-catalog-table tbody tr:hover { background: #f7fafb; }
  .quote-catalog-table td:first-child strong, .quote-review-table td:first-child strong { display: block; color: var(--quote-navy); }
  .quote-catalog-table td:first-child span, .quote-review-table td:first-child span { display: block; margin-top: .18rem; color: var(--quote-muted); font-size: .75rem; }
  .quote-catalog-table code { color: var(--quote-navy); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .78rem; white-space: nowrap; }
