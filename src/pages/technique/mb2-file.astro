---
import ProductLayout from '../../layouts/ProductLayout.astro';
import acrobatMb2FileImage from '../../assets/acrobat-mb2-file-transparent.png';

const base = import.meta.env.BASE_URL;
const mb2GatewayNumbers = Array.from({ length: 15 }, (_, index) => String(index + 1).padStart(2, '0'));
const mb2ChecklistPdfHref = `${base}downloads/EndoTech-NZ-MB2-15-Point-Protocol-Checklist.pdf`;
const acrobatMb2ProductHref = `${base}products/acrobat-glide-path/`;

const protocolNav = [
  { label: 'Technique', href: '#technique' },
  { label: 'Specifications', href: '#specifications' },
  { label: 'Checklist', href: '#checklist' },
  { label: 'Evidence', href: '#evidence' },
];

const anatomyViews = [
  {
    name: 'Classic groove',
    description: 'MB2 lies between MB1 and palatal along the developmental groove.',
    mb2: { x: 142, y: 132 },
  },
  {
    name: 'Close coronal',
    description: 'MB2 is tucked close to MB1 and may be hidden by a dentin shelf.',
    mb2: { x: 134, y: 112 },
  },
  {
    name: 'Palatal shift',
    description: 'MB2 sits farther palatal along the MB1-palatal line.',
    mb2: { x: 154, y: 154 },
  },
  {
    name: 'Distal angle',
    description: 'MB2 presents slightly distal, requiring controlled troughing direction.',
    mb2: { x: 165, y: 136 },
  },
  {
    name: 'MB1 overlap',
    description: 'MB2 partially overlaps MB1, making the second canal difficult to separate visually.',
    mb2: { x: 132, y: 82 },
  },
];

const sequenceSteps = [
  {
    number: '01',
    title: 'Dentin shelf removal',
    text: 'Use a long-shank round bur or ultrasonic tip to remove the mesial overhanging shelf between MB1 and the isthmus.',
  },
  {
    number: '02',
    title: 'Orifice localization',
    text: 'Locate the MB2 orifice, commonly 1.5 mm to 2 mm palatal to the MB1 orifice along the developmental groove.',
  },
  {
    number: '03',
    title: 'MB2 file negotiation',
    text: "Introduce the Acrobat MB2 file using feedback to confirm forward direction - never force. Use 'Available' length and then re inspect with a pre-curved hand file.",
  },
  {
    number: '04',
    title: 'Controlled advancement',
    text: 'Advance 1-2 mm at a time, withdraw to clean flutes, irrigate, and do not force past resistance.',
  },
];

const problemRows = [
  {
    constraint: 'Reduced coronal headroom',
    why: 'The handpiece has less freedom to align with the MB2 entrance.',
    response: 'The 17 mm option can improve clearance during the access stage.',
  },
  {
    constraint: 'Tight entry angle',
    why: 'The file can engage the canal wall before the path is confirmed.',
    response: 'A controlled glide path step separates entry from shaping.',
  },
  {
    constraint: 'Limited visibility',
    why: 'Small changes in tactile feedback become clinically significant.',
    response: 'Progression is based on repeatable entry, not pressure.',
  },
  {
    constraint: 'Narrow secondary canal',
    why: 'MB2 anatomy may hide under shelf dentin and isthmus detail.',
    response: 'The file is used to confirm a reproducible path before TransformX shaping.',
  },
];

const featureCards = [
  {
    label: 'Access',
    title: '17 mm working length option',
    text: 'Supports improved handpiece clearance when chamber anatomy limits positioning.',
  },
  {
    label: 'Glide path',
    title: '15/.05 controlled entry',
    text: 'Provides a deliberate access step before larger shaping files are introduced.',
  },
  {
    label: 'Workflow',
    title: 'Acrobat sequence compatibility',
    text: 'Keeps MB2 access inside the wider EndoTech glide path and TransformX workflow.',
  },
];

const benefits = [
  'Better coronal clearance',
  'More controlled canal entry',
  'Cleaner separation between access and shaping',
  'Improved tactile confidence',
  'More predictable handoff into TransformX shaping',
  'Useful in restricted maxillary molar anatomy',
];

const evidenceStats = [
  { value: '80.1%', label: 'MB2 prevalence' },
  {
    value: '59%',
    label: 'Vertucci Type II',
    configuration: '2-1',
    diagramTitle: 'Vertucci Type II two canals merging to one canal',
    paths: [
      'M39 23 C38 44 42 59 48 71 C50 85 49 107 48 125',
      'M57 23 C58 44 55 59 49 71',
    ],
    apices: [48],
  },
  {
    value: '19.9%',
    label: 'Vertucci Type I',
    configuration: '1-1',
    diagramTitle: 'Vertucci Type I one canal from chamber to apex',
    paths: ['M48 23 C47 50 49 92 48 125'],
    apices: [48],
  },
  {
    value: '15.3%',
    label: 'Vertucci Type IV',
    configuration: '2-2',
    diagramTitle: 'Vertucci Type IV two separate canals from chamber to apex',
    paths: [
      'M39 23 C38 50 38 89 39 125',
      'M57 23 C58 50 58 89 57 125',
    ],
    apices: [39, 57],
  },
  {
    value: '5.7%',
    label: 'Vertucci Type III',
    configuration: '1-2-1',
    diagramTitle: 'Vertucci Type III one canal splitting then rejoining to one canal',
    paths: [
      'M48 23 C48 42 48 50 48 59 C40 72 40 88 48 101 C49 111 49 119 48 125',
      'M48 59 C57 72 56 88 48 101',
    ],
    apices: [48],
  },
];

const relatedLinks = [
  { label: 'Acrobat Glide Path Files', href: `${base}products/acrobat-glide-path/` },
  { label: 'Rotary Glide Path Files', href: `${base}products/rotary-glide-path-files/` },
  { label: 'Motor Settings', href: `${base}technique/motor-settings/` },
  { label: 'TransformX ET Files', href: `${base}products/et-transformx/` },
];
---

<ProductLayout
  title="MB2 File Protocol | EndoTech NZ"
  description="Clinical MB2 file protocol for restricted molar access, including when a shorter Acrobat glide path file improves control before TransformX shaping."
  accent="teal"
>
  <div class="mb2-protocol-page">
    <section class="mb2-protocol-hero" aria-labelledby="mb2-protocol-title">
      <p class="mb2-protocol-eyebrow">Clinical protocol / Acrobat MB2</p>
      <h1 id="mb2-protocol-title">MB2 Mastery: Control-First Negotiation</h1>
      <nav class="mb2-protocol-local-nav" aria-label="MB2 page sections">
        <span>On this protocol</span>
        {protocolNav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </section>

    <section id="technique" class="mb2-protocol-grid" aria-label="MB2 technique overview">
      <aside class="mb2-protocol-left-stack">
        <section class="mb2-protocol-panel mb2-protocol-panel--mint mb2-anatomy-card" aria-labelledby="mb2-anatomy-title">
          <div class="mb2-protocol-panel-head">
            <h2 id="mb2-anatomy-title">Anatomy Map</h2>
            <div class="mb2-protocol-variation-control">
              <button
                class="mb2-protocol-status"
                type="button"
                data-anatomy-next
                aria-label="Show next MB2 anatomy variation"
              >
                <span data-anatomy-button-label>Variation 1</span>
              </button>
              <p>Click to show five variations</p>
            </div>
          </div>

          <figure class="mb2-anatomy-stage">
            <svg viewBox="0 0 320 260" role="img" aria-labelledby="mb2-anatomy-map-title mb2-anatomy-map-description">
              <title id="mb2-anatomy-map-title">MB1, MB2, palatal, and distobuccal orientation map</title>
              <desc id="mb2-anatomy-map-description">{anatomyViews[0].description}</desc>
              <circle cx="160" cy="130" r="97" fill="none" stroke="#77908e" stroke-dasharray="2 4" opacity="0.5" />
              <polyline data-anatomy-path points="126,78 142,132 172,186" fill="none" stroke="#77908e" opacity="0.48" />

              <g class="mb2-anatomy-node mb2-anatomy-node--mb1" transform="translate(126 78)">
                <circle r="34" fill="#dff1ec" opacity="0.08" />
                <circle r="8" fill="#e9f4f0" />
                <g aria-hidden="true" class="mb2-anatomy-labels">
                  <path d="M-13 -16 L-3 -4" />
                  <rect x="-50" y="-35" width="42" height="23" rx="8" />
                  <text x="-29" y="-20">MB1</text>
                </g>
              </g>

              <g class="mb2-anatomy-node mb2-anatomy-node--db" transform="translate(220 118)">
                <circle r="8" fill="#90a5a2" />
                <g aria-hidden="true" class="mb2-anatomy-labels">
                  <path d="M9 -4 L18 -8" />
                  <rect x="19" y="-20" width="34" height="23" rx="8" />
                  <text x="36" y="-5">DB</text>
                </g>
              </g>

              <g class="mb2-anatomy-node mb2-anatomy-node--p" transform="translate(172 186)">
                <circle r="8" fill="#90a5a2" />
                <g aria-hidden="true" class="mb2-anatomy-labels">
                  <path d="M12 -1 L21 -1" />
                  <rect x="22" y="-12" width="27" height="23" rx="8" />
                  <text x="35.5" y="3">P</text>
                </g>
              </g>

              <g class="mb2-anatomy-node mb2-anatomy-node--mb2" data-anatomy-mb2 style="transform: translate(142px, 132px);">
                <circle r="40" fill="#c84d48" opacity="0.08" />
                <circle r="8" fill="#c84d48" />
                <g aria-hidden="true" class="mb2-anatomy-labels">
                  <path d="M10 7 L17 12" />
                  <rect x="18" y="7" width="44" height="23" rx="8" />
                  <text x="40" y="22">MB2</text>
                </g>
              </g>
            </svg>
            <figcaption>
              <span>Mesial-buccal aspect / 8x mag</span>
              <strong data-anatomy-view-name>{anatomyViews[0].name}</strong>
            </figcaption>
          </figure>

          <div class="mb2-protocol-metrics" aria-label="MB2 anatomy metrics">
            <div>
              <strong>1.5<span>-2.0 mm</span></strong>
              <p>Typical MB1-MB2 orientation</p>
            </div>
            <div>
              <strong>17<span> mm</span></strong>
              <p>Short access file option</p>
            </div>
          </div>
        </section>

        <section class="mb2-protocol-panel mb2-warning-panel" aria-labelledby="mb2-warning-title">
          <h2 id="mb2-warning-title">Clinical Warning</h2>
          <p>
            The MB2 canal can hide under a shelf of dentin. Direct access without
            control can increase <strong>instrument fatigue</strong> and
            <strong>ledge formation</strong>.
          </p>
        </section>
      </aside>

      <section class="mb2-protocol-panel mb2-sequence-panel" aria-labelledby="mb2-sequence-title">
        <div class="mb2-protocol-sequence-head">
          <h2 id="mb2-sequence-title">MB2 Sequence</h2>
          <span>Sequence: Controlled Adaptation</span>
        </div>

        <div class="mb2-protocol-steps">
          {sequenceSteps.map((step) => (
            <article class="mb2-protocol-step">
              <span>{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </article>
          ))}
        </div>

        <div id="specifications" class="mb2-protocol-specs" aria-label="MB2 file specifications">
          <div>
            <span>File tip size</span>
            <strong>0.15 <small>mm</small></strong>
          </div>
          <div>
            <span>Taper option</span>
            <strong>.05</strong>
          </div>
        </div>

        <section class="mb2-available-file" aria-labelledby="mb2-available-file-title">
          <div class="mb2-available-file-visual" aria-hidden="true">
            <img
              src={acrobatMb2FileImage.src}
              alt=""
              loading="lazy"
              width={acrobatMb2FileImage.width}
              height={acrobatMb2FileImage.height}
            />
            <span class="mb2-available-status">Available</span>
          </div>

          <div class="mb2-available-file-copy">
            <p class="mb2-protocol-eyebrow">Acrobat MB2 file</p>
            <h3 id="mb2-available-file-title">Size 15, .05 taper, 17 mm short-access file.</h3>
            <p>
              This is the Acrobat MB2 file used in the sequence above: a short access
              glide-path option for controlled MB2 negotiation after the hand file has
              confirmed direction.
            </p>

            <dl class="mb2-available-file-specs" aria-label="Acrobat MB2 file ordering details">
              <div>
                <dt>Ordering code</dt>
                <dd>ACGP-150517RF</dd>
              </div>
              <div>
                <dt>Pack</dt>
                <dd>6 files</dd>
              </div>
              <div>
                <dt>Clinical role</dt>
                <dd>Controlled MB2 glide path</dd>
              </div>
            </dl>

            <a class="mb2-available-file-link" href={acrobatMb2ProductHref}>View Acrobat files</a>
          </div>
        </section>
      </section>
    </section>

    <section class="mb2-protocol-detail" aria-labelledby="mb2-clinical-problem-title">
      <div class="mb2-protocol-section-heading">
        <p class="mb2-protocol-eyebrow">Clinical Problem</p>
        <h2 id="mb2-clinical-problem-title">Restricted access changes the practical demands of rotary instrumentation.</h2>
        <p>
          MB2 cases often become difficult before the file reaches the canal. The access angle,
          headroom, visibility, and tactile feedback determine whether the clinician can enter
          the secondary canal without forcing the instrument off-axis.
        </p>
      </div>

      <div class="mb2-protocol-problem-table">
        <div class="mb2-protocol-problem-head" aria-hidden="true">
          <span>Clinical constraint</span>
          <span>Why it matters</span>
          <span>Controlled response</span>
        </div>
        {problemRows.map((row) => (
          <article class="mb2-protocol-problem-row">
            <div>
              <span>Constraint</span>
              <strong>{row.constraint}</strong>
            </div>
            <div>
              <span>Why it matters</span>
              <p>{row.why}</p>
            </div>
            <div>
              <span>Controlled response</span>
              <p>{row.response}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mb2-protocol-solution" aria-labelledby="mb2-solution-title">
      <article class="mb2-protocol-panel mb2-protocol-solution-copy">
        <p class="mb2-protocol-eyebrow">TransformX Solution</p>
        <h2 id="mb2-solution-title">Control the entry before shaping begins.</h2>
        <p>
          The Acrobat MB2 option supports a deliberate glide path step before the clinician
          transitions into TransformX ET or PT shaping. The objective is not simply to use
          a smaller file. The objective is to establish a controlled, reproducible path.
        </p>
      </article>

      <div class="mb2-protocol-feature-grid" aria-label="MB2 key features">
        {featureCards.map((feature) => (
          <article class="mb2-protocol-feature-card">
            <span>{feature.label}</span>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mb2-protocol-benefits" aria-labelledby="mb2-benefits-title">
      <div>
        <p class="mb2-protocol-eyebrow">Clinical Benefits</p>
        <h2 id="mb2-benefits-title">Benefits stay linked to the access problem.</h2>
      </div>

      <div class="mb2-protocol-benefit-grid">
        {benefits.map((benefit) => (
          <div>{benefit}</div>
        ))}
      </div>
    </section>

    <section id="checklist" class="mb2-protocol-checklist" aria-labelledby="mb2-checklist-title">
      <div class="mb2-protocol-section-heading">
        <p class="mb2-protocol-eyebrow">15-point protocol checklist</p>
        <h2 id="mb2-checklist-title">A controlled search sequence for MB2 cases.</h2>
        <p>
          Work from diagnosis to orientation, then controlled dentine removal,
          passive negotiation, pathway confirmation, and referral judgment.
        </p>
      </div>

      <div class="mb2-checklist-actions">
        <a class="mb2-checklist-button" href={`${base}technique/mb2-file/checklist/`}>
          <span class="mb2-gateway-rail" aria-hidden="true">
            {mb2GatewayNumbers.map((number) => (
              <i>{number}</i>
            ))}
          </span>
          <span class="mb2-gateway-copy">
            <span>Interactive protocol guide</span>
            <strong>Open the full 15-point MB2 guide.</strong>
            <small>
              Hover each point to reveal detailed clinical guidance for access,
              troughing, negotiation, pathway confirmation, and referral decisions.
            </small>
          </span>
          <span class="mb2-gateway-action" aria-hidden="true">
            <span>Open full guide</span>
            <b>-&gt;</b>
          </span>
        </a>

        <a class="mb2-checklist-download" href={mb2ChecklistPdfHref} download>
          <span>Download PDF</span>
          <strong>15-point chairside checklist</strong>
          <small>Printable MB2 protocol with sources.</small>
        </a>
      </div>
    </section>

    <section id="evidence" class="mb2-protocol-related" aria-labelledby="mb2-related-title">
      <div class="mb2-protocol-section-heading">
        <p class="mb2-protocol-eyebrow">Evidence and workflow</p>
        <h2 id="mb2-related-title">Review the supporting pages before adopting the sequence.</h2>
      </div>

      <aside class="mb2-evidence-snapshot" aria-label="CBCT evidence snapshot">
        <div>
          <p class="mb2-protocol-eyebrow">CBCT evidence snapshot</p>
          <h3>MB2 anatomy is common enough to search deliberately.</h3>
          <p>
            One CBCT study of maxillary permanent first molars in an Emirati population
            reported 80.1% MB2 prevalence. Vertucci Type II was the most common
            mesiobuccal root configuration.
          </p>
          <cite>
            Source:
            <a href="https://link.springer.com/article/10.1186/s12903-020-01269-2">
              Al Mheiri et al., "Evaluation of root and canal morphology of maxillary
              permanent first molars in an Emirati population; a cone-beam computed
              tomography study," BMC Oral Health, 2020.
            </a>
          </cite>
        </div>

        <dl class="mb2-evidence-stat-grid">
          {evidenceStats.map((stat) => (
            <div class={stat.paths ? 'mb2-evidence-stat mb2-evidence-stat--diagram' : 'mb2-evidence-stat'}>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
              {stat.configuration && <span class="mb2-evidence-stat-code">{stat.configuration} system</span>}
              {stat.paths && (
                <svg
                  class="mb2-vertucci-diagram"
                  viewBox="0 0 96 144"
                  role="img"
                  aria-label={stat.diagramTitle}
                >
                  <path
                    class="mb2-vertucci-root"
                    d="M31 10 C22 30 20 58 27 84 C32 105 41 121 48 134 C55 121 64 105 69 84 C76 58 74 30 65 10 C55 15 41 15 31 10 Z"
                  />
                  <path class="mb2-vertucci-chamber" d="M31 15 C40 8 56 8 65 15" />
                  {stat.paths.map((path) => (
                    <path class="mb2-vertucci-canal" d={path} />
                  ))}
                  {stat.apices?.map((x) => (
                    <circle class="mb2-vertucci-apex" cx={x} cy="125" r="3.2" />
                  ))}
                </svg>
              )}
            </div>
          ))}
        </dl>
      </aside>

      <div class="mb2-protocol-link-grid">
        {relatedLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </section>
  </div>

  <footer class="mb2-protocol-footer">
    <div>
      <p class="mb2-protocol-eyebrow">Next step</p>
      <h2>Questions about MB2 access or file selection?</h2>
      <p>
        Send a clinical question or review the Acrobat range if you want to connect the MB2
        access step into the wider EndoTech glide path and TransformX shaping workflow.
      </p>
    </div>
    <nav aria-label="MB2 footer actions">
      <a href={`${base}about/contact/`}>Ask a clinical question</a>
      <a href={`${base}products/acrobat-glide-path/`}>View Acrobat files</a>
    </nav>
  </footer>

  <script is:inline define:vars={{ anatomyViews }}>
    (() => {
      const button = document.querySelector('[data-anatomy-next]');
      const buttonLabel = document.querySelector('[data-anatomy-button-label]');
      const mb2Node = document.querySelector('[data-anatomy-mb2]');
      const connector = document.querySelector('[data-anatomy-path]');
      const viewName = document.querySelector('[data-anatomy-view-name]');
      const viewDescription = document.getElementById('mb2-anatomy-map-description');

      if (!button || !buttonLabel || !mb2Node || !connector || !viewName || !Array.isArray(anatomyViews)) {
        return;
      }

      let activeIndex = 0;

      const setAnatomyView = (nextIndex) => {
        activeIndex = (nextIndex + anatomyViews.length) % anatomyViews.length;
        const view = anatomyViews[activeIndex];

        mb2Node.style.transform = `translate(${view.mb2.x}px, ${view.mb2.y}px)`;
        connector.setAttribute('points', `126,78 ${view.mb2.x},${view.mb2.y} 172,186`);
        buttonLabel.textContent = `Variation ${activeIndex + 1}`;
        viewName.textContent = view.name;
        button.setAttribute(
          'aria-label',
          `Show next MB2 anatomy variation. Current view: ${view.name}`
        );

        if (viewDescription) {
          viewDescription.textContent = view.description;
        }
      };

      button.addEventListener('click', () => setAnatomyView(activeIndex + 1));
      setAnatomyView(0);
    })();
  </script>
</ProductLayout>

<style>
  :global(body) {
    background: #f3f6f4;
  }

  .mb2-protocol-page,
  .mb2-protocol-footer {
    --mb2-ink: #102b2d;
    --mb2-ink-2: #254b50;
    --mb2-muted: #577077;
    --mb2-soft: #f3f6f4;
    --mb2-panel: #ffffff;
    --mb2-mint: #e4f1ec;
    --mb2-line: #dce6e4;
    --mb2-line-strong: #c6d5d2;
    --mb2-dark: #102f31;
    --mb2-red: #c2413a;
    --mb2-shadow: 0 24px 54px rgba(16, 43, 45, 0.09);
    --mb2-shadow-soft: 0 12px 32px rgba(16, 43, 45, 0.06);
    color: var(--mb2-ink);
    font-family:
      Inter, "SF Pro Display", "SF Pro Text", -apple-system, BlinkMacSystemFont,
      "Segoe UI", Roboto, Arial, sans-serif;
    letter-spacing: 0;
  }

  .mb2-protocol-page {
    background: var(--mb2-soft);
  }

  #technique,
  #specifications,
  #checklist,
  #evidence {
    scroll-margin-top: 96px;
  }

  .mb2-protocol-hero,
  .mb2-protocol-grid,
  .mb2-protocol-detail,
  .mb2-protocol-solution,
  .mb2-protocol-benefits,
  .mb2-protocol-checklist,
  .mb2-protocol-related {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 56px;
    padding-right: 56px;
  }

  .mb2-protocol-hero {
    padding-top: clamp(56px, 7vw, 94px);
    padding-bottom: clamp(34px, 5vw, 58px);
  }

  .mb2-protocol-eyebrow {
    margin: 0;
    color: var(--mb2-ink-2);
    font-size: 13px;
    font-weight: 760;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .mb2-protocol-hero h1 {
    max-width: 900px;
    margin: 26px 0 0;
    color: var(--mb2-ink);
    font-size: clamp(3.35rem, 6.3vw, 4.8rem);
    font-weight: 680;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .mb2-protocol-local-nav {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 34px;
    border: 1px solid var(--mb2-line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    padding: 7px;
    box-shadow: var(--mb2-shadow-soft);
  }

  .mb2-protocol-local-nav span,
  .mb2-protocol-local-nav a {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: var(--mb2-ink-2);
    font-size: 12px;
    font-weight: 720;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

