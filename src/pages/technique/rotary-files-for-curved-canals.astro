---
import ProductLayout from '../../layouts/ProductLayout.astro';
import distalHookImage from '../../assets/education/curved-canals-distal-hook.png';
import mesialRootImage from '../../assets/education/curved-canals-mesial-root-lower-molar.png';
import stressPointImage from '../../assets/education/curved-canals-stress-point.png';

const base = import.meta.env.BASE_URL;
const curvedGatewayNumbers = Array.from({ length: 13 }, (_, index) => String(index + 1).padStart(2, '0'));
const curvedCanalChecklistPdfHref = `${base}downloads/EndoTech-NZ-Curved-Canal-13-Point-Checklist.pdf`;

const protocolNav = [
  { label: 'Technique', href: '#technique' },
  { label: 'Specifications', href: '#specifications' },
  { label: 'Checklist', href: '#checklist' },
  { label: 'Evidence', href: '#evidence' },
];

const stressPointImages = [
  {
    name: 'Mesial root stress point',
    description: 'A cleared lower molar root showing why curvature must be read before shaping pressure is added.',
    src: mesialRootImage.src,
    alt: 'Cleared mesial root of a lower molar showing canal curvature and instrument position.',
  },
  {
    name: 'Distal apical hook',
    description: 'A terminal hook is a stop-and-reassess pattern, not an invitation to force.',
    src: distalHookImage.src,
    alt: 'Cleared root showing a distal apical hook and an instrument approaching the curved endpoint.',
  },
  {
    name: 'Danger zone',
    description: 'A severe curve concentrates file contact where short engagement and recapitulation matter most.',
    src: stressPointImage.src,
    alt: 'Cleared curved root showing a pronounced canal curve and outer-wall stress region.',
  },
];

const sequenceSteps = [
  {
    number: '01',
    title: 'Read the curve',
    text: 'Study angled radiographs and use CBCT when anatomy, calcification, retreatment, or symptoms make the curve uncertain.',
  },
  {
    number: '02',
    title: 'Scout passively',
    text: 'Use a small pre-curved #08 or #10 K-file to follow the canal path with tactile feedback before rotary shaping.',
  },
  {
    number: '03',
    title: 'Confirm glide path',
    text: 'Pull back around 1 mm and confirm that the file slips back to length without forcing or handle manipulation.',
  },
  {
    number: '04',
    title: 'Shape with control',
    text: 'Use short, light engagement with irrigation, recapitulation, and clean flutes so the file follows the prepared path.',
  },
];

const problemRows = [
  {
    constraint: 'Straightening tendency',
    why: 'A file under load wants to recover toward a straighter shape.',
    response: 'Confirm the path before shaping and use light, repeatable progression.',
  },
  {
    constraint: 'Lateral wall stress',
    why: 'Curvature concentrates cyclic fatigue and contact on the outer wall.',
    response: 'Use short engagements, withdraw often, and clean flutes before re-entry.',
  },
  {
    constraint: 'Incomplete glide path',
    why: 'The shaping file is forced to negotiate and cut at the same time.',
    response: 'Scout, pre-curve, irrigate, and prove a reproducible pathway first.',
  },
  {
    constraint: 'Apical pressure',
    why: 'The last millimetres are narrow, curved, and less forgiving.',
    response: 'Protect working length with recapitulation and stop when feedback changes.',
  },
];

const quickConcepts = [
  {
    label: 'Acrobat tip',
    title: 'Feel the direction',
    text: 'The tip reads the curve with light feedback before anything is enlarged.',
  },
  {
    label: 'Acrobat flight path',
    title: 'Make the route repeatable',
    text: 'Acrobat turns that first line into a glide path the shaping file can re-enter.',
  },
  {
    label: 'Transform Technology',
    title: 'Adapt through the curve',
    text: 'The file response stays calmer where curvature creates stiffness and outer-wall load.',
  },
  {
    label: 'Avatar Tip',
    title: 'Stay guided apically',
    text: 'The shaping tip follows the prepared path instead of trying to make its own.',
  },
];

const evidenceCards = [
  {
    label: 'Passivity test',
    title: 'A glide path must be reproducible',
    text: 'The transcript set repeatedly supports withdrawing slightly and confirming that the file returns to length passively, without forcing.',
    source: 'Advanced Endodontics: Glide Path Management - Irregular Glide Path',
    href: 'https://www.youtube.com/watch?v=O9yclUIPCqA',
    icon: 'slip',
  },
  {
    label: 'Curvature reading',
    title: 'Canals often curve more than roots suggest',
    text: 'The planning principle is to read the pre-operative film and visualize the final prepared path before the first shaping file.',
    source: 'Glide Path & Shaping Strategies with Dr. Ruddle',
    href: 'https://www.youtube.com/watch?v=ClLd0AhHb7w',
    icon: 'film',
  },
  {
    label: 'Cyclic fatigue',
    title: 'Severe curves may need manual finishing',
    text: 'A decreasing radius curve can remain high risk even after glide path preparation, so finishing strategy must follow feedback.',
    source: 'Advanced Endodontics: Working Length & Patency',
    href: 'https://www.youtube.com/watch?v=qLzjL-MOtoU',
    icon: 'fatigue',
  },
  {
    label: 'Small-file control',
    title: '#08 or #10 negotiation comes first',
    text: 'The resource set repeatedly places small-file scouting before mechanical glide path or rotary shaping in curved anatomy.',
    source: 'Curved Canals transcript set: 15 reviewed sources',
    href: 'https://www.youtube.com/watch?v=RqX0R_tyM3M',
    icon: 'file',
  },
];

const relatedLinks = [
  { label: 'TransformX ET Files', href: `${base}products/et-transformx/` },
  { label: 'Acrobat Glide Path Files', href: `${base}products/acrobat-glide-path/` },
  { label: 'Transform Technology', href: `${base}technology/transform-technology/` },
  { label: 'Avatar Tip', href: `${base}technology/avatar-tip/` },
  { label: 'Motor Settings', href: `${base}technique/motor-settings/` },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: 'Curved Canals: Glide-First Control',
  description:
    'A clinical education guide for maintaining canal path, glide path control, and apical discipline when shaping curved root canals.',
  about: {
    '@type': 'MedicalCondition',
    name: 'Curved root canals',
  },
};
---

<ProductLayout
  title="Curved Canals: Glide-First Control | EndoTech NZ"
  description="A clinical protocol guide for rotary files in curved canals, with glide path discipline, apical control, Transform Technology, and Avatar Tip guidance."
  schema={schema}
  accent="teal"
>
  <section class="curve-protocol" id="technique">
    <div class="protocol-shell">
      <div class="protocol-hero">
        <div>
          <p class="eyebrow">Clinical protocol v1.0</p>
          <h1>Curved Canals: Glide-First Control</h1>
          <p class="hero-copy">
            Curvature is not just a shape. It amplifies every decision: access, pre-curve, glide path,
            rotary pressure, irrigation, and the moment you decide to stop.
          </p>
        </div>
        <nav class="protocol-nav" aria-label="Curved canal protocol sections">
          {protocolNav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>

      <div class="protocol-grid">
        <div class="left-stack">
          <article class="map-card">
            <div class="card-heading">
              <div>
                <span class="section-kicker">Anatomy map</span>
                <h2>Danger Map</h2>
              </div>
              <button class="pattern-toggle" type="button">
                <span class="status-dot" aria-hidden="true"></span>
                Stress Points
              </button>
            </div>

            <div class="curve-stage">
              <div class="stress-image-wrap">
                <img
                  id="stress-point-image"
                  src={stressPointImages[0].src}
                  alt={stressPointImages[0].alt}
                  loading="eager"
                />
              </div>
              <div class="stage-caption">
                <strong id="stress-point-name">{stressPointImages[0].name}</strong>
                <p id="stress-point-description">{stressPointImages[0].description}</p>
              </div>
            </div>

          </article>

          <article class="warning-card">
            <span>Clinical warning</span>
            <h2>Do not ask a rotary file to discover the curve.</h2>
            <p>
              Curved canals punish load. If the path is incomplete, the file can straighten, engage the
              outer wall, block with debris, ledge, transport, or fatigue before the clinician has reliable control.
            </p>
          </article>
        </div>

        <article class="sequence-card">
          <div class="sequence-header">
            <div>
              <span class="section-kicker">MB2 sibling protocol</span>
              <h2>Curve Sequence</h2>
            </div>
            <span class="sequence-pill">Glide path first</span>
          </div>

          <div class="sequence-list">
            {sequenceSteps.map((step) => (
              <article>
                <span>{step.number}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </article>
            ))}
          </div>

          <div class="sequence-specs" id="specifications">
            <div>
              <span>Primary rule</span>
              <strong>Follow</strong>
              <small>do not force</small>
            </div>
            <div>
              <span>Shaping mode</span>
              <strong>short</strong>
              <small>clean, irrigate, recapitulate</small>
            </div>
          </div>
        </article>
      </div>

      <section class="problem-section">
        <div class="section-heading">
          <span class="section-kicker">Clinical problem</span>
          <h2>Curvature changes file behaviour before shaping begins.</h2>
          <p>
            A curved canal is a control problem. The file must be allowed to follow anatomy, not convert
            the canal into a straighter path under apical pressure.
          </p>
        </div>

        <div class="problem-table" role="table" aria-label="Curved canal clinical risk factors">
          <div class="table-row table-head" role="row">
            <span role="columnheader">Constraint</span>
            <span role="columnheader">Why it matters</span>
            <span role="columnheader">Controlled response</span>
          </div>
          {problemRows.map((row) => (
            <div class="table-row" role="row">
              <strong role="cell">{row.constraint}</strong>
              <span role="cell">{row.why}</span>
              <span role="cell">{row.response}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="feature-section solution-section">
        <div class="solution-simple">
          <div class="solution-summary">
            <span class="section-kicker">EndoTech solution</span>
            <h2>Build the flight path first. Shape inside it.</h2>
            <p>
              Acrobat creates the repeatable route. TransformX then shapes that route with
              Transform Technology and Avatar Tip guidance.
            </p>
          </div>

          <div class="concept-grid" aria-label="EndoTech curved canal control concept">
            {quickConcepts.map((concept) => (
              <article>
                <span>{concept.label}</span>
                <h3>{concept.title}</h3>
                <p>{concept.text}</p>
              </article>
            ))}
          </div>

          <div class="chairside-rule">
            <span>Chairside rule</span>
            <strong>If the file stops following the path, stop shaping and rebuild the glide path.</strong>
          </div>
        </div>
      </section>

      <section class="checklist-section" id="checklist">
        <div class="checklist-actions">
          <a class="checklist-button" href={`${base}technique/rotary-files-for-curved-canals/checklist/`}>
            <span class="gateway-rail" aria-hidden="true">
              {curvedGatewayNumbers.map((number) => (
                <i>{number}</i>
              ))}
            </span>
            <span class="gateway-copy">
              <span>Interactive protocol guide</span>
              <strong>Open the full 13-point curved-canal guide.</strong>
              <small>
                Hover each point to reveal chairside guidance for glide path control,
                shaping, stop decisions, and referral judgment.
              </small>
            </span>
            <span class="gateway-action" aria-hidden="true">
              <span>Open full guide</span>
              <b>-&gt;</b>
            </span>
          </a>

          <a class="checklist-download" href={curvedCanalChecklistPdfHref} download>
            <span>Download PDF</span>
            <strong>13-point chairside checklist</strong>
            <small>Printable curved-canal protocol with sources.</small>
          </a>
        </div>
      </section>

      <section class="evidence-section" id="evidence">
        <div class="section-heading">
          <span class="section-kicker">Evidence and source anchors</span>
          <h2>Four ideas from the curved-canal source set that belong on the page.</h2>
          <p>
            The local research pack reviewed 15 curved-canal videos and transcripts. The page uses them
            as workflow anchors and redraws the clinical ideas as original diagrams.
          </p>
        </div>

        <div class="evidence-grid">
          {evidenceCards.map((card) => (
            <article>
              <div class="evidence-icon" aria-hidden="true">
                {card.icon === 'slip' && (
                  <svg viewBox="0 0 96 96">
                    <path d="M24 20 C50 32 49 61 72 76" />
                    <path class="accent-path" d="M32 39 C50 46 53 62 66 70" />
                    <circle cx="32" cy="39" r="4" />
                    <circle cx="66" cy="70" r="4" />
                  </svg>
                )}
                {card.icon === 'film' && (
                  <svg viewBox="0 0 96 96">
                    <rect x="23" y="18" width="50" height="60" rx="7" />
                    <path d="M38 27 C58 41 36 53 58 69" />
                    <path class="accent-path" d="M32 72 L64 24" />
                  </svg>
                )}
                {card.icon === 'fatigue' && (
                  <svg viewBox="0 0 96 96">
                    <path d="M28 20 C60 36 25 61 68 78" />
                    <path class="accent-path" d="M57 58 L73 50 M58 64 L77 66 M54 70 L67 82" />
                  </svg>
                )}
                {card.icon === 'file' && (
                  <svg viewBox="0 0 96 96">
                    <path d="M49 16 L49 72" />
                    <path class="accent-path" d="M49 72 C57 76 62 82 64 88" />
                    <path d="M41 23 L57 23 M42 32 L56 32 M43 41 L55 41 M44 50 L54 50" />
                  </svg>
                )}
              </div>
              <span>{card.label}</span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
              <a href={card.href} target="_blank" rel="noreferrer">{card.source}</a>
            </article>
          ))}
        </div>
      </section>

      <section class="related-section">
        <div>
          <span class="section-kicker">Related pages</span>
          <h2>Keep the curve-control pathway connected to the wider EndoTech system.</h2>
        </div>
        <div class="related-links">
          {relatedLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      </section>
    </div>
  </section>

  <script is:inline define:vars={{ stressPointImages }}>
    document.addEventListener('DOMContentLoaded', () => {
      const button = document.querySelector('.pattern-toggle');
      const image = document.getElementById('stress-point-image');
      const stressPointName = document.getElementById('stress-point-name');
      const stressPointDescription = document.getElementById('stress-point-description');
      let index = 0;

      function setStressPoint(nextIndex) {
        const item = stressPointImages[nextIndex];
        if (!item || !image || !stressPointName || !stressPointDescription) return;
        image.setAttribute('src', item.src);
        image.setAttribute('alt', item.alt);
        stressPointName.textContent = item.name;
        stressPointDescription.textContent = item.description;
      }

      button?.addEventListener('click', () => {
        index = (index + 1) % stressPointImages.length;
        setStressPoint(index);
      });
    });
  </script>
</ProductLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(.product-site-main) {
    background: #f4f7f6;
  }

  .curve-protocol {
    --ink: #10272a;
    --muted: #4b6267;
    --subtle: #6e8085;
    --canvas: #f4f7f6;
    --surface: #ffffff;
    --soft: #eef3f1;
    --mint: #dfeee8;
    --line: rgba(16, 39, 42, 0.11);
    --line-strong: rgba(16, 39, 42, 0.2);
    --accent: #4cae73;
    --danger: #c4554d;
    --dark: #132c2f;
    color: var(--ink);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.86) 0%, rgba(244, 247, 246, 0.96) 38%, #f4f7f6 100%);
    font-family: Inter, "SF Pro Display", "SF Pro Text", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .protocol-shell {
    width: min(1320px, calc(100% - 48px));
    margin: 0 auto;
    padding: 74px 0 84px;
  }

  .protocol-hero {
    display: grid;
    grid-template-columns: minmax(0, 760px) auto;
    gap: 32px;
    align-items: start;
    padding-bottom: 58px;
  }

  .eyebrow,
  .section-kicker {
    display: block;
    margin: 0 0 20px;
    color: #31575e;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .protocol-hero h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(3.05rem, 7vw, 5.9rem);
    line-height: 0.98;
    font-weight: 760;
    letter-spacing: 0;
  }

  .hero-copy {
    max-width: 700px;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: 1.14rem;
    line-height: 1.7;
  }

  .protocol-nav {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 3px;
  }

  .protocol-nav a {
    color: #30484d;
    text-decoration: none;
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 10px 12px;
    border: 1px solid transparent;
  }

  .protocol-nav a:hover {
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.68);
    border-radius: 999px;
  }

  .protocol-grid {
    display: grid;
    grid-template-columns: minmax(340px, 0.92fr) minmax(520px, 1.38fr);
    gap: 40px;
    align-items: start;
  }

  .left-stack {
    display: grid;
    gap: 26px;
  }

  .map-card,
  .sequence-card,
  .warning-card {
    border: 1px solid rgba(255, 255, 255, 0.72);
    box-shadow: 0 22px 55px rgba(18, 39, 41, 0.08);
  }

  .map-card {
    border-radius: 30px;
    padding: 38px;
    background: var(--mint);
  }

  .card-heading,
  .sequence-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 28px;
  }

  .card-heading h2,
  .sequence-header h2,
  .warning-card h2,
  .section-heading h2,
  .related-section h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.55rem, 2.2vw, 2.15rem);
    line-height: 1.16;
    letter-spacing: 0;
  }

  .card-heading .section-kicker,
  .sequence-header .section-kicker {
    margin-bottom: 10px;
  }

  .pattern-toggle {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0 15px;
    background: rgba(255, 255, 255, 0.74);
    color: var(--ink);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 850;
    cursor: pointer;
  }

  .status-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 5px rgba(76, 174, 115, 0.12);
  }

  .curve-stage {
    overflow: hidden;
    border-radius: 24px;
    background:
      radial-gradient(circle at 53% 42%, rgba(91, 164, 158, 0.22), rgba(19, 44, 47, 0) 35%),
      var(--dark);
  }

  .stress-image-wrap {
    display: grid;
    place-items: center;
    padding: 20px 20px 0;
    background: #132c2f;
  }

  .stress-image-wrap img {
    display: block;
    width: 100%;
    max-height: 560px;
    object-fit: contain;
    border-radius: 18px;
    background: #0d1719;
  }

  .curve-stage svg {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
  }

  .root-outline {
    fill: rgba(223, 238, 232, 0.035);
    stroke: rgba(223, 238, 232, 0.28);
    stroke-width: 1.4;
  }

  .access-line,
  .note-line {
    fill: none;
    stroke: rgba(223, 238, 232, 0.36);
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  .reference-path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.18);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 5 7;
    transition: d 260ms ease;
  }

  .canal-path {
    fill: none;
    stroke: #edf9f2;
    stroke-width: 4.6;
    stroke-linecap: round;
    filter: url("#softGlow");
    transition: d 260ms ease;
  }

  .danger-zone {
    fill: none;
    stroke: var(--danger);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-dasharray: 1 9;
    transition: d 260ms ease;
  }

  .orifice-dot {
    fill: #f1fbf6;
  }

  .apex-dot {
    fill: var(--danger);
  }

  .svg-label,
  .svg-note {
    fill: rgba(240, 248, 245, 0.82);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .svg-note {
    fill: rgba(239, 206, 201, 0.86);
    font-size: 8.5px;
  }

  .stage-caption {
    padding: 0 28px 26px;
    color: #edf9f2;
  }

  .stage-caption strong {
    display: block;
    font-size: 1.05rem;
  }

  .stage-caption p {
    margin: 7px 0 0;
    color: rgba(237, 249, 242, 0.72);
    line-height: 1.5;
    font-size: 0.92rem;
  }

  .warning-card {
    border-radius: 24px;
    padding: 36px 38px;
    background: var(--surface);
  }

  .warning-card span {
    color: var(--danger);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .warning-card h2 {
    margin-top: 16px;
    max-width: 440px;
  }

  .warning-card p {
    margin: 28px 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .sequence-card {
    border-radius: 30px;
    padding: 46px;
    background: var(--surface);
  }

  .sequence-pill {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--soft);
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .sequence-list {
    display: grid;
    gap: 18px;
  }

  .sequence-list article {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 18px;
    min-height: 118px;
    align-items: start;
    padding: 28px;
    border-radius: 18px;
    background: #f2f5f4;
  }

  .sequence-list article > span {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.45);
    font-size: 0.85rem;
    font-weight: 850;
  }

  .sequence-list h3 {
    margin: 2px 0 10px;
    color: var(--ink);
    font-size: 1.16rem;
    letter-spacing: 0;
  }

  .sequence-list p {
    margin: 0;
    color: var(--muted);
    line-height: 1.58;
  }

  .sequence-specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
