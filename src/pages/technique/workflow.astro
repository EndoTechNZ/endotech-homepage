---
import ProductLayout from '../../layouts/ProductLayout.astro';
import ClinicalWorkflowWheel from '../../components/home/ClinicalWorkflowWheel.astro';
import transformxSystem from '../../assets/transformx-rotary-file-system.png';

const base = import.meta.env.BASE_URL;

const principles = [
  'Irrigate thoroughly before advancing to the next file.',
  'Recapitulate with a small hand file to confirm patency.',
  'Re-irrigate before continuing the rotary sequence.',
];

const systems = [
  {
    title: 'TransformX™ ET',
    text: 'For familiar .04 / .06 constant-taper workflows, including clinicians currently using EdgeFile X7, HyFlex CM, RaCe, and similar rotary sequences.',
    href: `${base}products/et-transformx/`,
    guide: `${base}downloads/ET-Technique-Work-Flow.pdf`,
  },
  {
    title: 'TransformX™ PT',
    text: 'For clinicians already using ProTaper Gold-style sequence logic and a progressive coronal-to-apical shaping workflow.',
    href: `${base}products/pt-transformx/`,
    guide: `${base}downloads/PT-Technique-Work-Flow.pdf`,
  },
];
---

<ProductLayout
  title="Workflow Overview | EndoTech NZ"
  description="TransformX™ clinical workflow showing the sequence from glide path through shaping, cleaning, and sealing."
  accent="slate"
>
  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 sm:py-20 lg:grid-cols-[minmax(0,0.92fr)_minmax(320px,0.78fr)] lg:items-center lg:py-24">
      <div>
        <div class="workflow-page-clinical-workflow-reveal-mask">
          <p class="workflow-page-clinical-workflow-reveal-text js-workflow-page-clinical-workflow-reveal">
            Clinical Workflow
          </p>
        </div>
        <h1 class="mt-5 max-w-[11ch] text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-[3.8rem]">
          A calmer sequence from glide path to seal.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
          This page translates TransformX™ into a simple clinical system: establish access, shape with control, maintain cleaning discipline, and finish with confidence.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={`${base}resources/clinical-tips/`}
            class="inline-flex min-w-[15rem] items-center justify-center rounded-full bg-slate-900 px-6 py-3.5 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.16),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
          >
            Clinical guidance
          </a>
          <a
            href={`${base}resources/downloads/`}
            class="inline-flex min-w-[15rem] items-center justify-center rounded-full border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.82),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color,color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
          >
            Open downloads
          </a>
        </div>
      </div>

      <div class="rounded-[2rem] border border-slate-200 bg-[linear-gradient(180deg,#ffffff,#f5f8fb)] p-6 shadow-[0_28px_80px_-48px_rgba(15,23,42,0.16)] sm:p-8">
        <div class="rounded-[1.5rem] border border-slate-200 bg-white p-4">
          <img src={transformxSystem.src} alt="TransformX™ file system" class="workflow-hero-image w-full object-contain" />
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Sequence</p>
            <p class="mt-2 text-sm leading-7 text-slate-700">Use the same ET or PT logic you already know.</p>
          </div>
          <div class="rounded-[1.2rem] border border-slate-200 bg-[#123d78] p-4 text-white">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-100/90">Clinical aim</p>
            <p class="mt-2 text-sm leading-7 text-slate-100">Reduce procedural stress by keeping the workflow disciplined and repeatable.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-slate-50/70">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-20 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Workflow Sequence</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Glide, shape, clean 3D, then seal.
        </h2>
        <p class="mt-4 text-base leading-8 text-slate-600 sm:text-lg">
          The workflow is intentionally simple. The value comes from how consistently each stage is handled.
        </p>
      </div>
      <div class="mt-10">
        <ClinicalWorkflowWheel base={base} />
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto grid max-w-7xl gap-5 px-6 py-20 sm:py-20 lg:grid-cols-[minmax(0,0.92fr)_minmax(320px,0.78fr)] lg:py-24">
      <article class="rounded-[1.75rem] border border-slate-200 bg-slate-50/70 p-6 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)] sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Between Each File</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Irrigate, recapitulate, re-irrigate.
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
          This remains the simplest high-value discipline in the sequence. It supports debris removal, patency, and preparation continuity before the next rotary file is introduced.
        </p>
      </article>

      <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)]">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Key review points</p>
        <ol class="mt-5 space-y-4">
          {principles.map((item, index) => (
            <li class="flex gap-4">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-semibold text-white">
                {index + 1}
              </span>
              <p class="text-sm leading-7 text-slate-600">{item}</p>
            </li>
          ))}
        </ol>
      </article>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-slate-50/70">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-20 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">System-Specific Guides</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Match the guide to the shaping logic you already use.
        </h2>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {systems.map((system) => (
          <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)] sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Technique guide</p>
            <h3 class="mt-4 text-2xl font-bold tracking-tight text-slate-900">{system.title}</h3>
            <p class="mt-4 text-base leading-8 text-slate-600">{system.text}</p>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <a
                href={system.href}
                class="inline-flex items-center justify-center rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.16),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
              >
                View product
              </a>
              <a
                href={system.guide}
                class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.82),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color,color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
              >
                Open PDF
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-20 lg:py-24">
      <div class="rounded-[2rem] bg-gradient-to-br from-slate-900 to-slate-800 px-6 py-10 text-white shadow-[0_30px_70px_-45px_rgba(15,23,42,0.45)] sm:px-8 sm:py-12">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-300">Next Step</p>
        <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl">
          Questions about workflow or file selection?
        </h2>
        <p class="mt-4 max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">
          If you&rsquo;re unsure whether TransformX™ ET or TransformX™ PT best fits your technique, send us a question. We&rsquo;re happy to discuss workflow, shaping strategy, irrigation, obturation or any other endodontic topic.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={`${base}products/overview/`}
            class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.8),0_1px_2px_rgba(2,6,23,0.08)] transition-[background-color,box-shadow,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-slate-100 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.88),0_12px_24px_rgba(2,6,23,0.18),0_2px_6px_rgba(2,6,23,0.08)]"
          >
            View product systems
          </a>
          <a
            href={`${base}about/contact/`}
            class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/[0.04] px-6 py-3.5 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur-sm transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-white/35 hover:bg-white/[0.08] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_12px_24px_rgba(2,6,23,0.18)]"
          >
            Ask a clinical question
          </a>
        </div>
      </div>
    </div>
  </section>
</ProductLayout>

<script>
  const workflowPageClinicalWorkflowMask = document.querySelector('.workflow-page-clinical-workflow-reveal-mask');
  const workflowPageClinicalWorkflowText = document.querySelector('.js-workflow-page-clinical-workflow-reveal');

  if (workflowPageClinicalWorkflowMask && workflowPageClinicalWorkflowText) {
    const originalText = 'Clinical Workflow';

    workflowPageClinicalWorkflowText.setAttribute('aria-label', originalText);
    workflowPageClinicalWorkflowText.innerHTML = Array.from(originalText)
      .map((char, index) => {
        const safeChar = char === ' ' ? '&nbsp;' : char;
        return `<span class="workflow-page-clinical-workflow-reveal-char" aria-hidden="true" style="--char-index:${index}">${safeChar}</span>`;
      })
      .join('');

    const workflowPageClinicalWorkflowObserver = new IntersectionObserver(
      (entries, observerInstance) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            window.setTimeout(() => {
              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  workflowPageClinicalWorkflowMask.classList.add('is-visible');
                });
              });
            }, 180);

            observerInstance.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        threshold: 0.2,
      }
    );

    workflowPageClinicalWorkflowObserver.observe(workflowPageClinicalWorkflowMask);
  }
</script>

<style>
  .workflow-page-clinical-workflow-reveal-mask {
    display: block;
    overflow: hidden;
    text-align: left;
    padding: 0 0 14px;
    min-height: 24px;
  }

  .workflow-page-clinical-workflow-reveal-text {
    margin: 0;
    color: #64748b;
    font-size: 0.75rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    text-align: left;
    white-space: nowrap;
  }

  :global(.workflow-page-clinical-workflow-reveal-char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(5px);
    filter: blur(1.5px);
    transition:
      opacity 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--char-index) * 12ms);
    will-change: opacity, transform, filter;
  }

  :global(.workflow-page-clinical-workflow-reveal-mask.is-visible .workflow-page-clinical-workflow-reveal-char) {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .workflow-hero-image {
    transform: scaleY(-1);
    transform-origin: center;
  }
</style>
