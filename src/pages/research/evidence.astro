---
import ProductLayout from '../../layouts/ProductLayout.astro';
import {
  evidenceChecklistItems,
  evidenceOutcomeVideoLibrary,
} from '../../data/evidenceChecklist';

const base = import.meta.env.BASE_URL;
const checklistHref = `${base}research/evidence/checklist/`;
const checklistPdfHref = `${base}downloads/EndoTech-NZ-Endodontic-Outcomes-10-Point-Checklist.pdf`;
const gatewayNumbers = evidenceChecklistItems.map((item) => item.number);

const metrics = [
  {
    value: '75-83%',
    label: 'Primary RCT healing',
    note: 'Approximate healing range cited from the current Evidence page source set.',
  },
  {
    value: '77-80%',
    label: 'Secondary RCT healing',
    note: 'Retreatment outcomes remain sensitive to disinfection and apical control.',
  },
  {
    value: '95%',
    label: 'Four-year tooth survival',
    note: 'Tooth retention depends on endodontic control and the restorative pathway.',
  },
];

const domains = [
  {
    number: '01',
    title: 'Pre-operative status',
    problem: 'Lesions, symptoms, retreatment history, cracks, and restorability change the baseline prognosis.',
    response: 'Name the risk before choosing the sequence.',
  },
  {
    number: '02',
    title: 'Apical extent',
    problem: 'Under-extension and over-extension both reduce biological control in the apical third.',
    response: 'Use working length evidence, tactile feedback, and a controlled terminus.',
  },
  {
    number: '03',
    title: 'Obturation quality',
    problem: 'Voids, short fills, and extrusion usually reflect preparation and apical-control problems upstream.',
    response: 'Shape to support irrigant exchange, cone fit, and a dense seal.',
  },
  {
    number: '04',
    title: 'Coronal restoration',
    problem: 'A delayed or leaking restoration can compromise an otherwise controlled endodontic result.',
    response: 'Plan the restorative seal and structural protection before treatment is complete.',
  },
  {
    number: '05',
    title: 'Procedural control',
    problem: 'Transportation, ledging, perforation, blocked canals, and file separation can turn anatomy into outcome risk.',
    response: 'Preserve the original path and stop when feedback becomes unreliable.',
  },
];

const workflowSteps = [
  {
    title: 'Diagnose the case',
    copy: 'Record pulpal status, apical status, symptoms, lesion size, restorability, and retreatment history.',
  },
  {
    title: 'Control the pathway',
    copy: 'Protect length, curvature, patency, and the apical stop before shaping becomes mechanical.',
  },
  {
    title: 'Create conditions for seal',
    copy: 'Prepare for irrigant exchange, obturation density, controlled termination, and restorative protection.',
  },
  {
    title: 'Review before retreating',
    copy: 'Compare healing against baseline, symptoms, restoration, missed anatomy, and time.',
  },
];

const outcomeVisualStages = [
  { number: '01', label: 'Diagnose' },
  { number: '02', label: 'Control' },
  { number: '03', label: 'Seal' },
  { number: '04', label: 'Review' },
];

const transformLinks = [
  {
    label: 'Avatar Tip',
    href: `${base}technology/avatar-tip/`,
    title: 'Apical guidance',
    copy: 'Supports controlled advancement in the apical third, where length and terminus decisions carry biological consequence.',
  },
  {
    label: 'Transform Technology',
    href: `${base}technology/transform-technology/`,
    title: 'Curvature response',
    copy: 'Supports adaptability and centred shaping behaviour when canal anatomy resists a straight-line preparation.',
  },
  {
    label: 'Curved canal guide',
    href: `${base}technique/rotary-files-for-curved-canals/`,
    title: 'Procedural discipline',
    copy: 'Connects diagnosis, small-file scouting, glide path confirmation, short engagement, and stop-or-refer decisions.',
  },
];

const referenceCards = [
  {
    label: 'Ng outcome research',
    citation:
      'Ng Y-L, Mann V, Gulabivala K. A prospective study of factors affecting outcomes of nonsurgical root canal treatment: Part 1: periapical health. International Endodontic Journal. 2011;44(7):583-609; Part 2: tooth survival. 2011;44(7):610-625.',
    importance:
      'Defines outcomes as measurable healing and survival endpoints. Useful because it links prognosis to patient, tooth, technical, and restorative factors rather than a single instrument choice.',
  },
  {
    label: 'Friedman Toronto Study',
    citation:
      'Friedman S, Abitbol S, Lawrence HP. Treatment outcome in endodontics: the Toronto Study. Phase 1: initial treatment. Journal of Endodontics. 2003;29(12):787-793.',
    importance:
      'The Toronto Study is a landmark prospective clinical series. It shows apical periodontitis and case factors shape healing probability, giving clinicians a realistic framework for prognosis.',
  },
  {
    label: 'Ricucci and Siqueira',
    citation:
      'Ricucci D, Siqueira JF Jr, Bate AL, Pitt Ford TR. Histologic investigation of root canal-treated teeth with apical periodontitis: a retrospective study from twenty-four patients. Journal of Endodontics. 2009;35(4):493-502.',
    importance:
      'Connects persistent disease with tissue and microbial findings after treatment. Useful because it keeps outcome claims biological: symptoms, radiographs, anatomy, infection, and apical tissues must be read together.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: 'Clinical Evidence for Endodontic Outcomes',
  description:
    'An evidence-led guide to controllable endodontic outcome variables, apical management, obturation quality, restoration, retreatment judgment, and Transform S workflow fit.',
  about: {
    '@type': 'MedicalProcedure',
    name: 'Non-surgical root canal treatment',
  },
};
---

<ProductLayout
  title="Clinical Evidence | EndoTech NZ"
  description="Evidence-led guide to controllable endodontic outcome variables, apical control, obturation quality, restoration, retreatment decisions, and Transform S workflow fit."
  schema={schema}
  accent="teal"
>
  <section class="evidence-page">
    <section class="evidence-hero" aria-labelledby="evidence-title">
      <div class="evidence-hero-copy">
        <p class="evidence-eyebrow">Clinical evidence / outcome variables</p>
        <h1 id="evidence-title">Endodontic outcomes are built from controllable steps.</h1>
        <p>
          Biology sets the baseline. Clinical control changes the conditions for healing:
          diagnosis, apical extent, canal path, disinfection, obturation, restoration, and review.
        </p>
        <div class="evidence-hero-actions" aria-label="Evidence page quick links">
          <a href="#checklist">Open the 10-point guide</a>
          <a href="#video-library">Review video sources</a>
        </div>
      </div>

      <div class="outcome-visual" aria-label="Outcome variable map">
        <div class="outcome-visual-top">
          <span>Outcome map</span>
          <strong>Diagnose -> Control -> Seal -> Restore -> Review</strong>
        </div>
        <svg class="outcome-svg" viewBox="0 0 560 450" role="img" aria-labelledby="outcome-svg-title">
          <title id="outcome-svg-title">Clinical tooth cross-section showing pulp space, canal pathway, periodontal tissues, and apical anatomy</title>
          <defs>
            <linearGradient id="sectionPanel" x1="0" x2="1" y1="0" y2="1">
              <stop offset="0" stop-color="#ffffff" />
              <stop offset="0.72" stop-color="#f8fbfd" />
              <stop offset="1" stop-color="#eef6fb" />
            </linearGradient>
            <linearGradient id="enamelFill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="#fffdf5" />
              <stop offset="0.58" stop-color="#f6f3e6" />
              <stop offset="1" stop-color="#ece8d4" />
            </linearGradient>
            <linearGradient id="dentinFill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="#dfeef4" />
              <stop offset="1" stop-color="#cddfe7" />
            </linearGradient>
            <linearGradient id="pulpFill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="#9e605d" />
              <stop offset="1" stop-color="#c88487" />
            </linearGradient>
            <filter id="toothSectionShadow" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="0" dy="18" stdDeviation="20" flood-color="#0f2238" flood-opacity="0.10" />
            </filter>
            <pattern id="boneTexture" width="22" height="22" patternUnits="userSpaceOnUse">
              <circle cx="4" cy="5" r="2.1" fill="#c5bea5" opacity="0.45" />
              <circle cx="15" cy="8" r="1.8" fill="#c5bea5" opacity="0.38" />
              <circle cx="9" cy="17" r="2.4" fill="#c5bea5" opacity="0.34" />
              <circle cx="19" cy="19" r="1.4" fill="#c5bea5" opacity="0.34" />
            </pattern>
          </defs>

          <rect x="18" y="18" width="524" height="394" rx="34" fill="url(#sectionPanel)" stroke="#d7e2ea" />

          <g filter="url(#toothSectionShadow)">
            <path
              d="M84 230c32-25 64-42 101-46 19-2 37 0 55 7 21 8 39 8 59 0 19-7 39-10 60-7 39 5 77 25 116 48l-22 161H112Z"
              fill="#e9e1c6"
              stroke="#cfc7a9"
              stroke-width="3"
            />
            <path
              d="M84 230c35-31 73-51 115-56 26-3 50 1 74 11 26 11 48 11 75 0 25-10 51-14 78-10 31 5 58 19 91 43l-23 58c-46-29-81-40-117-37-30 2-55 13-82 29-25 15-51 15-77 0-25-15-51-26-79-28-35-3-68 10-113 40Z"
              fill="#d9859f"
              opacity="0.86"
              stroke="#c46f8a"
              stroke-width="3"
            />
            <path d="M112 273h341v120H112Z" fill="url(#boneTexture)" opacity="0.86" />

            <path
              d="M270 48c-26-17-64-12-82 11-19 25-16 60-1 94 12 27 23 52 32 88 12 47 18 104 24 154 4 27 13 45 27 46 17 1 22-22 26-52 3-22 8-59 18-59 10 0 16 38 20 61 5 29 12 50 28 49 16-1 24-21 29-53 8-51 15-107 28-154 10-36 22-61 35-88 16-34 19-70-1-95-19-24-56-29-83-12-22 14-48 14-70 0Z"
              fill="url(#enamelFill)"
              stroke="#cfcab4"
              stroke-width="4"
            />
            <path
              d="M280 110c-21-11-47-8-61 10-14 19-8 49 5 78 12 26 20 57 27 104 5 33 9 66 14 94 2 12 7 20 14 20 8 0 11-13 13-29 5-43 11-84 28-84 17 0 24 43 31 85 3 16 7 28 14 28 8 0 13-10 15-22 5-29 10-62 16-95 9-46 17-76 29-102 14-29 19-58 5-78-14-18-41-22-62-11-21 11-47 11-68 0Z"
              fill="url(#dentinFill)"
              stroke="#d3d8cf"
              stroke-width="3"
            />
            <path
              d="M281 140c-15-8-35-4-45 10-9 14-5 35 5 58 12 27 20 61 24 107 3 35 6 73 8 100 1 9 5 14 10 14 6 0 8-8 9-19 4-46 7-101 24-101 17 0 21 55 26 101 1 10 4 18 9 18 6 0 10-6 11-15 3-27 6-64 10-99 5-45 13-78 26-105 10-22 15-44 5-58-10-14-30-18-45-10-18 9-39 9-58 0Z"
              fill="url(#pulpFill)"
              opacity="0.94"
              stroke="#b56f76"
              stroke-width="3"
            />
            <path d="M287 173 C287 220 288 265 288 312 C288 354 286 392 283 428" fill="none" stroke="#0b75b7" stroke-width="6" stroke-linecap="round" />
            <path d="M343 174 C349 221 350 260 347 298 C344 340 350 382 358 420" fill="none" stroke="#1ba6a6" stroke-width="5" stroke-linecap="round" />
            <path d="M302 201c-16-12-26-25-30-42" fill="none" stroke="#d9a326" stroke-width="3" stroke-linecap="round" />
            <path d="M302 207c-17 2-31 11-41 27" fill="none" stroke="#d9a326" stroke-width="3" stroke-linecap="round" />
            <path d="M337 202c14-14 22-29 24-47" fill="none" stroke="#d9a326" stroke-width="3" stroke-linecap="round" />
            <path d="M339 209c15 3 27 14 35 30" fill="none" stroke="#d9a326" stroke-width="3" stroke-linecap="round" />
          </g>
        </svg>
        <div class="outcome-visual-strip" aria-label="Outcome workflow stages">
          {outcomeVisualStages.map((step) => (
            <span>
              <b>{step.number}</b>
              <em>{step.label}</em>
            </span>
          ))}
        </div>
      </div>
    </section>

    <section class="evidence-metrics" aria-label="Evidence outcome snapshot">
      {metrics.map((metric) => (
        <article>
          <span>{metric.label}</span>
          <strong>{metric.value}</strong>
          <p>{metric.note}</p>
        </article>
      ))}
    </section>

    <section class="evidence-band evidence-problem" aria-labelledby="problem-title">
      <div class="section-heading">
        <p class="evidence-eyebrow">Clinical problem</p>
        <h2 id="problem-title">Outcome risk appears when the controllable variables drift.</h2>
        <p>
          Prognosis improves when diagnosis, length, disinfection, obturation, restoration,
          and review are controlled as one pathway.
        </p>
      </div>

      <div class="domain-grid">
        {domains.map((domain) => (
          <article>
            <span>{domain.number}</span>
            <h3>{domain.title}</h3>
            <p>{domain.problem}</p>
            <strong>{domain.response}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="evidence-band evidence-features" aria-labelledby="features-title">
      <div class="section-heading">
        <p class="evidence-eyebrow">Key features linked to clinical problems</p>
        <h2 id="features-title">Three places where careful clinical planning supports outcome discipline.</h2>
      </div>

      <div class="feature-grid">
        {transformLinks.map((item) => (
          <a href={item.href}>
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <b aria-hidden="true">-&gt;</b>
          </a>
        ))}
      </div>
    </section>

    <section id="checklist" class="evidence-band evidence-checklist" aria-labelledby="checklist-title">
      <div class="section-heading">
        <p class="evidence-eyebrow">10-point outcomes guide</p>
        <h2 id="checklist-title">A chairside checklist for clinical outcome control.</h2>
        <p>
          References: Ng outcome research, Shimon Friedman's Toronto Study, and
          Ricucci/Siqueira histologic apical-periodontitis work.
        </p>
      </div>

      <div class="evidence-checklist-actions">
        <a class="evidence-checklist-button" href={checklistHref}>
          <span class="evidence-gateway-rail" aria-hidden="true">
            {gatewayNumbers.map((number) => (
              <i>{number}</i>
            ))}
          </span>
          <span class="evidence-gateway-copy">
            <span>Interactive outcomes guide</span>
            <strong>Open the full 10-point outcome guide.</strong>
            <small>
              Hover each point to reveal chairside guidance for diagnosis, apical control,
              shaping, obturation, restoration, review, and retreatment decisions.
            </small>
          </span>
          <span class="evidence-gateway-action" aria-hidden="true">
            <span>Open full guide</span>
            <b>-&gt;</b>
          </span>
        </a>

        <a class="evidence-checklist-download" href={checklistPdfHref} download>
          <span>Download PDF</span>
          <strong>10-point chairside checklist</strong>
          <small>Includes sources plus curated YouTube learning links for each point.</small>
        </a>
      </div>
    </section>

    <section class="evidence-band evidence-reference" aria-label="Outcome evidence references">
      <div class="source-grid">
        {referenceCards.map((reference) => (
          <article class="source-card" tabindex="0">
            <span>{reference.label}</span>
            <p>{reference.citation}</p>
            <aside class="source-popup" aria-label={`${reference.label} importance`}>
              <strong>Why it matters</strong>
              <p>{reference.importance}</p>
            </aside>
          </article>
        ))}
      </div>
    </section>

    <section id="video-library" class="evidence-band evidence-videos" aria-labelledby="videos-title">
      <div class="section-heading">
        <p class="evidence-eyebrow">YouTube research set</p>
        <h2 id="videos-title">20 outcome-focused videos used to shape the checklist.</h2>
        <p>
          The videos were reviewed as education anchors for diagnosis, apical periodontitis,
          obturation, restoration, retreatment, and survival. They are presented as learning
          links, not as substitute primary evidence.
        </p>
      </div>

      <div class="video-grid">
        {evidenceOutcomeVideoLibrary.map((video, index) => (
          <a href={video.url} target="_blank" rel="noopener noreferrer">
            <span>{String(index + 1).padStart(2, '0')} / {video.channel}</span>
            <h3>{video.title}</h3>
            <p>{video.focus}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="evidence-footer" aria-labelledby="next-title">
      <div>
        <p class="evidence-eyebrow">Next clinical pages</p>
        <h2 id="next-title">Move from evidence to workflow control.</h2>
      </div>
      <div class="next-links">
        <a href={`${base}technology/avatar-tip/`}>Avatar Tip</a>
        <a href={`${base}technology/transform-technology/`}>Transform Technology</a>
        <a href={`${base}resources/downloads/`}>Evidence & Downloads</a>
      </div>
    </section>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const sourceCards = Array.from(document.querySelectorAll('.source-card'));

      function clearCards(exceptCard) {
        sourceCards.forEach((card) => {
          if (card !== exceptCard) {
            card.classList.remove('is-active');
          }
        });
      }

      sourceCards.forEach((card) => {
        card.addEventListener('mouseenter', () => card.classList.add('is-active'));
        card.addEventListener('mouseleave', () => card.classList.remove('is-active'));
        card.addEventListener('focus', () => {
          clearCards(card);
          card.classList.add('is-active');
        });
        card.addEventListener('blur', () => card.classList.remove('is-active'));
        card.addEventListener('click', (event) => {
          event.stopPropagation();
          const isActive = card.classList.contains('is-active');
          clearCards(card);
          card.classList.toggle('is-active', !isActive);
        });
      });

      document.addEventListener('click', () => clearCards());
    });
  </script>
</ProductLayout>

<style>
  :global(.product-site-main) {
    background: #ffffff;
  }

  .evidence-page {
    --ink: #111827;
    --ink-2: #24364a;
    --muted: #607084;
    --subtle: #8a94a3;
    --line: #e3e8ee;
    --line-strong: #cad5e0;
    --blue: #0b75b7;
    --blue-soft: #eef8fc;
    --teal: #1ba6a6;
    --green: #4bae73;
    --warning: #b7791f;
    --canvas: #f7f9fc;
    color: var(--ink);
    background: #ffffff;
    font-family: Inter, "SF Pro Display", "SF Pro Text", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .evidence-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 0.8fr);
    gap: 56px;
    align-items: start;
    width: min(1320px, calc(100% - 48px));
    margin: 0 auto;
    padding: 76px 0 62px;
  }

  .evidence-hero-copy {
    max-width: 760px;
  }

  .evidence-eyebrow {
    margin: 0;
    color: #31575e;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.16em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .evidence-hero h1,
  .section-heading h2,
  .evidence-footer h2 {
    margin: 0;
    color: var(--ink);
    font-weight: 760;
    letter-spacing: 0;
  }

  .evidence-hero h1 {
    max-width: 760px;
    margin-top: 20px;
    font-size: 68px;
    line-height: 1.02;
  }

  .evidence-hero-copy > p:not(.evidence-eyebrow) {
    max-width: 690px;
    margin: 26px 0 0;
    color: var(--muted);
    font-size: 20px;
    line-height: 1.7;
  }

  .evidence-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .evidence-hero-actions a,
  .next-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0 18px;
    color: var(--ink);
    background: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 780;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .evidence-hero-actions a:first-child {
    border-color: #0b75b7;
    color: #ffffff;
    background: #0b75b7;
  }

  .evidence-hero-actions a:hover,
  .evidence-hero-actions a:focus-visible,
  .next-links a:hover,
  .next-links a:focus-visible {
    border-color: var(--blue);
    transform: translateY(-1px);
  }

  .outcome-visual {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 24px;
    background:
      linear-gradient(180deg, #ffffff 0%, #f8fbfd 100%),
      #ffffff;
    box-shadow: 0 26px 70px -56px rgba(17, 24, 39, 0.3);
  }

  .outcome-visual-top {
    display: grid;
    gap: 8px;
    margin-bottom: 14px;
  }

  .outcome-visual-top span,
  .outcome-visual-strip span {
    color: #31575e;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .outcome-visual-top strong {
    color: var(--ink-2);
    font-size: 22px;
    line-height: 1.25;
  }

  .outcome-svg {
    display: block;
    width: 100%;
    height: auto;
    min-height: 320px;
  }

  .outcome-visual-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 14px;
  }

  .outcome-visual-strip span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #ffffff;
  }

  .outcome-visual-strip b {
    color: #31575e;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  .outcome-visual-strip em {
    color: var(--ink-2);
    font-size: 12px;
    font-style: normal;
    font-weight: 760;
    letter-spacing: 0;
    text-transform: none;
  }

  .evidence-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: min(1320px, calc(100% - 48px));
    margin: 0 auto 32px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 22px 60px -52px rgba(17, 24, 39, 0.24);
  }

  .evidence-metrics article {
    min-height: 178px;
    padding: 28px;
  }

  .evidence-metrics article + article {
    border-left: 1px solid var(--line);
  }

  .evidence-metrics span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .evidence-metrics strong {
    display: block;
    margin-top: 18px;
    color: var(--ink);
    font-size: 46px;
    line-height: 1;
    letter-spacing: 0;
  }

  .evidence-metrics p {
    max-width: 310px;
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .evidence-band {
    width: min(1320px, calc(100% - 48px));
    margin: 0 auto;
    padding: 88px 0;
  }

  .evidence-problem,
  .evidence-reference {
    border-top: 1px solid var(--line);
  }

  .section-heading {
    max-width: 820px;
  }

  .section-heading h2,
  .evidence-footer h2 {
    margin-top: 16px;
    font-size: 44px;
    line-height: 1.12;
  }

  .section-heading > p:not(.evidence-eyebrow) {
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.75;
