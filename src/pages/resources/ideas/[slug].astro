---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import { blogIdeas, type BlogIdea } from '../../../data/blogIdeas';
import { withBasePath } from '../../../utils/paths';

export function getStaticPaths() {
  return blogIdeas.map((idea) => ({
    params: { slug: idea.slug },
    props: { idea },
  }));
}

interface Props {
  idea: BlogIdea;
}

const { idea } = Astro.props;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: idea.title,
  description: idea.summary,
  image: withBasePath(idea.image),
  articleSection: idea.category,
  isAccessibleForFree: true,
};

const isIrrigationArticle = idea.slug === 'irrigation-dynamics-that-matter';
const isVptArticle = idea.slug === 'stepwise-chairside-vital-pulp-therapy-technique';
const isVertucciArticle = idea.slug === 'vertucci-canal-pathways';
const irrigationChecklistHref = withBasePath('/resources/ideas/irrigation-dynamics-that-matter/checklist/');
const irrigationChecklistPdfHref = withBasePath('/downloads/EndoTech-NZ-Irrigation-12-Point-Clinical-Checklist.pdf');
const vptGuideHref = withBasePath('/downloads/Vital_Pulp_Therapy_Chairside_Quick_Guide.pdf');

const vptReadiness = [
  'Rubber dam isolation before caries removal',
  'Magnification and strong light',
  'New sterile burs and sterile coolant for the pulp phase',
  '1-2% NaOCl with sterile cotton pellets',
  'A well-sealed definitive restoration, preferably at the same visit',
];

const vptCariesRoutes = [
  {
    label: 'Deep caries + normal/reversible response',
    text:
      'With a radiographically distinct dentine barrier, selective caries removal may avoid pulp exposure while preserving a sound peripheral seal.',
  },
  {
    label: 'Extremely deep / symptomatic caries',
    text:
      'Where the pulp is vital and bleeding can be controlled, complete excavation permits direct tissue assessment and may lead to full pulpotomy.',
  },
];

const vptOperativePhases = [
  {
    title: 'Isolate + disinfect',
    text:
      'Achieve profound anaesthesia, secure rubber dam before caries removal, and disinfect the isolated crown, clamp, and adjacent dam.',
  },
  {
    title: 'Remove caries',
    text:
      'Work through the infected phase and establish sound peripheral margins using the caries route selected for the case.',
  },
  {
    title: 'Enter the clean pulp phase',
    text:
      'Change to new sterile burs and sterile coolant before entering the pulp wound. Inspect the tissue under magnification.',
  },
];

const vptHaemostasis = [
  {
    time: '0-2 minutes',
    text:
      'Place a sterile cotton pellet lightly moistened with 1-2% NaOCl directly over the wound. Use gentle pressure.',
  },
  {
    time: '2-4 minutes',
    text:
      'Remove and inspect. If bleeding remains brisk, resect a further 1-2 mm with a new sterile bur and coolant, then place a fresh pellet.',
  },
  {
    time: '4-6 minutes',
    text:
      'If needed, repeat once more after reassessment and further tissue removal. Treat this as the final two-minute checkpoint.',
  },
];

const vptFinishingSteps = [
  {
    number: '05',
    title: 'Pulp material',
    text:
      'Place a validated hydraulic calcium-silicate cement directly over the clean pulp wound, typically 1-3 mm thick, following the product IFU.',
  },
  {
    number: '06',
    title: 'Definitive restoration',
    text:
      'Protect the cement with compatible materials and create a well-sealed definitive restoration, preferably at the same visit.',
  },
  {
    number: '07',
    title: 'Follow-up',
    text:
      'Review clinically at six months, clinically and radiographically at 12 months, then yearly when indicated for up to four years.',
  },
];

const irrigationLevers = [
  {
    kicker: 'Access',
    title: 'A shaped canal is not automatically a cleaned canal.',
    text:
      'Files prepare the main path, but fins, isthmuses, cul-de-sacs and apical irregularities can still shelter tissue, debris and biofilm. Irrigation is how chemistry reaches anatomy that instruments do not touch.',
  },
  {
    kicker: 'Chemistry',
    title: 'Sodium hypochlorite works, but the protocol matters.',
    text:
      'NaOCl remains the primary irrigant because it dissolves organic tissue and disrupts microbial load. Its effect is shaped by concentration, temperature, contact time, replenishment and agitation, and it is usually paired with a chelator for inorganic smear layer control.',
  },
  {
    kicker: 'Delivery',
    title: 'Needle position changes the clinical problem.',
    text:
      'The important question is not just how much irrigant is delivered, but whether it is exchanged in the apical third without binding the needle or forcing solution beyond the foramen. Space for reverse flow is a safety feature.',
  },
  {
    kicker: 'Activation',
    title: 'Activation is a supplement, not a shortcut.',
    text:
      'Sonic, ultrasonic and negative-pressure approaches can improve debris removal and irrigant movement in complex spaces. Use them to improve exchange after access has been created, not to rescue an under-shaped pathway.',
  },
];

const irrigationSequence = [
  {
    title: 'Shape for irrigant access',
    text:
      'Choose apical size and taper with irrigation in mind. The canal needs enough space for a non-binding needle and coronal backflow, especially when treating curved or complex anatomy.',
  },
  {
    title: 'Keep the chemistry fresh',
    text:
      'Replenish NaOCl throughout shaping rather than saving it for the end. Fresh solution, contact time and exchange are more meaningful than a single large flush.',
  },
  {
    title: 'Deliver close, loose and controlled',
    text:
      'Place the needle short of working length, keep it moving, and never bind it. Side-vented and smaller-gauge needles can improve access, but every design changes pressure and flow.',
  },
  {
    title: 'Activate after the pathway exists',
    text:
      'Use ultrasonic, sonic or negative-pressure activation when the canal has been shaped enough to let the irrigant move. Activation cannot compensate for blocked access.',
  },
  {
    title: 'Finish with a deliberate final rinse',
    text:
      'Use a sequence that respects organic dissolution, smear layer removal and final disinfection. Avoid mixing irrigants casually; each step should have a reason.',
  },
];

const irrigationTeachingSignals = [
  {
    title: 'Fresh solution beats heroic concentration.',
    text:
      'NaOCl is consumed as it dissolves tissue and contacts organic load. Clinicians repeatedly emphasize renewal: irrigate throughout shaping, refresh the reservoir, and avoid relying on one final flush.',
  },
  {
    title: 'Delivery is the first activation step.',
    text:
      'Before choosing a device, make sure the irrigant can physically reach the working area. A loose needle path, controlled flow and coronal backflow make the protocol safer and more effective.',
  },
  {
    title: 'Needle design changes the feel of the case.',
    text:
      'Side-vented, flexible and smaller-gauge tips can help irrigant reach deeper anatomy, especially in curved canals. The clinical aim is controlled placement, not force.',
  },
  {
    title: 'Irrigants have different jobs.',
    text:
      'NaOCl is the organic-tissue and antimicrobial workhorse. EDTA or another chelator addresses smear layer. Chlorhexidine is not a drop-in replacement and should not be mixed casually with NaOCl.',
  },
  {
    title: 'Activation needs a prepared pathway.',
    text:
      'Sonic and ultrasonic activation are most useful once the canal is shaped enough for irrigant movement. Activation is about fluid motion and exchange, not simply vibrating a file in a tight canal.',
  },
  {
    title: 'Safety is part of cleanliness.',
    text:
      'Extrusion risk, open apices, resorption and perforation change the protocol. Negative-pressure irrigation or more conservative delivery may be useful when apical control matters most.',
  },
];

const irrigationClinicalChecks = [
  'Can the needle or delivery tip move freely without binding?',
  'Is NaOCl being renewed between files, not only at the end?',
  'Has the canal been shaped enough for irrigant exchange and activation?',
  'Is EDTA being used as a separate smear-layer step with an intentional rinse sequence?',
  'Does the apical anatomy require slower delivery, shallower placement or negative pressure?',
  'Is the final rinse sequence simple enough to repeat every time?',
];

const irrigationVariables = [
  ['Variable', 'Clinical meaning'],
  ['Apical size and taper', 'Creates space for irrigant exchange and a non-binding needle.'],
  ['Needle depth', 'Closer placement improves exchange, but pressure control becomes more important.'],
  ['Needle design', 'Open-ended and side-vented needles create different flow, velocity and apical pressure patterns.'],
  ['Flow rate', 'Higher flow can improve replacement, but safety depends on backflow and needle control.'],
  ['Activation', 'Improves movement and debris removal when access has already been created.'],
  ['Chelation', 'Complements NaOCl by addressing the inorganic smear layer.'],
];

const irrigationControlQuestions = [
  {
    question: 'Is there enough shape for exchange?',
    answer: 'The needle should sit short of length without binding, with room for coronal return flow.',
  },
  {
    question: 'Is the active chemistry being renewed?',
    answer: 'Fresh NaOCl throughout shaping matters more than a single large final flush.',
  },
  {
    question: 'Is activation being used at the right time?',
    answer: 'Activate after the pathway exists, when irrigant can move rather than simply vibrate in a blocked space.',
  },
  {
    question: 'Is the final sequence chemically deliberate?',
    answer: 'Organic tissue, smear layer and final disinfection need separate decisions, not a casual mix of solutions.',
  },
];

const vertucciTypes = [
  {
    type: 'I',
    notation: '1-1',
    label: 'One canal, one exit',
    entries: [80],
    exits: [80],
    paths: ['M80 62 C80 108 80 190 80 247'],
  },
  {
    type: 'II',
    notation: '2-1',
    label: 'Two canals converge',
    entries: [67, 93],
    exits: [80],
    paths: [
      'M67 62 C68 101 71 126 80 147 C80 184 80 218 80 247',
      'M93 62 C92 101 89 126 80 147',
    ],
  },
  {
    type: 'III',
    notation: '1-2-1',
    label: 'Divide, then rejoin',
    entries: [80],
    exits: [80],
    paths: [
      'M80 62 C80 82 80 97 80 108',
      'M80 108 C67 125 67 154 80 176 C80 201 80 224 80 247',
      'M80 108 C93 125 93 154 80 176',
    ],
  },
  {
    type: 'IV',
    notation: '2-2',
    label: 'Two canals, two exits',
    entries: [68, 92],
    exits: [68, 92],
    paths: [
      'M68 62 C69 108 69 190 68 247',
      'M92 62 C91 108 91 190 92 247',
    ],
  },
  {
    type: 'V',
    notation: '1-2',
    label: 'One canal divides',
    entries: [80],
    exits: [68, 92],
    paths: [
      'M80 62 C80 108 80 157 80 178',
      'M80 178 C72 199 69 224 68 247',
      'M80 178 C88 199 91 224 92 247',
    ],
  },
  {
    type: 'VI',
    notation: '2-1-2',
    label: 'Merge, then redivide',
    entries: [67, 93],
    exits: [68, 92],
    paths: [
      'M67 62 C68 96 72 119 80 137',
      'M93 62 C92 96 88 119 80 137',
      'M80 137 C80 151 80 165 80 179',
      'M80 179 C72 201 69 225 68 247',
      'M80 179 C88 201 91 225 92 247',
    ],
  },
  {
    type: 'VII',
    notation: '1-2-1-2',
    label: 'Divide, join, divide',
    entries: [80],
    exits: [68, 92],
    paths: [
      'M80 62 C80 82 80 94 80 106',
      'M80 106 C69 119 69 140 80 154',
      'M80 106 C91 119 91 140 80 154',
      'M80 154 C80 163 80 171 80 180',
      'M80 180 C72 202 69 226 68 247',
      'M80 180 C88 202 91 226 92 247',
    ],
  },
  {
    type: 'VIII',
    notation: '3-3',
    label: 'Three canals, three exits',
    entries: [64, 80, 96],
    exits: [64, 80, 96],
    paths: [
      'M64 62 C65 111 65 191 64 247',
      'M80 62 C80 111 80 191 80 247',
      'M96 62 C95 111 95 191 96 247',
    ],
  },
];

const vertucciClinicalChecks = [
  {
    number: '01',
    title: 'Find the entry pattern',
    text: 'Count distinct coronal canal entries and look for developmental grooves that may connect or conceal them.',
  },
  {
    number: '02',
    title: 'Verify every transition',
    text: 'Use angled radiographs, magnification, tactile feedback, an apex locator, and CBCT when clinically indicated to test the pathway you think is present.',
  },
  {
    number: '03',
    title: 'Preserve the pathway',
    text: 'Establish a reproducible glide path and shape with enough control to respect divisions, curves, convergence, and separate exits.',
  },
];
---

<ProductLayout
  title={`${idea.title} | EndoTech NZ`}
  description={idea.summary}
  image={withBasePath(idea.image)}
  schema={articleSchema}
  accent="slate"
>
  <article class="article-page">
    <header class="article-hero">
      <a class="article-back" href={withBasePath('/resources/ideas/')} aria-label="Back to Case Notes and Ideas">
        <span class="article-back__icon" aria-hidden="true">←</span>
        <span>Back to Case Notes & Ideas</span>
      </a>
      <p class="article-eyebrow">{idea.category}</p>
      <h1>{idea.title}</h1>
      <p class="article-summary">{idea.summary}</p>
      <div class="article-meta" aria-label="Article details">
        <span>{idea.readTime}</span>
        <span>EndoTech NZ</span>
        <span>{isVptArticle ? 'Chairside guide' : isVertucciArticle ? 'Clinical anatomy guide' : 'Draft ready'}</span>
      </div>
    </header>

    <figure class={`article-media ${isVptArticle || isVertucciArticle ? 'article-media--contain' : ''}`}>
      <img
        src={withBasePath(idea.image)}
        alt={isVertucciArticle ? 'Original schematic overview of the eight Vertucci root canal configurations' : ''}
      />
      <figcaption>{idea.focus}</figcaption>
    </figure>

    {
      isIrrigationArticle ? (
        <div class="irrigation-article">
          <section class="irrigation-intro" aria-labelledby="irrigation-frame">
            <div>
              <p class="article-eyebrow">Clinical frame</p>
              <h2 id="irrigation-frame">Irrigation is how chemistry reaches what files leave behind.</h2>
              <p>
                Instrumentation creates the path. Irrigation cleans through that path. The clinical
                challenge is to exchange active solution inside the apical third, move it into fins
                and isthmuses, and do it without forcing irrigant through the apex.
              </p>
              <p>
                The interesting idea is that irrigation is not one variable. It is anatomy, chemistry,
                delivery and activation working together. A safer protocol makes each variable visible.
              </p>
            </div>
            <aside class="control-panel" aria-label="Irrigation control questions">
              <p class="control-panel__label">Control questions</p>
              <ul>
                {irrigationControlQuestions.map((item) => (
                  <li>
                    <strong>{item.question}</strong>
                    <span>{item.answer}</span>
                  </li>
                ))}
              </ul>
            </aside>
          </section>

          <section class="irrigation-section" aria-labelledby="irrigation-levers">
            <p class="article-eyebrow">Four levers</p>
            <h2 id="irrigation-levers">The protocol is a set of controlled variables.</h2>
            <div class="lever-grid">
              {irrigationLevers.map((lever) => (
                <section class="lever-card">
                  <span>{lever.kicker}</span>
                  <h3>{lever.title}</h3>
                  <p>{lever.text}</p>
                </section>
              ))}
            </div>
          </section>

          <section class="irrigation-section sequence-section" aria-labelledby="irrigation-sequence">
            <div>
              <p class="article-eyebrow">Chairside sequence</p>
              <h2 id="irrigation-sequence">A practical irrigation mindset.</h2>
              <p>
                This is not a prescription for every tooth. It is a way to make irrigation decisions
                traceable: create access, exchange active chemistry, activate when useful, and finish
                with a sequence that respects the chemistry.
              </p>
            </div>
            <ol class="sequence-list">
              {irrigationSequence.map((step) => (
                <li>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>

          <section class="irrigation-section variables-section" aria-labelledby="irrigation-variables">
            <p class="article-eyebrow">Flow variables</p>
            <h2 id="irrigation-variables">Small technical choices change cleaning and safety.</h2>
            <div class="variables-table" role="table" aria-label="Irrigation variables and clinical meaning">
              {irrigationVariables.map((row, index) => (
                <div class={index === 0 ? 'variables-row variables-head' : 'variables-row'} role="row">
                  <span role="cell">{row[0]}</span>
                  <span role="cell">{row[1]}</span>
                </div>
              ))}
            </div>
          </section>

          <section class="irrigation-section teaching-section" aria-labelledby="irrigation-teaching">
            <p class="article-eyebrow">Clinical teaching signal</p>
            <h2 id="irrigation-teaching">What experienced clinicians keep coming back to.</h2>
            <p>
              A review of ten irrigation teaching videos showed the same practical pattern: clinicians
              talk less about a single miracle solution and more about repeatable exchange, safe
              delivery and making the chemistry active at the right moment.
            </p>
            <div class="teaching-grid">
              {irrigationTeachingSignals.map((item) => (
                <section class="teaching-card">
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </section>
              ))}
            </div>
          </section>

          <section class="irrigation-section checks-section" aria-labelledby="irrigation-checks">
            <div>
              <p class="article-eyebrow">Before obturation</p>
              <h2 id="irrigation-checks">Six checks for a cleaner, calmer finish.</h2>
              <p>
                These are chairside questions, not academic footnotes. If the answer is unclear, the
                irrigation step probably needs one more deliberate pass before the canal is dried.
              </p>
            </div>
            <ul class="check-list">
              {irrigationClinicalChecks.map((check) => (
                <li>{check}</li>
              ))}
            </ul>
          </section>

          <section class="irrigation-section download-section" id="irrigation-download" aria-labelledby="irrigation-download-title">
            <div>
              <p class="article-eyebrow">Downloadable guide</p>
              <h2 id="irrigation-download-title">Take the 12-point irrigation checklist chairside.</h2>
              <p>
                The interactive guide expands each point with the clinical reasoning behind it. The
                PDF keeps the same points in a compact protocol sheet for team discussion, training,
                or case review.
              </p>
            </div>
            <div class="download-actions">
              <a class="guide-link" href={irrigationChecklistHref}>
                <span>Interactive guide</span>
                <strong>Open the full 12-point irrigation guide.</strong>
                <small>Flow, chemistry, delivery, activation, safety, and finish.</small>
              </a>
              <a class="guide-download" href={irrigationChecklistPdfHref} download>
                <span>Download PDF</span>
                <strong>12-point chairside checklist</strong>
                <small>Includes source notes plus curated YouTube learning links.</small>
              </a>
            </div>
          </section>
        </div>
      ) : isVptArticle ? (
        <div class="vpt-article">
          <section class="vpt-intro" aria-labelledby="vpt-clinical-frame">
            <div>
              <p class="article-eyebrow">Clinical frame</p>
              <h2 id="vpt-clinical-frame">Preserve vitality by controlling every decision around the pulp.</h2>
              <p>
                Vital pulp therapy is not one material or one moment. It is a sequence: select the
                case, establish asepsis, assess the exposed tissue, control bleeding, place a
                calcium-silicate cement, and protect the result with a durable coronal seal.
              </p>
              <p>
                This stepwise guide is designed as a clinician discussion aid for permanent teeth.
                Diagnosis, case selection, and treatment remain the treating clinician's responsibility.
              </p>
            </div>
            <aside class="vpt-readiness" aria-label="VPT readiness checks">
              <p>Do not start without these five</p>
              <ol>
                {vptReadiness.map((item, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <strong>{item}</strong>
                  </li>
                ))}
              </ol>
            </aside>
          </section>

          <section class="vpt-section" aria-labelledby="vpt-select">
            <p class="article-eyebrow">Select</p>
            <h2 id="vpt-select">Choose the caries route before you pick up the bur.</h2>
            <div class="vpt-choice-grid">
              {vptCariesRoutes.map((route) => (
                <section class="vpt-card">
                  <h3>{route.label}</h3>
                  <p>{route.text}</p>
                </section>
              ))}
            </div>
            <p class="vpt-warning">
              Stop or refer if the tooth is non-restorable, vitality is doubtful, necrosis or
              purulence is present, significant apical pathosis is seen, or reliable rubber-dam
              isolation cannot be achieved.
            </p>
          </section>

          <section class="vpt-section" aria-labelledby="vpt-perform">
            <p class="article-eyebrow">Perform</p>
            <h2 id="vpt-perform">Keep the clean phase clean.</h2>
            <div class="vpt-step-grid">
              {vptOperativePhases.map((phase, index) => (
                <section class="vpt-step">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <h3>{phase.title}</h3>
                  <p>{phase.text}</p>
                </section>
              ))}
            </div>
          </section>

          <section class="vpt-section vpt-timing" aria-labelledby="vpt-haemostasis">
            <p class="article-eyebrow">Haemostasis pathway</p>
            <h2 id="vpt-haemostasis">Use two-minute checkpoints to inspect, not simply wait.</h2>
            <div class="vpt-timing-grid">
              {vptHaemostasis.map((step) => (
                <section>
                  <strong>{step.time}</strong>
                  <p>{step.text}</p>
                </section>
              ))}
            </div>
            <p class="vpt-checkpoint">
              At every checkpoint: remove the pellet, inspect under magnification, and reassess the
              tissue and bleeding. If control is not achieved after full pulpotomy, or necrosis or
              purulence is seen, stop VPT and reassess the treatment plan.
            </p>
          </section>

          <section class="vpt-section" aria-labelledby="vpt-protect">
            <p class="article-eyebrow">Protect</p>
            <h2 id="vpt-protect">Finish the biological job.</h2>
            <div class="vpt-finish-list">
              {vptFinishingSteps.map((step) => (
                <section>
                  <span>{step.number}</span>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </section>
              ))}
            </div>
          </section>

          <section class="vpt-section vpt-download" aria-labelledby="vpt-download-title">
            <div>
              <p class="article-eyebrow">Chairside download</p>
              <h2 id="vpt-download-title">Take the full three-page protocol into the surgery.</h2>
              <p>
                The downloadable guide includes the case-selection framework, operative phases,
                two-minute haemostasis pathway, finishing steps, chairside checklist, and source notes.
              </p>
            </div>
            <div class="vpt-download__actions">
              <a class="vpt-download__primary" href={vptGuideHref} target="_blank" rel="noopener noreferrer">
                <span>Open PDF guide</span>
                <strong>Vital Pulp Therapy - Chairside Quick Guide</strong>
                <small>Three A4 pages for clinical discussion, training, or case review.</small>
              </a>
              <div class="vpt-sources">
                <span>Clinical sources</span>
                <a href="https://www.aapd.org/globalassets/media/policies_guidelines/g_vpt-permanentteeth.pdf" target="_blank" rel="noopener noreferrer">AAPD permanent-tooth VPT guideline</a>
                <a href="https://www.aae.org/wp-content/uploads/2021/05/VitalPulpTherapy_PositionStatement_v2.pdf" target="_blank" rel="noopener noreferrer">AAE vital pulp therapy position statement</a>
              </div>
            </div>
          </section>
        </div>
      ) : isVertucciArticle ? (
        <div class="vertucci-article">
          <section class="vertucci-intro" aria-labelledby="vertucci-frame">
            <div>
              <p class="article-eyebrow">Clinical frame</p>
              <h2 id="vertucci-frame">The number is a pathway—not just a canal count.</h2>
              <p>
                Vertucci classification describes how canals begin coronally, divide or merge through the
                root, and finish apically. Read the sequence from chamber to apex: <strong>2-1</strong>,
                for example, means two distinct canals converge into one exit.
              </p>
              <p>
                Critical to have case-specific diagnosis, imaging, magnification, or clinical judgement.
              </p>
            </div>
            <aside class="vertucci-key" aria-label="How to read Vertucci notation">
              <span>Read from chamber to apex</span>
              <div class="vertucci-key__sequence" aria-label="Two canals merge into one">
                <strong>2</strong>
                <i aria-hidden="true">→</i>
                <strong>1</strong>
              </div>
              <p>Coronal entries <b>→</b> divisions or joins <b>→</b> apical exits</p>
            </aside>
          </section>

          <section class="vertucci-atlas" aria-labelledby="vertucci-atlas-title">
            <div class="vertucci-section-heading">
              <div>
                <p class="article-eyebrow">Anatomy map</p>
                <h2 id="vertucci-atlas-title">The eight classic configurations.</h2>
              </div>
              <div class="vertucci-legend" aria-label="Diagram legend">
                <span><i class="vertucci-legend__orifice"></i>Coronal entry</span>
                <span><i class="vertucci-legend__canal"></i>Canal pathway</span>
                <span><i class="vertucci-legend__exit"></i>Apical exit</span>
              </div>
            </div>

            <div class="vertucci-grid">
              {vertucciTypes.map((item) => (
                <article class="vertucci-card">
                  <header>
                    <div>
                      <span>Type {item.type}</span>
                      <strong>{item.notation}</strong>
                    </div>
                    <p>{item.label}</p>
                  </header>
                  <svg
                    viewBox="0 0 160 270"
                    role="img"
                    aria-labelledby={`vertucci-type-${item.type}`}
                    preserveAspectRatio="xMidYMid meet"
                  >
                    <title id={`vertucci-type-${item.type}`}>Vertucci Type {item.type}: {item.label}</title>
                    <path
                      class="vertucci-root"
                      d="M47 13 C35 31 34 55 40 84 L57 234 C59 251 69 260 80 260 C91 260 101 251 103 234 L120 84 C126 55 125 31 113 13 C95 22 65 22 47 13 Z"
                    />
                    <path
                      class="vertucci-chamber"
                      d="M63 38 Q80 27 97 38 L93 63 Q80 76 67 63 Z"
                    />
                    {item.paths.map((path) => <path class="vertucci-canal" d={path} />)}
                    {item.entries.map((x) => <circle class="vertucci-orifice" cx={x} cy="62" r="4.8" />)}
                    {item.exits.map((x) => <circle class="vertucci-exit" cx={x} cy="247" r="5" />)}
                  </svg>
                  <footer>
                    <span>{item.entries.length} {item.entries.length === 1 ? 'entry' : 'entries'}</span>
                    <span>{item.exits.length} {item.exits.length === 1 ? 'exit' : 'exits'}</span>
                  </footer>
                </article>
              ))}
            </div>
            <p class="vertucci-atlas__note">
              Original EndoTech NZ schematics. Simplified, not to scale, and intended for education—not anatomical prediction.
            </p>
          </section>

          <section class="vertucci-application" aria-labelledby="vertucci-application-title">
            <div class="vertucci-application__heading">
              <p class="article-eyebrow">Chairside application</p>
              <h2 id="vertucci-application-title">Classification should guide you to – 1, 2, 3.</h2>
              <p>
                Naming the likely pathway is useful only when it changes what you look for and how
                deliberately you confirm it.
              </p>
            </div>
            <div class="vertucci-checks">
              {vertucciClinicalChecks.map((check) => (
                <article>
                  <span>{check.number}</span>
                  <h3>{check.title}</h3>
                  <p>{check.text}</p>
                </article>
              ))}
            </div>
          </section>

          <aside class="vertucci-caution" aria-labelledby="vertucci-caution-title">
            <div aria-hidden="true">!</div>
            <section>
              <p class="article-eyebrow">Clinical caution</p>
              <h2 id="vertucci-caution-title">A clean diagram can hide complex anatomy.</h2>
              <p>
                Lateral canals, isthmuses, apical deltas, curvature, calcification, resorption, and
                configurations beyond these eight types may change treatment.
              </p>
            </section>
          </aside>

          <section class="vertucci-evidence" aria-labelledby="vertucci-evidence-title">
            <div>
              <span class="vertucci-evidence__number">2,400</span>
              <p>human permanent teeth in Vertucci's landmark cleared-tooth investigation.</p>
            </div>
            <div>
              <p class="article-eyebrow">Primary source</p>
              <h2 id="vertucci-evidence-title">Root canal anatomy of the human permanent teeth.</h2>
              <p>
                Vertucci FJ. <em>Oral Surgery, Oral Medicine, and Oral Pathology.</em> 1984;58(5):589-599.
              </p>
              <a href="https://pubmed.ncbi.nlm.nih.gov/6595621/" target="_blank" rel="noopener noreferrer">
                View the PubMed record <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>
        </div>
      ) : (
        <div class="article-shell">
          <aside class="article-aside" aria-label="Article format">
            <p>Suggested format</p>
            <ol>
              {idea.placeholders.map((placeholder) => (
                <li>{placeholder}</li>
              ))}
            </ol>
          </aside>

          <div class="article-body">
            <section>
              <h2>Clinical problem</h2>
              <p>
                Add the opening clinical context here. Frame the problem clearly, then connect each
                point to control, safety, and adaptability in the procedure.
              </p>
            </section>

            <section>
              <h2>Case notes</h2>
              <p>
