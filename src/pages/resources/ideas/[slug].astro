---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import { blogIdeas, type BlogIdea } from '../../../data/blogIdeas';
import { withBasePath } from '../../../utils/paths';

export function getStaticPaths() {
  return blogIdeas.map((idea) => ({
    params: { slug: idea.slug },
    props: { idea },
  }));
}

interface Props {
  idea: BlogIdea;
}

const { idea } = Astro.props;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: idea.title,
  description: idea.summary,
  image: withBasePath(idea.image),
  articleSection: idea.category,
  isAccessibleForFree: true,
};

const isIrrigationArticle = idea.slug === 'irrigation-dynamics-that-matter';
const irrigationChecklistHref = withBasePath('/resources/ideas/irrigation-dynamics-that-matter/checklist/');
const irrigationChecklistPdfHref = withBasePath('/downloads/EndoTech-NZ-Irrigation-12-Point-Clinical-Checklist.pdf');

const irrigationLevers = [
  {
    kicker: 'Access',
    title: 'A shaped canal is not automatically a cleaned canal.',
    text:
      'Files prepare the main path, but fins, isthmuses, cul-de-sacs and apical irregularities can still shelter tissue, debris and biofilm. Irrigation is how chemistry reaches anatomy that instruments do not touch.',
  },
  {
    kicker: 'Chemistry',
    title: 'Sodium hypochlorite works, but the protocol matters.',
    text:
      'NaOCl remains the primary irrigant because it dissolves organic tissue and disrupts microbial load. Its effect is shaped by concentration, temperature, contact time, replenishment and agitation, and it is usually paired with a chelator for inorganic smear layer control.',
  },
  {
    kicker: 'Delivery',
    title: 'Needle position changes the clinical problem.',
    text:
      'The important question is not just how much irrigant is delivered, but whether it is exchanged in the apical third without binding the needle or forcing solution beyond the foramen. Space for reverse flow is a safety feature.',
  },
  {
    kicker: 'Activation',
    title: 'Activation is a supplement, not a shortcut.',
    text:
      'Sonic, ultrasonic and negative-pressure approaches can improve debris removal and irrigant movement in complex spaces. Use them to improve exchange after access has been created, not to rescue an under-shaped pathway.',
  },
];

const irrigationSequence = [
  {
    title: 'Shape for irrigant access',
    text:
      'Choose apical size and taper with irrigation in mind. The canal needs enough space for a non-binding needle and coronal backflow, especially when treating curved or complex anatomy.',
  },
  {
    title: 'Keep the chemistry fresh',
    text:
      'Replenish NaOCl throughout shaping rather than saving it for the end. Fresh solution, contact time and exchange are more meaningful than a single large flush.',
  },
  {
    title: 'Deliver close, loose and controlled',
    text:
      'Place the needle short of working length, keep it moving, and never bind it. Side-vented and smaller-gauge needles can improve access, but every design changes pressure and flow.',
  },
  {
    title: 'Activate after the pathway exists',
    text:
      'Use ultrasonic, sonic or negative-pressure activation when the canal has been shaped enough to let the irrigant move. Activation cannot compensate for blocked access.',
  },
  {
    title: 'Finish with a deliberate final rinse',
    text:
      'Use a sequence that respects organic dissolution, smear layer removal and final disinfection. Avoid mixing irrigants casually; each step should have a reason.',
  },
];

const irrigationTeachingSignals = [
  {
    title: 'Fresh solution beats heroic concentration.',
    text:
      'NaOCl is consumed as it dissolves tissue and contacts organic load. Clinicians repeatedly emphasize renewal: irrigate throughout shaping, refresh the reservoir, and avoid relying on one final flush.',
  },
  {
    title: 'Delivery is the first activation step.',
    text:
      'Before choosing a device, make sure the irrigant can physically reach the working area. A loose needle path, controlled flow and coronal backflow make the protocol safer and more effective.',
  },
  {
    title: 'Needle design changes the feel of the case.',
    text:
      'Side-vented, flexible and smaller-gauge tips can help irrigant reach deeper anatomy, especially in curved canals. The clinical aim is controlled placement, not force.',
  },
  {
    title: 'Irrigants have different jobs.',
    text:
      'NaOCl is the organic-tissue and antimicrobial workhorse. EDTA or another chelator addresses smear layer. Chlorhexidine is not a drop-in replacement and should not be mixed casually with NaOCl.',
  },
  {
    title: 'Activation needs a prepared pathway.',
    text:
      'Sonic and ultrasonic activation are most useful once the canal is shaped enough for irrigant movement. Activation is about fluid motion and exchange, not simply vibrating a file in a tight canal.',
  },
  {
    title: 'Safety is part of cleanliness.',
    text:
      'Extrusion risk, open apices, resorption and perforation change the protocol. Negative-pressure irrigation or more conservative delivery may be useful when apical control matters most.',
  },
];

const irrigationClinicalChecks = [
  'Can the needle or delivery tip move freely without binding?',
  'Is NaOCl being renewed between files, not only at the end?',
  'Has the canal been shaped enough for irrigant exchange and activation?',
  'Is EDTA being used as a separate smear-layer step with an intentional rinse sequence?',
  'Does the apical anatomy require slower delivery, shallower placement or negative pressure?',
  'Is the final rinse sequence simple enough to repeat every time?',
];

const irrigationVariables = [
  ['Variable', 'Clinical meaning'],
  ['Apical size and taper', 'Creates space for irrigant exchange and a non-binding needle.'],
  ['Needle depth', 'Closer placement improves exchange, but pressure control becomes more important.'],
  ['Needle design', 'Open-ended and side-vented needles create different flow, velocity and apical pressure patterns.'],
  ['Flow rate', 'Higher flow can improve replacement, but safety depends on backflow and needle control.'],
  ['Activation', 'Improves movement and debris removal when access has already been created.'],
  ['Chelation', 'Complements NaOCl by addressing the inorganic smear layer.'],
];

const irrigationControlQuestions = [
  {
    question: 'Is there enough shape for exchange?',
    answer: 'The needle should sit short of length without binding, with room for coronal return flow.',
  },
  {
    question: 'Is the active chemistry being renewed?',
    answer: 'Fresh NaOCl throughout shaping matters more than a single large final flush.',
  },
  {
    question: 'Is activation being used at the right time?',
    answer: 'Activate after the pathway exists, when irrigant can move rather than simply vibrate in a blocked space.',
  },
  {
    question: 'Is the final sequence chemically deliberate?',
    answer: 'Organic tissue, smear layer and final disinfection need separate decisions, not a casual mix of solutions.',
  },
];
---

<ProductLayout
  title={`${idea.title} | EndoTech NZ`}
  description={idea.summary}
  image={withBasePath(idea.image)}
  schema={articleSchema}
  accent="slate"
>
  <article class="article-page">
    <header class="article-hero">
      <a class="article-back" href={withBasePath('/resources/ideas/')} aria-label="Back to Case Notes and Ideas">
        <span class="article-back__icon" aria-hidden="true">←</span>
        <span>Back to Case Notes & Ideas</span>
      </a>
      <p class="article-eyebrow">{idea.category}</p>
      <h1>{idea.title}</h1>
      <p class="article-summary">{idea.summary}</p>
      <div class="article-meta" aria-label="Article details">
        <span>{idea.readTime}</span>
        <span>EndoTech NZ</span>
        <span>Draft ready</span>
      </div>
    </header>

    <figure class="article-media">
      <img src={withBasePath(idea.image)} alt="" />
      <figcaption>{idea.focus}</figcaption>
    </figure>

    {
      isIrrigationArticle ? (
        <div class="irrigation-article">
          <section class="irrigation-intro" aria-labelledby="irrigation-frame">
            <div>
              <p class="article-eyebrow">Clinical frame</p>
              <h2 id="irrigation-frame">Irrigation is how chemistry reaches what files leave behind.</h2>
              <p>
                Instrumentation creates the path. Irrigation cleans through that path. The clinical
                challenge is to exchange active solution inside the apical third, move it into fins
                and isthmuses, and do it without forcing irrigant through the apex.
              </p>
              <p>
                The interesting idea is that irrigation is not one variable. It is anatomy, chemistry,
                delivery and activation working together. A safer protocol makes each variable visible.
              </p>
            </div>
            <aside class="control-panel" aria-label="Irrigation control questions">
              <p class="control-panel__label">Control questions</p>
              <ul>
                {irrigationControlQuestions.map((item) => (
                  <li>
                    <strong>{item.question}</strong>
                    <span>{item.answer}</span>
                  </li>
                ))}
              </ul>
            </aside>
          </section>

          <section class="irrigation-section" aria-labelledby="irrigation-levers">
            <p class="article-eyebrow">Four levers</p>
            <h2 id="irrigation-levers">The protocol is a set of controlled variables.</h2>
            <div class="lever-grid">
              {irrigationLevers.map((lever) => (
                <section class="lever-card">
                  <span>{lever.kicker}</span>
                  <h3>{lever.title}</h3>
                  <p>{lever.text}</p>
                </section>
              ))}
            </div>
          </section>

          <section class="irrigation-section sequence-section" aria-labelledby="irrigation-sequence">
            <div>
              <p class="article-eyebrow">Chairside sequence</p>
              <h2 id="irrigation-sequence">A practical irrigation mindset.</h2>
              <p>
                This is not a prescription for every tooth. It is a way to make irrigation decisions
                traceable: create access, exchange active chemistry, activate when useful, and finish
                with a sequence that respects the chemistry.
              </p>
            </div>
            <ol class="sequence-list">
              {irrigationSequence.map((step) => (
                <li>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>

          <section class="irrigation-section variables-section" aria-labelledby="irrigation-variables">
            <p class="article-eyebrow">Flow variables</p>
            <h2 id="irrigation-variables">Small technical choices change cleaning and safety.</h2>
            <div class="variables-table" role="table" aria-label="Irrigation variables and clinical meaning">
              {irrigationVariables.map((row, index) => (
                <div class={index === 0 ? 'variables-row variables-head' : 'variables-row'} role="row">
                  <span role="cell">{row[0]}</span>
                  <span role="cell">{row[1]}</span>
                </div>
              ))}
            </div>
          </section>

          <section class="irrigation-section teaching-section" aria-labelledby="irrigation-teaching">
            <p class="article-eyebrow">Clinical teaching signal</p>
            <h2 id="irrigation-teaching">What experienced clinicians keep coming back to.</h2>
            <p>
              A review of ten irrigation teaching videos showed the same practical pattern: clinicians
              talk less about a single miracle solution and more about repeatable exchange, safe
              delivery and making the chemistry active at the right moment.
            </p>
            <div class="teaching-grid">
              {irrigationTeachingSignals.map((item) => (
                <section class="teaching-card">
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </section>
              ))}
            </div>
          </section>

          <section class="irrigation-section checks-section" aria-labelledby="irrigation-checks">
            <div>
              <p class="article-eyebrow">Before obturation</p>
              <h2 id="irrigation-checks">Six checks for a cleaner, calmer finish.</h2>
              <p>
                These are chairside questions, not academic footnotes. If the answer is unclear, the
                irrigation step probably needs one more deliberate pass before the canal is dried.
              </p>
            </div>
            <ul class="check-list">
              {irrigationClinicalChecks.map((check) => (
                <li>{check}</li>
              ))}
            </ul>
          </section>

          <section class="irrigation-section download-section" id="irrigation-download" aria-labelledby="irrigation-download-title">
            <div>
              <p class="article-eyebrow">Downloadable guide</p>
              <h2 id="irrigation-download-title">Take the 12-point irrigation checklist chairside.</h2>
              <p>
                The interactive guide expands each point with the clinical reasoning behind it. The
                PDF keeps the same points in a compact protocol sheet for team discussion, training,
                or case review.
              </p>
            </div>
            <div class="download-actions">
              <a class="guide-link" href={irrigationChecklistHref}>
                <span>Interactive guide</span>
                <strong>Open the full 12-point irrigation guide.</strong>
                <small>Flow, chemistry, delivery, activation, safety, and finish.</small>
              </a>
              <a class="guide-download" href={irrigationChecklistPdfHref} download>
                <span>Download PDF</span>
                <strong>12-point chairside checklist</strong>
                <small>Includes source notes plus curated YouTube learning links.</small>
              </a>
            </div>
          </section>
        </div>
      ) : (
        <div class="article-shell">
          <aside class="article-aside" aria-label="Article format">
            <p>Suggested format</p>
            <ol>
              {idea.placeholders.map((placeholder) => (
                <li>{placeholder}</li>
              ))}
            </ol>
          </aside>

          <div class="article-body">
            <section>
              <h2>Clinical problem</h2>
              <p>
                Add the opening clinical context here. Frame the problem clearly, then connect each
                point to control, safety, and adaptability in the procedure.
              </p>
            </section>

            <section>
              <h2>Case notes</h2>
              <p>
                Add observations, decision points, technique notes, images, or evidence references
                here. Keep the language precise and evidence-informed.
              </p>
            </section>

            <section>
              <h2>Clinical implications</h2>
              <p>
                Add the practical conclusion here. Link the idea back to patient outcomes, workflow
                confidence, and the clinical problem described above.
              </p>
            </section>
          </div>
        </div>
      )
    }
  </article>
</ProductLayout>

<style>
  :global(body) {
    font-family: Inter, 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }

  .article-page {
    background: #ffffff;
  }

  .article-hero {
    width: min(920px, calc(100% - 48px));
    margin: 0 auto;
    padding: 72px 0 38px;
  }

  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    margin-bottom: 34px;
    border: 1px solid #d8e2ec;
    border-radius: 999px;
    background:
      linear-gradient(180deg, #ffffff 0%, #f7f9fc 100%);
    padding: 0.7rem 0.96rem 0.7rem 0.72rem;
    color: #24364a;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow:
      0 1px 2px rgba(12, 23, 48, 0.04),
      0 10px 28px rgba(0, 55, 112, 0);
    transition:
      border-color 200ms ease-in-out,
      box-shadow 200ms ease-in-out,
      color 200ms ease-in-out,
      transform 200ms ease-in-out;
  }

  .article-back:hover,
  .article-back:focus-visible {
    border-color: #b8d8ea;
    color: #0b75b7;
    box-shadow:
      0 1px 2px rgba(12, 23, 48, 0.04),
      0 8px 24px rgba(0, 55, 112, 0.08);
    transform: translateY(-1px);
    outline: none;
  }

  .article-back__icon {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid #c7d5e4;
    border-radius: 50%;
    background: #ffffff;
    color: #0b75b7;
    font-size: 1rem;
    line-height: 1;
    transition:
      border-color 200ms ease-in-out,
      background-color 200ms ease-in-out,
      transform 200ms ease-in-out;
  }

  .article-back:hover .article-back__icon,
  .article-back:focus-visible .article-back__icon {
    border-color: #0b75b7;
    background: #eef8fc;
    transform: translateX(-2px);
  }

  .article-eyebrow {
    margin: 0 0 14px;
    color: #0b75b7;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .article-hero h1 {
    margin: 0;
    color: #111827;
    font-family: Inter, 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .article-summary {
    max-width: 46rem;
    margin: 22px 0 0;
    color: #42526a;
    font-size: clamp(1.08rem, 2vw, 1.34rem);
    line-height: 1.58;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
    color: #607084;
    font-family: 'Geist Mono', 'SF Mono', ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .article-meta span {
    border: 1px solid #e3e8ee;
    border-radius: 999px;
    padding: 0.5rem 0.72rem;
    background: #f7f9fc;
  }

  .article-media {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .article-media img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-radius: 12px;
    background: #0c1730;
  }

  .article-media figcaption {
    margin-top: 12px;
    color: #607084;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .article-shell {
    display: grid;
    grid-template-columns: 260px minmax(0, 760px);
    gap: 54px;
    align-items: start;
    width: min(1040px, calc(100% - 48px));
    margin: 0 auto;
    padding: 58px 0 88px;
  }

  .article-aside {
    position: sticky;
    top: 104px;
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    padding: 18px;
    background: #f7f9fc;
  }

  .article-aside p {
    margin: 0 0 12px;
    color: #111827;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .article-aside ol {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 18px;
    color: #42526a;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .article-body {
    display: grid;
    gap: 42px;
  }

  .article-body section {
    border-bottom: 1px solid #e3e8ee;
    padding-bottom: 36px;
  }

  .article-body section:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .article-body h2 {
    margin: 0 0 14px;
    color: #111827;
    font-family: Inter, 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .article-body p {
    margin: 0;
    color: #24364a;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .irrigation-article {
    background: #ffffff;
  }

  .irrigation-intro,
  .irrigation-section {
    width: min(1160px, calc(100% - 48px));
    margin: 0 auto;
    padding: 64px 0;
    border-bottom: 1px solid #dde6ef;
  }

  .irrigation-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.72fr);
    align-items: center;
    gap: 48px;
  }

  .irrigation-intro h2,
  .irrigation-section h2 {
    margin: 8px 0 18px;
    color: #15354c;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.06;
    letter-spacing: 0;
  }

  .irrigation-intro p,
  .irrigation-section > p,
  .sequence-section > div > p,
  .checks-section > div > p {
    margin: 0 0 16px;
    color: #4f5f6d;
    font-size: 1.03rem;
    line-height: 1.75;
    max-width: 760px;
  }

  .control-panel {
    margin: 0;
    border: 1px solid #d8e4ef;
    border-radius: 12px;
    background: #f8fbfd;
    padding: 28px;
    box-shadow: 0 18px 48px rgba(22, 60, 86, 0.08);
  }

  .control-panel__label {
    margin: 0 0 18px;
    color: #0a83a8;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .control-panel ul {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .control-panel li {
    display: grid;
    gap: 6px;
    padding-top: 18px;
    border-top: 1px solid #dce7f0;
  }

  .control-panel li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .control-panel strong {
    color: #15354c;
    font-size: 1rem;
    line-height: 1.35;
  }

  .control-panel span {
    color: #526372;
    font-size: 0.96rem;
    line-height: 1.62;
  }

  .lever-grid,
  .teaching-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-top: 30px;
  }

  .teaching-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .lever-card,
  .teaching-card {
    border: 1px solid #dce7f0;
    border-radius: 8px;
    background: #f8fbfd;
    padding: 24px;
    min-height: 100%;
  }

  .lever-card span {
    display: block;
    color: #0a83a8;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .lever-card h3,
  .teaching-card h3,
  .sequence-list h3 {
    margin: 0 0 10px;
    color: #15354c;
    font-size: 1.02rem;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .lever-card p,
  .teaching-card p,
  .sequence-list p {
    margin: 0;
    color: #526372;
    line-height: 1.68;
    font-size: 0.96rem;
  }

  .sequence-section,
  .checks-section,
  .download-section {
    display: grid;
    grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1fr);
    gap: 44px;
    align-items: start;
  }

  .sequence-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: irrigation-step;
    display: grid;
    gap: 16px;
  }

  .sequence-list li {
    counter-increment: irrigation-step;
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: 18px;
    padding: 20px 0;
    border-top: 1px solid #dce7f0;
  }

  .sequence-list li::before {
    content: counter(irrigation-step, decimal-leading-zero);
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #e7f4f8;
    color: #0a83a8;
    font-size: 0.82rem;
    font-weight: 900;
  }

  .variables-table {
    margin-top: 28px;
    border: 1px solid #dce7f0;
    border-radius: 8px;
    overflow: hidden;
    background: #ffffff;
  }

  .variables-row {
    display: grid;
    grid-template-columns: minmax(180px, 0.38fr) minmax(0, 1fr);
    border-top: 1px solid #dce7f0;
  }

  .variables-row:first-child {
    border-top: 0;
  }

  .variables-row span {
    padding: 16px 20px;
    color: #506171;
    line-height: 1.55;
  }

  .variables-row span:first-child {
    color: #15354c;
    font-weight: 800;
    border-right: 1px solid #dce7f0;
  }

  .variables-head {
    background: #15354c;
  }

  .variables-head span,
  .variables-head span:first-child {
    color: #ffffff;
