---
import ProductLayout from '../../layouts/ProductLayout.astro';
import { withBasePath } from '../../utils/paths';

const ideasHref = withBasePath('/resources/ideas/');
const ideasTeaserSrc = withBasePath('/blog-ideas-teaser.png');

const documentGroups = [
  {
    label: 'Technique Guides',
    description: 'Workflow PDFs for the ET and PT shaping systems.',
    files: [
      { name: 'ET Technique Workflow (PDF)', href: '/downloads/ET-Technique-Work-Flow.pdf' },
      { name: 'PT Technique Workflow (PDF)', href: '/downloads/PT-Technique-Work-Flow.pdf' },
    ],
  },
  {
    label: 'Education Checklists',
    description: 'Chairside protocol PDFs for the MB2 and curved-canal education guides.',
    files: [
      { name: 'MB2 15-point Protocol Checklist (PDF)', href: '/downloads/EndoTech-NZ-MB2-15-Point-Protocol-Checklist.pdf' },
      { name: 'Curved Canal 13-point Checklist (PDF)', href: '/downloads/EndoTech-NZ-Curved-Canal-13-Point-Checklist.pdf' },
    ],
  },
  {
    label: 'Part Numbers & Ordering',
    description: 'Core ordering references for ET, PT, and Acrobat systems.',
    files: [
      { name: 'ET Part Numbers (PDF)', href: '/downloads/ET-Part-Numbers.pdf' },
      { name: 'PT Part Numbers (PDF)', href: '/downloads/PT-Part-Numbers.pdf' },
      { name: 'Acrobat Part Numbers (PDF)', href: '/downloads/Acrobat-Part-Numbers.pdf' },
      { name: 'Acrobat Clinical Blueprint (PDF)', href: '/downloads/Acrobat_Clinical_Blueprint.pdf' },
    ],
  },
  {
    label: 'Instructions for Use',
    description: 'Product-specific IFUs for TransformX™ ET, TransformX™ PT, and Acrobat Glide Path.',
    files: [
      { name: 'TransformX™ ET IFU (PDF)', href: '/downloads/ETNZ-IFU-TXET-001-TransformX-ET.pdf' },
      { name: 'TransformX™ PT IFU (PDF)', href: '/downloads/ETNZ-IFU-TXPT-001-TransformX-PT.pdf' },
      { name: 'Acrobat Glide Path IFU (PDF)', href: '/downloads/ETNZ-IFU-ACROBAT-001-Acrobat-Glide-Path.pdf' },
    ],
  },
  {
    label: 'Company Information',
    description: 'Mission, purpose, and long-term support direction for New Zealand dentistry.',
    files: [
      { name: 'EndoTech NZ Mission Statement', href: '' },
    ],
  },
];

const missionStatement = {
  title: 'EndoTech NZ Mission Statement',
  subtitle: 'Better Endodontics for New Zealand Dentistry',
  paragraphs: [
    'EndoTech NZ has been created by Steve Shepherd to support the future of endodontics in New Zealand through better products, fairer pricing, and practical clinical support for dentists.',
    'This mission is the result of a lifelong learning curve in endodontics — over 30 years of market development, product education, clinician training, distributor partnerships, and direct involvement in building endodontic markets across New Zealand, Australia, Asia and Europe. Steve’s background includes growing endodontic portfolios, supporting key opinion leaders, training dental teams, developing education models, and helping bring specialist-level endodontic thinking into everyday dental practice.',
    'EndoTech NZ is built around a simple belief: New Zealand dentists deserve access to high-quality endodontic systems that are clinically sensible, technically credible, and priced responsibly.',
    'Our purpose is not just to supply products. It is to help create better endodontics — by supporting safer shaping, improved apical control, effective irrigation, predictable obturation, and a clearer treatment workflow from diagnosis through restoration.',
    'We also believe that dentistry in New Zealand needs a more competitive and sustainable supply environment. High-quality endodontic treatment should not be limited by unnecessarily high product costs or dependence on a small number of expensive legacy brands.',
    'EndoTech NZ aims to build the foundations for long-term support of the New Zealand dental industry: reliable supply, practical education, responsive local service, transparent product information, and products selected specifically for the needs of New Zealand dentists.',
    'Our mission is to help dentists work with greater confidence, improve clinical outcomes, and make modern endodontic care more accessible across New Zealand.',
  ],
};
---

<ProductLayout
  title="Downloads | EndoTech NZ"
  description="Product documentation, technique guides, part numbers, and supporting EndoTech files."
  accent="slate"
>
  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-16 sm:py-20 lg:grid-cols-[minmax(0,0.92fr)_minmax(320px,0.78fr)] lg:items-center lg:py-24">
      <div>
        <div class="downloads-evidence-reveal-mask">
          <p class="downloads-evidence-reveal-text js-downloads-evidence-reveal">
            Evidence & Downloads
          </p>
        </div>
        <h1 class="mt-5 max-w-[11ch] text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-[3.7rem]">
          Technical files in one clean library.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
          Technique guides, part numbers, and supporting company files presented in the same premium clinical system as the redesigned product pages.
        </p>
      </div>

      <a
        href={ideasHref}
        class="group block overflow-hidden rounded-[2rem] border border-slate-200 bg-[linear-gradient(180deg,#ffffff,#f5f8fb)] p-4 shadow-[0_28px_80px_-48px_rgba(15,23,42,0.16)] transition-[transform,box-shadow,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:border-slate-300 hover:shadow-[0_34px_90px_-52px_rgba(15,23,42,0.2)] sm:p-5"
      >
        <div class="overflow-hidden rounded-[1.5rem] border border-slate-200 bg-slate-950">
          <img
            src={ideasTeaserSrc}
            alt="Blog page teaser showing a luminous clinical tooth illustration"
            class="h-full w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.02]"
          />
        </div>
        <div class="mt-5 flex items-center justify-between gap-4 px-2 pb-1">
          <div>
            <p class="text-lg font-bold uppercase tracking-[0.28em] text-slate-800 sm:text-xl">Blog</p>
            <p class="mt-2 text-xl font-bold tracking-tight text-slate-900">Open the EndoTech NZ blog</p>
            <p class="mt-2 text-sm leading-7 text-slate-600">Case notes, clinical ideas, and evidence-led thinking.</p>
          </div>
          <span class="inline-flex h-11 min-w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.82),0_1px_2px_rgba(15,23,42,0.04)] transition-[transform,box-shadow,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-0.5 group-hover:border-slate-300 group-hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]">
            <span aria-hidden="true">&rarr;</span>
          </span>
        </div>
      </a>
    </div>
  </section>

  <section class="bg-slate-50/70">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-20 lg:py-24">
      <div class="grid gap-5">
        {documentGroups.map((group) => (
          <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)] sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">{group.label}</p>
            <h2 class="mt-4 text-2xl font-bold tracking-tight text-slate-900">{group.label}</h2>
            <p class="mt-3 text-base leading-8 text-slate-600">{group.description}</p>

            {group.label === 'Company Information' ? (
              <div class="mt-6 rounded-[1.35rem] border border-slate-200 bg-slate-50/80 p-5 sm:p-6">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Mission statement</p>
                <h3 class="mt-3 text-2xl font-bold tracking-tight text-slate-900">{missionStatement.title}</h3>
                <p class="mt-2 text-lg font-semibold tracking-tight text-slate-700">{missionStatement.subtitle}</p>
                <div class="mt-5 grid gap-4">
                  {missionStatement.paragraphs.map((paragraph) => (
                    <p class="text-base leading-8 text-slate-600">{paragraph}</p>
                  ))}
                </div>
              </div>
            ) : (
              <div class="mt-6 grid gap-4">
                {group.files.map((file) => (
                  <div class="flex flex-col gap-3 rounded-[1.35rem] border border-slate-200 bg-slate-50/80 p-5 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">PDF document</p>
                      <h3 class="mt-2 text-lg font-bold tracking-tight text-slate-900">{file.name}</h3>
                    </div>
                    <a
                      href={withBasePath(file.href)}
                      class="inline-flex items-center justify-center rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.16),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
                    >
                      Open PDF
                    </a>
                  </div>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</ProductLayout>

<script>
  const downloadsEvidenceMask = document.querySelector('.downloads-evidence-reveal-mask');
  const downloadsEvidenceText = document.querySelector('.js-downloads-evidence-reveal');

  if (downloadsEvidenceMask && downloadsEvidenceText) {
    const originalText = 'Evidence & Downloads';

    downloadsEvidenceText.setAttribute('aria-label', originalText);
    downloadsEvidenceText.innerHTML = Array.from(originalText)
      .map((char, index) => {
        const safeChar = char === ' ' ? '&nbsp;' : char;
        return `<span class="downloads-evidence-reveal-char" aria-hidden="true" style="--char-index:${index}">${safeChar}</span>`;
      })
      .join('');

    const downloadsEvidenceObserver = new IntersectionObserver(
      (entries, observerInstance) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            window.setTimeout(() => {
              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  downloadsEvidenceMask.classList.add('is-visible');
                });
              });
            }, 180);

            observerInstance.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        threshold: 0.2,
      }
    );

    downloadsEvidenceObserver.observe(downloadsEvidenceMask);
  }
</script>

<style>
  .downloads-evidence-reveal-mask {
    display: block;
    overflow: hidden;
    text-align: left;
    padding: 0 0 14px;
    min-height: 24px;
  }

  .downloads-evidence-reveal-text {
    margin: 0;
    color: #64748b;
    font-size: 0.75rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    text-align: left;
    white-space: nowrap;
  }

  :global(.downloads-evidence-reveal-char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(5px);
    filter: blur(1.5px);
    transition:
      opacity 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--char-index) * 12ms);
    will-change: opacity, transform, filter;
  }

  :global(.downloads-evidence-reveal-mask.is-visible .downloads-evidence-reveal-char) {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
</style>
