---
import ProductLayout from '../../layouts/ProductLayout.astro';
import WorkflowStrip from '../../components/navigation/WorkflowStrip.astro';
import { withBasePath } from '../../utils/paths';

const base = import.meta.env.BASE_URL;
const ideasHref = withBasePath('/resources/ideas/');
const ideasTeaserSrc = withBasePath('/blog-ideas-teaser.png');

const educationCards = [
  {
    id: 'mb2-access',
    step: 'MB2 Access',
    note: 'Short-file control for restricted molar access.',
    href: `${base}technique/mb2-file/`,
    icon: 'access',
  },
  {
    id: 'motor-settings',
    step: 'Motor Settings',
    note: 'RPM and torque reference for ET, PT, and Micro-Path.',
    href: `${base}technique/motor-settings/`,
    icon: 'settings',
  },
  {
    id: 'curved-canals',
    step: 'Curved Canals',
    note: 'Glide path, centering, and apical control in curvature.',
    href: `${base}technique/rotary-files-for-curved-canals/`,
    icon: 'curve',
  },
  {
    id: 'irrigation-ideas',
    step: 'Interesting ideas on irrigation',
    note: 'Flow, chemistry, activation, and what remains.',
    href: `${base}resources/ideas/irrigation-dynamics-that-matter/`,
    icon: 'clean',
  },
  {
    id: 'pt-technique',
    step: 'PT Technique',
    note: 'Progressive taper sequence from coronal shaping to finish.',
    href: `${base}technique/pt-technique/`,
    icon: 'pt',
  },
  {
    id: 'et-technique',
    step: 'ET Technique',
    note: 'Glide path, shape, and finish for ET-style workflows.',
    href: `${base}technique/et-technique/`,
    icon: 'et',
  },
  {
    id: 'clinical-evidence',
    step: 'Evidence',
    note: 'Outcome evidence and apical-control rationale.',
    href: `${base}research/evidence/`,
    icon: 'evidence',
  },
  {
    id: 'apical-control',
    step: 'Apical Control',
    note: 'Working-length discipline and safer apical preparation.',
    href: `${base}research/apical-control/`,
    icon: 'apical',
  },
];

const principles = [
  {
    number: '01',
    title: 'Establish a reproducible glide path first',
    text: 'Before introducing rotary shaping, confirm a smooth path to working length. This remains the most important control step before file progression.',
  },
  {
    number: '02',
    title: 'Irrigate, recapitulate, re-irrigate',
    text: 'Between files, flush debris, confirm patency with a small hand file, and irrigate again before moving to the next rotary instrument.',
  },
  {
    number: '03',
    title: 'Let the file work without excess apical pressure',
    text: 'Transform S™ is designed for controlled advancement. Excessive apical pressure can reduce the benefit of the file geometry and increase procedural stress.',
  },
  {
    number: '04',
    title: 'Inspect files before reuse',
    text: 'Watch for unwinding, visible distortion, or repeated use in difficult anatomy. Discard files when fatigue signs appear.',
  },
];

const systems = [
  {
    title: 'Transform S™ ET',
    points: [
      'Designed around familiar ET-style sequence logic.',
      'No motor setting change is required for established ET workflows.',
      'Use existing clinical selection logic while evaluating file behaviour in demanding anatomy.',
    ],
    href: `${base}products/transform-s-et/`,
    guide: `${base}products/transform-s-et/`,
  },
  {
    title: 'Transform S™ PT',
    points: [
      'Follows familiar PT-style progressive shaping philosophy.',
      'No motor setting change is required for established PT workflows.',
      'Supports crown-down progression with added apical guidance and metallurgical adaptability.',
    ],
    href: `${base}products/transform-s-pt/`,
    guide: `${base}products/transform-s-pt/`,
  },
];

const avatarPoints = [
  'Canal centering in the apical third',
  'Controlled engagement as curvature increases',
  'Reduced tendency toward abrupt wall contact',
  'Smoother progression toward working length',
];
---

<ProductLayout
  title="Clinical Education | EndoTech NZ"
  description="Clinical guidance for using Transform S™ with controlled glide path, shaping, irrigation, and apical guidance principles."
  accent="slate"
>
  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-16 sm:py-20 lg:grid-cols-[minmax(0,0.92fr)_minmax(320px,0.78fr)] lg:items-center lg:py-24">
      <div>
        <div class="clinical-tips-education-reveal-mask">
          <p class="clinical-tips-education-reveal-text js-clinical-tips-education-reveal">
            Education
          </p>
        </div>
        <h1 class="mt-5 max-w-[11ch] text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Clinical guidance for controlled shaping.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
          Concise technique principles for integrating Transform S™ into familiar workflows, with emphasis on glide path control, irrigation discipline, and careful apical advancement.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={`${base}technique/workflow/`}
            class="inline-flex min-w-[15rem] items-center justify-center rounded-full bg-slate-900 px-6 py-3.5 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.16),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
          >
            Review workflow
          </a>
          <a
            href={`${base}resources/downloads/`}
            class="inline-flex min-w-[15rem] items-center justify-center rounded-full border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.82),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color,color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
          >
            Open downloads
          </a>
        </div>
      </div>

      <a
        href={ideasHref}
        class="group block overflow-hidden rounded-[2rem] border border-slate-200 bg-[linear-gradient(180deg,#ffffff,#f5f8fb)] p-4 shadow-[0_28px_80px_-48px_rgba(15,23,42,0.16)] transition-[transform,box-shadow,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:border-slate-300 hover:shadow-[0_34px_90px_-52px_rgba(15,23,42,0.2)] sm:p-5"
      >
        <div class="overflow-hidden rounded-[1.5rem] border border-slate-200 bg-slate-950">
          <img
            src={ideasTeaserSrc}
            alt="Blog page teaser showing a luminous clinical tooth illustration"
            class="h-full w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.02]"
          />
        </div>
        <div class="mt-5 flex items-center justify-between gap-4 px-2 pb-1">
          <div>
            <p class="text-lg font-bold uppercase tracking-[0.28em] text-slate-800 sm:text-xl">Blog</p>
            <p class="mt-2 text-xl font-bold tracking-tight text-slate-900">Open the EndoTech NZ blog</p>
            <p class="mt-2 text-sm leading-7 text-slate-600">Case notes, clinical ideas, and evidence-led thinking.</p>
          </div>
          <span class="inline-flex h-11 min-w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.82),0_1px_2px_rgba(15,23,42,0.04)] transition-[transform,box-shadow,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-0.5 group-hover:border-slate-300 group-hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]">
            <span aria-hidden="true">&rarr;</span>
          </span>
        </div>
      </a>
    </div>
  </section>

  <WorkflowStrip items={educationCards} title="Education page navigation" />

  <section class="border-b border-slate-200/80 bg-slate-50/70">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-18 lg:py-20">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">General Principles</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          A calmer sequence begins before the first shaping file.
        </h2>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {principles.map((principle) => (
          <article class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-[0_20px_48px_-42px_rgba(15,23,42,0.12)]">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">{principle.number}</p>
            <h3 class="mt-4 text-2xl font-bold tracking-tight text-slate-900">{principle.title}</h3>
            <p class="mt-4 text-sm leading-7 text-slate-600">{principle.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto grid max-w-7xl gap-5 px-6 py-16 sm:py-18 lg:grid-cols-[minmax(0,0.92fr)_minmax(320px,0.78fr)] lg:py-20">
      <article class="rounded-[1.75rem] border border-slate-200 bg-slate-50/70 p-6 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)] sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Between Each File</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Irrigate, recapitulate, re-irrigate.
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
          Keep the sequence simple and repeatable. The technique value comes from how consistently those control steps are maintained.
        </p>
      </article>

      <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)]">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Avatar Tip</p>
        <ul class="mt-5 space-y-3">
          {avatarPoints.map((item) => (
            <li class="rounded-[1.15rem] border border-slate-200 bg-slate-50/80 px-4 py-4 text-sm leading-7 text-slate-600">
              {item}
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-slate-50/70">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-18 lg:py-20">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">System-Specific Guidance</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Use familiar sequence logic with a more controlled file response.
        </h2>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {systems.map((system) => (
          <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)] sm:p-8">
            <h3 class="text-2xl font-bold tracking-tight text-slate-900">{system.title}</h3>
            <ul class="mt-5 space-y-3">
              {system.points.map((point) => (
                <li class="text-sm leading-7 text-slate-600">{point}</li>
              ))}
            </ul>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <a
                href={system.href}
                class="inline-flex items-center justify-center rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.16),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
              >
                View product
              </a>
              <a
                href={system.guide}
                class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.82),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color,color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
              >
                Open PDF
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-18 lg:py-20">
      <div class="rounded-[2rem] bg-gradient-to-br from-slate-900 to-slate-800 px-6 py-10 text-white shadow-[0_30px_70px_-45px_rgba(15,23,42,0.45)] sm:px-8 sm:py-12">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-300">Next Step</p>
        <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl">
          Review the workflow, then connect the technique to the system.
        </h2>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={`${base}technology/`}
            class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.8),0_1px_2px_rgba(2,6,23,0.08)] transition-[background-color,box-shadow,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-slate-100 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.88),0_12px_24px_rgba(2,6,23,0.18),0_2px_6px_rgba(2,6,23,0.08)]"
          >
            Technology overview
          </a>
          <a
            href={`${base}about/contact/`}
            class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/[0.04] px-6 py-3.5 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur-sm transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-white/35 hover:bg-white/[0.08] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_12px_24px_rgba(2,6,23,0.18)]"
          >
            Ask a clinical question
          </a>
        </div>
      </div>
    </div>
  </section>
</ProductLayout>

<script>
  const clinicalTipsEducationMask = document.querySelector('.clinical-tips-education-reveal-mask');
  const clinicalTipsEducationText = document.querySelector('.js-clinical-tips-education-reveal');

  if (clinicalTipsEducationMask && clinicalTipsEducationText) {
    const originalText = 'Education';

    clinicalTipsEducationText.setAttribute('aria-label', originalText);
    clinicalTipsEducationText.innerHTML = Array.from(originalText)
      .map((char, index) => {
        const safeChar = char === ' ' ? '&nbsp;' : char;
        return `<span class="clinical-tips-education-reveal-char" aria-hidden="true" style="--char-index:${index}">${safeChar}</span>`;
      })
      .join('');

    const clinicalTipsEducationObserver = new IntersectionObserver(
      (entries, observerInstance) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            window.setTimeout(() => {
              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  clinicalTipsEducationMask.classList.add('is-visible');
                });
              });
            }, 180);

            observerInstance.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        threshold: 0.2,
      }
    );

    clinicalTipsEducationObserver.observe(clinicalTipsEducationMask);
  }
</script>

<style>
  .clinical-tips-education-reveal-mask {
    display: block;
    overflow: hidden;
    text-align: left;
    padding: 0 0 14px;
    min-height: 24px;
  }

  .clinical-tips-education-reveal-text {
    margin: 0;
    color: #64748b;
    font-size: 0.75rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    text-align: left;
    white-space: nowrap;
  }

  :global(.clinical-tips-education-reveal-char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(5px);
    filter: blur(1.5px);
    transition:
      opacity 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--char-index) * 12ms);
    will-change: opacity, transform, filter;
  }

  :global(.clinical-tips-education-reveal-mask.is-visible .clinical-tips-education-reveal-char) {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
</style>
