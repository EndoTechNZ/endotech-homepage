---
import ProductLayout from '../../layouts/ProductLayout.astro';
import WorkflowStrip from '../../components/navigation/WorkflowStrip.astro';
import transformxSystem from '../../assets/transformx-rotary-file-system.png';

const base = import.meta.env.BASE_URL;
const explainerVideoSrc = `${base}videos/explainer.mp4`;

const phases = [
  {
    label: 'Austenite',
    role: 'Coronal stability',
    text: 'A firmer response where cutting efficiency and torsional control matter most.',
  },
  {
    label: 'R-phase',
    role: 'Transition behaviour',
    text: 'An intermediate response as anatomy and shaping demands become more complex.',
  },
  {
    label: 'Martensite',
    role: 'Apical adaptability',
    text: 'A more flexible response where curvature and working-length control are most sensitive.',
  },
];

const benefits = [
  {
    title: 'Progressive stress management',
    text: 'Support a more controlled response through the working length instead of asking one material state to do everything.',
  },
  {
    title: 'Lower restoring-force pressure',
    text: 'Help reduce the tendency toward transportation, ledging, zipping, and other iatrogenic movement in curved anatomy.',
  },
  {
    title: 'Familiar clinical workflow',
    text: 'The technology is intended to improve file behaviour without asking clinicians to abandon established sequence logic.',
  },
];

const technologyStories = [
  {
    label: 'Transform Technology',
    title: 'Variable-phase metallurgy for a calmer shaping response.',
    text: 'Supports coronal efficiency and greater apical adaptability without asking clinicians to abandon familiar sequence logic.',
    ctaLabel: 'Review shaping systems',
    href: `${base}products/overview/`,
    accent: 'light',
  },
  {
    label: 'Avatar Tip',
    title: 'Guidance-focused apical geometry where canal control becomes more sensitive.',
    text: 'Frames the apical guidance story earlier: smoother advancement, reduced aggressive engagement, and more centered progression in demanding anatomy.',
    ctaLabel: 'Explore Avatar Tip',
    href: `${base}technology/avatar-tip/`,
    accent: 'dark',
  },
];
---

<ProductLayout
  title="Transform Technology | EndoTech NZ"
  description="How Transform Technology uses variable-phase NiTi metallurgy to support controlled shaping and apical adaptability."
  accent="slate"
>
  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 sm:py-20 lg:grid-cols-[minmax(0,0.9fr)_minmax(320px,0.82fr)] lg:items-center lg:py-24">
      <div>
        <div class="transform-technology-reveal-mask">
          <p class="transform-technology-reveal-text js-transform-technology-reveal">
            Technology
          </p>
        </div>
        <h1 class="mt-5 max-w-[9ch] text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-[3.8rem]">
          Transform Technology
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
          Variable-phase NiTi engineering designed to deliver a calmer shaping response as canal anatomy becomes more demanding.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={`${base}products/et-transformx/`}
            class="inline-flex min-w-[15rem] items-center justify-center rounded-full bg-slate-900 px-6 py-3.5 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.16),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
          >
            View ET TransformX
          </a>
          <a
            href={`${base}products/pt-transformx/`}
            class="inline-flex min-w-[15rem] items-center justify-center rounded-full border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.82),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color,color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
          >
            View PT TransformX
          </a>
        </div>
      </div>

      <div class="rounded-[2rem] border border-slate-200 bg-[linear-gradient(180deg,#ffffff,#f5f8fb)] p-6 shadow-[0_28px_80px_-48px_rgba(15,23,42,0.16)] sm:p-8">
        <div class="rounded-[1.5rem] border border-slate-200 bg-white p-4">
          <img src={transformxSystem.src} alt="TransformX rotary file system" class="w-full object-contain" />
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <div class="rounded-[1.2rem] border border-slate-200 bg-slate-50/80 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Technology aim</p>
            <p class="mt-2 text-sm leading-7 text-slate-700">Stability coronally and greater adaptability as the file approaches the apex.</p>
          </div>
          <div class="rounded-[1.2rem] border border-slate-200 bg-[#123d78] p-4 text-white">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-100/90">Clinical frame</p>
            <p class="mt-2 text-sm leading-7 text-slate-100">The same shaping logic, with a more controlled material response through the canal.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WorkflowStrip activeStep="assess" />

  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Technology Overview</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Transform Technology explained in one focused clinical overview.
        </h2>
        <p class="mt-4 text-base leading-8 text-slate-600 sm:text-lg">
          This short explainer brings the metallurgy, shaping logic, and product-family story back into one place so the
          technology page feels complete again.
        </p>
      </div>

      <div class="mx-auto mt-10 max-w-5xl overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-950 shadow-[0_30px_90px_-45px_rgba(15,23,42,0.42)]">
        <video controls playsinline preload="metadata" class="block aspect-video w-full bg-slate-950">
          <source src={explainerVideoSrc} type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>

      <p class="mt-6 text-center text-sm text-slate-500">37 seconds of TransformX technology and product overview.</p>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-slate-50/70">
    <div class="mx-auto grid max-w-7xl gap-5 px-6 py-20 sm:py-20 lg:grid-cols-[minmax(0,0.92fr)_minmax(320px,0.78fr)] lg:py-24">
      <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)] sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Clinical Problem</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          One uniform file response has to serve two different shaping demands.
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
          Coronal shaping needs strength and efficiency. Apical shaping needs flexibility and reduced lateral stress. A uniform material response can compromise one zone while trying to serve the other.
        </p>
      </article>

      <article class="rounded-[1.75rem] border border-slate-200 bg-[#123d78] p-6 text-white shadow-[0_24px_60px_-42px_rgba(15,23,42,0.42)]">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cyan-100/90">TransformX Solution</p>
        <p class="mt-4 text-sm leading-7 text-slate-100">
          Use controlled phase transitions in nickel-titanium metallurgy to tune behaviour through the active working length.
        </p>
      </article>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-20 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Technology Platform</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Two connected technology stories, shown at the same level.
        </h2>
        <p class="mt-4 text-base leading-8 text-slate-600 sm:text-lg">
          Transform Technology explains the material response. Avatar Tip explains the apical guidance behaviour. Both belong near the centre of the platform story, not as a late footnote.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {technologyStories.map((story) => (
          <article
            class:list={[
              'rounded-[1.85rem] p-6 shadow-[0_24px_56px_-44px_rgba(15,23,42,0.18)] sm:p-8',
              story.accent === 'dark'
                ? 'border border-[#123d78]/20 bg-[#123d78] text-white'
                : 'border border-slate-200 bg-slate-50/70 text-slate-900',
            ]}
          >
            <p
              class:list={[
                'text-xs font-semibold uppercase tracking-[0.3em]',
                story.accent === 'dark' ? 'text-cyan-100/90' : 'text-slate-500',
              ]}
            >
              {story.label}
            </p>
            <h3 class="mt-4 text-2xl font-bold tracking-tight sm:text-[2rem]">{story.title}</h3>
            <p class:list={['mt-4 max-w-xl text-base leading-8', story.accent === 'dark' ? 'text-slate-100' : 'text-slate-600']}>
              {story.text}
            </p>
            <div class="mt-8">
              <a
                href={story.href}
                class:list={[
                  'inline-flex items-center justify-center rounded-full px-6 py-3.5 text-sm font-semibold transition-[background-color,box-shadow,transform,border-color,color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5',
                  story.accent === 'dark'
                    ? 'bg-white text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.8),0_1px_2px_rgba(2,6,23,0.08)] hover:bg-slate-100 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.88),0_12px_24px_rgba(2,6,23,0.18),0_2px_6px_rgba(2,6,23,0.08)]'
                    : 'border border-slate-200 bg-white text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.82),0_1px_2px_rgba(15,23,42,0.04)] hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]',
                ]}
              >
                {story.ctaLabel}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-20 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Phase Sequence</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          A progressive response through the working length.
        </h2>
        <p class="mt-4 text-base leading-8 text-slate-600 sm:text-lg">
          The file is not being framed as uniformly rigid or uniformly flexible. The idea is controlled response where different parts of the canal demand different behaviour.
        </p>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {phases.map((phase) => (
          <article class="rounded-[1.5rem] border border-slate-200 bg-slate-50/80 p-6 shadow-[0_20px_48px_-42px_rgba(15,23,42,0.12)]">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">{phase.label}</p>
            <h3 class="mt-4 text-2xl font-bold tracking-tight text-slate-900">{phase.role}</h3>
            <p class="mt-4 text-sm leading-7 text-slate-600">{phase.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-slate-50/70">
    <div class="mx-auto max-w-7xl px-6 py-20 sm:py-20 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Clinical Benefits</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Technology framed by what it helps control.
        </h2>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {benefits.map((benefit) => (
          <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)]">
            <h3 class="text-2xl font-bold tracking-tight text-slate-900">{benefit.title}</h3>
            <p class="mt-4 text-base leading-8 text-slate-600">{benefit.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-18 lg:py-20">
      <div class="rounded-[2rem] bg-gradient-to-br from-slate-900 to-slate-800 px-6 py-10 text-white shadow-[0_30px_70px_-45px_rgba(15,23,42,0.45)] sm:px-8 sm:py-12">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-300">Next Step</p>
        <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl">
          Move from technology into workflow or shaping system selection.
        </h2>
        <p class="mt-4 max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">
          The core technology stories are now on the page. From here, the next useful step is either to review the workflow sequence or move straight into ET and PT product selection.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={`${base}products/overview/`}
            class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.8),0_1px_2px_rgba(2,6,23,0.08)] transition-[background-color,box-shadow,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-slate-100 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.88),0_12px_24px_rgba(2,6,23,0.18),0_2px_6px_rgba(2,6,23,0.08)]"
          >
            Review shaping systems
          </a>
          <a
            href={`${base}technique/workflow/`}
            class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/[0.04] px-6 py-3.5 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur-sm transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-white/35 hover:bg-white/[0.08] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_12px_24px_rgba(2,6,23,0.18)]"
          >
            Review workflow
          </a>
        </div>
      </div>
    </div>
  </section>
</ProductLayout>

<script>
  const transformTechnologyMask = document.querySelector('.transform-technology-reveal-mask');
  const transformTechnologyText = document.querySelector('.js-transform-technology-reveal');

  if (transformTechnologyMask && transformTechnologyText) {
    const originalText = 'Technology';

    transformTechnologyText.setAttribute('aria-label', originalText);
    transformTechnologyText.innerHTML = Array.from(originalText)
      .map((char, index) => {
        const safeChar = char === ' ' ? '&nbsp;' : char;
        return `<span class="transform-technology-reveal-char" aria-hidden="true" style="--char-index:${index}">${safeChar}</span>`;
      })
      .join('');

    const transformTechnologyObserver = new IntersectionObserver(
      (entries, observerInstance) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            window.setTimeout(() => {
              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  transformTechnologyMask.classList.add('is-visible');
                });
              });
            }, 180);

            observerInstance.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        threshold: 0.2,
      }
    );

    transformTechnologyObserver.observe(transformTechnologyMask);
  }
</script>

<style>
  .transform-technology-reveal-mask {
    display: block;
    overflow: hidden;
    text-align: left;
    padding: 0 0 14px;
    min-height: 24px;
  }

  .transform-technology-reveal-text {
    margin: 0;
    color: #64748b;
    font-size: 0.75rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    text-align: left;
    white-space: nowrap;
  }

  :global(.transform-technology-reveal-char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(5px);
    filter: blur(1.5px);
    transition:
      opacity 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--char-index) * 12ms);
    will-change: opacity, transform, filter;
  }

  :global(.transform-technology-reveal-mask.is-visible .transform-technology-reveal-char) {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
</style>
