---
import ProductLayout from '../../layouts/ProductLayout.astro';
import WorkflowStrip from '../../components/navigation/WorkflowStrip.astro';
import avatarComparison from '../../assets/avatar-tip-comparison.png';

const base = import.meta.env.BASE_URL;

const controls = [
  'Rounded guidance profile',
  'Smooth transition geometry',
  'Bi-conical tip behaviour',
  'Controlled apical advancement',
];

const benefits = [
  'Better canal centering in the apical third',
  'Reduced tendency toward transportation and ledging',
  'Lower risk of abrupt lateral wall engagement',
  'Smoother progression toward working length',
];
---

<ProductLayout
  title="Avatar Tip Technology | EndoTech Singapore"
  description="Avatar Tip Technology is a guidance-focused apical tip design for centered advancement and controlled shaping."
  accent="slate"
>
  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-16 sm:py-20 lg:grid-cols-[minmax(0,0.9fr)_minmax(320px,0.82fr)] lg:items-center lg:py-24">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Avatar Tip Technology</p>
        <h1 class="mt-5 max-w-[11ch] text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Guidance where apical tolerance is lowest.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
          Avatar Tip is the TransformX apical geometry designed to support centered advancement, smoother engagement, and calmer control in demanding anatomy.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="#comparison"
            class="inline-flex min-w-[15rem] items-center justify-center rounded-full bg-slate-900 px-6 py-3.5 text-sm font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.16),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
          >
            Compare geometry
          </a>
          <a
            href={`${base}technology/transform-technology/`}
            class="inline-flex min-w-[15rem] items-center justify-center rounded-full border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.82),0_1px_2px_rgba(15,23,42,0.04)] transition-[background-color,box-shadow,transform,border-color,color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_12px_24px_rgba(15,23,42,0.08),0_2px_6px_rgba(15,23,42,0.05)]"
          >
            Transform Technology
          </a>
        </div>
      </div>

      <div class="rounded-[2rem] border border-slate-200 bg-[linear-gradient(180deg,#ffffff,#f5f8fb)] p-6 shadow-[0_28px_80px_-48px_rgba(15,23,42,0.16)] sm:p-8">
        <div class="rounded-[1.5rem] border border-slate-200 bg-white p-4">
          <img src={avatarComparison.src} alt="Avatar Tip compared with a sharper competitor tip profile" class="w-full object-contain" />
        </div>
        <div class="mt-6 rounded-[1.2rem] border border-slate-200 bg-[#123d78] p-4 text-white">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-100/90">Clinical frame</p>
          <p class="mt-2 text-sm leading-7 text-slate-100">Tip geometry is presented here as a control feature, not as an aggressiveness claim.</p>
        </div>
      </div>
    </div>
  </section>

  <WorkflowStrip activeStep="access" />

  <section class="border-b border-slate-200/80 bg-slate-50/70">
    <div class="mx-auto grid max-w-7xl gap-5 px-6 py-16 sm:py-18 lg:grid-cols-[minmax(0,0.92fr)_minmax(320px,0.78fr)] lg:py-20">
      <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)] sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Clinical Problem</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          The apical third allows the least tolerance for abrupt file behaviour.
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
          Canal curvature, reduced dentin thickness, and limited room for error make tip behaviour clinically important. A more aggressive leading profile can engage the outer wall before the file is fully centered.
        </p>
      </article>

      <article class="rounded-[1.75rem] border border-slate-200 bg-[#123d78] p-6 text-white shadow-[0_24px_60px_-42px_rgba(15,23,42,0.42)]">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cyan-100/90">TransformX Solution</p>
        <p class="mt-4 text-sm leading-7 text-slate-100">
          A guidance-focused apical geometry designed to reduce abrupt wall engagement and help preserve the original canal path.
        </p>
      </article>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-18 lg:py-20">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Control Features</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Geometry intended to guide, not force.
        </h2>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {controls.map((item) => (
          <article class="rounded-[1.5rem] border border-slate-200 bg-slate-50/80 p-6 shadow-[0_20px_48px_-42px_rgba(15,23,42,0.12)]">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Feature</p>
            <h3 class="mt-4 text-xl font-bold tracking-tight text-slate-900">{item}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="comparison" class="border-b border-slate-200/80 bg-slate-50/70">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-18 lg:py-20">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Video Comparison</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Compare rounded guidance with a sharper transition profile.
        </h2>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <figure class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)]">
          <div class="overflow-hidden rounded-[1.35rem] border border-slate-200 bg-slate-50/70">
            <video class="aspect-video w-full object-contain" controls muted playsinline preload="metadata">
              <source src={`${base}videos/avatar-tip/avatar-tip-rounded.mp4`} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
          <figcaption class="mt-4 text-sm leading-7 text-slate-600">
            Avatar Tip: rounded leading geometry designed for smoother guidance.
          </figcaption>
        </figure>

        <figure class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)]">
          <div class="overflow-hidden rounded-[1.35rem] border border-slate-200 bg-slate-50/70">
            <video class="aspect-video w-full object-contain" controls muted playsinline preload="metadata">
              <source src={`${base}videos/avatar-tip/competitor-tip-pointed.mp4`} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
          <figcaption class="mt-4 text-sm leading-7 text-slate-600">
            Sharper transition profile shown for comparison of leading-edge behaviour.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto grid max-w-7xl gap-5 px-6 py-16 sm:py-18 lg:grid-cols-[minmax(0,0.92fr)_minmax(320px,0.78fr)] lg:py-20">
      <article class="rounded-[1.75rem] border border-slate-200 bg-slate-50/70 p-6 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)] sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Apical Behaviour</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Controlled traversal through the final 2 mm.
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
          The safety story is not only how the tip looks under magnification. It is how the file behaves as it advances through a complex apical pathway.
        </p>
      </article>

      <figure class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_22px_48px_-42px_rgba(15,23,42,0.14)]">
        <div class="overflow-hidden rounded-[1.35rem] border border-slate-200 bg-slate-50/70">
          <video class="aspect-video w-full object-contain" controls muted playsinline preload="metadata">
            <source src={`${base}videos/avatar-tip/avatar-tip-apical-control.mp4`} type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        </div>
        <figcaption class="mt-4 text-sm leading-7 text-slate-600">
          Bi-conical block demonstration showing centered advancement through the apical segment.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-18 lg:py-20">
      <div class="rounded-[2rem] bg-gradient-to-br from-slate-900 to-slate-800 px-6 py-10 text-white shadow-[0_30px_70px_-45px_rgba(15,23,42,0.45)] sm:px-8 sm:py-12">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-300">Clinical Benefits</p>
        <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl">
          Apical control expressed in clinical terms.
        </h2>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {benefits.map((item) => (
            <li class="rounded-[1.2rem] border border-white/10 bg-white/6 px-4 py-4 text-sm leading-7 text-slate-100">
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</ProductLayout>
