---
import ProductLayout from '../../layouts/ProductLayout.astro';
import etProduct from '../../assets/et-transformx.png';

const base = import.meta.env.BASE_URL;
---

<ProductLayout
  title="Account Application Sent | EndoTech NZ"
  description="EndoTech NZ has received your account application."
  image={etProduct.src}
  accent="slate"
>
  <main class="thanks-page">
    <section class="thanks-panel" aria-labelledby="thanks-title">
      <p>EndoTech NZ</p>
      <h1 id="thanks-title">Application sent.</h1>
      <span>Your account application has been submitted for manual review. EndoTech NZ will follow up directly.</span>
      <div>
        <a href={`${base}apply-for-account/`}>Back to application</a>
        <a href={`${base}`}>Home</a>
      </div>
    </section>
  </main>
</ProductLayout>

<style>
  .thanks-page {
    min-height: 62vh;
    display: grid;
    place-items: center;
    background: #f7f9fb;
    padding: 56px 18px;
  }

  .thanks-panel {
    width: min(760px, 100%);
    border: 1px solid #e3e8ee;
    border-radius: 10px;
    background: #ffffff;
    padding: clamp(28px, 5vw, 54px);
    box-shadow: 0 8px 24px rgba(0, 55, 112, 0.08), 0 2px 6px rgba(0, 55, 112, 0.04);
  }

  .thanks-panel p {
    margin: 0 0 16px;
    color: #607084;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .thanks-panel h1 {
    margin: 0;
    color: #111827;
    font-family: Inter, 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 600;
    line-height: 1;
  }

  .thanks-panel span {
    display: block;
    margin-top: 22px;
    color: #536478;
    font-size: 1.04rem;
    line-height: 1.72;
  }

  .thanks-panel div {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .thanks-panel a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border: 1px solid #0b75b7;
    border-radius: 999px;
    padding: 0 18px;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
    background: #0b75b7;
  }

  .thanks-panel a + a {
    border-color: #b8d8ea;
    color: #0b75b7;
    background: #ffffff;
  }
</style>
