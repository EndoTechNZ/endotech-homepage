---
import ProductLayout from '../../layouts/ProductLayout.astro';
---
<ProductLayout title="3D Solutions with MicroPath | EndoTech NZ" description="Explore upper and lower molar teaching models with MicroPath.">
 <section class="three-d-shell"><a class="back-link" href="/products/micro-path/">← Back to MicroPath</a><p class="eyebrow">Interactive anatomy</p><h1>3D Solutions with MicroPath</h1><p class="intro">Explore the upper first molar and lower molar. Choose a model, adjust your view, then inspect the MicroPath file.</p>
 <nav class="molar-choices" aria-label="Choose a molar"><a href="?model=upper" data-model="upper">Upper first molar</a><a href="?model=lower" data-model="lower">Lower molar · LM6</a></nav>
 <section class="model-card" aria-labelledby="model-heading"><div class="model-top"><div><p class="eyebrow">Interactive model</p><h2 id="model-heading">Upper first molar</h2><p id="model-description"></p></div><div class="model-actions"><button id="watch-video" type="button">Watch video instead</button><a id="open-viewer" target="_blank" rel="noopener">Open larger viewer ↗</a></div></div><div id="model-host"></div><div id="video-host" hidden><video id="model-video" controls playsinline preload="metadata"></video><button id="return-model" type="button">Return to interactive model</button><p id="video-description"></p></div><p class="model-limits" id="model-limits"></p></section></section>
 <script is:inline>
 const config={upper:{title:'Upper first molar',description:'MB2 MicroPath teaching model · 21 mm CAD stopper setting',viewer:'/viewers/upper-molar-mb2/?v=3d-solutions-20261008',video:'/models/upper-molar-mb2/upper-molar-with-mb2-roots-up-v8.mp4',limits:'Research-informed, non-to-scale illustration. Prescribed file route; wall contact/overlap is permitted. This is not a cutting or clinical file-fit simulation.'},lower:{title:'Lower molar · LM6',description:'Scan-derived candidate spaces · approved 21 mm teaching view',viewer:'/viewers/lower-molar-lm6/?view=teaching&v=lm6-opacity34-20261008',video:'/models/lower-molar-lm6/lm6-model-360-v2.mp4',limits:'LM6 scan-derived teaching model. Candidate internal spaces and partial routes retain unresolved termini. The 21 mm teaching view is scaled; measured view and original scan evidence remain available. No clinical working length or anatomical connectivity validation is implied.'}};
 const model=new URLSearchParams(location.search).get('model')==='lower'?'lower':'upper',c=config[model],host=document.querySelector('#model-host'),video=document.querySelector('#model-video');document.querySelector('#model-heading').textContent=c.title;document.querySelector('#model-description').textContent=c.description;document.querySelector('#model-limits').textContent=c.limits;document.querySelector('#open-viewer').href=c.viewer;for(const a of document.querySelectorAll('[data-model]'))if(a.dataset.model===model)a.setAttribute('aria-current','page');
 function load(){if(host.querySelector('iframe'))return;const frame=document.createElement('iframe');frame.src=c.viewer;frame.title=c.title+' interactive MicroPath model';frame.allow='fullscreen';frame.allowFullscreen=true;host.append(frame)}load();
 document.querySelector('#watch-video').onclick=()=>{host.querySelector('iframe')?.remove();host.hidden=true;document.querySelector('#video-host').hidden=false;video.src=c.video;if(model==='lower'){video.classList.add('lm6-video');video.poster='/models/lower-molar-lm6/lm6-model-360-v2.jpg';}video.setAttribute('aria-label',c.title+' model video');document.querySelector('#video-description').textContent=model==='lower'?'A complete 360° rotation of the approved LM6 model, with a full-tooth view beside illustrative file motion. Crown, all roots and the complete file stay in frame. Anatomy and dimensions are unchanged.':'Existing approved upper-molar animation.';video.focus();};document.querySelector('#return-model').onclick=()=>{video.pause();video.removeAttribute('src');video.load();document.querySelector('#video-host').hidden=true;host.hidden=false;load();};window.addEventListener('message',e=>{const f=host.querySelector('iframe');if(e.origin===location.origin&&e.source===f?.contentWindow&&e.data?.type==='endo-viewer-height')f.style.height=Math.max(780,Math.min(5000,e.data.height))+'px'});
 </script>
</ProductLayout>
<style>.three-d-shell{max-width:1280px;margin:auto;padding:46px 24px 60px}.back-link{color:#22647b;font-size:13px;text-underline-offset:4px}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.16em;font-weight:700;color:#647c7b;margin:28px 0 10px}h1{font-size:clamp(30px,4vw,46px);font-weight:600;letter-spacing:-1px;margin:0;color:#19373d}.intro{font-size:16px;line-height:1.7;max-width:760px;color:#5d7479}.molar-choices{display:flex;gap:10px;flex-wrap:wrap;margin:28px 0}.molar-choices a{padding:14px 22px;border:1px solid #d5dee7;border-radius:8px;text-decoration:none;color:#294b70;font-size:14px;font-weight:600;background:#f8fafc}.molar-choices a[aria-current=page]{background:#0c4a6e;color:#fff;border-color:#0c4a6e}.model-card{border:1px solid #dce4e4;border-radius:24px;overflow:hidden;background:#fff}.model-top{display:flex;justify-content:space-between;gap:24px;align-items:center;padding:26px 30px;border-bottom:1px solid #e4ebed}.model-top .eyebrow{margin:0 0 9px}.model-top h2{font-size:26px;font-weight:600;margin:0;color:#19373d}.model-top p:not(.eyebrow){font-size:13px;color:#5d7479;margin:8px 0 0}.model-actions{display:flex;gap:14px;align-items:center;flex-wrap:wrap}.model-actions a{font-size:13px;color:#22647b;white-space:nowrap}.model-actions button,#return-model{border:1px solid #d5dee7;border-radius:8px;padding:12px 16px;background:#f8fafc;color:#294b70;font:600 13px inherit;cursor:pointer;min-height:44px}#model-host :global(iframe){width:100%;height:980px;border:0;display:block}.model-limits{padding:20px 30px;margin:0;border-top:1px solid #dce4e4;color:#5d7479;font-size:12px;line-height:1.7}#video-host{padding:24px}video{width:100%;max-height:680px;background:#fff}video.lm6-video{aspect-ratio:16/9;object-fit:contain;object-position:center;display:block}#return-model{display:block;margin-top:16px}a:focus-visible,button:focus-visible{outline:3px solid #1678b5;outline-offset:4px}@media(max-width:720px){.three-d-shell{padding:28px 16px}.model-top{padding:20px;flex-direction:column;align-items:start;gap:18px}.model-top h2{font-size:23px}.molar-choices{display:grid;grid-template-columns:1fr 1fr;gap:8px}.molar-choices a{font-size:12px;text-align:center;padding:14px 9px}.model-card{border-radius:18px}.model-limits{padding:18px 20px}.model-actions{gap:12px}#video-host{padding:14px}}
</style>
