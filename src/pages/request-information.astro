---
import ProductLayout from '../layouts/ProductLayout.astro';
import acrobatFiles from '../assets/acrobat-glide-path-files.png';
import etProduct from '../assets/et-transformx.png';
import ptProduct from '../assets/pt-transformx.png';
import bcsSealer from '../assets/bcs-sealer.png';
import vortiflowFlow from '../assets/vortiflow/vortiflow-fluid-dynamics-clean.png';
import { siteConfig } from '../config/site';

const base = import.meta.env.BASE_URL;

const quickLinks = [
  { label: 'TransformX ET', href: '#et-enquiry' },
  { label: 'TransformX PT', href: '#pt-enquiry' },
  { label: 'Acrobat', href: '#acrobat-enquiry' },
  { label: 'BCS', href: '#bcs-enquiry' },
  { label: 'VortiFlow', href: '#vortiflow-enquiry' },
];

const enquiryModules = [
  {
    id: 'et-enquiry',
    eyebrow: 'Shape',
    title: 'ET TransformX',
    text: 'For clinicians evaluating an ET-style .04/.06 shaping pathway with stronger apical control and familiar sequence logic.',
    image: etProduct.src,
    alt: 'ET TransformX rotary files',
    details: ['ET-style shaping sequence', '.04 and .06 workflow logic', 'Pack configuration and regional availability by enquiry'],
    formHref: `${base}request-information/form/#ET%20TransformX`,
  },
  {
    id: 'pt-enquiry',
    eyebrow: 'Shape',
    title: 'PT TransformX',
    text: 'For clinicians working in a ProTaper-style rhythm who want a clearer route to product fit, documentation, and supply discussion.',
    image: ptProduct.src,
    alt: 'PT TransformX rotary files',
    details: ['PT-style shaping sequence', 'SX, shaping, finishing, and assortment discussions', 'Suitable for clinic, group, or distributor enquiries'],
    formHref: `${base}request-information/form/#PT%20TransformX`,
  },
  {
    id: 'acrobat-enquiry',
    eyebrow: 'Glide',
    title: 'Acrobat Glide Path',
    text: 'For glide path planning before shaping, including standard sequence questions and MB2-specific interest.',
    image: acrobatFiles.src,
    alt: 'Acrobat Glide Path files',
    details: ['Rotary glide path support', 'Standard and MB2-specific interest', 'Part-number and technique documentation available on request'],
    formHref: `${base}request-information/form/#Acrobat%20Glide%20Path`,
  },
  {
    id: 'bcs-enquiry',
    eyebrow: 'Seal',
    title: 'BCS BioCeramic Materials',
    text: 'For obturation and repair material enquiries connected to the shaping-to-sealing workflow.',
    image: bcsSealer.src,
    alt: 'BCS BioCeramic sealer packaging',
    details: ['Sealer and putty discussions', 'Clinical use and availability questions', 'Regional supply and distributor conversations'],
    formHref: `${base}request-information/form/#BCS%20BioCeramic%20Materials`,
  },
  {
    id: 'vortiflow-enquiry',
    eyebrow: 'Clean',
    title: 'VortiFlow Irrigation Needle',
    text: 'For cleaning-stage interest and product-fit discussion within the wider EndoTech clinical workflow.',
    image: vortiflowFlow.src,
    alt: 'VortiFlow irrigation flow visual',
    details: ['Irrigation workflow questions', 'Product-fit and availability enquiries', 'Clinical documentation and follow-up support'],
    formHref: `${base}request-information/form/#VortiFlow%20Irrigation%20Needle`,
  },
];
---

<ProductLayout
  title="Request Information | EndoTech Singapore"
  description="A non-commerce information request route for EndoTech Singapore product availability, clinical support, and regional supply discussions."
  image={ptProduct.src}
  accent="slate"
>
  <main class="order-page">
    <section class="order-hero" aria-labelledby="order-title">
      <div class="order-hero-copy">
        <p class="order-eyebrow">Singapore Information Requests</p>
        <h1 id="order-title">Request product information.</h1>
        <p class="order-lede">
          EndoTech Singapore uses a direct enquiry pathway for product availability, clinical fit, distributor discussion, and clinic support. All requests are handled by email follow-up.
        </p>
        <div class="order-actions">
          <a class="order-primary-action" href={`${base}request-information/form/`}>Open request form</a>
          <a class="order-secondary-action" href={`${base}resources/downloads/`}>Review downloads</a>
        </div>
      </div>

      <aside class="order-hero-side" aria-label="Enquiry details">
        <div class="order-hero-side-intro">
          <span>Non-commerce enquiries</span>
          <p>Use this route for product-fit questions, clinical documentation, availability, and regional supply discussion through direct email follow-up.</p>
        </div>
        <div class="order-legal-note">
          <span>Legal entity</span>
          <p>{siteConfig.legalName}</p>
        </div>
        <nav class="order-quick-nav" aria-label="Order enquiry shortcuts">
          {quickLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      </aside>
    </section>

    <section class="order-process" aria-labelledby="order-process-title">
      <div>
        <p class="order-eyebrow">How to enquire</p>
        <h2 id="order-process-title">Send the details needed for a precise response.</h2>
      </div>
      <ol>
        <li>
          <strong>Product interest</strong>
          <span>List the product family, file sequence, material, or irrigation item you want to discuss.</span>
        </li>
        <li>
          <strong>Clinic or region</strong>
          <span>Include your clinic, company, country, and whether the enquiry is clinical, commercial, or distribution-related.</span>
        </li>
        <li>
          <strong>Follow-up route</strong>
          <span>EndoTech Singapore will respond by email with availability, documentation, and next-step support.</span>
        </li>
      </ol>
    </section>

    {enquiryModules.map((module, index) => (
      <section id={module.id} class="order-module" aria-labelledby={`${module.id}-title`}>
        <article class="order-module-card">
          <div class="order-module-index" aria-hidden="true">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <small>{module.eyebrow}</small>
          </div>

          <div class="order-module-intro">
            <div>
              <p class="order-eyebrow">{module.eyebrow}</p>
              <h2 id={`${module.id}-title`}>{module.title}</h2>
              <p>{module.text}</p>
              <ul>
                {module.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            </div>
            <figure>
              <img src={module.image} alt={module.alt} />
            </figure>
          </div>

          <div class="order-module-actions">
            <a href={module.formHref}>Request information</a>
            <a href={`${base}about/contact/`}>Contact details</a>
          </div>
        </article>
      </section>
    ))}
  </main>
</ProductLayout>

<style>
  .order-page {
    background: #f7f9fb;
    color: #0b1424;
  }

  .order-hero,
  .order-process,
  .order-module {
    max-width: 1260px;
    margin: 0 auto;
    padding-left: 48px;
    padding-right: 48px;
  }

  .order-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.78fr);
    gap: clamp(40px, 6vw, 84px);
    align-items: center;
    min-height: min(620px, calc(100vh - 82px));
    padding-top: 72px;
    padding-bottom: 52px;
    background:
      linear-gradient(rgba(15, 23, 42, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.018) 1px, transparent 1px);
    background-size: 34px 34px;
  }

  .order-eyebrow {
    margin: 0 0 18px;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .order-hero h1,
  .order-process h2,
  .order-module h2 {
    margin: 0;
    color: #090f1d;
    font-family: 'Sora', system-ui, sans-serif;
    letter-spacing: 0;
  }

  .order-hero h1 {
    max-width: 11ch;
    font-size: clamp(3.1rem, 5vw, 5.8rem);
    font-weight: 700;
    line-height: 0.98;
  }

  .order-lede,
  .order-hero-side p,
  .order-process span,
  .order-module-intro p,
  .order-module-intro li {
    margin: 0;
    color: #536478;
    font-size: 1.04rem;
    line-height: 1.76;
  }

  .order-lede {
    max-width: 44rem;
    margin-top: 30px;
  }

  .order-actions,
  .order-module-actions,
  .order-quick-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .order-actions {
    margin-top: 32px;
  }

  .order-primary-action,
  .order-secondary-action,
  .order-module-actions a,
  .order-quick-nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border: 1px solid #c8d2dc;
    border-radius: 8px;
    padding: 0 16px;
    color: #0b1424;
    font-weight: 800;
    text-decoration: none;
    transition: border-color 180ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .order-primary-action,
  .order-module-actions a:first-child {
    border-color: #0b1424;
    background: #0b1424;
    color: #ffffff;
  }

  .order-primary-action:hover,
  .order-primary-action:focus-visible,
  .order-secondary-action:hover,
  .order-secondary-action:focus-visible,
  .order-module-actions a:hover,
  .order-module-actions a:focus-visible,
  .order-quick-nav a:hover,
  .order-quick-nav a:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
  }

  .order-hero-side {
    display: grid;
    gap: 22px;
    align-self: stretch;
    border: 1px solid #dbe3ea;
    border-radius: 18px;
    padding: 32px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(247, 250, 252, 0.96) 100%);
    box-shadow: 0 28px 80px -54px rgba(15, 23, 42, 0.16);
  }

  .order-hero-side-intro {
    display: grid;
    gap: 12px;
  }

  .order-legal-note {
    display: grid;
    gap: 6px;
    border-top: 1px solid #dbe3ea;
    padding-top: 18px;
  }

  .order-hero-side-intro span {
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .order-legal-note span {
    color: #64748b;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .order-process {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 36px;
    border-top: 1px solid #dbe3ea;
    border-bottom: 1px solid #dbe3ea;
    padding-top: 52px;
    padding-bottom: 52px;
    background: #ffffff;
  }

  .order-process h2 {
    max-width: 15ch;
    font-size: clamp(2rem, 2.7vw, 3.2rem);
    line-height: 1.08;
  }

  .order-process ol {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .order-process li {
    display: grid;
    gap: 6px;
    border: 1px solid #dbe3ea;
    border-radius: 8px;
    background: #f8fafc;
    padding: 18px;
  }

  .order-process strong {
    color: #0b1424;
    font-family: 'Sora', system-ui, sans-serif;
  }

  .order-module {
    scroll-margin-top: 104px;
    padding-top: 52px;
  }

  .order-module:last-child {
    padding-bottom: 96px;
  }

  .order-module-card {
    position: relative;
    overflow: hidden;
    border: 1px solid #ccd8e3;
    border-left: 7px solid #0f5878;
    border-radius: 10px;
    background:
      linear-gradient(90deg, rgba(15, 88, 120, 0.055), transparent 38%),
      #ffffff;
    padding: 34px 32px 32px;
    box-shadow: 0 26px 62px -52px rgba(15, 23, 42, 0.34);
  }

  .order-module-index {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 34px;
    margin-bottom: 28px;
    border: 1px solid #c8d5e0;
    border-radius: 999px;
    background: #f7fafc;
    padding: 0 14px 0 5px;
    color: #0b1424;
    font-family: 'Sora', system-ui, sans-serif;
    font-weight: 800;
  }

  .order-module-index span {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: #0b1424;
    color: #ffffff;
    font-size: 0.7rem;
  }

  .order-module-index small {
    color: #5076b8;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .order-module-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(280px, 0.72fr);
    gap: 36px;
    align-items: end;
  }

  .order-module-intro h2 {
    font-size: clamp(2rem, 2.5vw, 3rem);
    line-height: 1.06;
  }

  .order-module-intro p {
    max-width: 44rem;
    margin-top: 18px;
  }

  .order-module-intro ul {
    display: grid;
    gap: 8px;
    margin: 22px 0 0;
    padding-left: 1.15rem;
  }

  .order-module-intro li {
    padding-left: 0.15rem;
  }

  .order-module-intro figure {
    display: grid;
    place-items: center;
    min-height: 190px;
    margin: 0;
    border: 1px solid #d6e0e8;
    border-radius: 8px;
    background: #f8fafc;
    padding: 26px;
  }

  .order-module-intro img {
    display: block;
    width: 100%;
    max-height: 240px;
    object-fit: contain;
    margin: 0 auto;
  }

  .order-module-actions {
    margin-top: 26px;
  }

  @media (max-width: 1120px) {
    .order-hero,
    .order-process,
    .order-module {
      padding-left: 30px;
      padding-right: 30px;
    }

    .order-hero,
    .order-process,
    .order-module-intro {
      grid-template-columns: 1fr;
    }

    .order-hero {
      min-height: auto;
      padding-top: 48px;
    }
  }

  @media (max-width: 720px) {
    .order-hero,
    .order-process,
    .order-module {
      padding-left: 18px;
      padding-right: 18px;
    }

    .order-hero h1 {
      font-size: clamp(2.6rem, 11vw, 4.1rem);
    }

    .order-quick-nav,
    .order-actions,
    .order-module-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .order-module-card {
      border-left-width: 5px;
      padding: 22px 16px 18px;
    }
  }
</style>
