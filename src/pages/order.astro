---
import ProductLayout from '../layouts/ProductLayout.astro';
import { siteConfig } from '../config/site';

const base = import.meta.env.BASE_URL;
const orderEmailHref = `mailto:${siteConfig.email}?subject=EndoTech%20NZ%20account%20order`;
---

<ProductLayout
  title="Account Ordering | EndoTech NZ"
  description="EndoTech NZ online ordering is temporarily unavailable while account ordering is introduced."
  accent="slate"
>
  <section class="ordering-hold" aria-labelledby="ordering-hold-title">
    <div class="ordering-hold-card">
      <p class="ordering-hold-eyebrow">Account ordering</p>
      <h1 id="ordering-hold-title">Online ordering is temporarily unavailable</h1>
      <p class="ordering-hold-lede">
        EndoTech NZ has paused its online checkout while we move to account ordering.
      </p>
      <p>
        To place an order, submit a purchase order, or ask about an existing order, please email
        <a href={orderEmailHref}>{siteConfig.email}</a>. Include your account or practice name,
        purchase order number, products, quantities, and delivery details.
      </p>
      <div class="ordering-hold-actions">
        <a class="ordering-hold-primary" href={orderEmailHref}>Email an account order</a>
        <a class="ordering-hold-secondary" href={`${base}about/contact/`}>Contact EndoTech NZ</a>
      </div>
      <p class="ordering-hold-note">
        Please do not send patient-identifiable clinical information with an order enquiry.
      </p>
    </div>
  </section>
</ProductLayout>

<style>
  .ordering-hold {
    min-height: 68vh;
    display: grid;
    place-items: center;
    padding: clamp(4rem, 9vw, 8rem) 1.25rem;
    background:
      radial-gradient(circle at 15% 10%, rgba(22, 101, 98, 0.1), transparent 34rem),
      linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .ordering-hold-card {
    width: min(100%, 54rem);
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid #dbe4ea;
    border-top: 5px solid #166562;
    border-radius: 1.25rem;
    background: #ffffff;
    box-shadow: 0 1.5rem 4rem rgba(15, 35, 55, 0.1);
  }

  .ordering-hold-eyebrow {
    margin: 0 0 0.75rem;
    color: #166562;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ordering-hold h1 {
    max-width: 15ch;
    margin: 0;
    color: #102a43;
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .ordering-hold p {
    max-width: 46rem;
    color: #3d4f61;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .ordering-hold p a {
    color: #125b58;
    font-weight: 700;
  }

  .ordering-hold-lede {
    margin-top: 1.5rem;
    color: #20384d !important;
    font-size: clamp(1.2rem, 2vw, 1.5rem) !important;
  }

  .ordering-hold-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .ordering-hold-actions a {
    display: inline-flex;
    min-height: 3.1rem;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.25rem;
    border: 1px solid #166562;
    border-radius: 999px;
    font-weight: 800;
    text-decoration: none;
  }

  .ordering-hold-primary {
    background: #166562;
    color: #ffffff;
  }

  .ordering-hold-secondary {
    background: #ffffff;
    color: #125b58;
  }

  .ordering-hold-note {
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid #e3e9ee;
    color: #647587 !important;
    font-size: 0.9rem !important;
  }

  @media (max-width: 40rem) {
    .ordering-hold-actions a {
      width: 100%;
    }
  }
</style>
