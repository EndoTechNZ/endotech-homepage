---
import ProductLayout from '../layouts/ProductLayout.astro';
import SGProformaSelector from '../components/product/SGProformaSelector.astro';
import acrobatFiles from '../assets/acrobat-glide-path-files.png';
import etProduct from '../assets/et-transformx.png';
import ptProduct from '../assets/pt-transformx.png';
import bcsSealer from '../assets/bcs-sealer.png';
import vortiflowFlow from '../assets/vortiflow/vortiflow-fluid-dynamics-clean.png';
import { siteConfig } from '../config/site';

const base = import.meta.env.BASE_URL;

const orderPanelDescription = `To request proforma
- Choose file size or configuration (Step 1)
- Choose file length (Step 2)
- Click 'Add to order'`;

const acrobatItems = [
  ...['13/.03', '15/.03', '17/.03'].flatMap((size) =>
    ['21 mm', '25 mm', '29 mm'].map((length) => {
      const sizeCode = size.replace('/.', '').replace('.', '');
      const lengthCode = length.replace(' mm', '');
      return {
        size,
        length,
        sku: `ACGP-${sizeCode}${lengthCode}RF`,
        description: `Acrobat Glide Path file ${size}, ${length}`,
      };
    }),
  ),
  {
    size: '15/.05',
    length: '17 mm',
    sku: 'ACGP-150517RF',
    description: 'Acrobat MB2 file 15/.05, 17 mm',
    isMb2: true,
  },
];

const etTips = ['17', '20', '25', '30', '35', '40', '45'];
const etItems = [
  ...etTips.flatMap((tip) =>
    ['21 mm', '25 mm', '29 mm'].map((length) => ({
      size: `${tip}/.04`,
      length,
      sku: `TXET-${tip}04${length.replace(' mm', '')}`,
      description: `ET TransformX ${tip}/.04, ${length}`,
    })),
  ),
  { size: '.04 assortment', length: '21 mm', sku: 'TXET-0421MM', description: 'ET TransformX .04 assortment, 21 mm' },
  { size: '.04 assortment', length: '25 mm', sku: 'TXET-0425MM', description: 'ET TransformX .04 assortment, 25 mm' },
  ...etTips.flatMap((tip) =>
    ['21 mm', '25 mm', '29 mm'].map((length) => ({
      size: `${tip}/.06`,
      length,
      sku: `TXET-${tip}06${length.replace(' mm', '')}`,
      description: `ET TransformX ${tip}/.06, ${length}`,
    })),
  ),
  { size: '.06 assortment', length: '21 mm', sku: 'TXET-0621MM', description: 'ET TransformX .06 assortment, 21 mm' },
  { size: '.06 assortment', length: '25 mm', sku: 'TXET-0625MM', description: 'ET TransformX .06 assortment, 25 mm' },
];

const ptItems = [
  { size: 'SX', length: '19 mm', sku: 'TXPT-SX-19', description: 'PT TransformX SX shaping file, 19 mm' },
  ...['21 mm', '25 mm', '31 mm'].flatMap((length) =>
    ['S1', 'S2', 'F1', 'F2', 'F3', 'F4', 'F5'].map((size) => ({
      size,
      length,
      sku: `TXPT-${size}-${length.replace(' mm', '')}`,
      description: `PT TransformX ${size} file, ${length}`,
    })),
  ),
  { size: 'Assortment', length: '21 mm', sku: 'TXPT-ASS21', description: 'PT TransformX assortment, 21 mm' },
  { size: 'Assortment', length: '25 mm', sku: 'TXPT-ASS25', description: 'PT TransformX assortment, 25 mm' },
  { size: 'Assortment', length: '31 mm', sku: 'TXPT-ASS31', description: 'PT TransformX assortment, 31 mm' },
];

const quickLinks = [
  { label: 'Acrobat', href: '#acrobat-order', marker: '01' },
  { label: 'ET TransformX', href: '#et-order', marker: '02' },
  { label: 'PT TransformX', href: '#pt-order', marker: '03' },
  { label: 'BCS', href: '#contact-products', marker: '04' },
  { label: 'VortiFlow', href: '#contact-products', marker: '05' },
];

const contactProducts = [
  {
    title: 'VortiFlow Irrigation Needle',
    text: 'Use the same page to move from shaping requests into cleaning-stage enquiries.',
    image: vortiflowFlow.src,
    href: `${base}products/vortiflow-irrigation-needle/`,
    cta: 'View VortiFlow',
  },
  {
    title: 'BCS BioCeramic Materials',
    text: 'Request availability for sealing and repair materials as part of the wider clinical workflow.',
    image: bcsSealer.src,
    href: `${base}products/bcs/`,
    cta: 'View BCS family',
  },
];

const orderModules = [
  {
    id: 'acrobat-order',
    eyebrow: 'Glide',
    title: 'Acrobat Glide Path',
    text: 'Build the glide path stage first, then continue directly into shaping on the same request.',
    image: acrobatFiles.src,
    alt: 'Acrobat Glide Path Files',
    orderTitle: 'Request Acrobat sequence proforma',
    productFamily: 'Glide Path',
    productLabel: 'Acrobat Glide Path',
    items: acrobatItems,
    coverageLabel: '13/.03, 15/.03, 17/.03 and MB2',
    selectionNote: 'The MB2 option is limited to 17 mm. Standard Acrobat sequence files are available in 21 mm, 25 mm, and 29 mm.',
  },
  {
    id: 'et-order',
    eyebrow: 'Shape',
    title: 'ET TransformX',
    text: 'For clinicians already working in ET, EdgeX7, and .04/.06-style sequence logic.',
    image: etProduct.src,
    alt: 'ET TransformX rotary files',
    orderTitle: 'Request ET sequence proforma',
    productFamily: 'Rotary Files',
    productLabel: 'ET TransformX',
    items: etItems,
    coverageLabel: '.04 and .06 sequences',
    selectionNote: 'ET TransformX covers .04 and .06 sequences across 21 mm, 25 mm, and 29 mm lengths, with assortment options available.',
  },
  {
    id: 'pt-order',
    eyebrow: 'Shape',
    title: 'PT TransformX',
    text: 'For ProTaper-style shaping workflows that need a familiar sequence with a direct SG proforma request route.',
    image: ptProduct.src,
    alt: 'PT TransformX rotary files',
    orderTitle: 'Request PT sequence proforma',
    productFamily: 'Rotary Files',
    productLabel: 'PT TransformX',
    items: ptItems,
    coverageLabel: 'SX, S1/S2, F1-F5 and assortments',
    selectionNote: 'SX is supplied in 19 mm. Shaping and finishing files run across 21 mm, 25 mm, and 31 mm lengths.',
  },
];
---

<ProductLayout
  title="Request Proforma | EndoTech Singapore"
  description="Build a direct EndoTech Singapore proforma request by file system, size, length, SKU, and quantity."
  image={ptProduct.src}
  accent="slate"
>
  <main class="order-page">
    <section class="order-hero" aria-labelledby="order-title">
      <div>
        <p class="order-eyebrow">Singapore Proforma Request</p>
        <h1 id="order-title">Proforma Order Request</h1>
        <p class="order-lede">
          Add Acrobat, ET TransformX, and PT TransformX packs into one direct proforma request. EndoTech Singapore will confirm pricing, availability, and delivery details by follow-up.
        </p>
      </div>

      <div class="order-hero-side">
        <nav class="order-quick-nav" aria-label="Order section shortcuts">
          {quickLinks.map((link) => (
            <a href={link.href}>
              <span>{link.marker}</span>
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </section>

    <section class="order-flow-note" aria-label="Ordering note">
      <div>
        <strong>One combined request</strong>
        <p>Add Glide Path, ET, and PT packs as you scroll. Each selector contributes to the same proforma request list.</p>
      </div>
      <a href={`${base}resources/downloads/`}>Open technical files</a>
    </section>

    <section class="order-category-heading" aria-labelledby="file-systems-title">
      <div>
        <p class="order-eyebrow">File Systems</p>
        <h2 id="file-systems-title">Active proforma request for glide path and shaping files.</h2>
        <p>
          Acrobat, ET TransformX, and PT TransformX are grouped here as the current file request area for EndoTech Singapore.
        </p>
      </div>
      <div class="legal-entity-panel">
        <span>Legal entity</span>
        <strong>{siteConfig.legalName}</strong>
      </div>
    </section>

    {orderModules.map((module, index) => (
      <section id={module.id} class="order-module" aria-labelledby={`${module.id}-title`}>
        <div class="order-module-card">
          <div class="order-module-index" aria-hidden="true">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <small>{module.eyebrow}</small>
          </div>

          <div class="order-module-intro">
            <div>
              <p class="order-eyebrow">{module.eyebrow}</p>
              <h2 id={`${module.id}-title`}>{module.title}</h2>
              <p>{module.text}</p>
            </div>
            <figure>
              <img src={module.image} alt={module.alt} />
            </figure>
          </div>

          <SGProformaSelector
            title={module.orderTitle}
            description={orderPanelDescription}
            coverageLabel={module.coverageLabel}
            packFormat="6 files per pack"
            items={module.items}
            selectionNote={module.selectionNote}
            productFamily={module.productFamily}
            productLabel={module.productLabel}
            email={siteConfig.email}
          />
        </div>
      </section>
    ))}

    <section id="contact-products" class="contact-products-section" aria-labelledby="contact-products-title">
      <div class="contact-products-heading">
        <div>
          <p class="order-eyebrow">Contact Products</p>
          <h2 id="contact-products-title">Materials and irrigation stay connected to the request flow.</h2>
          <p>
            VortiFlow and BCS are included here as direct enquiry routes. They can be discussed alongside the file proforma request.
          </p>
        </div>
        <a href={`${base}request-information/`}>Request information</a>
      </div>

      <div class="contact-products-grid">
        {contactProducts.map((product) => (
          <article>
            <figure>
              <img src={product.image} alt="" />
            </figure>
            <div>
              <h3>{product.title}</h3>
              <p>{product.text}</p>
              <a href={product.href}>{product.cta}</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</ProductLayout>

<style>
  .order-page {
    background: #f7f9fb;
    color: #0b1424;
  }

  .order-hero,
  .order-flow-note,
  .order-category-heading,
  .order-module,
  .contact-products-section {
    max-width: 1260px;
    margin: 0 auto;
    padding-left: 48px;
    padding-right: 48px;
  }

  .order-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.78fr);
    gap: clamp(40px, 6vw, 84px);
    align-items: end;
    min-height: min(640px, calc(100vh - 82px));
    padding-top: 64px;
    padding-bottom: 56px;
    background:
      linear-gradient(rgba(15, 23, 42, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.018) 1px, transparent 1px);
    background-size: 34px 34px;
  }

  .order-eyebrow {
    margin: 0 0 18px;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .order-hero h1,
  .order-category-heading h2,
  .order-module h2,
  .contact-products-heading h2,
  .contact-products-grid h3 {
    margin: 0;
    color: #090f1d;
    font-family: 'Sora', system-ui, sans-serif;
    letter-spacing: 0;
  }

  .order-hero h1 {
    max-width: 12ch;
    font-size: clamp(3.2rem, 4.8vw, 5.6rem);
    font-weight: 700;
    line-height: 1;
  }

  .order-lede,
  .order-hero-side p,
  .order-flow-note p,
  .order-category-heading p,
  .order-module-intro p,
  .contact-products-heading p,
  .contact-products-grid p {
    margin: 0;
    color: #536478;
    font-size: 1.04rem;
    line-height: 1.76;
  }

  .order-lede {
    max-width: 50rem;
    margin-top: 28px;
  }

  .order-hero-side {
    border-top: 1px solid #cfd9e2;
    padding-top: 26px;
  }

  .order-quick-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 0;
  }

  .order-quick-nav a,
  .order-flow-note a,
  .contact-products-heading > a,
  .contact-products-grid a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border: 1px solid #c8d2dc;
    border-radius: 999px;
    padding: 0 16px;
    color: #0b1424;
    font-weight: 800;
    text-decoration: none;
  }

  .order-quick-nav a {
    justify-content: flex-start;
    gap: 10px;
    min-height: 54px;
    border-color: #cbd9e6;
    border-radius: 8px;
    background:
      linear-gradient(90deg, rgba(15, 88, 120, 0.07), transparent 42%),
      #ffffff;
    padding: 0 16px 0 10px;
    box-shadow: 0 16px 34px -32px rgba(15, 23, 42, 0.42);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease,
      background-color 160ms ease;
  }

  .order-quick-nav a span {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: #0b1424;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0;
  }

  .order-quick-nav a:hover,
  .order-quick-nav a:focus-visible {
    border-color: #0f5878;
    background-color: #f8fbfd;
    box-shadow: 0 18px 38px -30px rgba(15, 88, 120, 0.48);
    transform: translateY(-1px);
  }

  .order-flow-note {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    border-top: 1px solid #dbe3ea;
    border-bottom: 1px solid #dbe3ea;
    background: #ffffff;
    padding-top: 24px;
    padding-bottom: 24px;
  }

  .order-flow-note strong {
    display: block;
    margin-bottom: 6px;
    color: #0b1424;
    font-family: 'Sora', system-ui, sans-serif;
  }

  .order-category-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.42fr);
    gap: 36px;
    align-items: end;
    padding-top: 80px;
    padding-bottom: 16px;
  }

  .order-category-heading h2 {
    max-width: 18ch;
    font-size: clamp(2.35rem, 3vw, 3.75rem);
    line-height: 1.06;
  }

  .order-category-heading p {
    max-width: 52rem;
    margin-top: 20px;
  }

  .legal-entity-panel {
    display: grid;
    gap: 8px;
    border-top: 1px solid #cfd9e2;
    padding-top: 18px;
  }

  .legal-entity-panel span {
    color: #64748b;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .legal-entity-panel strong {
    color: #0b1424;
  }

  .order-module {
    scroll-margin-top: 104px;
    padding-top: 40px;
    padding-bottom: 0;
  }

  .order-module + .order-module {
    padding-top: 84px;
  }

  .order-module-card {
    position: relative;
    overflow: hidden;
    border: 1px solid #ccd8e3;
    border-left: 7px solid #0f5878;
    border-radius: 10px;
    background:
      linear-gradient(90deg, rgba(15, 88, 120, 0.055), transparent 38%),
      #ffffff;
    padding: 34px 32px 32px;
    box-shadow: 0 26px 62px -52px rgba(15, 23, 42, 0.34);
  }

  .order-module-index {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 34px;
    margin-bottom: 28px;
    border: 1px solid #c8d5e0;
    border-radius: 999px;
    background: #f7fafc;
    padding: 0 14px 0 5px;
    color: #0b1424;
    font-family: 'Sora', system-ui, sans-serif;
    font-weight: 800;
  }

  .order-module-index span {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: #0b1424;
    color: #ffffff;
    font-size: 0.7rem;
  }

  .order-module-index small {
    color: #5076b8;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .order-module-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(280px, 0.72fr);
    gap: 36px;
    align-items: end;
    margin-bottom: 28px;
  }

  .order-module-intro h2 {
    font-size: clamp(2rem, 2.5vw, 3rem);
    line-height: 1.06;
  }

  .order-module-intro p {
    max-width: 44rem;
    margin-top: 18px;
  }

  .order-module-intro figure {
    display: grid;
    place-items: center;
    min-height: 190px;
    margin: 0;
    border: 1px solid #d6e0e8;
    border-radius: 8px;
    background: #f8fafc;
    padding: 26px;
  }

  .order-module-intro img {
    display: block;
    width: 100%;
    max-height: 240px;
    object-fit: contain;
    margin: 0 auto;
  }

  .contact-products-section {
    border-top: 1px solid #dbe3ea;
    padding-top: 96px;
    padding-bottom: 112px;
    background: #ffffff;
  }

  .contact-products-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: end;
  }

  .contact-products-heading h2 {
    max-width: 16ch;
    font-size: clamp(2rem, 2.6vw, 3.15rem);
    line-height: 1.08;
  }

  .contact-products-heading p {
    max-width: 48rem;
    margin-top: 18px;
  }

  .contact-products-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 42px;
  }

  .contact-products-grid article {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 22px;
    border: 1px solid #dbe3ea;
    border-radius: 8px;
    background: #f8fafc;
    padding: 22px;
  }

  .contact-products-grid figure {
    display: grid;
    place-items: center;
    margin: 0;
    border-radius: 8px;
    background: #ffffff;
    padding: 16px;
  }

  .contact-products-grid img {
    width: 100%;
    max-height: 150px;
    object-fit: contain;
  }

  .contact-products-grid div {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .contact-products-grid h3 {
    font-size: 1.4rem;
    line-height: 1.18;
  }

  .contact-products-grid a {
    width: fit-content;
    margin-top: 6px;
  }

  @media (max-width: 1120px) {
    .order-hero,
    .order-flow-note,
    .order-category-heading,
    .order-module,
    .contact-products-section {
      padding-left: 30px;
      padding-right: 30px;
    }

    .order-hero,
    .order-category-heading,
    .order-module-intro,
    .contact-products-heading,
    .contact-products-grid {
      grid-template-columns: 1fr;
    }

    .order-hero {
      min-height: auto;
      padding-top: 48px;
      padding-bottom: 52px;
    }

    .order-flow-note {
      grid-template-columns: 1fr;
    }

    .contact-products-grid article {
      grid-template-columns: 200px minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    .order-hero,
    .order-flow-note,
    .order-category-heading,
    .order-module,
    .contact-products-section {
      padding-left: 18px;
      padding-right: 18px;
    }

    .order-hero h1 {
      font-size: clamp(2.8rem, 11.8vw, 4.2rem);
      line-height: 0.98;
    }

    .order-quick-nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .order-module + .order-module {
      padding-top: 56px;
    }

    .order-module-card {
      border-left-width: 5px;
      padding: 22px 16px 18px;
    }

    .order-module-intro {
      gap: 24px;
      margin-bottom: 22px;
    }

    .order-module-intro figure {
      min-height: 160px;
      padding: 18px 0;
    }

    .contact-products-grid article {
      grid-template-columns: 1fr;
      padding: 18px;
    }

    .contact-products-grid a,
    .contact-products-heading > a {
      width: 100%;
    }
  }
</style>
