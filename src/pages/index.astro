---
import Layout from '../layouts/Layout.astro';
import HomepageConceptV3 from '../components/home/HomepageConceptV3.astro';
import heroProduct from '../assets/transformx-rotary-file-system.png';
import { siteConfig } from '../config/site';

const description =
  'EndoTech NZ supplies rotary NiTi endodontic files, glide path instruments, irrigation products, and bioceramic materials to dentists and endodontists throughout New Zealand.';
---

<Layout
  title={siteConfig.homepageTitle}
  description={description}
  image={heroProduct.src}
>
  <HomepageConceptV3 />
</Layout>
