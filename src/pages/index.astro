---
import Layout from '../layouts/Layout.astro';
import HomepageConceptV3 from '../components/home/HomepageConceptV3.astro';
import heroProduct from '../assets/homepage-transform-s-clinical-splash.png';
import { siteConfig } from '../config/site';

const description =
  'EndoTech NZ supplies rotary and reciprocating NiTi endodontic files, glide-path instruments, irrigation products, and bioceramic materials throughout New Zealand.';
---

<Layout
  title={siteConfig.homepageTitle}
  description={description}
  image={heroProduct.src}
>
  <HomepageConceptV3 />
</Layout>
